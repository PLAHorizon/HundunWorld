{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Orleans": "Warning",
      "Orleans.Runtime": "Warning",
      "Orleans.Serialization": "Warning",
      "Orleans.Reminders": "Warning",
      "TouchSocket": "Warning",
      "Horizon.Game.Gateway": "Information",
      "Horizon.Game.Core": "Warning",
      "Horizon.Orleans.Grains": "Information"
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Horizon.Game.Gateway.Services.GatewayRegistryHostedService": "Information",
        "Horizon.Game.Gateway.Services.GatewayHostedService": "Information",
        "Horizon.Game.Gateway.Services.SyncDispatcherHostedService": "Information"
      }
    },
    "File": {
      "LogLevel": {
        "Default": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Horizon.Game.Gateway": "Information",
        "Horizon.Game.Gateway.Services.SyncDispatcherHostedService": "Debug",
        "Horizon.Game.Gateway.Services.PlayerDespawnScheduler": "Debug",
        "Horizon.Game.Gateway.Network.GameNetworkServer": "Information",
        "Horizon.Game.Gateway.Services.ConnectionManager": "Information",
        "Horizon.Game.Gateway.Services.CharacterPresenceMonitorHostedService": "Information",
        "Horizon.Orleans.Grains": "Information",
        "Horizon.Game.Core.Handlers.SyncPacketHandler": "Information"
      },
      "LogDirectory": "Logs",
      "ServiceName": "HundunWorld-Gateway",
      "MaxFileSizeMB": 20,
      "RetainDays": 15,
      "DailyRotation": true,
      "FlushIntervalSeconds": 2,
      "MaxQueueSize": 20000
    }
  },
  
  "Gateway": {
    "Name": "混沌世界游戏网关",
    "GatewayId": "TYMYD-Gateway-001",
    "Region": "华东",
    "StrictEmptyRegionMode": false,
    "ValidateTokenMachineId": false,
    "MaxConnections": 10000,
    "ConnectionTimeout": 300,
    "HeartbeatInterval": 30,
    "EnableCompression": true,
    "EnableEncryption": true,
    "BufferSize": 8192,
    "StatisticsInterval": 60,
    "EnableVerboseLogging": false,
    "UseSyncPacketDispatch": true,
    "UseDS": true,
    "DsUplinkPort": 19871,
    "DsControlToken": "",
    "DsGrayRatio": 100,
    "DsRouteUsePersistentConnection": true,
    "RequireStrictVersionMatch": false,
    "DsRollback": {
      "WindowSeconds": 30,
      "MinAttemptsPerWindow": 10,
      "FallbackRateThreshold": 0.5,
      "LatencyMsThreshold": 1000,
      "CorrectionsPerWindowThreshold": 0,
      "ConsecutiveBadWindowsToTrigger": 2,
      "ConsecutiveHealthyWindowsToRecover": 3,
      "OverrideCooldownSeconds": 60
    }
  },

  "Network": {
    "TcpPort": 7789,
    "UdpPort": 8889,
    "WebSocketPort": 8890,
    "IpAddress": "${GATEWAY_BIND_IP}",
    "NoDelay": true,
    "SendBufferSize": 32768,
    "ReceiveBufferSize": 32768,
    "Backlog": 100,
    "KeepAliveInterval": 30000,
    "KeepAliveTimeout": 5000,
    "EnableSsl": false,
    "SslCertificatePath": null,
    "SslCertificatePassword": null
  },

  "Monitoring": {
    "PrometheusPort": 9465,
    "Otlp": {
      "Endpoint": ""
    }
  },

  "Orleans": {
    "ClusterId": "dev",
    "ServiceId": "BaseService",
    "SiloEndpoints": [ "${ORLEANS_SILO_ENDPOINTS}" ],
    "GatewayPort": 30000,
    "RetryCount": 0,
    "RetryInterval": 1000,
    "ResponseTimeout": 30000,
    "EnableStatistics": true,
    "EnablePerformanceCounters": true
  },
  "ClusterOptions": {
    "ClusterId": "dev",
    "ServiceId": "BaseService"
  },
  "Redis": {
    "ConnectionString": "${GATEWAY_REDIS_CONNECTION_STRING}"
  },
  "DataBase": {
    "RedisMasters": [
      {
        "Host": "${REDIS_HOST}",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "${REDIS_HOST}",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      }
    ],
    "RedisSlaves": [
      {
        "Host": "${REDIS_HOST}",
        "Port": "9679",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "${REDIS_HOST}",
        "Port": "9779",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "${REDIS_HOST}",
        "Port": "9879",
        "Password": "${REDIS_PASSWORD}"
      }
    ],
    "RedisSentinels": [
      {
        "Host": "127.0.0.1",
        "Port": "6379"
      },
      {
        "Host": "127.0.0.1",
        "Port": "6379"
      }
    ]
  },
  "Configs": {
    "Ali": {
      "AliOSSAccessKeyId": "${ALI_OSS_ACCESS_KEY_ID}",
      "AliOSSAccessKeySecret": "${ALI_OSS_ACCESS_KEY_SECRET}",
      "AliOSSPrivateEndpoint": "oss-cn-beijing.aliyuncs.com",
      "AliOSSFileServerDomain": "Horizon-wcf-im-oss.oss-cn-beijing.aliyuncs.com",
      "AliOSSBucketName": "Horizon-wcf-im-oss",
      "AliOSSImageServerDomain": "Horizon-wcf-im-oss.oss-cn-beijing.aliyuncs.com"
    },
    "BuiDu": {
      "BaiDuApiKey": "${BAIDU_API_KEY}",
      "BaiDuSecretKey": "${BAIDU_SECRET_KEY}"
    },
    "XunFei": {
      "XunFeiSpeechTTS": "5a4459ff",
      "XunFeiIsRealTime": "true"
    },
    "HorizonSelf": {
      "LogRepository": "Horizon.Common",
      "ApiLogRepository": "Horizon.Api"
    }
  },
  "ClusteringSiloOptions": {
    "OrleansSiloHost": "${ORLEANS_SILO_HOST}",
    "SqlServer": {
      "ConnectionString": "${ORLEANS_SQLSERVER_CONNECTION_STRING}",
      "Invariant": "Microsoft.Data.SqlClient"
    },
    "Npgsql": {
      "ConnectionString": "${ORLEANS_NPGSQL_CONNECTION_STRING}",
      "Invariant": "Npgsql"
    },
    "Mysql": {
      "ConnectionString": "${ORLEANS_MYSQL_CONNECTION_STRING}",
      "Invariant": "MySql.Data.MySqlClient"
    },
    "Oracle": {
      "ConnectionString": "${ORLEANS_ORACLE_CONNECTION_STRING}",
      "Invariant": "Oracle.ManagedDataAccess.Client"
    }
  },
  "DatabaseOptions": {
    "Basic": {
      "ConnectionString": "${DB_BASIC_CONNECTION_STRING}",
      "Type": 0
    },
    "Game": {
      "ConnectionString": "${DB_GAME_CONNECTION_STRING}",
      "Type": 0
    },
    "Article": {
      "ConnectionString": "${DB_ARTICLE_CONNECTION_STRING}",
      "Type": 0
    },
    "Support": {
      "ConnectionString": "${DB_SUPPORT_CONNECTION_STRING}",
      "Type": 0
    },
    "Xingguang": {
      "ConnectionString": "${DB_XINGGUANG_CONNECTION_STRING}",
      "Type": 0
    }
  },
  "DashboardOptions": {
    "Host": "${ORLEANS_DASHBOARD_HOST}",
    "Port": 1199,
    "Username": "${ORLEANS_DASHBOARD_USERNAME}",
    "Password": "${ORLEANS_DASHBOARD_PASSWORD}"
  },
  "VerificationUserDataOptions": {
    "Phone": 5,
    "Email": 1440,
    "IdCard": 3,
    "FaceId": 3
  },
  
  "Security": {
    "MaxLoginAttempts": 5,
    "LoginAttemptsWindowMinutes": 15,
    "SessionTimeoutHours": 24,
    "RequiredClientVersion": "1.0.0",
    "EnableAccountValidation": true,
    "EnablePasswordComplexityCheck": true,
    "EnableIPWhitelist": false,
    "AllowedIPs": [],
    "EnableRateLimiting": true,
    "MaxRequestsPerMinute": 60,
    "AuthTokenSecret": "${GATEWAY_AUTH_TOKEN_SECRET}"
  },
  
  "Authentication": {
    "TokenExpirationMinutes": 1440,
    "RefreshTokenExpirationHours": 168,
    "EnableMultipleDeviceLogin": true,
    "MaxConcurrentSessions": 3,
    "EnableRememberMe": true,
    "RememberMeDurationDays": 30
  },
  
  "CharacterManagement": {
    "MaxCharactersPerAccount": 5,
    "CharacterNameMinLength": 2,
    "CharacterNameMaxLength": 12,
    "EnableSensitiveWordFilter": true,
    "AllowSpecialCharacters": false,
    "EnableCharacterDeletion": true,
    "CharacterDeletionCooldownHours": 24
  },
  
  "MessageHandler": {
    "EnableMessageValidation": true,
    "MaxMessageSize": 65536,
    "MessageProcessingTimeout": 30000,
    "EnableMessageCompression": true,
    "CompressionThreshold": 1024
  },

  "SyncReconciliation": {
    "StormThreshold": 5,
    "StormWindowSeconds": 2.0,
    "StormCooldownSeconds": 1.0
  }
}
