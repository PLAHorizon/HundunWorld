<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.EconomyCli</RootNamespace>
    <AssemblyName>Horizon.EconomyCli</AssemblyName>
    <!-- 同其它 CLI：不要开 InvariantGlobalization（SqlClient 会直接抛）。 -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Entities\Horizon.Entities.csproj" />
    <ProjectReference Include="..\Horizon.Model\Horizon.Model.csproj" />
    <!-- 连接串解析复用 QuestCli（与 NpcCli/MonsterCli 同一份约定，不写第二份清单）。 -->
    <ProjectReference Include="..\Horizon.QuestCli\Horizon.QuestCli.csproj" />
  </ItemGroup>

</Project>
