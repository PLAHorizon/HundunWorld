<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Horizon.MonsterCli</RootNamespace>
    <AssemblyName>Horizon.MonsterCli</AssemblyName>
    <!-- 不要开 InvariantGlobalization：Microsoft.Data.SqlClient 在不变区域模式下直接抛异常。 -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Core.Abstract\Horizon.Core.Abstract.csproj" />
    <ProjectReference Include="..\Horizon.Entities\Horizon.Entities.csproj" />
    <ProjectReference Include="..\Horizon.Game.Sim\Horizon.Game.Sim.csproj" />
    <!-- 导出内容快照需要 Core 里的快照 DTO（DsHost 的读端也在 Core）：
         写端与读端共用同一份类型，避免"导出的 JSON 只有另一边能解"。 -->
    <ProjectReference Include="..\Horizon.Game.Core\Horizon.Game.Core.csproj" />
    <ProjectReference Include="..\Horizon.Model\Horizon.Model.csproj" />
    <!-- 连接串与 Redis 候选的解析口径**复用** QuestCli 的 ConnectionConfig，不做第二份副本：
         两处各写一份"从 env / .env / repository.json 里找连接串"的清单，漏改一处就会让两个编辑器
         连到不同的库，而两边的输出都是 ok=true。 -->
    <ProjectReference Include="..\Horizon.QuestCli\Horizon.QuestCli.csproj" />
  </ItemGroup>

</Project>
