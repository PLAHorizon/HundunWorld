<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_build_validation\**" />
    <EmbeddedResource Remove="_build_validation\**" />
    <None Remove="_build_validation\**" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Consul" />
	  <PackageReference Include="K4os.Compression.LZ4" />
	  <PackageReference Include="MemoryPack.Core" />
	  <PackageReference Include="MemoryPack.Generator" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.DependencyValidation.Analyzers" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Console" />
	  <PackageReference Include="Microsoft.Orleans.Client" />
	  <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
	  <PackageReference Include="Microsoft.Orleans.Clustering.Redis" />
	  <PackageReference Include="Microsoft.Orleans.CodeGenerator">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Orleans.Core" />
	  <PackageReference Include="Microsoft.Orleans.Sdk" />
	  <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" />
	  <PackageReference Include="Microsoft.Orleans.Serialization.NewtonsoftJson" />
	  <PackageReference Include="Newtonsoft.Json" />	  
	  <PackageReference Include="System.Data.SqlClient" />
	  <PackageReference Include="System.ValueTuple" />
	  <!-- Updated TouchSocket packages to align versions -->
	  <PackageReference Include="TouchSocket" />
	  <PackageReference Include="TouchSocket.Core" />
	  <PackageReference Include="TouchSocket.Rpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Core.Abstract\Horizon.Core.Abstract.csproj" />
    <ProjectReference Include="..\Horizon.Core\Horizon.Core.csproj" />
    <ProjectReference Include="..\Horizon.Game.Message\Horizon.Game.Message.csproj" />
    <ProjectReference Include="..\Horizon.Orleans.Interface\Horizon.Orleans.Interface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

  <!-- 编译后将客户端需要的依赖复制�?Flax Tools 目录 -->
  <Target Name="CopyToFlax" AfterTargets="Build">
    <PropertyGroup>
      <FlaxToolsDir>C:\Program Files (x86)\Flax\Flax_1.12\Binaries\Tools</FlaxToolsDir>
    </PropertyGroup>

    <ItemGroup>
      <!-- 主程序集 -->
      <FlaxFilesToCopy Include="$(TargetDir)$(AssemblyName).dll" />
      <FlaxFilesToCopy Include="$(TargetDir)$(AssemblyName).xml" />
      <FlaxFilesToCopy Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <!-- 项目引用与运行时依赖 -->
      <FlaxFilesToCopy Include="$(TargetDir)*.dll" Exclude="$(TargetDir)Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>

    <Message Text="正在复制 Horizon.Game.Core 及依赖到 Flax 目录..." Importance="high" />

    <Copy SourceFiles="@(FlaxFilesToCopy)" DestinationFolder="$(FlaxToolsDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Retries="3" RetryDelayMilliseconds="1000" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="CopiedFiles" ItemName="SuccessfullyCopiedFiles" />
    </Copy>

    <Message Text="成功复制文件: @(SuccessfullyCopiedFiles)" Importance="high" />
  </Target>

</Project>
