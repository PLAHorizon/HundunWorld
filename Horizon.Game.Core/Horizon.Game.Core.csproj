<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="_build_validation\**" />
    <EmbeddedResource Remove="_build_validation\**" />
    <None Remove="_build_validation\**" />
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="Consul" />
	  <PackageReference Include="K4os.Compression.LZ4" />
	  <PackageReference Include="MemoryPack.Core" />
	  <PackageReference Include="MemoryPack.Generator" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.DependencyValidation.Analyzers" />
	  <PackageReference Include="Microsoft.Extensions.Logging.Console" />
	  <PackageReference Include="Microsoft.Orleans.Client" />
	  <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
	  <PackageReference Include="Microsoft.Orleans.Clustering.Redis" />
	  <PackageReference Include="Microsoft.Orleans.CodeGenerator">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Orleans.Core" />
	  <PackageReference Include="Microsoft.Orleans.Sdk" />
	  <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" />
	  <PackageReference Include="Microsoft.Orleans.Serialization.NewtonsoftJson" />
	  <PackageReference Include="Newtonsoft.Json" />	  
	  <PackageReference Include="System.Data.SqlClient" />
	  <PackageReference Include="System.ValueTuple" />
	  <!-- Updated TouchSocket packages to align versions -->
	  <PackageReference Include="TouchSocket" />
	  <PackageReference Include="TouchSocket.Core" />
	  <PackageReference Include="TouchSocket.Rpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Core.Abstract\Horizon.Core.Abstract.csproj" />
    <ProjectReference Include="..\Horizon.Core\Horizon.Core.csproj" />
    <ProjectReference Include="..\Horizon.Game.Message\Horizon.Game.Message.csproj" />
    <ProjectReference Include="..\Horizon.Game.Sim\Horizon.Game.Sim.csproj" />
    <!-- 阶段 1.5：MortonCodec/WorldCoord/ZoneShardAoi 已抽至纯 C# 共享库（UE5 DS 与 Orleans 共用） -->
    <ProjectReference Include="..\Horizon.Game.World\Horizon.Game.World.csproj" />
    <ProjectReference Include="..\Horizon.Orleans.Interface\Horizon.Orleans.Interface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

