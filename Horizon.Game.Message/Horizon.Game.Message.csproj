<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.0.0.1</AssemblyVersion>
    <FileVersion>1.0.0.1</FileVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <DocumentationFile>$(TargetDir)$(AssemblyName).xml</DocumentationFile>
    <!-- 强制复制所有运行时依赖到输出目�?-->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- 使用滚动前向(Roll Forward)策略,允许使用较新的运行时版本 -->
    <RollForward>LatestMajor</RollForward>
    <!-- 源生成器产物落盘到 obj/generated/（与 MemoryPack / Orleans 生成器的落盘约定一致），
         便于人肉审阅 union 注册块与常量表，也便于排查生成器漂移。 -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Network\UnifiedMessages.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Game.Message.Generator\Horizon.Game.Message.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MemoryPack.Core" /> 
    <PackageReference Include="MemoryPack.Generator" PrivateAssets="all" />
    <PackageReference Include="K4os.Compression.LZ4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <!-- Microsoft.CodeAnalysis packages might not be strictly needed by the project itself after removing FlatSharp compiler and post-processor -->
    <!-- but keep them if other parts of your build or analysis rely on them -->
    <!-- <PackageReference Include="Microsoft.CodeAnalysis.Common" /> -->
    <!-- <PackageReference Include="Microsoft.CodeAnalysis.CSharp" /> -->
    <!-- <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" -->
    <!-- <PackageReference Include="Microsoft.Net.Compilers.Toolset"> -->
    <!--  <PrivateAssets>all</PrivateAssets> -->
    <!--  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets> -->
    <!-- </PackageReference> -->
    <PackageReference Include="Microsoft.Orleans.Core" /> 
    <PackageReference Include="Microsoft.Orleans.Sdk" />
    <PackageReference Include="Microsoft.Orleans.Serialization" />
    <PackageReference Include="TouchSocket" />
    <PackageReference Include="TouchSocket.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <Folder Include="Enums\" />
  </ItemGroup>

  <!-- Removed FlatSharpSchema ItemGroup -->
  <!-- Removed Target Name="RunFlatSharpPostProcessor" -->

  <!-- 解决方案编译后，把本程序集分发到 Flax 引擎托管工具目录，
       供 MMORPG 客户端（Game.csproj 的 <Reference> 与 Game.Build.cs 的 dlls[]）编译期/构建期解析。
       - FlaxToolsDir / CopyToFlax 均可在命令行覆盖（-p:CopyToFlax=false 关闭分发）；
       - 仅当目标目录存在时才执行，避免未装 Flax 的 CI 报错；
       - 写入 Program Files 需管理员权限，失败按警告处理（ContinueOnError），不阻断编译。 -->
  <PropertyGroup>
    <FlaxToolsDir Condition="'$(FlaxToolsDir)' == ''">C:\Program Files (x86)\Flax\Flax_1.13\Binaries\Tools</FlaxToolsDir>
    <CopyToFlax Condition="'$(CopyToFlax)' == ''">true</CopyToFlax>
  </PropertyGroup>

  <Target Name="CopyToFlax" AfterTargets="Build"
          Condition="'$(CopyToFlax)' == 'true' And Exists('$(FlaxToolsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')"
          DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
          Condition="Exists('$(TargetDir)$(TargetName).xml')"
          DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="[CopyToFlax] $(TargetFileName) -&gt; $(FlaxToolsDir)" />
  </Target>

</Project>
