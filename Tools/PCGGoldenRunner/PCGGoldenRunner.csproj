    <Compile Include="StreamingTests.cs" />
    <Compile Include="TextureSamplingTests.cs" />
    <Compile Include="SurfaceAlignTests.cs" />
    <Compile Include="PinSlotTests.cs" />
    <Compile Include="GrammarTests.cs" />
    <Compile Include="SymbolGrammarTests.cs" />
    <Compile Include="RayCastProjectTests.cs" />
    <Compile Include="ActorSamplerTests.cs" />
    <Compile Include="GeometryTests.cs" />
    <Compile Include="PipelineTests.cs" />
    <Compile Include="NodeIdTests.cs" />
    <Compile Include="PathPlannerTests.cs" />
    <Compile Include="HydrologyTests.cs" />
    <Compile Include="BiomeTests.cs" />
    <Compile Include="CaveTests.cs" />
    <Compile Include="SpecTests.cs" />
    <Compile Include="TerrainTests.cs" />
    <Compile Include="PointListTests.cs" />
    <Compile Include="PolygonTests.cs" />
    <Compile Include="MeshCutTests.cs" />
    <Compile Include="CavePipelineTests.cs" />
    <Compile Include="ClipToConvexTests.cs" />
    <Compile Include="$(PluginRoot)\Data\PCGSeededNoise.cs" Link="PCGSeededNoise.cs" />
    <Compile Include="$(PluginRoot)\Data\PCGMeshSurfaceSampling.cs" Link="PCGMeshSurfaceSampling.cs" />
    <Compile Include="$(PluginRoot)\Data\PCGDeterministicRng.cs" Link="PCGDeterministicRng.cs" />
    <Compile Include="$(PluginRoot)\Data\PCGTextureSampling.cs" Link="PCGTextureSampling.cs" />

