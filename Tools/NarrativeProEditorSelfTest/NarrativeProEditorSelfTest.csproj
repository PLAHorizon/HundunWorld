<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NarrativePro 编辑器数据层的离线自检：把插件运行期 + 编辑器源目录一起编进来，
    直接调用 NarrativeAssetStore 的纯数据通路（自动布局 / 复制节点 / 内存校验），
    不启动编辑器、不写 Content 目录（校验走系统临时文件）。

    用法：在仓库根执行 dotnet run，项目路径为 Tools/NarrativeProEditorSelfTest，配置 Release。
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <AssemblyName>NarrativeProEditorSelfTest</AssemblyName>
    <RootNamespace>NarrativeProEditorSelfTest</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefineConstants>FLAX_EDITOR;FLAX;NET;NET10_0</DefineConstants>
    <NoWarn>1591;0169;0414;0649;0618;0067</NoWarn>
    <EngineRoot>C:\Program Files (x86)\Flax\Flax_1.13</EngineRoot>
    <SourceRoot>$(MSBuildThisFileDirectory)..\..\HundunWorld\Plugins\NarrativePro\Source</SourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="FlaxEngine.CSharp">
      <HintPath>$(EngineRoot)\Binaries\Editor\Win64\Development\FlaxEngine.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(SourceRoot)\NarrativePro\**\*.cs" Exclude="$(SourceRoot)\NarrativePro\**\*.Build.cs;$(SourceRoot)\NarrativePro\NarrativePro.Gen.cs" />
    <Compile Include="$(SourceRoot)\NarrativeProEditor\**\*.cs" Exclude="$(SourceRoot)\NarrativeProEditor\**\*.Build.cs;$(SourceRoot)\NarrativeProEditor\NarrativeProEditor.Gen.cs" />
  </ItemGroup>

</Project>
