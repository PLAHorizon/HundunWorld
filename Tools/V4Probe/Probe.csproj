<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      V4 探针：验证 Script 生命周期在「非引擎驱动」的托管环境下是否可用，
      并静态确认 Flax 引擎是否真的按帧调用 Script.OnUpdate。
    -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>V4Probe</AssemblyName>
    <RootNamespace>V4Probe</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RestorePackages>false</RestorePackages>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>14.0</LangVersion>
    <!-- 与 Flax 构建目标同规则：禁用分层编译，避免方法内联改变反射可见性 -->
    <TieredCompilation>false</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引擎托管程序集：直接引用源文件，避免污染项目 Output 目录 -->
    <Reference Include="FlaxEngine.CSharp">
      <HintPath>..\..\HundunWorld\Output\Windows\FlaxEngine.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
