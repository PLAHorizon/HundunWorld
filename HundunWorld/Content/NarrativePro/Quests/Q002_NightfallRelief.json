{
  "questId": "Q002_NightfallRelief",
  "questName": "夜路送粮",
  "questDescription": "申时末村口敲钟，入夜后才许送粮出村；赶在日出前把口粮送到铁匠铺即成。",
  "questDialogueClass": "D002_NightfallSendOff",
  "startStateId": "s_begin",
  "//req": "任务要求：UE5 是 quest 资产内联的 Instanced UQuestRequirement；端口改用 questRequirements 按名构造（Tales/Quest/QuestRequirementFactory.cs）",
  "questRequirements": [
    {
      "type": "StayNearActorRequirement",
      "targetNpcId": "npc_village_smith",
      "maxUnits": 1800.0,
      "secondsLeeway": 10,
      "checkIntervalSeconds": 1.0,
      "warningMessage": "铁匠要出发了，跟紧他",
      "failedMessage": "你走得太远，没能守住这次接班"
    }
  ],
  "//": "本任务专门用真实参数打通三条时辰等待任务（WaitTimeOfDayTask / WaitTimeRangeStartTask / WaitSunsetOrSunriseTask）",
  "//2": "与 TaskNavigationMarker 的 provider 注册表通路（NarrativeLogicFactory.ProviderRegistry）：",
  "//3": "此前这些类型只有代码、没有任何资产用到（见 Tools/NarrativeProHarness Check 15 的加载断言）。",
  "//4": "三个 marker 各带一种 Actor 提供者，全部指向真实存在的对象：",
  "//5": "  · NarrativeActorProvider_NPC → 内联定义取 Content/NarrativePro/NPCs/npc_village_smith.json 的 NPCID/NPCName；",
  "//6": "  · NarrativeActorProvider_LevelReference → Content/Maps/World.scene 里真实存在的 Actor 名 'POI_Kaifeng'；",
  "//7": "  · NarrativeActorProvider_GUIDLookup → npc_village_smith.json 的 UniqueNPCGUID。",
  "//8": "注：TaskNavigationMarker.MarkerAttachActorOverride 在 UE5 与端口都是 UNarrativeActorProvider（QuestTask.h:64），",
  "//9": "    因此 NarrativeTransformProvider_POI 这类纯 Transform 提供者在本端口没有任何 JSON 落点（只能由代码构造），",
  "//10": "    Check 15 仍按注册表名解析它一次，以证明该提供者类型没被注册表漏掉。",
  "//11": "actorFallbackLocation 与 GoToLocation 的 locationName 都取 World.scene 实测值：",
  "//12": "    Kaifeng (-118, 50, -104)、Qinghe (200, 30, 500) 与 POIActor 标签 'Navigator.PointOfInterest.Qinghe'。",
