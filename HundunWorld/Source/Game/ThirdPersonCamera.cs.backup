using FlaxEngine;
using System;

namespace HundunWorld.Game
{
    /// <summary>
    /// 相机模式枚举
    /// </summary>
    public enum CameraMode
    {
        Normal,       // 标准模式
        Combat,       // 战斗模式
        Cinematic,    // 电影模式
        FirstPerson,  // 第一人称模式
        TopDown,      // 俯视模式
        SideScroller  // 横版卷轴模式
    }

    /// <summary>
    /// 相机边界类型枚举
    /// </summary>
    public enum CameraBoundsType
    {
        Sphere,    // 球形边界
        Box,       // 盒形边界
        Custom     // 自定义边界
    }

    /// <summary>
    /// 场景区域类型枚举
    /// </summary>
    public enum SceneZoneType
    {
        Indoor,    // 室内区域
        Outdoor,   // 室外区域
        Restricted // 受限区域
    }

    /// <summary>
    /// 第三人称相机控制器 - 简洁重构版
    /// 核心功能：
    /// 1. 相机在角色后方跟随移动
    /// 2. 鼠标控制相机围绕角色旋转
    /// 3. 滚轮控制距离缩放
    /// </summary>
    public class ThirdPersonCamera : Script
