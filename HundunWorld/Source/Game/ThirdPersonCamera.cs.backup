        private float _targetCollisionDistance = 0.0f;
        private bool _isColliding = false;
        private float _lastCollisionCheckTime = 0.0f;
        private Vector3[] _collisionRayDirections;
        private float _lastCollisionCheckDistance = 0.0f;

        // 性能优化相关字段
        private int _currentLODLevel = 0;
        private Vector3 _lastCameraPosition = Vector3.Zero;
        private Quaternion _lastCameraRotation = Quaternion.Identity;
        private float _lastUpdateTime = 0.0f;
        private int _frameSkipCounter = 0;
        private bool _isHighPerformanceMode = false;

        // 智能对齐与自动旋转相关字段
        private Vector3 _targetMovementDirection = Vector3.Forward;
        private Vector3 _lastTargetPosition = Vector3.Zero;
        private float _targetYaw = 0.0f;
        private float _autoRotationVelocity = 0.0f;
        private bool _isAutoRotating = false;
        private float _lastAlignmentCheckTime = 0.0f;

        // 地面穿透防护相关字段
