        /// <summary>
        /// 重置相机到默认状态
        /// </summary>
        public void ResetCamera()
        {
            // 重置相机位置
            Distance = DefaultDistance;
            VerticalAngle = DefaultVerticalAngle;
            HorizontalAngle = DefaultHorizontalAngle;

            // 重置相机抖动
            _shakeIntensity = 0.0f;
            _shakeDuration = 0.0f;
            _currentShakeOffset = Vector3.Zero;

            // 重置FOV
            _currentFOV = BaseFOV;
            if (_camera != null)
                _camera.FieldOfView = _currentFOV;

            // 重置场景适配状态
            _currentZoneType = SceneZoneType.Outdoor;
            _targetZoneType = SceneZoneType.Outdoor;
            _currentDistanceRange = OutdoorDistanceRange;
            _isTransitioningZones = false;

            // 重置边界状态
            _isNearBounds = false;
            _boundsConstrainedPosition = Vector3.Zero;

            // 重置遮挡状态
            _isOccluded = false;
            _occlusionDistance = DefaultDistance;

            // 重置性能优化状态
            _lastPositionUpdateTime = 0.0f;
            _lastRotationUpdateTime = 0.0f;
            _lastTargetPosition = Vector3.Zero;
            _targetSpeed = 0.0f;
            _lastSpeedCheckTime = 0.0f;
            _lastBoundsCheckTime = 0.0f;
            _lastOcclusionCheckTime = 0.0f;
            _lastEnvironmentCheckTime = 0.0f;
            _lastTargetPredictionTime = 0.0f;
            _targetPredictedPosition = Vector3.Zero;

            // 立即更新相机位置
            if (Target != null)
            {
                UpdateCameraPosition(Actor.Position);
            }
        }

        /// <summary>
        /// 切换相机模式
        /// </summary>
        /// <param name="mode">新的相机模式</param>
        public void SwitchCameraMode(CameraMode mode)
        {
            if (CurrentMode == mode)
                return;

            CurrentMode = mode;

            // 根据模式调整相机参数
            switch (mode)
            {
                case CameraMode.Normal:
                    // 标准模式
                    MinDistance = 2.0f;
                    MaxDistance = 8.0f;
                    Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                    break;

                case CameraMode.Combat:
                    // 战斗模式 - 更近的距离，更好的视角
                    MinDistance = 1.5f;
                    MaxDistance = 5.0f;
                    Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                    VerticalAngle = Mathf.Clamp(VerticalAngle, -10.0f, 30.0f);
                    break;

                case CameraMode.Cinematic:
                    // 电影模式 - 更远的距离，更大的视角范围
                    MinDistance = 3.0f;
                    MaxDistance = 15.0f;
                    Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                    break;

                case CameraMode.FirstPerson:
                    // 第一人称模式
                    MinDistance = 0.1f;
                    MaxDistance = 0.5f;
                    Distance = MinDistance;
                    VerticalAngle = 0.0f;
                    break;

                case CameraMode.TopDown:
                    // 俯视模式
                    MinDistance = 5.0f;
                    MaxDistance = 20.0f;
                    Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                    VerticalAngle = 90.0f;
                    break;

                case CameraMode.SideScroller:
                    // 横版卷轴模式
                    MinDistance = 5.0f;
                    MaxDistance = 15.0f;
                    Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                    VerticalAngle = 0.0f;
                    break;
            }

            // 更新相机位置
            UpdateCameraPosition(Actor.Position);
        }

        /// <summary>
        /// 触发相机抖动效果（PlayerController调用的方法）
        /// </summary>
        /// <param name="intensity">抖动强度</param>
        /// <param name="duration">抖动持续时间</param>
        public void TriggerShake(float intensity, float duration)
        {
            TriggerCameraShake(intensity, duration);
        }

        /// <summary>
        /// 更新相机抖动系统
        /// </summary>
        private void UpdateCameraShake()
        {
            if (!EnableCameraShake)
                return;

            // 如果当前没有抖动，直接返回
            if (_currentShakeIntensity <= 0f)
                return;

            // 更新抖动时间
            _shakeTime += Time.DeltaTime;

            // 计算噪声偏移
            _shakeNoiseOffset += Time.DeltaTime * ShakeFrequency;

            // 使用Sin函数生成平滑的抖动值
            float noiseX = Mathf.Sin(_shakeNoiseOffset * 5.0f) * Mathf.Cos(_shakeNoiseOffset * 3.7f) * 2f - 1f;
            float noiseY = Mathf.Sin(_shakeNoiseOffset * 4.3f) * Mathf.Cos(_shakeNoiseOffset * 6.1f) * 2f - 1f;
            float noiseZ = Mathf.Sin(_shakeNoiseOffset * 5.7f) * Mathf.Cos(_shakeNoiseOffset * 4.9f) * 2f - 1f;

            // 计算抖动偏移
            Vector3 shakeOffset = new Vector3(noiseX, noiseY, noiseZ) * _currentShakeIntensity * ShakeNoiseScale;
            _shakeOffset = Vector3.Lerp(_shakeOffset, shakeOffset, Time.DeltaTime * 10f);

            // 计算抖动旋转
            Vector3 shakeRotation = new Vector3(noiseY, noiseX, noiseZ) * _currentShakeIntensity * 0.5f;
            _shakeRotation = Vector3.Lerp(_shakeRotation, shakeRotation, Time.DeltaTime * 10f);

            // 计算FOV抖动
            float shakeFOV = noiseX * _currentShakeIntensity * 2f;
            _shakeFOV = Mathf.Lerp(_shakeFOV, shakeFOV, Time.DeltaTime * 10f);

            // 衰减抖动强度
            _currentShakeIntensity = Mathf.Max(0f, _currentShakeIntensity - ShakeDecaySpeed * Time.DeltaTime);

            // 应用抖动效果
            if (_currentShakeIntensity > 0f)
            {
                // 应用位置抖动
                if (PositionShakeWeight > 0f)
                {
                    Actor.Position += _shakeOffset * PositionShakeWeight;
                }

                // 应用旋转抖动
                if (RotationShakeWeight > 0f)
                {
                    Quaternion rotationShake = Quaternion.Euler(_shakeRotation * RotationShakeWeight);
                    Actor.Orientation = Actor.Orientation * rotationShake;
                }

                // 应用FOV抖动
                if (FOVShakeWeight > 0f && _camera != null)
                {
                    _camera.FieldOfView += _shakeFOV * FOVShakeWeight;
                }
            }
        }

        /// <summary>
        /// 更新相机位置
        /// </summary>
        /// <param name="position">新的相机位置</param>
        private void UpdateCameraPosition(Vector3 position)
        {
            Actor.Position = position;
        }

        /// <summary>
        /// 获取当前相机距离
        /// </summary>
        /// <returns>当前相机距离</returns>
        public float GetCurrentDistance()
        {
            return EnableCameraCollision ? _currentCollisionDistance : Distance;
        }

        /// <summary>
        /// 触发相机抖动
        /// </summary>
        /// <param name="intensity">抖动强度</param>
        /// <param name="duration">抖动持续时间（秒）</param>
        public void TriggerCameraShake(float intensity, float duration = 1.0f)
        {
            if (!EnableCameraShake)
                return;

            // 设置抖动强度
            _currentShakeIntensity = Mathf.Max(_currentShakeIntensity, intensity);

            // 重置抖动时间
            _shakeTime = 0f;

            // 如果指定了持续时间，计算衰减速度
            if (duration > 0f)
            {
                ShakeDecaySpeed = intensity / duration;
            }
        }

        /// <summary>
        /// 切换相机模式
        /// </summary>
        public void SwitchCameraMode()
        {
            // 切换到下一个模式
            CurrentMode = (CameraMode)(((int)CurrentMode + 1) % System.Enum.GetValues(typeof(CameraMode)).Length);
            
            // 应用模式设置
            switch (CurrentMode)
            {
                case CameraMode.Normal:
                    // 保持当前距离，不重置为默认值
                    // Distance = DefaultDistance;
                    VerticalAngle = DefaultVerticalAngle;
                    HorizontalAngle = DefaultHorizontalAngle;
                    break;
                case CameraMode.Combat:
                    Distance = DefaultDistance * 0.8f;
                    VerticalAngle = DefaultVerticalAngle * 0.7f;
                    break;
                case CameraMode.Cinematic:
                    Distance = DefaultDistance * 1.5f;
                    VerticalAngle = DefaultVerticalAngle * 1.2f;
                    break;
            }
        }

        /// <summary>
        /// 获取当前相机模式
        /// </summary>
        public CameraMode GetCurrentMode() => CurrentMode;

        /// <summary>
        /// 设置相机模式
        /// </summary>
        /// <param name="mode">要设置的相机模式</param>
        public void SetCameraMode(CameraMode mode)
        {
            if (CurrentMode != mode)
            {
                CurrentMode = mode;
                // 应用模式设置
                switch (CurrentMode)
                {
                    case CameraMode.Normal:
                        // 保持当前距离，不重置为默认值
                        // Distance = DefaultDistance;
                        VerticalAngle = DefaultVerticalAngle;
                        HorizontalAngle = DefaultHorizontalAngle;
                        break;
                    case CameraMode.Combat:
                        Distance = DefaultDistance * 0.8f;
                        VerticalAngle = DefaultVerticalAngle * 0.7f;
                        break;
                    case CameraMode.Cinematic:
                        Distance = DefaultDistance * 1.5f;
                        VerticalAngle = DefaultVerticalAngle * 1.2f;
                        break;
                }
            }
        }

        /// <summary>
        /// 更新手柄输入系统
        /// </summary>
        private void UpdateGamepadInput()
        {
            if (!EnableGamepadInput)
                return;

            // 获取手柄右摇杆输入（相机旋转）
            Vector2 rightStick = new Vector2(
                Input.GetAxis(GamepadRightStickHorizontal),
                Input.GetAxis(GamepadRightStickVertical)
            );

            // 应用死区
            if (rightStick.Length < GamepadDeadZone)
            {
                rightStick = Vector2.Zero;
            }
            else
            {
                // 计算摇杆速度（用于平滑处理）
                _gamepadRightStickVelocity = (rightStick - _lastGamepadRightStick) / Time.DeltaTime;
                _lastGamepadRightStick = rightStick;

                // 应用摇杆输入到相机旋转
                if (Mathf.Abs(rightStick.X) > 0.001f || Mathf.Abs(rightStick.Y) > 0.001f)
                {
                    Yaw += rightStick.X * GamepadRotationSensitivity;
                    Pitch -= rightStick.Y * GamepadRotationSensitivity;
                    Pitch = Mathf.Clamp(Pitch, MinPitch, MaxPitch);

                    // 规范化Yaw到0-360
                    while (Yaw < 0) Yaw += 360;
                    while (Yaw >= 360) Yaw -= 360;
                }
            }

            // 获取手柄左摇杆输入（可选功能，如相机平移）
            Vector2 leftStick = new Vector2(
                Input.GetAxis(GamepadLeftStickHorizontal),
                Input.GetAxis(GamepadLeftStickVertical)
            );

            // 应用死区
            if (leftStick.Length < GamepadDeadZone)
            {
                leftStick = Vector2.Zero;
            }
            else
            {
                // 计算摇杆速度（用于平滑处理）
                _gamepadLeftStickVelocity = (leftStick - _lastGamepadLeftStick) / Time.DeltaTime;
                _lastGamepadLeftStick = leftStick;
            }

            // 获取手柄扳机输入（缩放）
            float rightTrigger = Input.GetAxis(GamepadRightTrigger);
            float leftTrigger = Input.GetAxis(GamepadLeftTrigger);

            // 应用扳机输入到相机缩放
            if (Mathf.Abs(rightTrigger - _lastGamepadRightTrigger) > 0.001f)
            {
                Distance -= rightTrigger * GamepadZoomSensitivity * Time.DeltaTime;
                Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                _lastGamepadRightTrigger = rightTrigger;
            }

            if (Mathf.Abs(leftTrigger - _lastGamepadLeftTrigger) > 0.001f)
            {
                Distance += leftTrigger * GamepadZoomSensitivity * Time.DeltaTime;
                Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
                _lastGamepadLeftTrigger = leftTrigger;
            }

            // 获取手柄肩键输入（可选功能，如重置相机）
            bool rightShoulder = Input.GetAction(GamepadRightShoulder);
            bool leftShoulder = Input.GetAction(GamepadLeftShoulder);

            // 检测右肩键按下（重置相机）
            if (rightShoulder && !_lastGamepadRightShoulder)
            {
                ResetCamera();
            }
            _lastGamepadRightShoulder = rightShoulder;

            // 检测左肩键按下（切换相机模式）
            if (leftShoulder && !_lastGamepadLeftShoulder)
            {
                SwitchCameraMode();
            }
            _lastGamepadLeftShoulder = leftShoulder;
        }

        /// <summary>
        /// 更新性能优化系统
        /// </summary>
        private void UpdatePerformanceOptimization()
        {
            if (!EnablePerformanceOptimization)
                return;

            // 检查是否需要跳帧
            if (EnableFrameSkipping)
            {
                _frameSkipCounter++;
                if (Time.DrawFPS > FrameSkipThreshold && _frameSkipCounter % 2 == 0)
                {
                    return; // 跳过这一帧
                }
            }

            // 更新LOD级别
            UpdateLODLevel();

            // 更新缓存
            UpdateCaches();
        }

        /// <summary>
        /// 更新LOD级别
        /// </summary>
        private void UpdateLODLevel()
        {
            if (!EnableRaycastLOD)
                return;

            // 根据距离调整LOD级别
            if (Distance > FarDistanceThreshold)
            {
                _currentLODLevel = 2; // 高距离，低质量
            }
            else if (Distance > FarDistanceThreshold * 0.6f)
            {
                _currentLODLevel = 1; // 中距离，中等质量
            }
            else
            {
                _currentLODLevel = 0; // 近距离，高质量
            }
        }

        /// <summary>
        /// 更新缓存
        /// </summary>
        private void UpdateCaches()
        {
            // 位置缓存
            if (EnablePositionCaching)
            {
                Vector3 currentPosition = Actor.Position;
                if (Vector3.Distance(_lastCameraPosition, currentPosition) > 0.01f)
                {
                    _lastCameraPosition = currentPosition;
                }
            }

            // 旋转缓存
            if (EnableRotationCaching)
            {
                Quaternion currentRotation = Actor.Orientation;
                if (Quaternion.Dot(_lastCameraRotation, currentRotation) < 0.99f)
                {
                    _lastCameraRotation = currentRotation;
                }
            }

            // 碰撞检测缓存
            if (EnableCollisionCaching)
            {
                if (Mathf.Abs(_lastCollisionCheckDistance - Distance) > 0.1f)
                {
                    _lastCollisionCheckDistance = Distance;
                }
            }
        }

        /// <summary>
        /// 获取当前LOD级别
        /// </summary>
        public int GetCurrentLODLevel() => _currentLODLevel;

        /// <summary>
        /// 获取当前碰撞射线数量（基于LOD）
        /// </summary>
        public int GetCurrentCollisionRayCount()
        {
            if (!EnableRaycastLOD)
                return CollisionRayCount;

            return _currentLODLevel switch
            {
                0 => CollisionRayCount,           // 高质量
                1 => Mathf.CeilToInt(CollisionRayCount * 0.7f), // 中等质量
                2 => FarDistanceCollisionRayCount, // 低质量
                _ => CollisionRayCount
            };
        }
        
        /// <summary>
        /// 打印诊断信息
        /// </summary>
        private void PrintDiagnosticInfo()
        {
            Debug.Log("============ 相机诊断信息 ============");
            Debug.Log($"Camera组件: {(_camera != null ? "✓ 已找到" : "✗ 未找到")}");
            Debug.Log($"InputManager: {(_inputManager != null ? "✓ 已找到" : "✗ 未找到")}");
            Debug.Log($"Target: {(Target != null ? "✓ 已设置" : "✗ 未设置")}");
            Debug.Log($"当前距离: {Distance:F2}, Pitch: {Pitch:F2}, Yaw: {Yaw:F2}");
            Debug.Log("=====================================");
        }
        
        #endregion
    }
}