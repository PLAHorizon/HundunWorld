        private const float BOUNDS_CHECK_INTERVAL = 0.1f;       // 边界检测间隔（秒）
        private const float ALIGNMENT_CHECK_INTERVAL = 0.05f;   // 对齐检测间隔（秒）
        private const float OCCLUSION_CHECK_INTERVAL = 0.1f;    // 遮挡检测间隔（秒）
        private const float ENVIRONMENT_CHECK_INTERVAL = 0.2f;  // 环境检测间隔（秒）
        
        #endregion

