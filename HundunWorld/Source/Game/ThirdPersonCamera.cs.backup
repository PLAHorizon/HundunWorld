        /// <summary>
        /// 更新目标跟踪预测
        /// </summary>
        private void UpdateTargetPrediction()
        {
            if (!EnableTargetPrediction || Target == null)
                return;

            // 计算目标预测位置
            Vector3 currentPosition = Target.Position;
            Vector3 velocity = (currentPosition - _lastTargetPosition) / Time.DeltaTime;
            _targetPredictedPosition = currentPosition + velocity * TargetPredictionTime;
        }

