        private float _targetGroundHeight = float.MaxValue;
        private bool _isNearGround = false;
        private float _lastGroundCheckTime = 0.0f;

        // 相机边界限制相关字段
        private Vector3 _boundsCenter = Vector3.Zero;
        private float _currentBoundsLimitStrength = 0.0f;
        private float _lastBoundsCheckTime = 0.0f;
        private bool _isNearBounds = false;
        private Vector3 _boundsConstrainedPosition = Vector3.Zero;

        // 场景适配相关字段
        private SceneZoneType _currentZoneType = SceneZoneType.Outdoor;
        private SceneZoneType _targetZoneType = SceneZoneType.Outdoor;
        private float _zoneTransitionStartTime = 0.0f;
        private float _zoneTransitionDuration = 0.0f;
        private bool _isTransitioningZones = false;
        private Float2 _currentDistanceRange = new Float2(5.0f, 30.0f);
        private Float2 _targetDistanceRange = new Float2(5.0f, 30.0f);
        private float _lastOcclusionCheckTime = 0.0f;
        private bool _isOccluded = false;
        private float _occlusionDistance = 0.0f;
        private Vector3 _bestCameraPosition = Vector3.Zero;
        private float _bestPositionScore = 0.0f;
        private Vector3 _targetPredictedPosition = Vector3.Zero;
        private float _environmentAwarenessValue = 0.0f;
        private float _lastEnvironmentCheckTime = 0.0f;
        private float _lastPositionUpdateTime = 0.0f;
        private float _lastRotationUpdateTime = 0.0f;
        private float _targetSpeed = 0.0f;
        private float _lastSpeedCheckTime = 0.0f;
        private float _lastTargetPredictionTime = 0.0f;
        private float _currentFOV = 60.0f;

        // 边界检查：确保距离在合法范围内
        if (Distance < MinDistance || Distance > MaxDistance)
        {
            // 将Distance限制在合法范围内，而不是重置为默认值
            Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);
        }
        
        _currentCollisionDistance = Distance;
        _targetCollisionDistance = Distance;
        _isColliding = false;
        _lastCollisionCheckTime = Time.GameTime;

        // 初始化智能对齐与自动旋转系统
        _targetMovementDirection = Vector3.Forward;
        _targetYaw = Yaw;
        _autoRotationVelocity = 0f;
        _isAutoRotating = false;
        _lastAlignmentCheckTime = Time.GameTime;

        // 初始化地面穿透防护系统
        _currentGroundHeight = float.MaxValue;
        _targetGroundHeight = float.MaxValue;
        _isNearGround = false;
        _lastGroundCheckTime = Time.GameTime;

        // 初始化相机抖动系统
        _currentShakeIntensity = 0f;
        _shakeTime = 0f;
        _shakeOffset = Vector3.Zero;
        _shakeRotation = Vector3.Zero;
        _shakeFOV = 0f;
        _shakeNoiseOffset = 0f;

        // 初始化手柄输入系统
        _lastGamepadRightStick = Vector2.Zero;
        _gamepadRightStickVelocity = Vector2.Zero;
        _lastGamepadLeftStick = Vector2.Zero;
        _gamepadLeftStickVelocity = Vector2.Zero;
        _lastGamepadRightTrigger = 0f;
        _lastGamepadLeftTrigger = 0f;
        _lastGamepadRightShoulder = false;
        _lastGamepadLeftShoulder = false;

        // 初始化性能优化系统
        _lastCameraPosition = Actor.Position;
        _lastCameraRotation = Actor.Orientation;
        _lastTargetPosition = Target != null ? Target.Position : Vector3.Zero;
        _lastCollisionCheckDistance = Distance;
        _lastUpdateTime = Time.GameTime;
        _frameSkipCounter = 0;
        _isHighPerformanceMode = Time.DrawFPS > FrameSkipThreshold;
        _currentLODLevel = 0;

        // 初始化相机边界限制系统
        _boundsCenter = Target != null ? Target.Position + BoxBoundsCenter : Vector3.Zero;
        _currentBoundsLimitStrength = 0f;
        _lastBoundsCheckTime = Time.GameTime;
        _isNearBounds = false;
        _boundsConstrainedPosition = Vector3.Zero;

        // 初始化场景适配系统
        _currentZoneType = SceneZoneType.Outdoor;
        _targetZoneType = SceneZoneType.Outdoor;
        _zoneTransitionStartTime = 0f;
        _zoneTransitionDuration = ZoneTransitionTime;
        _isTransitioningZones = false;
        _currentDistanceRange = OutdoorDistanceRange;
        _targetDistanceRange = OutdoorDistanceRange;
        _lastOcclusionCheckTime = Time.GameTime;
        _isOccluded = false;
        _occlusionDistance = Distance;
        _bestCameraPosition = Vector3.Zero;
        _bestPositionScore = 0f;
        _targetPredictedPosition = Target != null ? Target.Position : Vector3.Zero;
        _environmentAwarenessValue = 0f;
        _lastEnvironmentCheckTime = Time.GameTime;

        // 初始化碰撞检测射线方向数组
        InitializeCollisionRays();
        }

        public override void OnUpdate()
        {
            if (Target == null || _camera == null) return;

            // 1. 处理输入
            HandleInput();

            // 2. 计算聚焦点（角色头部位置）
            Vector3 focusPoint = Target.Position + FocusOffset;

            // 3. 执行碰撞检测
            UpdateCameraCollision(focusPoint);

            // 4. 根据Pitch和Yaw计算相机位置（直接使用Distance，不使用碰撞检测）
            float effectiveDistance = Distance;
            
            // 确保距离在合法范围内（5.0f-30.0f）
            effectiveDistance = Mathf.Clamp(effectiveDistance, MinDistance, MaxDistance);
            
            Vector3 cameraPosition = CalculateCameraPosition(focusPoint, Pitch, Yaw, effectiveDistance);

            // 5. 更新相机位置
            Actor.Position = cameraPosition;

            // 6. 更新相机朝向
            Actor.Orientation = Quaternion.LookRotation(Vector3.Normalize(focusPoint - Actor.Position), Vector3.Up);
            
            // 7. 更新动态FOV系统
            if (EnableDynamicFOV)
                UpdateDynamicFOV();
                
            // 8. 更新地面穿透防护系统
            if (EnableGroundPenetrationProtection)
                UpdateGroundPenetrationProtection();
                
            // 9. 更新相机边界限制系统
            if (EnableCameraBounds)
                UpdateCameraBounds();
                
            // 10. 更新场景适配系统
            if (EnableSceneAdaptation)
                UpdateSceneAdaptation();
                
            // 11. 更新性能优化系统
            if (EnablePerformanceOptimization)
                UpdatePerformanceOptimization();
        }

        // 7. 更新地面穿透防护系统
        private void UpdateGroundPenetrationProtection()
        {
            if (!EnableGroundPenetrationProtection)
                return;

            // 定期进行地面检测
            if (Time.GameTime - _lastGroundCheckTime < GROUND_CHECK_INTERVAL)
                return;

            _lastGroundCheckTime = Time.GameTime;

            // 计算相机当前位置
            Vector3 cameraPosition = Actor.Position;

            // 向下发射射线检测地面
            if (Physics.RayCast(cameraPosition, Vector3.Down, out RayCastHit groundHit, GroundCheckDistance, GroundLayers))
            {
                // 更新当前地面高度
                _currentGroundHeight = groundHit.Point.Y;
                _isNearGround = true;

                // 计算目标地面高度（相机与地面的最小距离）
                _targetGroundHeight = _currentGroundHeight + MinGroundHeight;

                // 如果启用地面高度预测
                if (EnableGroundHeightPrediction)
                {
                    // 预测前方的地面高度
                    Vector3 forwardDirection = new Vector3(Mathf.Sin(Yaw * Mathf.DegreesToRadians), 0, -Mathf.Cos(Yaw * Mathf.DegreesToRadians));
                    Vector3 predictionPosition = cameraPosition + forwardDirection * GroundPredictionDistance;

                    if (Physics.RayCast(predictionPosition, Vector3.Down, out RayCastHit predictionHit, GroundCheckDistance, GroundLayers))
                    {
                        // 结合预测高度调整目标高度
                        _targetGroundHeight = Mathf.Max(_targetGroundHeight, predictionHit.Point.Y + MinGroundHeight);
                    }
                }

                // 如果相机位置低于目标高度，平滑调整
                if (cameraPosition.Y < _targetGroundHeight)
                {
                    float newY = Mathf.Lerp(cameraPosition.Y, _targetGroundHeight, Time.DeltaTime * GroundHeightAdjustSpeed);
                    Actor.Position = new Vector3(cameraPosition.X, newY, cameraPosition.Z);
                }
            }
            else
            {
                _isNearGround = false;
                _currentGroundHeight = float.MaxValue;
                _targetGroundHeight = float.MaxValue;
            }
        }

        /// <summary>
        /// 检查相机是否会穿透地面
        /// </summary>
        private bool WillPenetrateGround(Vector3 position)
        {
            if (!EnableGroundPenetrationProtection)
                return false;

            // 检查指定位置是否会穿透地面
            return Physics.RayCast(position, Vector3.Down, MinGroundHeight, GroundLayers);
        }

        /// <summary>
        /// 获取安全的相机位置（避免地面穿透）
        /// </summary>
        private Vector3 GetSafeCameraPosition(Vector3 desiredPosition)
        {
            if (!EnableGroundPenetrationProtection)
                return desiredPosition;

            // 检查期望位置是否会穿透地面
            if (WillPenetrateGround(desiredPosition))
            {
                // 向上调整位置直到安全
                Vector3 safePosition = desiredPosition;
                while (WillPenetrateGround(safePosition) && safePosition.Y < desiredPosition.Y + GroundCheckDistance)
                {
                    safePosition.Y += 0.1f;
                }
                return safePosition;
            }

            return desiredPosition;
        }

        [Header("相机抖动系统")]
        [Tooltip("启用相机抖动")]
        public bool EnableCameraShake = true;

        [Tooltip("抖动强度")]
        public float ShakeIntensity = 0.1f;

        [Tooltip("抖动衰减速度")]
        public float ShakeDecaySpeed = 2.0f;

        [Tooltip("抖动频率")]
        public float ShakeFrequency = 20.0f;

        [Tooltip("抖动噪声缩放")]
        public float ShakeNoiseScale = 0.1f;

        [Tooltip("位置抖动权重")]
        [Range(0, 1)]
        public float PositionShakeWeight = 0.7f;

        [Tooltip("旋转抖动权重")]
        [Range(0, 1)]
        public float RotationShakeWeight = 0.3f;

        [Tooltip("FOV抖动权重")]
        [Range(0, 1)]
        public float FOVShakeWeight = 0.2f;

        /// <summary>
        /// 更新动态FOV系统
        /// </summary>
        private void UpdateDynamicFOV()
        {
            if (_camera == null)
                return;

            // 计算目标FOV
            float targetFOV = BaseFOV;

            // 基于距离的FOV调整
            if (EnableDistanceBasedFOV)
            {
                float distanceRatio = Mathf.InverseLerp(MinDistance, MaxDistance, Distance);
                float distanceFOV = Mathf.Lerp(MaxDistanceFOV, MinDistanceFOV, distanceRatio);
                targetFOV = distanceFOV;
            }

            // 基于速度的FOV调整
            if (EnableSpeedBasedFOV && Target != null)
            {
                // 定期检查目标速度
                if (Time.GameTime - _lastSpeedCheckTime > SPEED_CHECK_INTERVAL)
                {
                    Vector3 currentPosition = Target.Position;
                    float distance = Vector3.Distance(currentPosition, _lastTargetPosition);
                    _targetSpeed = distance / (Time.GameTime - _lastSpeedCheckTime);
                    _lastTargetPosition = currentPosition;
                    _lastSpeedCheckTime = Time.GameTime;
                }

                // 根据速度调整FOV
                float speedFOVIncrease = Mathf.Min(_targetSpeed * SpeedFOVFactor, MaxSpeedFOVIncrease);
                targetFOV += speedFOVIncrease;
            }

            // 平滑过渡到目标FOV
            _currentFOV = Mathf.Lerp(_currentFOV, targetFOV, Time.DeltaTime * FOVTransitionSpeed);
            _camera.FieldOfView = _currentFOV;
        }

        /// <summary>
        /// 更新相机边界限制系统
        /// </summary>
        private void UpdateCameraBounds()
        {
            if (!EnableCameraBounds || Target == null)
                return;

            // 定期进行边界检测
            if (Time.GameTime - _lastBoundsCheckTime < BOUNDS_CHECK_INTERVAL)
                return;

            _lastBoundsCheckTime = Time.GameTime;

            // 更新边界中心
            _boundsCenter = Target.Position + BoxBoundsCenter;

            // 获取当前相机位置
            Vector3 cameraPosition = Actor.Position;
            bool isOutOfBounds = false;
            Vector3 constrainedPosition = cameraPosition;

            // 根据边界类型进行限制
            switch (BoundsType)
            {
                case CameraBoundsType.Sphere:
                    // 球形边界检测
                    float distanceFromCenter = Vector3.Distance(cameraPosition, _boundsCenter);
                    if (distanceFromCenter > SphereBoundsRadius)
                    {
                        // 计算方向向量
                        Vector3 direction = Vector3.Normalize(cameraPosition - _boundsCenter);
                        
                        // 计算约束位置
                        constrainedPosition = _boundsCenter + direction * SphereBoundsRadius;
                        isOutOfBounds = true;
                    }
                    break;

                case CameraBoundsType.Box:
                    // 盒形边界检测
                    Vector3 localPosition = cameraPosition - _boundsCenter;
                    Vector3 halfBoxSize = BoxBoundsSize * 0.5f;
                    
                    // 检查每个轴
                    bool needsConstrain = false;
                    if (Mathf.Abs(localPosition.X) > halfBoxSize.X)
                    {
                        localPosition.X = Mathf.Sign(localPosition.X) * halfBoxSize.X;
                        needsConstrain = true;
                    }
                    if (Mathf.Abs(localPosition.Y) > halfBoxSize.Y)
                    {
                        localPosition.Y = Mathf.Sign(localPosition.Y) * halfBoxSize.Y;
                        needsConstrain = true;
                    }
                    if (Mathf.Abs(localPosition.Z) > halfBoxSize.Z)
                    {
                        localPosition.Z = Mathf.Sign(localPosition.Z) * halfBoxSize.Z;
                        needsConstrain = true;
                    }
                    
                    if (needsConstrain)
                    {
                        constrainedPosition = _boundsCenter + localPosition;
                        isOutOfBounds = true;
                    }
                    break;

                case CameraBoundsType.Custom:
                    // 自定义边界检测（这里可以实现更复杂的边界逻辑）
                    // 暂时使用球形边界作为默认实现
                    float customDistance = Vector3.Distance(cameraPosition, _boundsCenter);
                    if (customDistance > SphereBoundsRadius)
                    {
                        Vector3 direction = Vector3.Normalize(cameraPosition - _boundsCenter);
                        constrainedPosition = _boundsCenter + direction * SphereBoundsRadius;
                        isOutOfBounds = true;
                    }
                    break;
            }

            // 更新边界状态
            _isNearBounds = isOutOfBounds;
            _boundsConstrainedPosition = constrainedPosition;

            // 如果相机超出边界，平滑移回边界内
            if (isOutOfBounds)
            {
                // 计算边界限制强度（接近边界时逐渐增强）
                float distanceToBoundary = Vector3.Distance(cameraPosition, constrainedPosition);
                float limitStrength = Mathf.Clamp(1.0f - (distanceToBoundary / BoundsApproachDistance), 0.0f, 1.0f);
                limitStrength = Mathf.Pow(limitStrength, 2.0f); // 使用平方使过渡更平滑
                limitStrength *= BoundsLimitStrength;

                // 应用边界限制
                if (limitStrength > 0.01f)
                {
                    Vector3 newPosition = Vector3.Lerp(cameraPosition, constrainedPosition, limitStrength * Time.DeltaTime * BoundsSmoothing);
                    Actor.Position = newPosition;
                }
            }
        }

        /// <summary>
        /// 更新场景适配系统
        /// </summary>
        private void UpdateSceneAdaptation()
        {
            if (!EnableSceneAdaptation || Target == null)
                return;

            // 检测当前区域类型
            DetectCurrentZoneType();

            // 处理区域过渡
            HandleZoneTransition();

            // 更新动态遮挡检测
            UpdateDynamicOcclusion();

            // 更新智能位置选择
            UpdateSmartPositioning();

            // 更新视角优化
            UpdateViewOptimization();

            // 更新目标跟踪预测
            UpdateTargetPrediction();

            // 更新环境感知
            UpdateEnvironmentAwareness();
        }

        /// <summary>
        /// 检测当前区域类型
        /// </summary>
        private void DetectCurrentZoneType()
        {
            // 这里可以实现区域检测逻辑
            // 暂时保持当前区域类型不变
            _targetZoneType = _currentZoneType;
        }

        /// <summary>
        /// 处理区域过渡
        /// </summary>
        private void HandleZoneTransition()
        {
            // 如果目标区域与当前区域相同，直接返回
            if (_targetZoneType == _currentZoneType)
                return;

            // 开始区域过渡
            if (!_isTransitioningZones)
            {
                _isTransitioningZones = true;
                _zoneTransitionStartTime = Time.GameTime;
                _zoneTransitionDuration = ZoneTransitionTime;

                // 根据目标区域设置目标距离范围
                switch (_targetZoneType)
                {
                    case SceneZoneType.Indoor:
                        _targetDistanceRange = IndoorDistanceRange;
                        break;
                    case SceneZoneType.Outdoor:
                        _targetDistanceRange = OutdoorDistanceRange;
                        break;
                    case SceneZoneType.Restricted:
                        _targetDistanceRange = RestrictedDistanceRange;
                        break;
                }
            }

            // 更新过渡进度
            float transitionProgress = (Time.GameTime - _zoneTransitionStartTime) / _zoneTransitionDuration;
            transitionProgress = Mathf.Clamp(transitionProgress, 0.0f, 1.0f);

            // 平滑过渡距离范围
            _currentDistanceRange = Vector2.Lerp(_currentDistanceRange, _targetDistanceRange, transitionProgress);

            // 更新相机距离限制
            MinDistance = _currentDistanceRange.X;
            MaxDistance = _currentDistanceRange.Y;
            Distance = Mathf.Clamp(Distance, MinDistance, MaxDistance);

            // 检查过渡是否完成
            if (transitionProgress >= 1.0f)
            {
                _currentZoneType = _targetZoneType;
                _isTransitioningZones = false;
            }
        }

        /// <summary>
        /// 更新动态遮挡检测
        /// </summary>
        private void UpdateDynamicOcclusion()
        {
            if (!EnableDynamicOcclusion || Target == null)
                return;

            // 定期进行遮挡检测
            if (Time.GameTime - _lastOcclusionCheckTime < OcclusionCheckFrequency)
                return;

            _lastOcclusionCheckTime = Time.GameTime;

            // 计算相机到目标的向量
            Vector3 targetPosition = Target.Position + FocusOffset;
            Vector3 cameraToTarget = targetPosition - Actor.Position;
            float distance = cameraToTarget.Length;

            // 检测遮挡
            bool isOccluded = Physics.RayCast(Actor.Position, Vector3.Normalize(cameraToTarget), out RayCastHit hit, distance, OcclusionLayer);

            // 更新遮挡状态
            _isOccluded = isOccluded;

            // 如果有遮挡，调整相机距离
            if (isOccluded)
            {
                _occlusionDistance = Mathf.Max(hit.Distance - CollisionOffset, MinOcclusionDistance);
                Distance = Mathf.Lerp(Distance, _occlusionDistance, Time.DeltaTime * OcclusionAdjustSpeed);
            }
        }

