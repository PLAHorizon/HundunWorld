{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Horizon.IM.Gateway": "Debug"
    }
  },

  "Gateway": {
    "GatewayId": "TYMYD-IMGateway-001",
    "ClusterId": "",
    "Region": "华东",
    "RedisConnectionString": "${GATEWAY_REDIS_CONNECTION_STRING}",
    "PublicIpAddress": "${GATEWAY_PUBLIC_IP}",
    "PublicPort": 0,
    "RegistryHeartbeatIntervalSeconds": 30
  },

  "Network": {
    "IpAddress": "0.0.0.0",
    "TcpPort": 31000,
    "AllowPortFallback": true,
    "PortFallbackRange": 20,
    "NoDelay": true
  },

  "Orleans": {
    "ClusterId": "dev",
    "ServiceId": "BaseService",
    "ResponseTimeoutSeconds": 30,
    "RetryCount": 0,
    "RetryIntervalMilliseconds": 1000
  },

  "ClusterOptions": {
    "ClusterId": "dev",
    "ServiceId": "BaseService"
  },

  "ClusteringSiloOptions": {
    "SqlServer": {
      "ConnectionString": "${ORLEANS_SQLSERVER_CONNECTION_STRING}",
      "Invariant": "Microsoft.Data.SqlClient"
    }
  },

  "DataBase": {
    "RedisMasters": [
      {
        "Host": "192.168.1.78",
        "Port": "6379",
        "Password": "${REDIS_PASSWORD}"
      }
    ]
  },

  "Security": {
    "AuthTokenSecret": "${AUTH_TOKEN_SECRET}"
  }
}
