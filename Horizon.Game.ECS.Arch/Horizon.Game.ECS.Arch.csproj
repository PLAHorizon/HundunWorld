<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>$(TargetDir)$(AssemblyName).xml</DocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Arch 上游尚未发布 net10.0 资产；引用其 net8.0 输出，禁用相关兼容性提示�?-->
    <NoWarn>$(NoWarn);NU1701;NU1603;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" />
    <PackageReference Include="Arch.System" />
    <PackageReference Include="Arch.LowLevel" />
    <PackageReference Include="Collections.Pooled" />
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <!-- 阶段 5.4.2：ArchSystemBase.Log 注入式日志（替代 Debug.WriteLine 直接打印） -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Horizon.Game.Gateway.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Horizon.Game.Message\Horizon.Game.Message.csproj" />
    <ProjectReference Include="..\Horizon.Game.ECS\Horizon.Game.ECS.csproj" />
    <!-- 多玩家 AOI：LocalSimulationSystem 依赖 WorldCoord.ToChunkMortonKey 计算 chunk 边界。
         只引 World.Contracts（分块换算 + Morton 编码）——AOI 视野集/ZoneShard 租约算法不可下发客户端。
         亦不再引 Horizon.Game.Core：那条 ProjectReference 是服务端 Orleans 宿主链，
         ECS.Arch 从无类型真正引用它（`using Horizon.Game.Core.World` 解析到 World.Contracts）。 -->
    <ProjectReference Include="..\Horizon.Game.World.Contracts\Horizon.Game.World.Contracts.csproj" />
    <!-- 确定性移动公式/步进器/修正包：只引 Contracts，不引服务端权威核 Horizon.Game.Sim -->
    <ProjectReference Include="..\Horizon.Game.Sim.Contracts\Horizon.Game.Sim.Contracts.csproj" />
  </ItemGroup>

  <!-- 解决方案编译后，把本程序集分发到 Flax 引擎托管工具目录，
       供 MMORPG 客户端（Game.csproj 的 <Reference> 与 Game.Build.cs 的 dlls[]）编译期/构建期解析。
       - FlaxToolsDir / CopyToFlax 均可在命令行覆盖（-p:CopyToFlax=false 关闭分发）；
       - 仅当目标目录存在时才执行，避免未装 Flax 的 CI 报错；
       - 写入 Program Files 需管理员权限，失败按警告处理（ContinueOnError），不阻断编译。 -->
  <PropertyGroup>
    <FlaxToolsDir Condition="'$(FlaxToolsDir)' == ''">C:\Program Files (x86)\Flax\Flax_1.13\Binaries\Tools</FlaxToolsDir>
    <CopyToFlax Condition="'$(CopyToFlax)' == ''">true</CopyToFlax>
  </PropertyGroup>

  <Target Name="CopyToFlax" AfterTargets="Build"
          Condition="'$(CopyToFlax)' == 'true' And Exists('$(FlaxToolsDir)')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          Condition="Exists('$(TargetDir)$(TargetName).pdb')"
          DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).xml"
          Condition="Exists('$(TargetDir)$(TargetName).xml')"
          DestinationFolder="$(FlaxToolsDir)"
          SkipUnchangedFiles="true" ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="[CopyToFlax] $(TargetFileName) -&gt; $(FlaxToolsDir)" />
  </Target>

</Project>
