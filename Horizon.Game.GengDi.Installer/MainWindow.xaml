<Window x:Class="Horizon.Game.GengDi.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="耕地 安装程序"
        Width="620" Height="468"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

  <!-- 顶层 Grid，承载窗口阴影 + 圆角主体 -->
  <Grid>

    <!-- ══════════════════════════════════════════════
         主体圆角卡片（含渐变背景 + 装饰气泡 + 内容层）
         ══════════════════════════════════════════════ -->
    <Border x:Name="RootCard"
            CornerRadius="14"
            Margin="10"
            ClipToBounds="True">

      <!-- 渐变背景 -->
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#BDD5EC" Offset="0.00"/>
          <GradientStop Color="#D0E6F6" Offset="0.35"/>
          <GradientStop Color="#EAF4FC" Offset="0.65"/>
          <GradientStop Color="#F4FAFF" Offset="1.00"/>
        </LinearGradientBrush>
      </Border.Background>

      <!-- 卡片投影 -->
      <Border.Effect>
        <DropShadowEffect Color="#60304060"
                          BlurRadius="20"
                          ShadowDepth="6"
                          Opacity="0.28"/>
      </Border.Effect>

      <Grid>

        <!-- ── 装饰气泡层（置于所有内容之下） ── -->
        <Canvas IsHitTestVisible="False">
          <!-- 右上大气泡 -->
          <Ellipse Canvas.Right="-80" Canvas.Top="-80"
                   Width="320" Height="320" Opacity="0.35">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#80AACCEE" Offset="0"/>
                <GradientStop Color="Transparent"  Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <!-- 左下中气泡 -->
          <Ellipse Canvas.Left="-60" Canvas.Bottom="-60"
                   Width="260" Height="260" Opacity="0.28">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#70B8D8F0" Offset="0"/>
                <GradientStop Color="Transparent"  Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <!-- 右下小气泡 -->
          <Ellipse Canvas.Right="40" Canvas.Bottom="30"
                   Width="130" Height="130" Opacity="0.18">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#90C4E4FF" Offset="0"/>
                <GradientStop Color="Transparent"  Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
        </Canvas>

        <!-- ── 主内容层 ── -->
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="38"/>   <!-- 自定义标题栏 -->
            <RowDefinition Height="*"/>    <!-- 页面内容区 -->
          </Grid.RowDefinitions>

          <!-- 自定义标题栏（可拖拽区域） -->
          <Grid Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Margin="0,4,6,0">
              <Button Style="{StaticResource WinCtrlBtnStyle}"
                      Click="Minimize_Click"
                      ToolTip="最小化">
                <!-- 最小化横线 -->
                <Rectangle Width="12" Height="1.5"
                           Fill="#7A8A9E" VerticalAlignment="Center"/>
              </Button>
              <Button Style="{StaticResource CloseCtrlBtnStyle}"
                      Click="Close_Click"
                      ToolTip="关闭">
                <!-- × 形状（两条斜线） -->
                <Canvas Width="12" Height="12">
                  <Line X1="0" Y1="0" X2="12" Y2="12"
                        Stroke="#7A8A9E" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                  <Line X1="12" Y1="0" X2="0" Y2="12"
                        Stroke="#7A8A9E" StrokeThickness="1.8"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Button>
            </StackPanel>
          </Grid>

          <!-- 页面容器：通过 ContentControl 切换三个页面 -->
          <ContentControl x:Name="PageHost"
                          Grid.Row="1"
                          Focusable="False"/>
        </Grid>

      </Grid>
    </Border>

  </Grid>
</Window>
