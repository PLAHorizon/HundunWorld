<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>GengDi.Setup</AssemblyName>
    <AssemblyTitle>耕地 安装程序</AssemblyTitle>
    <AssemblyDescription>耕地游戏中心安装程序</AssemblyDescription>
    <RootNamespace>Horizon.Game.GengDi.Installer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Horizon.Game.GengDi.PC\Application.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- 将主应用图标嵌入为资源，供页�?Image 控件使用 -->
  <ItemGroup>
    <Resource Include="..\Horizon.Game.GengDi.PC\Application.ico" Link="Resources\app.ico" />
  </ItemGroup>

</Project>
