<UserControl x:Class="Horizon.Game.GengDi.Installer.Pages.CompletePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <StackPanel Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,-16,0,16">

      <!-- ── 成功勾选图标 ── -->
      <Grid Width="80" Height="80"
            HorizontalAlignment="Center"
            Margin="0,0,0,0">
        <!-- 绿色圆形背景 -->
        <Ellipse Width="80" Height="80">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,0.9">
              <GradientStop Color="#5AC880" Offset="0"/>
              <GradientStop Color="#2EA860" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <DropShadowEffect Color="#209050" BlurRadius="14"
                              ShadowDepth="4" Opacity="0.30"/>
          </Ellipse.Effect>
        </Ellipse>
        <!-- 白色对勾 -->
        <Viewbox Width="36" Height="36"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
          <Canvas Width="24" Height="24">
            <Path Data="M 4,12 L 10,18 L 20,6"
                  Stroke="White" StrokeThickness="2.4"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  StrokeLineJoin="Round" Fill="Transparent"/>
          </Canvas>
        </Viewbox>
      </Grid>

      <!-- ── 标题 ── -->
      <TextBlock Text="安装完成！"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#1A2333"
                 HorizontalAlignment="Center"
                 Margin="0,16,0,0"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 副文案 ── -->
      <TextBlock x:Name="TxtInstallInfo"
                 FontSize="13"
                 Foreground="#7A8A9E"
                 HorizontalAlignment="Center"
                 Margin="0,6,0,0"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 操作按钮 ── -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,28,0,0">
        <Button Content="立即启动耕地"
                Style="{StaticResource FinishButtonStyle}"
                Click="BtnLaunch_Click"
                Margin="0,0,14,0"/>
        <Button Content="关闭"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="BtnClose_Click"/>
      </StackPanel>

    </StackPanel>
  </Grid>

</UserControl>
