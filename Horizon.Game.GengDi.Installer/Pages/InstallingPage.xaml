<UserControl x:Class="Horizon.Game.GengDi.Installer.Pages.InstallingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

  <Grid Margin="36,10,36,28">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>       <!-- 主内容区 -->
      <RowDefinition Height="Auto"/>   <!-- 进度区 -->
    </Grid.RowDefinitions>

    <!-- ════════════════════════════════════════════
         主内容：左侧文字  +  右侧示意插图
         ════════════════════════════════════════════ -->
    <Grid Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="24"/>
        <ColumnDefinition Width="220"/>
      </Grid.ColumnDefinitions>

      <!-- 左：特性文字 -->
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="TxtFeatureTitle"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#1A2333"
                   TextWrapping="Wrap"
                   FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                   Margin="0,0,0,10"/>
        <TextBlock x:Name="TxtFeatureDesc"
                   FontSize="13"
                   Foreground="#556070"
                   TextWrapping="Wrap"
                   LineHeight="22"
                   FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>
      </StackPanel>

      <!-- 右：示意插图（纯 WPF 绘制，无需外部图片） -->
      <Border Grid.Column="2"
              CornerRadius="12"
              Background="#E8F3FC"
              BorderBrush="#C0D8EE"
              BorderThickness="1"
              ClipToBounds="True">
        <Canvas Width="220" Height="180">

          <!-- 游戏卡片 1 -->
          <Border Canvas.Left="14" Canvas.Top="18"
                  Width="192" Height="44"
                  CornerRadius="8"
                  Background="White">
            <Border.Effect>
              <DropShadowEffect Color="#8090A0" BlurRadius="6"
                                ShadowDepth="1" Opacity="0.12"/>
            </Border.Effect>
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
              </Grid.ColumnDefinitions>
              <!-- 游戏色块 -->
              <Border Grid.Column="0" Width="32" Height="32"
                      CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#60C060" Offset="0"/>
                    <GradientStop Color="#3090A0" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <!-- 标题 + 进度条 -->
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="角色扮演" FontSize="11" Foreground="#334"
                           FontFamily="Microsoft YaHei UI"/>
                <ProgressBar Value="72" Maximum="100" Height="4"
                             Margin="0,4,0,0"
                             Style="{StaticResource InstallerProgressBarStyle}"/>
              </StackPanel>
              <!-- 速度标签 -->
              <TextBlock Grid.Column="3" Text="26.5 MB/s"
                         FontSize="10" Foreground="#4A8EF5"
                         VerticalAlignment="Center" TextAlignment="Right"
                         FontFamily="Microsoft YaHei UI"/>
            </Grid>
          </Border>

          <!-- 游戏卡片 2 -->
          <Border Canvas.Left="14" Canvas.Top="74"
                  Width="192" Height="44"
                  CornerRadius="8"
                  Background="White">
            <Border.Effect>
              <DropShadowEffect Color="#8090A0" BlurRadius="6"
                                ShadowDepth="1" Opacity="0.12"/>
            </Border.Effect>
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="32" Height="32"
                      CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E07020" Offset="0"/>
                    <GradientStop Color="#C04080" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="策略战棋" FontSize="11" Foreground="#334"
                           FontFamily="Microsoft YaHei UI"/>
                <ProgressBar Value="45" Maximum="100" Height="4"
                             Margin="0,4,0,0"
                             Style="{StaticResource InstallerProgressBarStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="3" Text="18.2 MB/s"
                         FontSize="10" Foreground="#4A8EF5"
                         VerticalAlignment="Center" TextAlignment="Right"
                         FontFamily="Microsoft YaHei UI"/>
            </Grid>
          </Border>

          <!-- 游戏卡片 3 -->
          <Border Canvas.Left="14" Canvas.Top="130"
                  Width="192" Height="44"
                  CornerRadius="8"
                  Background="White">
            <Border.Effect>
              <DropShadowEffect Color="#8090A0" BlurRadius="6"
                                ShadowDepth="1" Opacity="0.12"/>
            </Border.Effect>
            <Grid Margin="10,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="32" Height="32"
                      CornerRadius="6" VerticalAlignment="Center">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#4060E0" Offset="0"/>
                    <GradientStop Color="#8030C0" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="开放世界" FontSize="11" Foreground="#334"
                           FontFamily="Microsoft YaHei UI"/>
                <ProgressBar Value="88" Maximum="100" Height="4"
                             Margin="0,4,0,0"
                             Style="{StaticResource InstallerProgressBarStyle}"/>
              </StackPanel>
              <TextBlock Grid.Column="3" Text="31.0 MB/s"
                         FontSize="10" Foreground="#4A8EF5"
                         VerticalAlignment="Center" TextAlignment="Right"
                         FontFamily="Microsoft YaHei UI"/>
            </Grid>
          </Border>

        </Canvas>
      </Border>
    </Grid>

    <!-- ════════════════════════════════════════════
         底部进度区
         ════════════════════════════════════════════ -->
    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="8"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 进度条 -->
      <ProgressBar x:Name="ProgressBar"
                   Grid.Row="0"
                   Style="{StaticResource InstallerProgressBarStyle}"
                   Height="8"
                   Value="0"/>

      <!-- 状态文字 + 百分比 -->
      <Grid Grid.Row="2">
        <TextBlock x:Name="TxtStatus"
                   FontSize="12"
                   Foreground="#556070"
                   HorizontalAlignment="Left"
                   FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                   Text="正在准备..."/>
        <TextBlock x:Name="TxtPercent"
                   FontSize="12"
                   Foreground="#4A8EF5"
                   HorizontalAlignment="Right"
                   FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                   Text="0%"/>
      </Grid>
    </Grid>

  </Grid>

</UserControl>
