<UserControl x:Class="Horizon.Game.GengDi.Installer.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

  <Grid>
    <!-- 居中主体，宽度固定便于对齐 -->
    <StackPanel Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,-10,0,16">

      <!-- ── 应用图标 ── -->
      <Grid Width="84" Height="84"
            HorizontalAlignment="Center"
            Margin="0,0,0,0">
        <!-- 圆形背景 -->
        <Ellipse Width="84" Height="84">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,0.9">
              <GradientStop Color="#5AAEFF" Offset="0"/>
              <GradientStop Color="#2E78E0" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <DropShadowEffect Color="#3060CC" BlurRadius="14"
                              ShadowDepth="4" Opacity="0.35"/>
          </Ellipse.Effect>
        </Ellipse>
        <!-- 中文字符作为 Logo -->
        <TextBlock Text="耕"
                   FontSize="38"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei"/>
      </Grid>

      <!-- ── 应用名称 ── -->
      <TextBlock Text="耕地"
                 FontSize="30"
                 FontWeight="Bold"
                 Foreground="#1A2333"
                 HorizontalAlignment="Center"
                 Margin="0,14,0,0"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 副标题 ── -->
      <TextBlock Text="游戏发现与启动平台"
                 FontSize="13"
                 Foreground="#7A8A9E"
                 HorizontalAlignment="Center"
                 Margin="0,5,0,0"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 安装按钮 ── -->
      <Button x:Name="BtnInstall"
              Content="开始安装"
              Style="{StaticResource InstallButtonStyle}"
              IsEnabled="False"
              HorizontalAlignment="Center"
              Margin="0,26,0,0"
              Click="BtnInstall_Click"/>

      <!-- ── 安装路径行 ── -->
      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="8"/>
          <ColumnDefinition Width="44"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="TxtInstallPath"
                 Grid.Column="0"
                 Style="{StaticResource PathTextBoxStyle}"/>

        <Button Grid.Column="2"
                Style="{StaticResource BrowseButtonStyle}"
                Click="BtnBrowse_Click"
                ToolTip="选择安装目录">
          <!-- 文件夹图标（SVG Path） -->
          <Path Width="20" Height="16"
                Stretch="Uniform"
                Fill="#5A7A9A"
                Data="M 1,4 L 7,4 L 9,6.5 L 19,6.5 L 19,16 L 1,16 Z
                      M 1,7 L 19,7"/>
        </Button>
      </Grid>

      <!-- ── EULA 同意行 ── -->
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,14,0,0">
        <CheckBox x:Name="ChkEula"
                  Style="{StaticResource EulaCheckBoxStyle}"
                  Checked="ChkEula_Changed"
                  Unchecked="ChkEula_Changed"
                  VerticalAlignment="Center">
          <TextBlock FontFamily="Microsoft YaHei UI, Microsoft YaHei"
                     VerticalAlignment="Center">
            <Run Text="同意"/>
            <Hyperlink Click="HypEula_Click"
                       Foreground="#4A8EF5"
                       TextDecorations="None">《用户许可协议》</Hyperlink>
          </TextBlock>
        </CheckBox>
      </StackPanel>

    </StackPanel>
  </Grid>

</UserControl>
