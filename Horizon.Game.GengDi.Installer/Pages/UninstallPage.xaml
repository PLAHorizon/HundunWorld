<UserControl x:Class="Horizon.Game.GengDi.Installer.Pages.UninstallPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Loaded="UserControl_Loaded">

  <Grid>
    <StackPanel Width="380"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Margin="0,-16,0,16">

      <!-- ── 标题 ── -->
      <TextBlock x:Name="TxtTitle"
                 Text="卸载耕地游戏中心"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="#1A2333"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,8"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 安装路径提示 ── -->
      <TextBlock x:Name="TxtInstallPath"
                 FontSize="13"
                 Foreground="#7A8A9E"
                 HorizontalAlignment="Center"
                 Margin="0,0,0,24"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 进度条（卸载中时显示） ── -->
      <ProgressBar x:Name="ProgressBar"
                   Style="{StaticResource InstallerProgressBarStyle}"
                   Height="8"
                   Value="0"
                   Visibility="Collapsed"
                   Margin="0,0,0,6"/>

      <!-- ── 状态文字 ── -->
      <TextBlock x:Name="TxtStatus"
                 FontSize="12"
                 Foreground="#556070"
                 HorizontalAlignment="Center"
                 Visibility="Collapsed"
                 FontFamily="Microsoft YaHei UI, Microsoft YaHei"/>

      <!-- ── 操作按钮 ── -->
      <StackPanel x:Name="PanelButtons"
                  Orientation="Horizontal"
                  HorizontalAlignment="Center"
                  Margin="0,20,0,0">
        <Button x:Name="BtnUninstall"
                Content="确认卸载"
                Style="{StaticResource InstallButtonStyle}"
                Click="BtnUninstall_Click"
                Margin="0,0,14,0"/>
        <Button Content="取消"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="BtnCancel_Click"/>
      </StackPanel>

    </StackPanel>
  </Grid>

</UserControl>
