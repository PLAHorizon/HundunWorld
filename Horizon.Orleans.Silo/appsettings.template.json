{
  "Logging": {
    "IncludeScopes": false,
    "LogLevel": { "Default": "Warning" }
  },
  "DataBase": {
    "RedisMasters": [
      {
        "Host": "127.0.0.1",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "127.0.0.1",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      }
    ],
    "RedisSlaves": [
      {
        "Host": "127.0.0.1",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "127.0.0.1",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      },
      {
        "Host": "127.0.0.1",
        "Port": "9379",
        "Password": "${REDIS_PASSWORD}"
      }
    ],
    "RedisSentinels": [
      {
        "Host": "127.0.0.1",
        "Port": "6379"
      },
      {
        "Host": "127.0.0.1",
        "Port": "6379"
      }
    ]
  },
  "Configs": {
    "Ali": {
      "AliOSSAccessKeyId": "${ALI_OSS_ACCESS_KEY_ID}",
      "AliOSSAccessKeySecret": "${ALI_OSS_ACCESS_KEY_SECRET}",
      "AliOSSPrivateEndpoint": "oss-cn-beijing.aliyuncs.com",
      "AliOSSFileServerDomain": "Horizon-wcf-im-oss.oss-cn-beijing.aliyuncs.com",
      "AliOSSBucketName": "Horizon-wcf-im-oss",
      "AliOSSImageServerDomain": "Horizon-wcf-im-oss.oss-cn-beijing.aliyuncs.com"
    },
    "BuiDu": {
      "BaiDuApiKey": "${BAIDU_API_KEY}",
      "BaiDuSecretKey": "${BAIDU_SECRET_KEY}"
    },
    "XunFei": {
      "XunFeiSpeechTTS": "${XUNFEI_APP_ID}",
      "XunFeiIsRealTime": "true"
    },
    "HorizonSelf": {
      "LogRepository": "Horizon.Common",
      "ApiLogRepository": "Horizon.Api"
    }
  },
  "ClusteringSiloOptions": {
    "Npgsql": {
      "ConnectionString": "${ORLEANS_NPGSQL_CONNECTION_STRING}",
      "Invariant": "Npgsql"
    },
    "SqlServer": {
      "ConnectionString": "${ORLEANS_SQLSERVER_CONNECTION_STRING}",
      "Invariant": "Microsoft.Data.SqlClient"
    },
    "OrleansSiloHost": "192.168.1.78" 
  },
  "ClusterOptions": {
    "ClusterId": "dev",
    "ServiceId": "BaseService"
  },
  "DatabaseOptions": {
    "Basic": {
      "ConnectionString": "${DB_BASIC_CONNECTION_STRING}",
      "Type": 0
    },
    "Game": {
      "ConnectionString": "${DB_GAME_CONNECTION_STRING}",
      "Type": 0
    },
    "Article": {
      "ConnectionString": "${DB_ARTICLE_CONNECTION_STRING}",
      "Type": 0
    },
    "Support": {
      "ConnectionString": "${DB_SUPPORT_CONNECTION_STRING}",
      "Type": 0
    },
    "Xingguang": {
      "ConnectionString": "${DB_XINGGUANG_CONNECTION_STRING}",
      "Type": 0
    }
  },
  "DashboardOptions": {
    "Host": "127.0.0.1",
    "Port": 1199,
    "Username": "${ORLEANS_DASHBOARD_USERNAME}",
    "Password": "${ORLEANS_DASHBOARD_PASSWORD}"
  },
  "VerificationUserDataOptions": { 
    "Phone": 5,
    "Email": 1440,
    "IdCard": 3,
    "FaceId": 3
  },
  "HorizonTimeoutConfiguration": {
    "ConnectionTimeoutMs": 10000,
    "GatewayTimeoutMs": 30000,
    "KeepAliveTimeoutMs": 15000,
    "RequestTimeoutMs": 60000,
    "ResponseTimeoutMs": 30000,
    "ResponseTimeoutWithDebuggerMs": 300000,
    "MaxRetryAttempts": 3,
    "RetryDelayMs": 1000,
    "MaxForwardCount": 2,
    "GatewayListRefreshPeriodMs": 60000,
    "DelayWarningThresholdMs": 500,
    "ClusterMembershipTimeoutMs": 40000,
    "GatewayConnectionTimeoutMs": 30000,
    "MessageProcessingTimeoutMs": 30000,
    "RetryCount": 3,
    "RetryIntervalMs": 1000,
    "GrainDeactivationTimeoutMs": 120000,
    "EnableTimeoutDiagnostics": true
  },
  "StartupOptimization": {
    "EnableParallelInitialization": true,
    "SkipNonCriticalServices": true,
    "DelayedServicesStartupSeconds": 10
  },
  "ClientConnectionOptions": {
    "EnableDetailedLogging": false,
    "LogConnectionDetails": false,
    "LogInterval": "00:05:00"
  },
  "Seq": {
    "Enabled": false,
    "ServerUrl": "http://localhost:5341",
    "ApiKey": "${SEQ_API_KEY}",
    "BatchIntervalSeconds": 2,
    "MaxBatchSize": 100
  },
  "Monitoring": {
    "PrometheusPort": 9464
  }
}
