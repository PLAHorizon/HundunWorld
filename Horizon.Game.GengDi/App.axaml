<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             x:Class="Horizon.Game.GengDi.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- GdTheme 提供完整 gd token 体系（旧 Resources.axaml 已移除） -->
                <ResourceInclude Source="avares://Horizon.Game.GengDi/Assets/Styles/GdTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:WeatherIconConverter x:Key="WeatherIconConverter" />
            <converters:ToastBgConverter x:Key="ToastBgConverter" />
            <converters:ToastBorderConverter x:Key="ToastBorderConverter" />
            <converters:ToastFgConverter x:Key="ToastFgConverter" />
            <converters:ToastIconConverter x:Key="ToastIconConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <sty:FluentAvaloniaTheme PreferSystemTheme="True" PreferUserAccentColor="True" />
        <StyleInclude Source="avares://Horizon.Game.GengDi/Assets/Styles/Styles.xaml" />
        <StyleInclude Source="avares://Horizon.Game.GengDi/Assets/Styles/ControlsGalleryStyles.axaml" />
        <!-- GdControls 最后加载，新 GalleryPage 轻量模板覆盖旧模板 -->
        <StyleInclude Source="avares://Horizon.Game.GengDi/Assets/Styles/GdControls.axaml" />
    </Application.Styles>
</Application>
