<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <NuGetAudit>false</NuGetAudit>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avalonia 资源：XAML样式/图标/图片等 -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\Data\*.json;Assets\Styles\ControlsGalleryStyles.axaml;Assets\Styles\Resources.axaml" />
    
    <!-- JSON 数据文件：需要复制到输出目录供 LiteDB 导入使用 -->
    <Content Include="Assets\Data\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    
    <Content Include="Assets\Icons\Weather\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.*.json" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.axaml" />
    <Page Include="Core\Views\MainView.axaml" />
    <Page Include="Core\Views\MainWindow.axaml" />
    <Page Include="Core\Views\HomeView.axaml" />
    <Page Include="Core\Views\GamesView.axaml" />
    <Page Include="Core\Views\DownloadsView.axaml" />
