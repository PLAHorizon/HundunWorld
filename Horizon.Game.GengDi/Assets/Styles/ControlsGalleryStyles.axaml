<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives">

    <Style Selector="ui|NavigationView.HorizonAppNav">
        <Setter Property="IsPaneToggleButtonVisible" Value="False" />
        <Setter Property="OpenPaneLength" Value="72" />
        <Setter Property="CompactPaneLength" Value="72" />
        <Setter Property="IsPaneOpen" Value="True" />
    </Style>

    <Style Selector="ui|NavigationView.HorizonAppNav /template/ Button#NavigationViewBackButton">
        <Setter Property="Width" Value="40" />
    </Style>

    <Style Selector="ui|NavigationView.HorizonAppNav[IsBackButtonVisible=False] SplitView /template/ ContentPresenter#PART_PanePresenter">
        <Setter Property="Margin" Value="0 40 0 0" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter">
        <Setter Property="Width" Value="72" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="4 2"
                        TemplatedControl.IsTemplateFocusTarget="True">
                    <Panel>
                        <Panel HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                            <Border Name="SelectionIndicator"
                                    Background="{DynamicResource NavigationViewSelectionIndicatorForeground}"
                                    Width="3"
                                    Opacity="0"
                                    VerticalAlignment="Center"
                                    Height="20"
                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                        </Panel>

                        <DockPanel>
                            <ContentPresenter Name="ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              FontSize="10"
                                              Padding="0 4"
                                              Margin="0 -15 0 3"
                                              DockPanel.Dock="Bottom"
                                              IsVisible="False">
                                <ContentPresenter.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>

                            <Viewbox Name="IconBox"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ContentPresenter Name="Icon"
                                                  Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Viewbox>
                        </DockPanel>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:pointerover /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:pointerover /template/ ContentPresenter#Icon">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:selected /template/ ContentPresenter#ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:selected /template/ ContentPresenter#Icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>

    <Style Selector="Border.SurfaceCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="Border.SurfaceCard.subtle">
        <Setter Property="Background" Value="{DynamicResource BattleNetSurfaceTintBrush}" />
    </Style>

    <Style Selector="Border.ListItemCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style Selector="TextBlock.PageEyebrow">
        <Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}" />
        <Setter Property="Foreground" Value="{StaticResource BattleNetPrimaryBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 12" />
    </Style>

    <Style Selector="TextBlock.SupportingText">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.PrimaryAction">
        <Setter Property="Background" Value="{StaticResource BattleNetPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BattleNetOutlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16 10" />
    </Style>

    <Style Selector="Button.PrimaryAction:pointerover">
        <Setter Property="Background" Value="{StaticResource BattleNetPrimaryHoverBrush}" />
    </Style>

    <Style Selector="Button.PrimaryAction:pressed">
        <Setter Property="Background" Value="{StaticResource BattleNetPrimaryPressedBrush}" />
    </Style>

    <Style Selector="Button.QuietAction">
        <Setter Property="Padding" Value="14 10" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <Style Selector="Button.QuietAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource BattleNetSurfaceTintBrush}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         战网风格标题栏按钮样式
         ══════════════════════════════════════════════════════════ -->

    <!-- 品牌 Logo 按钮 -->
    <Style Selector="Button.TitleBarBrand">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.TitleBarBrand:pointerover">
        <Setter Property="Background" Value="{DynamicResource TitleBarNavItemHoverBrush}" />
    </Style>

    <!-- 标题栏文本导航按钮 -->
    <Style Selector="Button.TitleBarNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.TitleBarNavItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource TitleBarNavItemHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.TitleBarNavItem:pressed">
        <Setter Property="Foreground" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
    </Style>
    <!-- 标题栏主导航项选中状态 -->
    <Style Selector="Button.TitleBarNavItem.TitleBarNavSelected">
        <Setter Property="Foreground" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
    </Style>
    <Style Selector="Button.TitleBarNavItem.TitleBarNavSelected:pointerover">
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
    </Style>

    <!-- 标题栏图标按钮 -->
    <Style Selector="Button.TitleBarIconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.TitleBarIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource TitleBarNavItemHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- 用户面板按钮 -->
    <!-- 底部边框始终占位 2px，仅在选中时改变 BorderBrush，避免布局抖动 -->
    <Style Selector="Button.TitleBarUserButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6 4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.TitleBarUserButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource TitleBarNavItemHoverBrush}" />
    </Style>
    <Style Selector="Button.TitleBarUserButton.TitleBarNavSelected">
        <Setter Property="Background" Value="{DynamicResource TitleBarNavItemHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         副导航条样式
         ══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.SubNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="12 8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SubNavItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource SubNavItemHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TitleBarTextBrush}" />
    </Style>
    <Style Selector="Button.SubNavItem.SubNavSelected">
        <Setter Property="Foreground" Value="{DynamicResource TitleBarNavItemSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SubNavItemSelectedBorderBrush}" />
    </Style>

    <Style Selector="controls|GalleryPage">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="Root"
                           Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                    <Panel DockPanel.Dock="Top">
                        <Border Background="{DynamicResource PageHeaderBackgroundBrush}"
                                OpacityMask="{DynamicResource HeaderOpacityMaskBrush}"
                                Height="88"
                                VerticalAlignment="Top" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="24 32 24 0">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="18">
                                <Border Width="104"
                                        Height="104"
                                        CornerRadius="{StaticResource HorizonLargeCornerRadius}"
                                        Background="{DynamicResource ControlOnImageFillColorDefaultBrush}">
                                    <Viewbox Margin="16">
                                        <ui:IconSourceElement IconSource="{TemplateBinding IconSource}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            MaxWidth="820">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Theme="{StaticResource TitleTextBlockStyle}"
                                               FontSize="34" />
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Classes="PageEyebrow"
                                               Margin="0 4 0 0" />
                                    <TextBlock Text="{TemplateBinding Description}"
                                               Classes="SupportingText"
                                               Margin="0 10 0 0"
                                               MaxWidth="720" />
                                </StackPanel>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderActionContent}"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right" />
                        </Grid>
                    </Panel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="{DynamicResource SampleAppPageMargin}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|GalleryPage[IsPageScrollingEnabled=False]">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="Root"
                           Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                    <Panel DockPanel.Dock="Top">
                        <Border Background="{DynamicResource PageHeaderBackgroundBrush}"
                                OpacityMask="{DynamicResource HeaderOpacityMaskBrush}"
                                Height="88"
                                VerticalAlignment="Top" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="24 32 24 0">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="18">
                                <Border Width="104"
                                        Height="104"
                                        CornerRadius="{StaticResource HorizonLargeCornerRadius}"
                                        Background="{DynamicResource ControlOnImageFillColorDefaultBrush}">
                                    <Viewbox Margin="16">
                                        <ui:IconSourceElement IconSource="{TemplateBinding IconSource}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            MaxWidth="820">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Theme="{StaticResource TitleTextBlockStyle}"
                                               FontSize="34" />
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Classes="PageEyebrow"
                                               Margin="0 4 0 0" />
                                    <TextBlock Text="{TemplateBinding Description}"
                                               Classes="SupportingText"
                                               Margin="0 10 0 0"
                                               MaxWidth="720" />
                                </StackPanel>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderActionContent}"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right" />
                        </Grid>
                    </Panel>

                    <Border Padding="{DynamicResource SampleAppPageMargin}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>