<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:uip="using:FluentAvalonia.UI.Controls.Primitives"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:helpers="using:Horizon.Game.GengDi.Core.Helpers">

    <!-- ==== LiveCharts2 图表 Tooltip 中文字体全局设置 ==== -->
    <!-- 修复 Tooltip 提示文字显示为方框的问题：默认字体不含中文字形 -->
    <Style Selector="lvc|CartesianChart">
        <Setter Property="TooltipTextPaint" Value="{x:Static helpers:FlowerChartHelper.DefaultTooltipTextPaint}" />
        <Setter Property="TooltipBackgroundPaint" Value="{x:Static helpers:FlowerChartHelper.DefaultTooltipBackgroundPaint}" />
    </Style>
    <Style Selector="lvc|PieChart">
        <Setter Property="TooltipTextPaint" Value="{x:Static helpers:FlowerChartHelper.DefaultTooltipTextPaint}" />
        <Setter Property="TooltipBackgroundPaint" Value="{x:Static helpers:FlowerChartHelper.DefaultTooltipBackgroundPaint}" />
    </Style>

    <Style Selector="ui|NavigationView.HorizonAppNav">
        <Setter Property="IsPaneToggleButtonVisible" Value="False" />
        <Setter Property="OpenPaneLength" Value="72" />
        <Setter Property="CompactPaneLength" Value="72" />
        <Setter Property="IsPaneOpen" Value="True" />
    </Style>

    <Style Selector="ui|NavigationView.HorizonAppNav /template/ Button#NavigationViewBackButton">
        <Setter Property="Width" Value="40" />
    </Style>

    <Style Selector="ui|NavigationView.HorizonAppNav[IsBackButtonVisible=False] SplitView /template/ ContentPresenter#PART_PanePresenter">
        <Setter Property="Margin" Value="0 40 0 0" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter">
        <Setter Property="Width" Value="72" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="LayoutRoot"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Margin="4 2"
                        TemplatedControl.IsTemplateFocusTarget="True">
                    <Panel>
                        <Panel HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                            <Border Name="SelectionIndicator"
                                    Background="{DynamicResource GdPrimaryBrush}"
                                    Width="3"
                                    Opacity="0"
                                    VerticalAlignment="Center"
                                    Height="20"
                                    CornerRadius="{DynamicResource GdRadiusMd}" />
                        </Panel>

                        <DockPanel>
                            <ContentPresenter Name="ContentPresenter"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Bottom"
                                              FontSize="10"
                                              Padding="0 4"
                                              Margin="0 -15 0 3"
                                              DockPanel.Dock="Bottom"
                                              IsVisible="False">
                                <ContentPresenter.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>

                            <Viewbox Name="IconBox"
                                     Height="28"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <ContentPresenter Name="Icon"
                                                  Content="{Binding TemplateSettings.Icon, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Viewbox>
                        </DockPanel>
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:pointerover /template/ ContentPresenter#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:pointerover /template/ ContentPresenter#Icon">
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:selected /template/ ContentPresenter#ContentPresenter">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="ui|NavigationViewItem.HorizonAppNav uip|NavigationViewItemPresenter:selected /template/ ContentPresenter#Icon">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
    </Style>

    <Style Selector="Border.SurfaceCard">
        <Setter Property="Background" Value="{DynamicResource GdCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusLg}" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #00000022" />
    </Style>

    <Style Selector="Border.SurfaceCard.subtle">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
        <Setter Property="BoxShadow" Value="0 1 4 0 #00000015" />
    </Style>

    <Style Selector="Border.ListItemCard">
        <Setter Property="Background" Value="{DynamicResource GdSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BackgroundSizing" Value="InnerBorderEdge" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.ListItemCard:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <Style Selector="Border.SurfaceCard.subtle">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <Style Selector="Border.SurfaceCard.QuickAccess">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.SurfaceCard.QuickAccess:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <Style Selector="TextBlock.PageEyebrow">
        <Setter Property="Theme" Value="{StaticResource CaptionTextBlockStyle}" />
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>

    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0 0 0 12" />
    </Style>

    <Style Selector="TextBlock.SupportingText">
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Button.PrimaryAction">
        <Setter Property="Background" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBrand400Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16 10" />
    </Style>

    <Style Selector="Button.PrimaryAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdBrand400Brush}" />
    </Style>

    <Style Selector="Button.PrimaryAction:pressed">
        <Setter Property="Background" Value="{DynamicResource GdBrand600Brush}" />
    </Style>

    <Style Selector="Button.QuietAction">
        <Setter Property="Padding" Value="14 10" />
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>

    <Style Selector="Button.QuietAction:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         战网风格标题栏按钮样式
         ══════════════════════════════════════════════════════════ -->

    <!-- 品牌 Logo 按钮 -->
    <Style Selector="Button.TitleBarBrand">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.TitleBarBrand:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>

    <!-- 标题栏文本导航按钮（设计稿：图标+文字, pill圆角, active=primary+info-surface） -->
    <Style Selector="Button.TitleBarNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14 7" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.TitleBarNavItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>
    <Style Selector="Button.TitleBarNavItem:pressed">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
    </Style>
    <!-- 标题栏主导航项选中状态（设计稿：primary色 + info-surface 背景） -->
    <Style Selector="Button.TitleBarNavItem.TitleBarNavSelected">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>
    <Style Selector="Button.TitleBarNavItem.TitleBarNavSelected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <!-- 标题栏图标按钮 -->
    <Style Selector="Button.TitleBarIconButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.TitleBarIconButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
    </Style>

    <!-- 用户面板按钮 -->
    <!-- 底部边框始终占位 2px，仅在选中时改变 BorderBrush，避免布局抖动 -->
    <Style Selector="Button.TitleBarUserButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0 0 0 2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6 4" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.TitleBarUserButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>
    <Style Selector="Button.TitleBarUserButton.TitleBarNavSelected">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdPrimaryBrush}" />
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         副导航条样式（设计稿：图标+文字13px, pill圆角radius-sm, active=primary+info-surface）
         ══════════════════════════════════════════════════════════ -->
    <Style Selector="Button.SubNavItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14 8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.SubNavItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>
    <Style Selector="Button.SubNavItem.SubNavSelected">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>
    <Style Selector="Button.SubNavItem.SubNavSelected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>

    <!-- 副导航 Badge（红色圆角小数字） -->
    <Style Selector="Border.SubNavBadge">
        <Setter Property="Background" Value="{DynamicResource GdErrorBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusFull}" />
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Padding" Value="4 0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.SubNavBadge TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="controls|GalleryPage">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="Root"
                           Background="{DynamicResource GdBackgroundBrush}">
                    <Panel DockPanel.Dock="Top">
                        <Border Background="{DynamicResource GdCardBrush}"
                                OpacityMask="{DynamicResource HeaderOpacityMaskBrush}"
                                Height="88"
                                VerticalAlignment="Top" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="24 32 24 0">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="18">
                                <Border Width="104"
                                        Height="104"
                                        CornerRadius="{StaticResource HorizonLargeCornerRadius}"
                                        Background="{DynamicResource GdMutedBrush}">
                                    <Viewbox Margin="16">
                                        <ui:IconSourceElement IconSource="{TemplateBinding IconSource}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            MaxWidth="820">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Theme="{StaticResource TitleTextBlockStyle}"
                                               FontSize="34" />
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Classes="PageEyebrow"
                                               Margin="0 4 0 0" />
                                    <TextBlock Text="{TemplateBinding Description}"
                                               Classes="SupportingText"
                                               Margin="0 10 0 0"
                                               MaxWidth="720" />
                                </StackPanel>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderActionContent}"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right" />
                        </Grid>
                    </Panel>

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="{DynamicResource SampleAppPageMargin}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </ScrollViewer>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="controls|GalleryPage[IsPageScrollingEnabled=False]">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Name="Root"
                           Background="{DynamicResource GdBackgroundBrush}">
                    <Panel DockPanel.Dock="Top">
                        <Border Background="{DynamicResource GdCardBrush}"
                                OpacityMask="{DynamicResource HeaderOpacityMaskBrush}"
                                Height="88"
                                VerticalAlignment="Top" />
                        <Grid ColumnDefinitions="*,Auto"
                              Margin="24 32 24 0">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="18">
                                <Border Width="104"
                                        Height="104"
                                        CornerRadius="{StaticResource HorizonLargeCornerRadius}"
                                        Background="{DynamicResource GdMutedBrush}">
                                    <Viewbox Margin="16">
                                        <ui:IconSourceElement IconSource="{TemplateBinding IconSource}" />
                                    </Viewbox>
                                </Border>

                                <StackPanel VerticalAlignment="Bottom"
                                            MaxWidth="820">
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Theme="{StaticResource TitleTextBlockStyle}"
                                               FontSize="34" />
                                    <TextBlock Text="{TemplateBinding Subtitle}"
                                               Classes="PageEyebrow"
                                               Margin="0 4 0 0" />
                                    <TextBlock Text="{TemplateBinding Description}"
                                               Classes="SupportingText"
                                               Margin="0 10 0 0"
                                               MaxWidth="720" />
                                </StackPanel>
                            </StackPanel>

                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding HeaderActionContent}"
                                              VerticalAlignment="Bottom"
                                              HorizontalAlignment="Right" />
                        </Grid>
                    </Panel>

                    <Border Padding="{DynamicResource SampleAppPageMargin}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         花卉市场设计原型共享样式（gd-stat-card / gd-quadrant / badge / chip 等）
         ══════════════════════════════════════════════════════════ -->

    <!-- Section Header -->
    <Style Selector="StackPanel.GdSectionHeader">
        <Setter Property="Margin" Value="0 0 0 16" />
        <Setter Property="Spacing" Value="2" />
    </Style>
    <Style Selector="TextBlock.GdSectionHeaderTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.GdSectionHeaderSub">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.GdSectionHeaderFile">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource GdFontMono}" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
        <Setter Property="Margin" Value="0 2 0 0" />
    </Style>

    <!-- Stat Card -->
    <Style Selector="Border.GdStatCard">
        <Setter Property="Background" Value="{DynamicResource GdCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusLg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #00000022" />
    </Style>
    <Style Selector="TextBlock.GdStatLabel">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
    </Style>
    <Style Selector="TextBlock.GdStatValue">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontFamily" Value="{DynamicResource GdFontMono}" />
        <Setter Property="Margin" Value="0 4 0 2" />
    </Style>
    <Style Selector="TextBlock.GdStatDelta">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="{DynamicResource GdFontMono}" />
    </Style>

    <!-- Quadrant Card (工作台 2x2 象限) -->
    <Style Selector="Border.GdQuadrant">
        <Setter Property="Background" Value="{DynamicResource GdCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusLg}" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #00000022" />
    </Style>
    <Style Selector="TextBlock.GdQuadrantTitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
    </Style>

    <!-- Badge -->
    <Style Selector="Border.GdBadge">
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusSm}" />
        <Setter Property="Padding" Value="6 2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.GdBadge TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.GdBadgeSuccess">
        <Setter Property="Background" Value="{DynamicResource GdSuccessSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeSuccess TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdSuccessBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeInfo">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeInfo TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdInfoBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeWarning">
        <Setter Property="Background" Value="{DynamicResource GdWarningSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeWarning TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdWarningBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeError">
        <Setter Property="Background" Value="{DynamicResource GdErrorSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdBadgeError TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdErrorBrush}" />
    </Style>

    <!-- Chip (品种筛选标签) -->
    <Style Selector="Border.GdChip">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusFull}" />
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.GdChip TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
    </Style>
    <Style Selector="Border.GdChipActive">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdChipActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Role Tab (角色切换标签) -->
    <Style Selector="Border.GdRoleTab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusMd}" />
        <Setter Property="Padding" Value="12 6" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.GdRoleTab TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdMutedForegroundBrush}" />
    </Style>
    <Style Selector="Border.GdRoleTabActive">
        <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
    </Style>
    <Style Selector="Border.GdRoleTabActive TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Divider -->
    <Style Selector="Border.GdDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="Margin" Value="0 0 0 10" />
    </Style>

    <!-- Sensor Card (IoT 传感器卡片) -->
    <Style Selector="Border.GdSensorCard">
        <Setter Property="Background" Value="{DynamicResource GdCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GdBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusLg}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BoxShadow" Value="0 2 8 0 #00000022" />
    </Style>

    <!-- Range Bar (传感器范围条) -->
    <Style Selector="Border.GdRangeBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
    </Style>
    <Style Selector="Border.GdRangeFill">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource GdPrimaryBrush}" />
    </Style>

    <!-- Calendar Cell (农事日历单元格) -->
    <Style Selector="Border.GdCalCell">
        <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusSm}" />
        <Setter Property="Padding" Value="6 4" />
        <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="Border.GdCalCellToday">
        <Setter Property="BorderBrush" Value="{DynamicResource GdPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.GdCalDay">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdForegroundBrush}" />
    </Style>
    <Style Selector="Ellipse.GdCalDot">
        <Setter Property="Width" Value="6" />
        <Setter Property="Height" Value="6" />
    </Style>

    <!-- Star Rating -->
    <Style Selector="TextBlock.GdStar">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdWarningBrush}" />
    </Style>
    <Style Selector="TextBlock.GdStarEmpty">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource GdBorderBrush}" />
    </Style>

    <!-- Data Table -->
    <Style Selector="DataGrid.GdDataTable">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="IsReadOnly" Value="True" />
    </Style>

</Styles>