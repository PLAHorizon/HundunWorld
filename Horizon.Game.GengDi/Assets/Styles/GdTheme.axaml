    <StreamGeometry x:Key="LucideSmileGeometry">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M8 14s1.5 2 4 2 4-2 4-2 M9 9h.01 M15 9h.01</StreamGeometry>
    <StreamGeometry x:Key="LucideSendGeometry">M22 2L11 13 M22 2l-7 20-4-9-9-4 20-7z</StreamGeometry>
    <StreamGeometry x:Key="LucideUserXGeometry">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0 .01 M17 8l5 5 M22 8l-5 5</StreamGeometry>
