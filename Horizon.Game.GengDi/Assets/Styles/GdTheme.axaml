    <StreamGeometry x:Key="LucidePlayGeometry">M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z</StreamGeometry>
    <StreamGeometry x:Key="LucideFolderOpenGeometry">M6 14l1.5-2.9A2 2 0 0 1 9.24 10H20a2 2 0 0 1 1.94 2.5l-1.54 6a2 2 0 0 1-1.95 1.5H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H18a2 2 0 0 1 2 2v2</StreamGeometry>
    <StreamGeometry x:Key="LucideTrash2Geometry">M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2</StreamGeometry>
    <StreamGeometry x:Key="LucideCheckGeometry">M20 6L9 17l-5-5</StreamGeometry>
    <StreamGeometry x:Key="LucideImageGeometry">M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3 3.5-4.5 4.5 6H5z</StreamGeometry>
    <StreamGeometry x:Key="LucideRotateCcwGeometry">M1 4v6h6 M3.51 15a9 9 0 1 0 2.13-9.36L1 10</StreamGeometry>
    <StreamGeometry x:Key="LucideSaveGeometry">M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8 M7 3v5h8</StreamGeometry>
    <StreamGeometry x:Key="LucideLoaderGeometry">M12 2v4 M16.2 7.8l2.9-2.9 M18 12h4 M16.2 16.2l2.9 2.9 M12 18v4 M4.9 19.1l2.9-2.9 M2 12h4 M4.9 4.9l2.9 2.9</StreamGeometry>
    <StreamGeometry x:Key="LucideDownloadGeometry">M12 15V3 M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M7 10l5 5 5-5</StreamGeometry>

    <!-- ==== 社交区 Lucide 图标几何 ==== -->
    <StreamGeometry x:Key="LucideMessageCircleGeometry">M7.9 20A9 9 0 1 0 4 16.1L2 22z</StreamGeometry>
    <StreamGeometry x:Key="LucideUserPlusGeometry">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0 .01 M19 8v6 M22 11h-6</StreamGeometry>
    <StreamGeometry x:Key="LucideSearchGeometry">M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16z M21 21l-4.35-4.35</StreamGeometry>
