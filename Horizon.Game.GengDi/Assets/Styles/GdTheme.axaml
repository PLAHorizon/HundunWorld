<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="using:FluentAvalonia.UI.Controls">

    <!-- ================================================================
         GdTheme.axaml — 耕地专业终端风格 token 体系
         Brand Prefix: gd | 品牌蓝 #2962ff
         参照 gengdi-trading-ui-redesign HTML 原型零色值偏差
         Dark mode is the primary experience, Light mode fully supported
         ================================================================ -->

    <!-- ==== gd 品牌色阶（Blue Scale，两种模式共用） ==== -->
    <Color x:Key="GdBrand50">#FFE8F0FF</Color>
    <Color x:Key="GdBrand100">#FFC5D8FF</Color>
    <Color x:Key="GdBrand200">#FF8FB4FF</Color>
    <Color x:Key="GdBrand300">#FF5A90FF</Color>
    <Color x:Key="GdBrand400">#FF3A78FF</Color>
    <Color x:Key="GdBrand500">#FF2962FF</Color>
    <Color x:Key="GdBrand600">#FF1F4FD6</Color>
    <Color x:Key="GdBrand700">#FF1A40AD</Color>
    <Color x:Key="GdBrand800">#FF163380</Color>
    <Color x:Key="GdBrand900">#FF122659</Color>

    <!-- ==== gd 状态色（两种模式共用） ==== -->
    <Color x:Key="GdSuccess">#FF26A69A</Color>
    <Color x:Key="GdWarning">#FFFF9800</Color>
    <Color x:Key="GdError">#FFEF5350</Color>
    <Color x:Key="GdInfo">#FF2962FF</Color>
    <Color x:Key="GdUp">#FF26A69A</Color>
    <Color x:Key="GdDown">#FFEF5350</Color>

    <!-- ==== gd 状态色 Surface（两种模式共用，12% 透明度） ==== -->
    <Color x:Key="GdSuccessSurface">#1F26A69A</Color>
    <Color x:Key="GdWarningSurface">#1FFF9800</Color>
    <Color x:Key="GdErrorSurface">#1FEF5350</Color>
    <Color x:Key="GdInfoSurface">#1F2962FF</Color>

    <!-- ==== gd 圆角（两种模式共用） ==== -->
    <CornerRadius x:Key="GdRadiusSm">4</CornerRadius>
    <CornerRadius x:Key="GdRadiusMd">8</CornerRadius>
    <CornerRadius x:Key="GdRadiusLg">12</CornerRadius>
    <CornerRadius x:Key="GdRadiusFull">9999</CornerRadius>

    <!-- ==== gd 字体（两种模式共用） ==== -->
    <FontFamily x:Key="GdFontSans">Inter, Noto Sans SC, ui-sans-serif, system-ui, sans-serif</FontFamily>
    <FontFamily x:Key="GdFontMono">JetBrains Mono, Cascadia Code, ui-monospace, monospace</FontFamily>

    <!-- ==== gd 品牌色阶 Brush（两种模式共用，供按钮 hover/pressed 状态使用） ==== -->
    <SolidColorBrush x:Key="GdBrand400Brush" Color="{StaticResource GdBrand400}" />
    <SolidColorBrush x:Key="GdBrand500Brush" Color="{StaticResource GdBrand500}" />
    <SolidColorBrush x:Key="GdBrand600Brush" Color="{StaticResource GdBrand600}" />
    <SolidColorBrush x:Key="GdBrand700Brush" Color="{StaticResource GdBrand700}" />
    <SolidColorBrush x:Key="GdBrand800Brush" Color="{StaticResource GdBrand800}" />

    <!-- ==== gd 状态色 Brush（两种模式共用） ==== -->
    <SolidColorBrush x:Key="GdUpBrush" Color="{StaticResource GdUp}" />
    <SolidColorBrush x:Key="GdDownBrush" Color="{StaticResource GdDown}" />
    <SolidColorBrush x:Key="GdSuccessBrush" Color="{StaticResource GdSuccess}" />
    <SolidColorBrush x:Key="GdWarningBrush" Color="{StaticResource GdWarning}" />
    <SolidColorBrush x:Key="GdErrorBrush" Color="{StaticResource GdError}" />
    <SolidColorBrush x:Key="GdInfoBrush" Color="{StaticResource GdInfo}" />
    <SolidColorBrush x:Key="GdSuccessSurfaceBrush" Color="{StaticResource GdSuccessSurface}" />
    <SolidColorBrush x:Key="GdWarningSurfaceBrush" Color="{StaticResource GdWarningSurface}" />
    <SolidColorBrush x:Key="GdErrorSurfaceBrush" Color="{StaticResource GdErrorSurface}" />
    <SolidColorBrush x:Key="GdInfoSurfaceBrush" Color="{StaticResource GdInfoSurface}" />

    <!-- ================================================================
         ThemeDictionaries — 暗色/浅色模式各自的面板色与画刷
         品牌蓝、状态色、圆角、字体等共用资源已在上方定义
         ================================================================ -->
    <ResourceDictionary.ThemeDictionaries>

        <!-- ════════════════════════════════════════════════════════════
             Dark Mode（默认，主要体验）
             背景 #0a0e17 | 前景 #e0e6ed | 卡片 #131722
             ════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="GdBackground">#FF0A0E17</Color>
            <Color x:Key="GdForeground">#FFE0E6ED</Color>
            <Color x:Key="GdCard">#FF131722</Color>
            <Color x:Key="GdCardForeground">#FFE0E6ED</Color>
            <Color x:Key="GdPopover">#FF1A1F2E</Color>
            <Color x:Key="GdPopoverForeground">#FFE0E6ED</Color>
            <Color x:Key="GdPrimary">#FF2962FF</Color>
            <Color x:Key="GdPrimaryForeground">#FFFFFFFF</Color>
            <Color x:Key="GdSecondary">#FF2A2E39</Color>
            <Color x:Key="GdSecondaryForeground">#FFE0E6ED</Color>
            <Color x:Key="GdMuted">#FF1A1F2E</Color>
            <Color x:Key="GdMutedForeground">#FF787B86</Color>
            <Color x:Key="GdAccent">#FF1F4FD6</Color>
            <Color x:Key="GdAccentForeground">#FFFFFFFF</Color>
            <Color x:Key="GdDestructive">#FFEF5350</Color>
            <Color x:Key="GdDestructiveForeground">#FFFFFFFF</Color>
            <Color x:Key="GdBorder">#FF2A2E39</Color>
            <Color x:Key="GdInput">#FF2A2E39</Color>
            <Color x:Key="GdRing">#FF2962FF</Color>

            <!-- Dark alpha 辅助色 -->
            <Color x:Key="GdForegroundMuted">#99E0E6ED</Color>
            <Color x:Key="GdBorderSubtle">#802A2E39</Color>
            <Color x:Key="GdOverlay">#80000000</Color>

            <!-- Dark SolidColorBrush -->
            <SolidColorBrush x:Key="GdBackgroundBrush" Color="{StaticResource GdBackground}" />
            <SolidColorBrush x:Key="GdCardBrush" Color="{StaticResource GdCard}" />
            <SolidColorBrush x:Key="GdPopoverBrush" Color="{StaticResource GdPopover}" />
            <SolidColorBrush x:Key="GdForegroundBrush" Color="{StaticResource GdForeground}" />
            <SolidColorBrush x:Key="GdMutedBrush" Color="{StaticResource GdMuted}" />
            <SolidColorBrush x:Key="GdMutedForegroundBrush" Color="{StaticResource GdMutedForeground}" />
            <SolidColorBrush x:Key="GdBorderBrush" Color="{StaticResource GdBorder}" />
            <SolidColorBrush x:Key="GdPrimaryBrush" Color="{StaticResource GdPrimary}" />
            <SolidColorBrush x:Key="GdPrimaryForegroundBrush" Color="{StaticResource GdPrimaryForeground}" />
            <SolidColorBrush x:Key="GdSecondaryBrush" Color="{StaticResource GdSecondary}" />
            <SolidColorBrush x:Key="GdSecondaryForegroundBrush" Color="{StaticResource GdSecondaryForeground}" />
            <SolidColorBrush x:Key="GdForegroundMutedBrush" Color="{StaticResource GdForegroundMuted}" />
            <SolidColorBrush x:Key="GdBorderSubtleBrush" Color="{StaticResource GdBorderSubtle}" />
            <SolidColorBrush x:Key="GdOverlayBrush" Color="{StaticResource GdOverlay}" />
        </ResourceDictionary>

        <!-- ════════════════════════════════════════════════════════════
             Light Mode（浅色模式）
             背景 #f8f9fb | 前景 #1a1f2e | 卡片 #ffffff
             ════════════════════════════════════════════════════════════ -->
        <ResourceDictionary x:Key="Light">
            <Color x:Key="GdBackground">#FFF8F9FB</Color>
            <Color x:Key="GdForeground">#FF1A1F2E</Color>
            <Color x:Key="GdCard">#FFFFFFFF</Color>
            <Color x:Key="GdCardForeground">#FF1A1F2E</Color>
            <Color x:Key="GdPopover">#FFFFFFFF</Color>
            <Color x:Key="GdPopoverForeground">#FF1A1F2E</Color>
            <Color x:Key="GdPrimary">#FF2962FF</Color>
            <Color x:Key="GdPrimaryForeground">#FFFFFFFF</Color>
            <Color x:Key="GdSecondary">#FFF0F2F5</Color>
            <Color x:Key="GdSecondaryForeground">#FF1A1F2E</Color>
            <Color x:Key="GdMuted">#FFF0F2F5</Color>
            <Color x:Key="GdMutedForeground">#FF6B7280</Color>
            <Color x:Key="GdAccent">#FF1F4FD6</Color>
            <Color x:Key="GdAccentForeground">#FFFFFFFF</Color>
            <Color x:Key="GdDestructive">#FFEF5350</Color>
            <Color x:Key="GdDestructiveForeground">#FFFFFFFF</Color>
            <Color x:Key="GdBorder">#FFE0E3E8</Color>
            <Color x:Key="GdInput">#FFE0E3E8</Color>
            <Color x:Key="GdRing">#FF2962FF</Color>

            <!-- Light alpha 辅助色 -->
            <Color x:Key="GdForegroundMuted">#991A1F2E</Color>
            <Color x:Key="GdBorderSubtle">#80C5CAD3</Color>
            <Color x:Key="GdOverlay">#80000000</Color>

            <!-- Light SolidColorBrush -->
            <SolidColorBrush x:Key="GdBackgroundBrush" Color="{StaticResource GdBackground}" />
            <SolidColorBrush x:Key="GdCardBrush" Color="{StaticResource GdCard}" />
            <SolidColorBrush x:Key="GdPopoverBrush" Color="{StaticResource GdPopover}" />
            <SolidColorBrush x:Key="GdForegroundBrush" Color="{StaticResource GdForeground}" />
            <SolidColorBrush x:Key="GdMutedBrush" Color="{StaticResource GdMuted}" />
            <SolidColorBrush x:Key="GdMutedForegroundBrush" Color="{StaticResource GdMutedForeground}" />
            <SolidColorBrush x:Key="GdBorderBrush" Color="{StaticResource GdBorder}" />
            <SolidColorBrush x:Key="GdPrimaryBrush" Color="{StaticResource GdPrimary}" />
            <SolidColorBrush x:Key="GdPrimaryForegroundBrush" Color="{StaticResource GdPrimaryForeground}" />
            <SolidColorBrush x:Key="GdSecondaryBrush" Color="{StaticResource GdSecondary}" />
            <SolidColorBrush x:Key="GdSecondaryForegroundBrush" Color="{StaticResource GdSecondaryForeground}" />
            <SolidColorBrush x:Key="GdForegroundMutedBrush" Color="{StaticResource GdForegroundMuted}" />
            <SolidColorBrush x:Key="GdBorderSubtleBrush" Color="{StaticResource GdBorderSubtle}" />
            <SolidColorBrush x:Key="GdOverlayBrush" Color="{StaticResource GdOverlay}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- ================================================================
         共用非主题资源（从 Resources.axaml 迁移，确保运行时可用）
         ================================================================ -->
    <Thickness x:Key="NavigationViewContentMargin">0,0,0,0</Thickness>
    <Thickness x:Key="SampleAppPageMargin">24,24,24,0</Thickness>
    <CornerRadius x:Key="HorizonLargeCornerRadius">16</CornerRadius>

    <SolidColorBrush x:Key="LoginErrorBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="BattleNetPrimaryBrush" Color="#FF5C7A3A" />
    <SolidColorBrush x:Key="BattleNetPrimaryHoverBrush" Color="#FF6E8E4A" />
    <SolidColorBrush x:Key="BattleNetPrimaryPressedBrush" Color="#FF4A6430" />
    <SolidColorBrush x:Key="BattleNetOutlineBrush" Color="#FF4A90D9" />

    <!-- ==== 图标定义（SymbolIconSource，颜色继承父级 Foreground） ==== -->
    <ui:SymbolIconSource x:Key="HomeIcon" Symbol="Home" />
    <ui:SymbolIconSource x:Key="GamesIcon" Symbol="Games" />
    <ui:SymbolIconSource x:Key="NewsIcon" Symbol="Document" />
    <ui:SymbolIconSource x:Key="SocialIcon" Symbol="People" />
    <ui:SymbolIconSource x:Key="DownloadsIcon" Symbol="Download" />
    <ui:SymbolIconSource x:Key="NotificationsIcon" Symbol="Alert" />
    <ui:SymbolIconSource x:Key="ProfileIcon" Symbol="Contact" />
    <ui:SymbolIconSource x:Key="SettingsIcon" Symbol="Settings" />
    <ui:SymbolIconSource x:Key="SearchIcon" Symbol="Find" />
    <ui:SymbolIconSource x:Key="ThemeIcon" Symbol="DarkTheme" />
    <ui:SymbolIconSource x:Key="LightThemeIcon" Symbol="WeatherSunny" />
    <ui:SymbolIconSource x:Key="SecurityIcon" Symbol="ProtectedDocument" />
    <ui:SymbolIconSource x:Key="BrandIcon" Symbol="Globe" />
    <ui:SymbolIconSource x:Key="LoginWeatherIcon" Symbol="WeatherSunny" />
    <ui:SymbolIconSource x:Key="LoginFlowerIcon" Symbol="Favorite" />
    <ui:SymbolIconSource x:Key="LoginGameIcon" Symbol="Games" />
    <ui:SymbolIconSource x:Key="LoginUserIcon" Symbol="Contact" />
    <ui:SymbolIconSource x:Key="LoginLockIcon" Symbol="Permissions" />
    <ui:SymbolIconSource x:Key="LoginEyeOffIcon" Symbol="HideBcc" />
    <ui:SymbolIconSource x:Key="LoginArrowIcon" Symbol="Forward" />
    <ui:SymbolIconSource x:Key="MusicIcon" Symbol="Audio" />
    <ui:SymbolIconSource x:Key="MusicInfoIcon" Symbol="MusicInfo" />
    <ui:SymbolIconSource x:Key="CheckIcon" Symbol="Accept" />
    <ui:SymbolIconSource x:Key="PlayIcon" Symbol="Play" />
    <ui:SymbolIconSource x:Key="RefreshIcon" Symbol="Refresh" />
    <ui:SymbolIconSource x:Key="FlowerIcon" Symbol="Favorite" />
    <ui:SymbolIconSource x:Key="MoreIcon" Symbol="More" />
    <ui:SymbolIconSource x:Key="DashboardIcon" Symbol="Home" />
    <ui:SymbolIconSource x:Key="LibraryIcon" Symbol="Library" />
    <ui:SymbolIconSource x:Key="CompassIcon" Symbol="Map" />
    <ui:SymbolIconSource x:Key="PlaylistIcon" Symbol="MusicInfo" />
    <ui:SymbolIconSource x:Key="GaugeIcon" Symbol="ReportHacked" />
    <ui:SymbolIconSource x:Key="MarketIcon" Symbol="Shop" />
    <ui:SymbolIconSource x:Key="SproutIcon" Symbol="WeatherSunny" />
    <ui:SymbolIconSource x:Key="CartIcon" Symbol="Shop" />
    <ui:SymbolIconSource x:Key="OrderIcon" Symbol="Page" />
    <ui:SymbolIconSource x:Key="AlertIcon" Symbol="Important" />
    <ui:SymbolIconSource x:Key="AIIcon" Symbol="Star" />
    <ui:SymbolIconSource x:Key="DataScreenIcon" Symbol="PreviewLink" />
    <ui:SymbolIconSource x:Key="StoreIcon" Symbol="Shop" />
    <ui:SymbolIconSource x:Key="AddressIcon" Symbol="MapPin" />
    <ui:SymbolIconSource x:Key="BellIcon" Symbol="Alert" />
    <ui:SymbolIconSource x:Key="MoonIcon" Symbol="DarkTheme" />

    <!-- ==== 下载任务图标渐变背景（4种，对应设计稿每个任务不同渐变） ==== -->
    <LinearGradientBrush x:Key="GdDlGradient0" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource GdBrand500}" Offset="0" />
        <GradientStop Color="{StaticResource GdBrand700}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GdDlGradient1" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource GdBrand600}" Offset="0" />
        <GradientStop Color="{StaticResource GdBrand800}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GdDlGradient2" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource GdBrand400}" Offset="0" />
        <GradientStop Color="{StaticResource GdBrand600}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GdDlGradient3" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource GdBrand700}" Offset="0" />
        <GradientStop Color="{StaticResource GdBrand900}" Offset="1" />
    </LinearGradientBrush>

    <!-- ==== Lucide 图标几何数据（用于 Path 描边渲染，100%匹配设计原型图标） ==== -->
    <StreamGeometry x:Key="LucideRocketGeometry">M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5 M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09 M9 12a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z M9 12H4s.55-3.03 2-4c1.62-1.08 5 .05 5 .05</StreamGeometry>
