    <StreamGeometry x:Key="LucideBellRingGeometry">M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9 M10.3 21a1.94 1.94 0 0 0 3.4 0 M4 2C2.8 3.7 2 5.7 2 8 M22 8c0-2.3-.8-4.3-2-6</StreamGeometry>
    <StreamGeometry x:Key="LucideMegaphoneGeometry">M3 11l18-5v12L3 14v-3z M11.6 16.8a3 3 0 1 1-5.8-1.6</StreamGeometry>
    <StreamGeometry x:Key="LucideTrendingUpGeometry">M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6</StreamGeometry>
    <StreamGeometry x:Key="LucideAlertTriangleGeometry">M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01</StreamGeometry>
    <StreamGeometry x:Key="LucideGiftGeometry">M20 12v10H4V12 M2 7h20v5H2z M12 22V7 M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z</StreamGeometry>
