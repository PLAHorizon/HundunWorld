    <ui:SymbolIconSource x:Key="MusicIcon" Symbol="Audio" />
    <ui:SymbolIconSource x:Key="MusicInfoIcon" Symbol="MusicInfo" />
    <ui:SymbolIconSource x:Key="CheckIcon" Symbol="Accept" />
    <ui:SymbolIconSource x:Key="PlayIcon" Symbol="Play" />
    <ui:SymbolIconSource x:Key="RefreshIcon" Symbol="Refresh" />
    <!-- 导航图标（设计稿 lucide → FluentAvalonia Symbol 映射） -->
    <ui:SymbolIconSource x:Key="FlowerIcon" Symbol="Favorite" />
    <ui:SymbolIconSource x:Key="MoreIcon" Symbol="More" />
    <ui:SymbolIconSource x:Key="DashboardIcon" Symbol="Home" />
