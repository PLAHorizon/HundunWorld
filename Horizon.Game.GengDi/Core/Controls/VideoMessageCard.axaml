<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             mc:Ignorable="d"
             x:Class="Horizon.Game.GengDi.Core.Controls.VideoMessageCard"
             x:DataType="vm:ChatMessageItemViewModel"
             d:DesignWidth="520"
             d:DesignHeight="320">
    <Border x:Name="InteractiveRoot"
            CornerRadius="14"
            MinWidth="380"
            Background="Transparent">
        <!-- MinWidth=380 ensures video controls and action buttons remain comfortably operable -->
        <Grid RowDefinitions="280,Auto"
              Background="#08121C">
            <Grid Grid.Row="0">
                <Border Background="#08121C"
                        IsVisible="{Binding IsPreviewVisible}">
                    <Grid>
                        <Image Source="{Binding PreviewImage}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding HasPreviewImage}" />
                        <Border Background="#48000000" />
                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="{Binding CardKindLabel}"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding CardHint}"
                                       Classes="SupportingText"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Background="#02050A"
                        IsVisible="{Binding IsInlinePlayerOpen}">
                    <ContentControl x:Name="PlaybackHost"
                                    Width="380"
                                    Height="214" />
                </Border>

                <Border Background="Transparent"
                    PointerEntered="InteractiveRoot_PointerEntered"
                    PointerExited="InteractiveRoot_PointerExited" />
            </Grid>

            <Border Grid.Row="1"
                    Padding="14"
                    Background="#0C1521">
                <StackPanel Spacing="6">
                    <TextBlock Text="{Binding CardProviderLabel}"
                               Classes="PageEyebrow" />
                    <TextBlock Text="{Binding PreviewTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PreviewSubtitle}"
                               Classes="SupportingText"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasPreviewSubtitle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>