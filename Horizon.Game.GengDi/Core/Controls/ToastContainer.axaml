<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             x:Class="Horizon.Game.GengDi.Core.Controls.ToastContainer"
             x:DataType="controls:ToastContainer">

    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0 60 24 0"
                  MaxWidth="420">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="controls:ToastMessage">
                <Border x:Name="ToastBorder"
                        MinWidth="240"
                        MinHeight="24"
                        Background="{Binding Type, Converter={StaticResource ToastBgConverter}}"
                        BorderBrush="{Binding Type, Converter={StaticResource ToastBorderConverter}}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14 10"
                        BoxShadow="0 4 16 0 #33000000"
                        Opacity="0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Type, Converter={StaticResource ToastIconConverter}}"
                                   FontSize="16" Margin="0 0 10 0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Type, Converter={StaticResource ToastFgConverter}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Content}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Type, Converter={StaticResource ToastFgConverter}}"
                                   MaxLines="3" />
                        <Button Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Padding="6 2"
                                Margin="8 0 0 0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#99FFFFFF"
                                Click="OnCloseClick" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
