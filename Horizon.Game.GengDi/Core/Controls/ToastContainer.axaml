<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             x:Class="Horizon.Game.GengDi.Core.Controls.ToastContainer"
             x:DataType="controls:ToastContainer">

    <ItemsControl ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0 60 24 0"
                  Width="360">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="controls:ToastMessage">
                <Border x:Name="ToastBorder"
                        Background="{DynamicResource GdCardBrush}"
                        BorderBrush="{DynamicResource GdBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource GdRadiusMd}"
                        Padding="12 16"
                        BoxShadow="0 4 16 0 #33000000"
                        Opacity="0">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>
                    <!-- 设计稿：左边框3px强调色 + 图标 + 内容 + 关闭 -->
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="3" VerticalAlignment="Stretch"
                                CornerRadius="2" Margin="0 0 10 0"
                                Background="{Binding Type, Converter={StaticResource ToastFgConverter}}" />
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Type, Converter={StaticResource ToastIconConverter}}"
                                       FontSize="16" Margin="0 0 10 0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Content}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GdForegroundBrush}"
                                       MaxLines="3" />
                        </Grid>
                        <Button Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Padding="4 2"
                                Margin="8 0 0 0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource GdRadiusSm}"
                                Foreground="{DynamicResource GdMutedForegroundBrush}"
                                Click="OnCloseClick" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
