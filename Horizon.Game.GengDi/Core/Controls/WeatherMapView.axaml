<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Horizon.Game.GengDi.Core.Controls.WeatherMapView">
    <Grid>
        <ContentControl x:Name="MapHost" />
        <Border x:Name="FallbackHost" IsVisible="False"
                Background="{DynamicResource GdBorderSubtleBrush}" CornerRadius="10"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                <TextBlock x:Name="FallbackCityText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="FallbackCoordText" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="🗺️ 地图不可用" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
