<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:model="using:Horizon.Game.GengDi.Models"
             xmlns:prim="using:Avalonia.Controls.Primitives"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="800"
             x:Class="Horizon.Game.GengDi.Core.Views.GamesView"
             x:DataType="vm:GamesViewModel"
             x:Name="gamesRoot">
    <UserControl.DataContext>
        <vm:GamesViewModel />
    </UserControl.DataContext>

    <controls:GalleryPage Title="游戏库"
                          Subtitle="Horizon.Game.GengDi.Games"
                          Description="已安装游戏与全部游戏的网格展示，含安装状态标签与启动/安装操作。"
                          IconSource="{StaticResource GamesIcon}">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="18">

            <!-- ═══ 筛选 chips 行（对应 HTML 原型 gd-pill 筛选区） ═══ -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,Auto,Auto,*,Auto"
                  ColumnSpacing="8">
                <Button Grid.Column="0"
                        Classes="GdPill GdPillActive"
                        Content="全部" />
                <Button Grid.Column="1"
                        Classes="GdPill"
                        Content="已安装" />
                <Button Grid.Column="2"
                        Classes="GdPill"
                        Content="未安装" />

                <!-- 搜索框 -->
                <Border Grid.Column="4"
                        Background="{DynamicResource GdMutedBrush}"
                        BorderBrush="{DynamicResource GdBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource GdRadiusMd}"
                        Padding="10 0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <ui:IconSourceElement IconSource="{StaticResource SearchIcon}"
                                              Width="15"
                                              Height="15"
                                              Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        <TextBox Background="Transparent"
                                 BorderThickness="0"
                                 Watermark="搜索游戏..."
                                 MinWidth="200"
                                 Padding="0 7" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 游戏网格 4 列（对应 HTML 原型 game-card 网格） ═══ -->
            <Grid Grid.Row="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AllGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="4"
                                                  RowSpacing="16"
                                                  ColumnSpacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:GameInfo">
                                <Border Classes="GdGameCard">
                                    <Grid RowDefinitions="140,Auto">
                                        <!-- 游戏封面区 -->
                                        <Border Grid.Row="0"
                                                Classes="GdGameCover"
                                                ClipToBounds="True">
                                            <Panel>
                                                <!-- 封面图（有图时显示） -->
                                                <Image Source="{Binding CoverImage}"
                                                       Stretch="UniformToFill"
                                                       IsVisible="{Binding CoverImage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                <!-- 无封面时渐变占位 -->
                                                <Border IsVisible="{Binding CoverImage, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Offset="0" Color="{DynamicResource GdBrand600}" />
                                                            <GradientStop Offset="1" Color="{DynamicResource GdBrand800}" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <ui:IconSourceElement IconSource="{StaticResource GamesIcon}"
                                                                          Width="48"
                                                                          Height="48"
                                                                          Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                                                          Opacity="0.9"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center" />
                                                </Border>
                                                <!-- 状态 badge（已安装） -->
                                                <Border Classes="GdBadge GdSuccess"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="10"
                                                        IsVisible="{Binding IsInstalled}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <ui:IconSourceElement IconSource="{StaticResource CheckIcon}"
                                                                              Width="11"
                                                                              Height="11"
                                                                              Foreground="{DynamicResource GdSuccessBrush}" />
                                                        <TextBlock Text="已安装" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 状态 badge（未安装） -->
                                                <Border Classes="GdBadge GdInfo"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Margin="10"
                                                        IsVisible="{Binding !IsInstalled}">
                                                    <TextBlock Text="未安装" />
                                                </Border>
                                            </Panel>
                                        </Border>

                                        <!-- 卡片内容区 -->
                                        <StackPanel Grid.Row="1"
                                                    Spacing="8"
                                                    Margin="14">
                                            <!-- 游戏名 -->
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GdForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- 开发商 -->
                                            <TextBlock Text="{Binding Developer, StringFormat='开发商：{0}'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- 版本 / 在线人数（已安装） -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        IsVisible="{Binding IsInstalled}">
                                                <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                                           Classes="GdNum"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding OnlinePlayerCountText, StringFormat='在线 {0}'}"
                                                           Classes="GdNum"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                            <!-- 累计游玩（未安装） -->
                                            <TextBlock Text="{Binding TotalPlayCountText, StringFormat='累计 {0}'}"
                                                       Classes="GdNum"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                       IsVisible="{Binding !IsInstalled}" />

                                            <!-- 操作按钮区 -->
                                            <StackPanel Margin="0 8 0 0">
                                                <!-- 已安装：启动按钮 -->
                                                <Button Classes="GdPrimary"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        IsEnabled="{Binding CanStart}"
                                                        IsVisible="{Binding IsInstalled}"
                                                        Command="{Binding $parent[UserControl].DataContext.StartGameCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ui:IconSourceElement IconSource="{StaticResource PlayIcon}"
                                                                              Width="14"
                                                                              Height="14" />
                                                        <TextBlock Text="启动" />
                                                    </StackPanel>
                                                </Button>
                                                <!-- 未安装：安装按钮 -->
                                                <Button Classes="GdGhost"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource GdBorderBrush}"
                                                        IsEnabled="{Binding CanInstall}"
                                                        IsVisible="{Binding !IsInstalled}"
                                                        Command="{Binding $parent[UserControl].DataContext.InstallGameCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <ui:IconSourceElement IconSource="{StaticResource DownloadsIcon}"
                                                                              Width="14"
                                                                              Height="14" />
                                                        <TextBlock Text="安装" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 加载遮罩 -->
                <Border Grid.Row="1"
                        Background="{DynamicResource GdOverlayBrush}"
                        IsVisible="{Binding IsLoading}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8">
                        <ProgressBar IsIndeterminate="True"
                                     Width="220" />
                        <TextBlock Text="{Binding LoadingMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </controls:GalleryPage>
</UserControl>
