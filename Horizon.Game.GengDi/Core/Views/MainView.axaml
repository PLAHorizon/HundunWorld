<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:uiw="using:FluentAvalonia.UI.Windowing"
             xmlns:views="using:Horizon.Game.GengDi.Core.Views"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="800"
             x:Class="Horizon.Game.GengDi.Core.Views.MainView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ══════════════════════════════════════════════════════════════
             设计稿顶栏（56px）：品牌 Logo + 水平主导航 + 右侧工具区
             ══════════════════════════════════════════════════════════════ -->
        <Border Name="TitleBarHost"
                Background="{DynamicResource GdCardBrush}"
                BorderBrush="{DynamicResource GdBorderBrush}"
                BorderThickness="0 0 0 1">
            <Grid ColumnDefinitions="Auto,*,Auto" Height="56">
                <!-- 左：品牌 Logo + 主导航项 -->
                <StackPanel Name="TitleBarNavPanel"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="20 0 0 0"
                            VerticalAlignment="Center">
                    <!-- Logo: 32x32 渐变圆角方块 + "耕地"文字 -->
                    <Button Classes="TitleBarBrand"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            ToolTip.Tip="耕地"
                            Command="{Binding NavigateToHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="32" Height="32" CornerRadius="{DynamicResource GdRadiusMd}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="{DynamicResource GdBrand500}" Offset="0" />
                                        <GradientStop Color="{DynamicResource GdBrand700}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ui:IconSourceElement IconSource="{StaticResource SproutIcon}"
                                                      Width="18" Height="18"
                                                      Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                            </Border>
                            <TextBlock Text="耕地" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GdForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24" Margin="16 0"
                            Background="{DynamicResource GdBorderBrush}" />

                    <!-- 主导航项（图标+文字） -->
                    <Button Classes="TitleBarNavItem"
                            Tag="Games"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding NavigateToGamesCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:IconSourceElement IconSource="{StaticResource GamesIcon}" Width="16" Height="16" />
                            <TextBlock Text="游戏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="TitleBarNavItem"
                            Tag="News"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding NavigateToNewsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:IconSourceElement IconSource="{StaticResource NewsIcon}" Width="16" Height="16" />
                            <TextBlock Text="新闻" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="TitleBarNavItem"
                            Tag="FlowerShop"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding NavigateToFlowerShopCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:IconSourceElement IconSource="{StaticResource FlowerIcon}" Width="16" Height="16" />
                            <TextBlock Text="花卉市场" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="TitleBarNavItem"
                            Tag="Music"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding NavigateToMusicDiscoverCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:IconSourceElement IconSource="{StaticResource MusicIcon}" Width="16" Height="16" />
                            <TextBlock Text="音乐" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 更多菜单 -->
                    <Button Classes="TitleBarNavItem"
                            uiw:AppWindow.AllowInteractionInTitleBar="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:IconSourceElement IconSource="{StaticResource MoreIcon}" Width="16" Height="16" />
                            <TextBlock Text="更多" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <ui:FAMenuFlyout Placement="BottomEdgeAlignedLeft">
                                <ui:MenuFlyoutItem Text="主页" IconSource="{StaticResource HomeIcon}"
                                                   Command="{Binding NavigateToHomeCommand}" />
                                <ui:MenuFlyoutItem Text="花卉市场" IconSource="{StaticResource FlowerIcon}"
                                                   Command="{Binding NavigateToFlowerShopCommand}" />
                                <ui:MenuFlyoutItem Text="购物车" IconSource="{StaticResource CartIcon}"
                                                   Command="{Binding NavigateToFlowerCartCommand}" />
                                <ui:MenuFlyoutItem Text="订单" IconSource="{StaticResource OrderIcon}"
                                                   Command="{Binding NavigateToFlowerOrderCenterCommand}" />
                                <ui:MenuFlyoutItem Text="商家管理" IconSource="{StaticResource StoreIcon}"
                                                   Command="{Binding NavigateToFlowerMerchantCommand}" />
                                <ui:MenuFlyoutItem Text="Excel 工具" IconSource="{StaticResource SettingsIcon}"
                                                   Command="{Binding NavigateToExcelProcessorCommand}" />
                                <ui:MenuFlyoutItem Text="个人设置" IconSource="{StaticResource ProfileIcon}"
                                                   Command="{Binding NavigateToProfileCommand}" />
                                <ui:MenuFlyoutItem Text="安全设置" IconSource="{StaticResource SecurityIcon}"
                                                   Command="{Binding NavigateToSecurityCommand}" />
                                <ui:MenuFlyoutItem Text="应用设置" IconSource="{StaticResource SettingsIcon}"
                                                   Command="{Binding NavigateToSettingsCommand}" />
                                <ui:MenuFlyoutSeparator />
                                <ui:MenuFlyoutItem Text="退出登录"
                                                   Command="{Binding LogoutCommand}" />
                            </ui:FAMenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 右：工具按钮 + 用户胶囊 + 窗口按钮预留区 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0 0 6 0"
                            VerticalAlignment="Center">
                    <!-- 通知（带红点） -->
                    <Button Classes="TitleBarIconButton"
                            ToolTip.Tip="通知"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding NavigateToNotificationCommand}">
                        <Grid>
                            <ui:IconSourceElement IconSource="{StaticResource BellIcon}" Width="18" Height="18" />
                            <Border Width="8" Height="8" CornerRadius="4"
                                    Background="{DynamicResource GdErrorBrush}"
                                    BorderBrush="{DynamicResource GdCardBrush}"
                                    BorderThickness="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top" />
                        </Grid>
                    </Button>

                    <!-- 主题切换 -->
                    <Button Classes="TitleBarIconButton"
                            ToolTip.Tip="主题切换"
                            uiw:AppWindow.AllowInteractionInTitleBar="True"
                            Command="{Binding SetDarkThemeCommand}">
                        <ui:IconSourceElement IconSource="{StaticResource MoonIcon}" Width="18" Height="18" />
                    </Button>

                    <Border Width="1" Height="24" Margin="4 0"
                            Background="{DynamicResource GdBorderBrush}" />

                    <!-- 用户胶囊（设计稿：26px头像+名字+ID, muted背景, radius-full） -->
                    <Button Name="UserButton"
                            Classes="TitleBarUserButton"
                            uiw:AppWindow.AllowInteractionInTitleBar="True">
                        <Button.Flyout>
                            <ui:FAMenuFlyout Placement="BottomEdgeAlignedRight">
                                <ui:MenuFlyoutItem Text="社交" IconSource="{StaticResource SocialIcon}"
                                                   Command="{Binding NavigateToSocialCommand}" />
                                <ui:MenuFlyoutItem Text="用户设置" IconSource="{StaticResource ProfileIcon}"
                                                   Command="{Binding NavigateToProfileCommand}" />
                                <ui:MenuFlyoutItem Text="修改密码" IconSource="{StaticResource SecurityIcon}"
                                                   Command="{Binding NavigateToSecurityCommand}" />
                                <ui:MenuFlyoutSeparator />
                                <ui:MenuFlyoutItem Text="主题：跟随系统"
                                                   Command="{Binding SetSystemThemeCommand}" />
                                <ui:MenuFlyoutItem Text="主题：浅色"
                                                   Command="{Binding SetLightThemeCommand}" />
                                <ui:MenuFlyoutItem Text="主题：深色"
                                                   Command="{Binding SetDarkThemeCommand}" />
                                <ui:MenuFlyoutSeparator />
                                <ui:MenuFlyoutItem Text="退出登录"
                                                   Command="{Binding LogoutCommand}" />
                            </ui:FAMenuFlyout>
                        </Button.Flyout>
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusFull}"
                                Padding="5 5 12 5">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Grid Width="26" Height="26">
                                    <Border CornerRadius="13"
                                            ClipToBounds="True"
                                            Background="{DynamicResource GdPrimaryBrush}">
                                        <Panel>
                                            <TextBlock Text="{Binding UserAvatarInitial}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                                       IsVisible="{Binding !UserHasAvatarBitmap}" />
                                            <Image Source="{Binding UserAvatarBitmap}"
                                                   Stretch="UniformToFill"
                                                   IsVisible="{Binding UserHasAvatarBitmap}" />
                                        </Panel>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center" Spacing="0">
                                    <TextBlock Text="{Binding UserDisplayName}"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}" />
                                    <TextBlock Text="{Binding UserPassportId}"
                                               FontSize="10"
                                               FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- 窗口控制按钮预留空间 -->
                    <Border Name="TitleBarRightInset" Width="0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════
             设计稿副导航（44px）：图标+文字, pill圆角, badge, 分隔线
             ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource GdCardBrush}"
                    BorderBrush="{DynamicResource GdBorderBrush}"
                    BorderThickness="0 0 0 1"
                    Height="44">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              VerticalAlignment="Center">
                    <StackPanel Name="SubNavBar"
                                Orientation="Horizontal"
                                Spacing="2"
                                Margin="20 0"
                                VerticalAlignment="Center">
                        <Button Classes="SubNavItem SubNavSelected" Tag="Home" Command="{Binding NavigateToHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource DashboardIcon}" Width="14" Height="14" />
                                <TextBlock Text="总览" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="Games" Command="{Binding NavigateToGamesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource LibraryIcon}" Width="14" Height="14" />
                                <TextBlock Text="全部游戏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="Downloads" Command="{Binding NavigateToDownloadsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource DownloadsIcon}" Width="14" Height="14" />
                                <TextBlock Text="下载" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="Settings" Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource SettingsIcon}" Width="14" Height="14" />
                                <TextBlock Text="设置" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="16" Margin="4 0" Background="{DynamicResource GdBorderBrush}" />
                        <Button Classes="SubNavItem" Tag="MusicDiscover" Command="{Binding NavigateToMusicDiscoverCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource CompassIcon}" Width="14" Height="14" />
                                <TextBlock Text="发现" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="PlaylistManage" Command="{Binding NavigateToPlaylistManageCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource PlaylistIcon}" Width="14" Height="14" />
                                <TextBlock Text="歌单" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="MusicSearch" Command="{Binding NavigateToMusicSearchCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource SearchIcon}" Width="14" Height="14" />
                                <TextBlock Text="搜索" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="16" Margin="4 0" Background="{DynamicResource GdBorderBrush}" />
                        <Button Classes="SubNavItem" Tag="FlowerDashboard" Command="{Binding NavigateToFlowerDashboardCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource GaugeIcon}" Width="14" Height="14" />
                                <TextBlock Text="行情仪表盘" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerShop" Command="{Binding NavigateToFlowerShopCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource MarketIcon}" Width="14" Height="14" />
                                <TextBlock Text="市场" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerPlantingAdvice" Command="{Binding NavigateToFlowerPlantingAdviceCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource SproutIcon}" Width="14" Height="14" />
                                <TextBlock Text="种植建议" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerCart" Command="{Binding NavigateToFlowerCartCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource CartIcon}" Width="14" Height="14" />
                                <TextBlock Text="购物车" VerticalAlignment="Center" />
                                <Border Classes="SubNavBadge"><TextBlock Text="3" /></Border>
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerOrderCenter" Command="{Binding NavigateToFlowerOrderCenterCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource OrderIcon}" Width="14" Height="14" />
                                <TextBlock Text="订单" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerAlertCenter" Command="{Binding NavigateToFlowerAlertCenterCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource AlertIcon}" Width="14" Height="14" />
                                <TextBlock Text="预警" VerticalAlignment="Center" />
                                <Border Classes="SubNavBadge"><TextBlock Text="5" /></Border>
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerAIAssistant" Command="{Binding NavigateToFlowerAIAssistantCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource AIIcon}" Width="14" Height="14" />
                                <TextBlock Text="AI助手" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerDataScreen" Command="{Binding NavigateToFlowerDataScreenCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource DataScreenIcon}" Width="14" Height="14" />
                                <TextBlock Text="数据大屏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="16" Margin="4 0" Background="{DynamicResource GdBorderBrush}" />
                        <Button Classes="SubNavItem" Tag="FlowerMerchant" Command="{Binding NavigateToFlowerMerchantCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource StoreIcon}" Width="14" Height="14" />
                                <TextBlock Text="商家" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerAddress" Command="{Binding NavigateToFlowerAddressCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource AddressIcon}" Width="14" Height="14" />
                                <TextBlock Text="收货地址" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="SubNavItem" Tag="FlowerProfile" Command="{Binding NavigateToFlowerProfileCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:IconSourceElement IconSource="{StaticResource ProfileIcon}" Width="14" Height="14" />
                                <TextBlock Text="个人中心" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 主内容 -->
            <TransitioningContentControl Grid.Row="1"
                                          x:Name="ContentFrame"
                                          Content="{Binding CurrentView}">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>

        <Panel Name="OverlayHost" Grid.Row="1" />

        <views:MiniPlayerView x:Name="MiniPlayer" Grid.Row="2" />

        <Panel Grid.RowSpan="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding Source={x:Static vm:MusicStoryViewModel.Instance}, Path=IsOpen}">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="StoryOverlay_Tapped" />
            <views:MusicStoryDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:MusicStoryDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:MusicStoryDrawerView.Transitions>
            </views:MusicStoryDrawerView>
        </Panel>

        <controls:ToastContainer Grid.RowSpan="3"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  IsHitTestVisible="True"
                                  ZIndex="9999" />
    </Grid>
</UserControl>
