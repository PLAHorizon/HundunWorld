<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.ProfileView"
             x:DataType="vm:ProfileViewModel">
    <UserControl.DataContext>
        <vm:ProfileViewModel />
    </UserControl.DataContext>

    <controls:GalleryPage Title="资料"
                          Subtitle="Horizon.Game.GengDi.Profile"
                          Description="资料表单卡，含头像、昵称、签名、性别、生日、地区与邮箱。"
                          IconSource="{StaticResource ProfileIcon}">

        <controls:GalleryPage.HeaderActionContent>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="安全设置" Classes="GdGhost" Command="{Binding NavigateToSecurityCommand}" />
                <Button Content="退出登录" Classes="GdGhost" Command="{Binding LogoutCommand}" />
            </StackPanel>
        </controls:GalleryPage.HeaderActionContent>

        <!-- 资料表单卡容器（max-width 760，对应 HTML 原型 metric-card） -->
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Stretch">

            <Border Classes="GdMetricCard" Padding="24">
                <StackPanel Spacing="20">

                    <!-- ═══ 头像区（水平）：80x80 渐变头像 + 在线状态点 + 右侧标题/按钮/提示 ═══ -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <Grid Grid.Column="0" Width="80" Height="80">
                            <Border Width="80"
                                    Height="80"
                                    CornerRadius="40"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Offset="0" Color="{StaticResource GdBrand500}" />
                                        <GradientStop Offset="1" Color="{StaticResource GdBrand700}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Panel>
                                    <Image x:Name="AvatarPreviewImage"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding AvatarIsLoaded}" />
                                    <TextBlock Text="{Binding NickNameInitial}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="30"
                                               FontWeight="SemiBold"
                                               Foreground="White"
                                               IsVisible="{Binding !AvatarIsLoaded}" />
                                </Panel>
                            </Border>
                            <Ellipse Width="14"
                                     Height="14"
                                     Fill="{DynamicResource GdSuccessBrush}"
                                     Stroke="{DynamicResource GdCardBrush}"
                                     StrokeThickness="2"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="0,0,2,2" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="头像"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GdForegroundBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="GdPrimary"
                                        Command="{Binding PickAvatarCommand}"
                                        FontSize="12"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="GdLucideIcon"
                                              Width="13"
                                              Height="13"
                                              Data="{StaticResource LucideImageGeometry}" />
                                        <TextBlock Text="更换图片" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="GdGhost"
                                        Command="{Binding RemoveAvatarCommand}"
                                        FontSize="12"
                                        Padding="12,6">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="GdLucideIcon"
                                              Width="13"
                                              Height="13"
                                              Data="{StaticResource LucideTrash2Geometry}" />
                                        <TextBlock Text="移除" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="支持 JPG、PNG、WEBP 格式，文件不超过 2MB，建议尺寸 240×240"
                                       FontSize="11"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 分隔线 -->
                    <Border Height="1"
                            Background="{DynamicResource GdBorderBrush}" />

                    <!-- ═══ 表单字段（2列网格，5行，gap 18） ═══ -->
                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnSpacing="18"
                          RowSpacing="18">

                        <!-- Row 0: 昵称 | 通行证号 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Text="昵称"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding NickName}"
                                     Watermark="请输入昵称"
                                     MaxLength="32"
                                     Classes="GdInput" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Text="通行证号"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding PassportId}"
                                     IsReadOnly="True"
                                     Watermark="—"
                                     Classes="GdInput"
                                     Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>

                        <!-- Row 1: 个性签名（跨2列） -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                            <TextBlock Text="个性签名"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding Bio}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     Watermark="请输入个性签名（选填）"
                                     MaxLength="200"
                                     Classes="GdInput" />
                        </StackPanel>

                        <!-- Row 2: 性别 | 生日 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                            <TextBlock Text="性别"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                                <RadioButton Content="男"
                                             GroupName="Gender"
                                             IsChecked="{Binding IsMale}" />
                                <RadioButton Content="女"
                                             GroupName="Gender"
                                             IsChecked="{Binding IsFemale}" />
                                <RadioButton Content="保密"
                                             GroupName="Gender"
                                             IsChecked="{Binding IsSecret}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                            <TextBlock Text="生日"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <CalendarDatePicker SelectedDate="{Binding Birthday}"
                                                HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- Row 3: 所在地区 | 邮箱 -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6">
                            <TextBlock Text="所在地区"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding ProvinceOptions}"
                                          SelectedItem="{Binding Province}"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding CityOptions}"
                                          SelectedItem="{Binding City}"
                                          HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                            <TextBlock Text="邮箱"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding Email}"
                                     Watermark="请输入邮箱"
                                     MaxLength="100"
                                     Classes="GdInput" />
                        </StackPanel>

                        <!-- Row 4: 手机号（含已验证 badge） -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6">
                            <TextBlock Text="手机号"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding Phone}"
                                         Watermark="请输入手机号"
                                         MaxLength="20"
                                         Classes="GdInput" />
                                <Border Grid.Column="1" Classes="GdBadge GdSuccess">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Path Classes="GdLucideIcon"
                                              Width="11"
                                              Height="11"
                                              Data="{StaticResource LucideCheckGeometry}" />
                                        <TextBlock Text="已验证" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 状态消息 -->
                    <TextBlock Text="{Binding BasicInfoMessage}"
                               Foreground="{Binding BasicInfoMessageBrush}"
                               TextWrapping="Wrap" />

                    <!-- 底部分隔线 -->
                    <Border Height="1"
                            Background="{DynamicResource GdBorderBrush}" />

                    <!-- 底部按钮行（右对齐：重置 + 保存资料） -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Classes="GdGhost"
                                Command="{Binding ResetCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="GdLucideIcon"
                                      Width="14"
                                      Height="14"
                                      Data="{StaticResource LucideRotateCcwGeometry}" />
                                <TextBlock Text="重置" />
                            </StackPanel>
                        </Button>
                        <Button Classes="GdPrimary"
                                Command="{Binding UpdateBasicInfoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="GdLucideIcon"
                                      Width="14"
                                      Height="14"
                                      Data="{StaticResource LucideSaveGeometry}" />
                                <TextBlock Text="保存资料" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:GalleryPage>
</UserControl>
