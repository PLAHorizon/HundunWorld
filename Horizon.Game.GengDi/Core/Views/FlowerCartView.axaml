<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:svc="using:Horizon.Game.GengDi.Core.Services"
             xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerCartView"
             x:DataType="vm:FlowerCartViewModel">

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Background="{DynamicResource SystemChromeLowColor}">
            <StackPanel Margin="24" Spacing="16" MaxWidth="900">
                <TextBlock Text="🛒 购物车" FontSize="24" FontWeight="Bold" Foreground="White"/>

                <Panel IsVisible="{Binding IsLoading}">
                    <ProgressBar IsIndeterminate="True"/>
                </Panel>

                <Panel IsVisible="{Binding IsEmpty}">
                    <StackPanel HorizontalAlignment="Center" Spacing="12" Margin="0,60,0,0">
                        <TextBlock Text="🛒" FontSize="48" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="购物车是空的" FontSize="16" Foreground="#888888" HorizontalAlignment="Center"/>
                        <TextBlock Text="去花卉商城逛逛吧" FontSize="13" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Panel>

                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding !IsEmpty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:CartItem">
                            <Border Background="#1E1E2E" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4" Grid.Column="0">
                                        <TextBlock Text="{Binding ProductName}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding MerchantName}" FontSize="12" Foreground="#888888"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                            <TextBlock Text="¥" FontSize="14" Foreground="#FF6B6B" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Price}" FontSize="14" Foreground="#FF6B6B" FontWeight="Bold"/>
                                            <TextBlock Text="×" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Quantity}" FontSize="13" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                                            <TextBlock Text="库存:" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Stock}" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Width="28" Height="28" CornerRadius="14"
                                                Command="{Binding $parent[ItemsControl].((vm:FlowerCartViewModel)DataContext).DecreaseQuantityCommand}"
                                                CommandParameter="{Binding ProductId}">
                                            <ui:SymbolIcon Symbol="Remove" FontSize="14"/>
                                        </Button>
                                        <Button Width="28" Height="28" CornerRadius="14"
                                                Command="{Binding $parent[ItemsControl].((vm:FlowerCartViewModel)DataContext).IncreaseQuantityCommand}"
                                                CommandParameter="{Binding ProductId}">
                                            <ui:SymbolIcon Symbol="Add" FontSize="14"/>
                                        </Button>
                                        <Button Width="28" Height="28" CornerRadius="14"
                                                Command="{Binding $parent[ItemsControl].((vm:FlowerCartViewModel)DataContext).RemoveItemCommand}"
                                                CommandParameter="{Binding ProductId}">
                                            <ui:SymbolIcon Symbol="Delete" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部结算栏 -->
        <Border Grid.Row="1" Background="#1E1E2E" Padding="24 16" IsVisible="{Binding !IsEmpty}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="商品合计:" FontSize="14" Foreground="#AAAAAA" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ProductTotalDisplay}" FontSize="16" Foreground="#FF6B6B" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0}件'}" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="清空" Classes="QuietAction" CornerRadius="8" Padding="16 8" FontSize="12"
                            Command="{Binding ClearCartCommand}"/>
                    <Button Content="去结算" Classes="PrimaryAction" CornerRadius="8" Padding="24 8" FontSize="14" FontWeight="SemiBold"
                            Command="{Binding ShowSettlementCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 结算面板（覆盖层） -->
        <Border Grid.RowSpan="2" Background="#CC000000" IsVisible="{Binding ShowSettlement}" ZIndex="100">
            <Border Background="#1E1E2E" CornerRadius="16 16 0 0" VerticalAlignment="Bottom" MaxHeight="600" Padding="24 20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="确认订单" FontSize="18" FontWeight="Bold" Foreground="White" />
                        <Button Grid.Column="1" Content="✕" FontSize="18" Background="Transparent" Foreground="#888888"
                                Command="{Binding HideSettlementCommand}" />
                    </Grid>

                    <!-- 收货地址 -->
                    <Border Background="#252535" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📍 收货地址" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <ComboBox ItemsSource="{Binding Addresses}" SelectedItem="{Binding SelectedAddress}"
                                      IsVisible="{Binding HasAddresses}" PlaceholderText="选择收货地址" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ShipTo}" FontSize="13" />
                                            <TextBlock Text="{Binding Phone}" FontSize="12" Foreground="#888888" />
                                            <TextBlock Text="{Binding FullAddress}" FontSize="12" Foreground="#AAAAAA" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="请先添加收货地址" FontSize="12" Foreground="#FF6B6B"
                                       IsVisible="{Binding !HasAddresses}" />
                        </StackPanel>
                    </Border>

                    <!-- 优惠券 -->
                    <Border Background="#252535" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎫 优惠券" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <ComboBox ItemsSource="{Binding AvailableCoupons}" SelectedItem="{Binding SelectedCoupon}"
                                      IsVisible="{Binding HasCoupons}" PlaceholderText="选择优惠券" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                            <TextBlock Text="{Binding CouponName}" FontSize="12" Foreground="#888888" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="暂无可用优惠券" FontSize="12" Foreground="#888888"
                                       IsVisible="{Binding !HasCoupons}" />
                        </StackPanel>
                    </Border>

                    <!-- 费用明细 -->
                    <Border Background="#252535" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="12">
                            <TextBlock Text="💰 费用明细" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                                <TextBlock Text="商品金额" FontSize="13" Foreground="#AAAAAA" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ProductTotalDisplay}" FontSize="13" Foreground="White" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="运费" FontSize="13" Foreground="#AAAAAA" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FreightDisplay}" FontSize="13" Foreground="White" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="优惠券抵扣" FontSize="13" Foreground="#AAAAAA" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DiscountDisplay}" FontSize="13" Foreground="#4CAF50" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                
                                <TextBlock Text="满减优惠" FontSize="13" Foreground="#AAAAAA" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FullDiscountDisplay}" FontSize="13" Foreground="#4CAF50" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                
                                <Border Grid.Row="4" Grid.ColumnSpan="2" Height="1" Background="#333333" Margin="0 8" />
                                
                                <TextBlock Text="应付总额" FontSize="15" FontWeight="Bold" Foreground="White" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OrderTotalDisplay}" FontSize="18" FontWeight="Bold" Foreground="#FF6B6B" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 提交订单 -->
                    <Button Content="提交订单" Classes="PrimaryAction" CornerRadius="10" Padding="0 14"
                            FontSize="16" FontWeight="Bold" HorizontalAlignment="Stretch"
                            Command="{Binding CheckoutCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- 支付对话框（覆盖层） -->
        <Panel Grid.RowSpan="2" IsVisible="{Binding ShowPaymentDialog}" ZIndex="200">
            <Border Background="#CC0D0D0D" />
            <Border Background="#272727" CornerRadius="20" Padding="32" MaxWidth="560" MinWidth="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="24">
                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" Background="#1A8B5C">
                                <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="确认支付" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Classes="QuietAction" Padding="10 6" CornerRadius="8"
                                Command="{Binding CancelPaymentCommand}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Amount Card -->
                    <Border Background="#1A1A1A" CornerRadius="16" Padding="24 20">
                        <StackPanel Spacing="8">
                            <TextBlock Text="应付金额" FontSize="13" Foreground="#888888"/>
                            <TextBlock Text="{Binding PaymentAmount, StringFormat='¥{0:F2}'}" FontSize="32"
                                       FontWeight="Bold" Foreground="#4ECB71" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Payment Method Card -->
                    <Border Background="#1A1A1A" CornerRadius="16" Padding="24 20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="支付方式" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC"/>
                            <ComboBox SelectedIndex="{Binding SelectedPaymentChannel}"
                                      HorizontalAlignment="Stretch"
                                      Background="#2A2A2A"
                                      BorderBrush="#3A3A3A"
                                      Foreground="White">
                                <ComboBoxItem Content="微信支付" />
                                <ComboBoxItem Content="支付宝" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Processing Indicator -->
                    <StackPanel IsVisible="{Binding IsPaymentProcessing}" Spacing="12" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                        <TextBlock Text="正在支付，请稍候..." FontSize="12" Foreground="#666666" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Result Message -->
                    <TextBlock Text="{Binding PaymentResultMessage}" FontSize="13" Foreground="#4ECB71"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding PaymentResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button Grid.Column="0" Content="取消" Classes="QuietAction" CornerRadius="12" Padding="0 14"
                                HorizontalAlignment="Stretch" FontSize="14"
                                Command="{Binding CancelPaymentCommand}"
                                IsEnabled="{Binding !IsPaymentProcessing}" />
                        <Button Grid.Column="1" Content="确认支付" Classes="PrimaryAction" CornerRadius="12" Padding="32 14"
                                HorizontalAlignment="Stretch" FontSize="14" FontWeight="SemiBold"
                                Command="{Binding ConfirmPaymentCommand}"
                                IsEnabled="{Binding !IsPaymentProcessing}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
