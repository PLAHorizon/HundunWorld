<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.HourlyForecastDrawerView"
             x:DataType="vm:HomeViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1 0 0 0"
            Width="420" MaxWidth="500"
            HorizontalAlignment="Right">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0 0 0 1" Padding="20 16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="逐时预报" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Classes="QuietAction" Padding="8 4" FontSize="14"
                            Command="{Binding CloseHourlyDetailCommand}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="20 16">

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌡️" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="温度趋势" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFBB" VerticalAlignment="Center" />
                        </StackPanel>
                        <Canvas Width="800" Height="80" ClipToBounds="True"
                                IsVisible="{Binding HourlyTemperaturePoints, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <Polygon Points="{Binding HourlyTemperatureFillPoints}" Fill="#1A7AA9FF" />
                            <Polyline Points="{Binding HourlyTemperaturePoints}" Stroke="{DynamicResource BattleNetOutlineBrush}" StrokeThickness="2" />
                        </Canvas>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WeatherForecast.Hourly}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:HourlyForecast">
                                        <Panel>
                                            <Border Background="#1A7AA9FF" CornerRadius="12" IsVisible="{Binding IsCurrentHour}" />
                                            <Border Background="#14FFFFFF" CornerRadius="12" Padding="10 10" MinWidth="62">
                                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                    <Panel>
                                                        <TextBlock Text="现在" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BattleNetOutlineBrush}" HorizontalAlignment="Center" IsVisible="{Binding IsCurrentHour}" />
                                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH}:00'}" FontSize="11" Foreground="#FFFFFF88" HorizontalAlignment="Center" IsVisible="{Binding !IsCurrentHour}" />
                                                    </Panel>
                                                    <controls:WeatherIconControl WmoCode="{Binding WmoCode}" Width="30" Height="30" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding Temperature, StringFormat='{}{0}°'}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal" Spacing="1" HorizontalAlignment="Center">
                                                        <TextBlock Text="💧" FontSize="8" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Precipitation, StringFormat='{}{0:F0}%'}" FontSize="9" Foreground="{DynamicResource BattleNetOutlineBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <Border BorderBrush="#1AFFFFFF" BorderThickness="0 1 0 0" IsVisible="{Binding HasPrecipitation}" />

                    <StackPanel Spacing="8" IsVisible="{Binding HasPrecipitation}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌧️" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="降水概率" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFFBB" VerticalAlignment="Center" />
                        </StackPanel>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding WeatherForecast.PrecipitationTimeline}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:PrecipitationTimelineItem">
                                        <StackPanel Spacing="3" HorizontalAlignment="Center" Width="24">
                                            <Border Background="#14FFFFFF" CornerRadius="2" Height="60" Width="8" HorizontalAlignment="Center" ClipToBounds="True">
                                                <Border Background="{DynamicResource BattleNetOutlineBrush}" CornerRadius="2" VerticalAlignment="Bottom" Height="{Binding Probability}" Width="8" />
                                            </Border>
                                            <TextBlock Text="{Binding TimeLabel}" FontSize="8" Foreground="#FFFFFF66" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
