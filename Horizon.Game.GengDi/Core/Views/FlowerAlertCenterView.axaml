<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerAlertCenterView"
             x:DataType="vm:FlowerAlertCenterViewModel">

    <UserControl.Resources>
        <converters:AlertLevelToSurfaceConverter x:Key="AlertSurfaceConverter" />
    </UserControl.Resources>
    <controls:GalleryPage Title="花卉预警中心"
                          Subtitle="Horizon.Game.GengDi.FlowerAlert"
                          Description="查看花卉价格预警和异常波动通知。"
                          IconSource="{StaticResource NotificationsIcon}">

        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="16">

            <!-- ============ 顶部统计栏（原型 metric-card：待处理预警 + 分类计数 + 操作按钮） ============ -->
            <Border Classes="GdCard" Padding="16 20" Margin="0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <!-- 待处理预警（图标容器 + 标签 + 大数字，warning 主题） -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Background="{DynamicResource GdWarningSurfaceBrush}">
                                <TextBlock Text="🔔" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource GdWarningBrush}" />
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="待处理预警" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text="{Binding PendingAlertCount}" FontSize="22" FontWeight="Bold"
                                           FontFamily="{DynamicResource GdFontMono}"
                                           Foreground="{DynamicResource GdWarningBrush}" LineHeight="24" />
                            </StackPanel>
                        </StackPanel>
                        <!-- 分隔线 -->
                        <Border Width="1" Height="36" Background="{DynamicResource GdBorderBrush}" />
                        <!-- 价格突破 -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="价格突破" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBlock Text="{Binding PriceBreakthroughCount}" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource GdFontMono}"
                                       Foreground="{DynamicResource GdErrorBrush}" />
                        </StackPanel>
                        <!-- 库存不足 -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="库存不足" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBlock Text="{Binding LowStockCount}" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource GdFontMono}"
                                       Foreground="{DynamicResource GdWarningBrush}" />
                        </StackPanel>
                        <!-- 异常波动 -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="异常波动" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBlock Text="{Binding AnomalyCount}" FontSize="14" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource GdFontMono}"
                                       Foreground="{DynamicResource GdErrorBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- 右侧操作按钮 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="GdGhost" Padding="12 6" FontSize="12"
                                Command="{Binding RefreshCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="刷新" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="GdPrimary" Padding="12 6" FontSize="12"
                                Command="{Binding MarkAllReadCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="✅" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="全部已读" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ 品种筛选标签栏（原型 filter-pill） ============ -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="全部品种" Classes="GdPill GdPillActive" Click="OnSpeciesFilterClick" Tag="0"/>
                    <Button Content="红玫瑰" Classes="GdPill" Click="OnSpeciesFilterClick" Tag="1"/>
                    <Button Content="百合" Classes="GdPill" Click="OnSpeciesFilterClick" Tag="2"/>
                    <Button Content="康乃馨" Classes="GdPill" Click="OnSpeciesFilterClick" Tag="3"/>
                    <Button Content="混合花束" Classes="GdPill" Click="OnSpeciesFilterClick" Tag="4"/>
                    <Button Content="红绿搭配" Classes="GdPill" Click="OnSpeciesFilterClick" Tag="5"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 预警列表（原型 alert-card） ============ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12" Margin="0 0 0 8">
                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AlertDisplayItem">
                                <Border Classes="GdCard" Padding="16" CornerRadius="{DynamicResource GdRadiusLg}" Margin="0">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <!-- alert-icon-wrap：表面色容器 + 业务图标 -->
                                        <Border Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusMd}"
                                                Background="{Binding AlertLevel, Converter={StaticResource AlertSurfaceConverter}}"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding AlertIcon}" FontSize="18"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <!-- 中间内容：标题 + badge + 品种 / 描述 / 触发信息 -->
                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding AlertTypeDisplay}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center"/>
                                                <Border Background="{Binding AlertLevel, Converter={StaticResource AlertSurfaceConverter}}"
                                                        CornerRadius="{DynamicResource GdRadiusSm}" Padding="6 2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LevelIcon}" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding SpeciesName, StringFormat='· {0}'}" FontSize="13"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13"
                                                       Foreground="{DynamicResource GdForegroundBrush}" LineHeight="20"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding TriggerLabel, StringFormat='{}{0}：'}" FontSize="12"
                                                           FontFamily="{DynamicResource GdFontMono}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding TriggeredValueDisplay}" FontSize="12"
                                                           FontFamily="{DynamicResource GdFontMono}"
                                                           Foreground="{Binding TriggeredValueColor}"/>
                                                <TextBlock Text="{Binding ThresholdLabel, StringFormat=' / {0} '}" FontSize="12"
                                                           FontFamily="{DynamicResource GdFontMono}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding ThresholdValueDisplay}" FontSize="12"
                                                           FontFamily="{DynamicResource GdFontMono}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='· 触发于 {0}'}" FontSize="12"
                                                           FontFamily="{DynamicResource GdFontMono}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- 已读按钮 -->
                                        <Button Grid.Column="2" Content="{Binding ReadIcon}"
                                                Classes="GdGhost" Padding="10 6" FontSize="11" CornerRadius="{DynamicResource GdRadiusSm}"
                                                VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:FlowerAlertCenterViewModel)DataContext).MarkAsReadCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态 -->
                    <Border Classes="GdCard" Padding="40" IsVisible="{Binding IsEmpty}">
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <TextBlock Text="✅" FontSize="32" HorizontalAlignment="Center"/>
                            <TextBlock Text="暂无预警" FontSize="14" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 预警趋势图占位区 ============ -->
            <Border Grid.Row="3" Classes="GdCard" Padding="20" Height="180" Margin="0">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="预警趋势" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="（近 7 日预警分布）" FontSize="12"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- 图表区域：近 7 日预警趋势柱状图 -->
                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding AlertTrendSeries}"
                                        XAxes="{Binding AlertXAxes}"
                                        YAxes="{Binding AlertYAxes}" />
                </Grid>
            </Border>
        </Grid>
    </controls:GalleryPage>
</UserControl>
