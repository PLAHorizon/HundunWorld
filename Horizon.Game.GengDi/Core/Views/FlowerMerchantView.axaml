<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerMerchantView"
             x:DataType="vm:FlowerMerchantViewModel">

    <UserControl.Resources>
        <converters:EqualToZeroConverter x:Key="EqualToZeroConverter" />
        <converters:EqualToOneConverter x:Key="EqualToOneConverter" />
        <converters:EqualToTwoConverter x:Key="EqualToTwoConverter" />
        <converters:BoolToIntEqualOneConverter x:Key="BoolToIntEqualOneConverter" />
        <converters:BoolToIntEqualZeroConverter x:Key="BoolToIntEqualZeroConverter" />
    </UserControl.Resources>

    <controls:GalleryPage Title="商家管理"
                          Subtitle="Horizon.Game.GengDi.FlowerMerchant"
                          Description="管理您的店铺、商品和订单。"
                          IconSource="{StaticResource HomeIcon}">

        <!-- 使用Grid让抽屉面板覆盖整个内容区 -->
        <Grid>
            <!-- 主内容滚动区 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="0 0 0 24">

                <!-- ═══ 未注册 - 引导提示 ═══ -->
                <Border Classes="SurfaceCard" Padding="48" IsVisible="{Binding ShowRegisterPrompt}">
                    <StackPanel HorizontalAlignment="Center" Spacing="20">
                        <TextBlock Text="🏪" FontSize="56" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="您还不是商家" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="注册成为商家后，即可发布商品、管理订单和查看经营数据" FontSize="13" Foreground="#888888" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="✓ 免费入驻" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 商品管理" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 订单处理" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 经营统计" FontSize="12" Foreground="#4CAF50" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="立即注册"
                                Classes="PrimaryAction"
                                HorizontalAlignment="Center"
                                Padding="32 12"
                                CornerRadius="10"
                                FontSize="14"
                                Command="{Binding ShowRegisterFormCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ 未注册 - 注册表单 ═══ -->
                <Border Classes="SurfaceCard" Padding="32" IsVisible="{Binding ShowRegisterForm}" MaxWidth="600" HorizontalAlignment="Center">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="注册商家" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="填写以下信息完成商家入驻" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="店铺名称 *" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBox Text="{Binding RegisterShopName}" Watermark="请输入店铺名称"
                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="商户类型" FontSize="12" Foreground="#AAAAAA"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="个人商户" IsChecked="True"
                                             GroupName="MerchantType" Padding="8 6" Click="OnRegisterTypeClick" Tag="0"/>
                                <RadioButton Content="企业商户" GroupName="MerchantType" Padding="8 6" Click="OnRegisterTypeClick" Tag="1"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="联系电话 *" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBox Text="{Binding RegisterPhone}" Watermark="请输入联系电话"
                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="店铺描述" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBox Text="{Binding RegisterDescription}" Watermark="简要描述您的店铺（选填）"
                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"
                                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10"
                                    Command="{Binding CancelRegisterCommand}"/>
                            <Button Content="提交注册" Classes="PrimaryAction" Padding="24 10" CornerRadius="10"
                                    Name="RegisterMerchantButton"
                                    Click="OnRegisterMerchantClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 已注册 - 商家内容 ═══ -->
                <Panel IsVisible="{Binding ShowMerchantContent}">
                    <StackPanel Spacing="20">

                        <!-- 商户信息卡片 -->
                        <Border Classes="SurfaceCard" Padding="20">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="56" Height="56" CornerRadius="28" Background="#2542A5F5">
                                    <TextBlock Text="🏪" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding MerchantInfo.ShopName}" FontSize="18" FontWeight="SemiBold"/>
                                        <Border Background="#254CAF50" CornerRadius="4" Padding="6 2" IsVisible="{Binding MerchantInfo.IsVerified}">
                                            <TextBlock Text="已认证" FontSize="10" Foreground="#4CAF50"/>
                                        </Border>
                                        <Border Background="#25FFA726" CornerRadius="4" Padding="6 2" IsVisible="{Binding !MerchantInfo.IsVerified}">
                                            <TextBlock Text="待认证" FontSize="10" Foreground="#FFA726"/>
                                        </Border>
                                        <Border Background="#2542A5F5" CornerRadius="4" Padding="6 2">
                                            <TextBlock Text="{Binding ShopGradeDisplay}" FontSize="10" Foreground="#42A5F5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MerchantInfo.Description}" FontSize="12" Foreground="#888888" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0 4 0 0">
                                        <TextBlock Text="{Binding MerchantTypeDisplay, StringFormat='类型: {0}'}" FontSize="11" Foreground="#666666"/>
                                        <TextBlock Text="{Binding MerchantInfo.ContactPhone, StringFormat='电话: {0}'}" FontSize="11" Foreground="#666666"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="2" Content="刷新" Classes="QuietAction" Padding="12 6" CornerRadius="8"
                                        Command="{Binding LoadMerchantCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Tab 栏 -->
                        <Border Classes="SurfaceCard" Padding="4">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="概览" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="0"/>
                                    <Button Content="商品" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="1"/>
                                    <Button Content="发布" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="2"/>
                                    <Button Content="订单" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="3"/>
                                    <Button Content="退款" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="4"/>
                                    <Button Content="结算" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="5"/>
                                    <Button Content="设置" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="6"/>
                                    <Button Content="运费" Padding="16 8" CornerRadius="8" FontSize="13"
                                            Click="OnTabClick" Tag="9"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 状态消息 -->
                        <Border Classes="SurfaceCard" Padding="12 8" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#42A5F5"/>
                        </Border>

                        <!-- ═══ Tab 0: 概览 ═══ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowOverviewPanel}">
                            <!-- 统计卡片 -->
                            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="10">
                                <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1A1A2E">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="今日订单" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TodayOrders}" FontSize="22" FontWeight="Bold" Foreground="#42A5F5" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1A1A2E" Grid.Column="1">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="今日收入" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TodayRevenue, StringFormat='¥{0:F0}'}" FontSize="22" FontWeight="Bold" Foreground="#66BB6A" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1A1A2E" Grid.Column="2">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="待发货" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding PendingShipCount}" FontSize="22" FontWeight="Bold" Foreground="#FFA726" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1A1A2E" Grid.Column="3">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="商品总数" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalProducts}" FontSize="22" FontWeight="Bold" Foreground="#AB47BC" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1A1A2E" Grid.Column="4">
                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                        <TextBlock Text="累计收入" FontSize="10" Foreground="#888888" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding TotalRevenue, StringFormat='¥{0:F0}'}" FontSize="22" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 最近订单 -->
                            <Border Classes="SurfaceCard" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="最近订单" FontSize="14" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding RecentOrders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="8" Margin="0 0 0 4" CornerRadius="8" Background="#1A1A2E">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="{Binding OrderNo}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:MM-dd HH:mm}'}" FontSize="10" Foreground="#888888"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='¥{0:F2}'}" FontSize="13" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="2" CornerRadius="4" Padding="6 2" Background="#25FFA726">
                                                            <TextBlock FontSize="10" Foreground="#FFA726" Text="{Binding Status}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Padding="20" IsVisible="{Binding !HasRecentOrders}">
                                        <TextBlock Text="暂无订单" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 1: 商品管理 ═══ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowProductsPanel}">
                            <!-- 搜索和筛选 -->
                            <Border Classes="SurfaceCard" Padding="12">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding SearchKeyword}" Watermark="搜索商品名称..."
                                             Padding="10 8" CornerRadius="8" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                    <Button Grid.Column="1" Content="搜索" Classes="QuietAction" Padding="12 8" CornerRadius="8"
                                            Command="{Binding SearchProductsCommand}"/>
                                    <Button Grid.Column="2" Content="刷新" Classes="QuietAction" Padding="12 8" CornerRadius="8"
                                            Command="{Binding RefreshProductsCommand}"/>
                                </Grid>
                            </Border>

                            <!-- 分类筛选 -->
                            <Border Classes="SurfaceCard" Padding="8 4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="全部" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="0"/>
                                        <Button Content="红玫瑰" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="1"/>
                                        <Button Content="百合" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="2"/>
                                        <Button Content="康乃馨" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="3"/>
                                        <Button Content="混合花束" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="4"/>
                                        <Button Content="红绿搭配" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnCategoryFilterClick" Tag="5"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- 智能调价建议 -->
                            <Border Classes="SurfaceCard" Padding="12" CornerRadius="10" Background="#1AFF9800">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="智能调价建议" FontSize="13" FontWeight="SemiBold" Foreground="#FF9800" VerticalAlignment="Center"/>
                                        <Border Background="#FF9800" CornerRadius="8" Padding="6 2" IsVisible="{Binding HasPriceAdjustments}">
                                            <TextBlock Text="{Binding PriceAdjustmentSuggestions.Count, StringFormat='{}{0}条'}" FontSize="10" Foreground="#1A1A2E" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="查看建议" Classes="QuietAction" Padding="12 6" CornerRadius="8" FontSize="12"
                                            Command="{Binding LoadPriceAdjustmentsCommand}" Click="OnShowPriceAdjustmentsClick"/>
                                </Grid>
                            </Border>

                            <!-- 调价建议列表 -->
                            <ItemsControl ItemsSource="{Binding PriceAdjustmentSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="SurfaceCard" Padding="12" Margin="0 0 0 6" CornerRadius="8" Background="#1A1A2E">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold"/>
                                                        <Border Background="#25EF5350" CornerRadius="4" Padding="6 2">
                                                            <TextBlock Text="{Binding ChangePercent, StringFormat='{}{0:+0.0;-0.0}%'}" FontSize="10" Foreground="#EF5350"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding CurrentPrice, StringFormat='当前: ¥{0:F2}'}" FontSize="11" Foreground="#888888"/>
                                                        <TextBlock Text="{Binding SuggestedPrice, StringFormat='建议: ¥{0:F2}'}" FontSize="11" Foreground="#42A5F5" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="#666666" TextWrapping="Wrap" MaxWidth="400"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="调整" Classes="PrimaryAction" Padding="12 5" FontSize="11" CornerRadius="8"
                                                        Click="OnAdjustPriceClick"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 商品列表 -->
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="SurfaceCard" Padding="16" Margin="0 0 0 8" CornerRadius="12">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                <!-- 商品编号 -->
                                                <Border Width="40" Height="40" CornerRadius="8" Background="#3A3A4E" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="#AAAAAA"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- 商品图标 -->
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#25FFFFFF">
                                                    <TextBlock Text="🌸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"/>
                                                        <Border Background="#FF9800" CornerRadius="4" Padding="8 2" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToZeroConverter}}">
                                                            <TextBlock Text="待审核" FontSize="10" Foreground="#FFFFFF"/>
                                                        </Border>
                                                        <Border Background="#4CAF50" CornerRadius="4" Padding="8 2" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToOneConverter}}">
                                                            <TextBlock Text="已通过" FontSize="10" Foreground="#FFFFFF"/>
                                                        </Border>
                                                        <Border Background="#EF5350" CornerRadius="4" Padding="8 2" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToTwoConverter}}">
                                                            <TextBlock Text="已拒绝" FontSize="10" Foreground="#FFFFFF"/>
                                                        </Border>
                                                        <Border Background="#2D503E" CornerRadius="4" Padding="8 2" IsVisible="{Binding IsActive}">
                                                            <TextBlock Text="已上架" FontSize="10" Foreground="#C8E6C9"/>
                                                        </Border>
                                                        <Border Background="#6B2D2D" CornerRadius="4" Padding="8 2" IsVisible="{Binding !IsActive}">
                                                            <TextBlock Text="已下架" FontSize="10" Foreground="#E8C8C8"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding Price, StringFormat='¥{0:F2}'}" FontSize="13" Foreground="#FF6B6B" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Stock, StringFormat='库存: {0}'}" FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <!-- 上移/下移按钮 -->
                                                    <Border Background="#1A7E57C2" CornerRadius="6">
                                                        <Button Padding="6 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#7E57C2" Background="Transparent"
                                                                Click="OnMoveUpProductClick">▲</Button>
                                                    </Border>
                                                    <Border Background="#1A7E57C2" CornerRadius="6">
                                                        <Button Padding="6 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#7E57C2" Background="Transparent"
                                                                Click="OnMoveDownProductClick">▼</Button>
                                                    </Border>
                                                    <Border Background="#1A42A5F5" CornerRadius="6">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#42A5F5" Background="Transparent"
                                                                Click="OnEditProductClick">编辑</Button>
                                                    </Border>
                                                    <Border Background="#1A9C27B0" CornerRadius="6">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#9C27B0" Background="Transparent"
                                                                Click="OnAuditProductClick">审核</Button>
                                                    </Border>
                                                    <Border Background="#1A4CAF50" CornerRadius="6" IsVisible="{Binding !IsActive}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#4CAF50" Background="Transparent"
                                                                Click="OnActivateProductClick">上架</Button>
                                                    </Border>
                                                    <Border Background="#1AFF9800" CornerRadius="6" IsVisible="{Binding IsActive}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#FF9800" Background="Transparent"
                                                                Click="OnDeactivateProductClick">下架</Button>
                                                    </Border>
                                                    <Border Background="#1AEF5350" CornerRadius="6">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Foreground="#EF5350" Background="Transparent"
                                                                Click="OnDeleteProductClick">删除</Button>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="SurfaceCard" Padding="40" IsVisible="{Binding !HasProducts}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无商品，去发布吧" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 2: 发布商品 ═══ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowPublishPanel}">
                            <Border Classes="SurfaceCard" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="发布新商品" FontSize="16" FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="花卉品种 *" FontSize="12" Foreground="#AAAAAA"/>
                                        <ComboBox ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding SelectedSpeciesFilter}"
                                                  DisplayMemberBinding="{Binding DisplayName}"
                                                  Padding="12 8" CornerRadius="10" Background="#2A2A3E" Foreground="#FFFFFF"
                                                  HorizontalAlignment="Stretch"
                                                  Name="PublishSpeciesComboBox"/>
                                    </StackPanel>

                                    <!-- 建议价格区域 -->
                                    <Border Background="#1A42A5F5" CornerRadius="8" Padding="12" IsVisible="{Binding HasSuggestedPrice}">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="智能建议价" FontSize="13" FontWeight="SemiBold" Foreground="#42A5F5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SuggestedPriceDisplay}" FontSize="12" Foreground="#90CAF9"/>
                                            <TextBlock Text="{Binding SuggestedPriceRange.Reason}" FontSize="11" Foreground="#64B5F6" TextWrapping="Wrap" MaxWidth="400"/>
                                            <Button Content="采纳建议价" Classes="PrimaryAction" Padding="16 6" CornerRadius="8" FontSize="12"
                                                    Command="{Binding AcceptSuggestedPriceCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#1A1A2E" CornerRadius="8" Padding="12" IsVisible="{Binding IsLoadingSuggestedPrice}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Width="100"/>
                                            <TextBlock Text="加载建议价..." FontSize="12" Foreground="#888888" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品名称 *" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding NewProductName}" Watermark="请输入商品名称"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="价格 (¥) *" FontSize="12" Foreground="#AAAAAA"/>
                                            <TextBox Text="{Binding NewProductPrice}" Watermark="0.00"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="库存数量 *" FontSize="12" Foreground="#AAAAAA"/>
                                            <TextBox Text="{Binding NewProductStock}" Watermark="0"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="计量单位" FontSize="12" Foreground="#AAAAAA"/>
                                            <TextBox Text="{Binding NewProductUnit}" Watermark="束"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="分类" FontSize="12" Foreground="#AAAAAA"/>
                                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                                      DisplayMemberBinding="{Binding Name}"
                                                      Padding="12 8" CornerRadius="10" Background="#2A2A3E" Foreground="#FFFFFF"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="运费模板" FontSize="12" Foreground="#AAAAAA"/>
                                        <ComboBox ItemsSource="{Binding FreightTemplates}" SelectedItem="{Binding SelectedFreightTemplate}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  Padding="12 8" CornerRadius="10" Background="#2A2A3E" Foreground="#FFFFFF"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品图片" FontSize="12" Foreground="#AAAAAA"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding NewProductImages}" Watermark="图片URL，多个用逗号分隔"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                            <Button Grid.Column="1" Content="📁 本地上传" Classes="QuietAction" Padding="12 8" CornerRadius="8"
                                                    FontSize="12" Click="OnLocalImageUploadClick" />
                                            <Button Grid.Column="2" Content="🔗 在线解析" Classes="QuietAction" Padding="12 8" CornerRadius="8"
                                                    FontSize="12" Click="OnOnlineImageParseClick" />
                                        </Grid>
                                        <!-- 图片预览 -->
                                        <ItemsControl ItemsSource="{Binding NewProductImageList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#2A2A3E" CornerRadius="8" Padding="8" Margin="0 0 8 8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Width="40" Height="40" CornerRadius="6" Background="#3A3A4E">
                                                                <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="#CCCCCC"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="2" Content="✕" Classes="QuietAction" Padding="4 2" FontSize="10" CornerRadius="4"
                                                                    Click="OnRemoveImageClick" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品描述" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding NewProductDescription}" Watermark="请输入商品描述"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"
                                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- 阶梯价格 -->
                                    <Border Background="#1A1A2E" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="阶梯价格" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOpenLadder}"/>
                                            </Grid>
                                            <StackPanel Spacing="8" IsVisible="{Binding IsOpenLadder}">
                                                <ItemsControl ItemsSource="{Binding LadderPrices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8" Margin="0 0 0 6">
                                                                <TextBox Text="{Binding MinBatch}" Watermark="最小批量" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                                <TextBox Grid.Column="1" Text="{Binding MaxBatch}" Watermark="最大批量" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                                <TextBox Grid.Column="2" Text="{Binding Price}" Watermark="价格" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                                <Button Grid.Column="3" Content="✕" Classes="QuietAction" Padding="6 4" FontSize="11" CornerRadius="6"
                                                                        Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).RemoveLadderPriceCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="+ 添加阶梯价格" Classes="QuietAction" Padding="12 6" CornerRadius="8" FontSize="11"
                                                        Command="{Binding AddLadderPriceCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- SKU 配置 -->
                                    <Border Background="#1A1A2E" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="SKU 配置" FontSize="13" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="颜色" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding SkuColors}" Watermark="红,蓝,白"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="尺寸" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding SkuSizes}" Watermark="S,M,L"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="版本" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding SkuVersions}" Watermark="标准,豪华"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="多个值用逗号分隔" FontSize="10" Foreground="#666666"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 预售设置 -->
                                    <Border Background="#1AFF6B6B" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="🏷️" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="预售商品" FontSize="13" FontWeight="SemiBold" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPresale}"/>
                                            </Grid>
                                            <StackPanel Spacing="8" IsVisible="{Binding ShowPresaleOptions}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="关联种植批次" FontSize="10" Foreground="#AAAAAA"/>
                                                    <ComboBox ItemsSource="{Binding AvailableBatches}" SelectedItem="{Binding SelectedBatch}"
                                                              DisplayMemberBinding="{Binding BatchName}"
                                                              Padding="10 8" CornerRadius="8" Background="#2A2A3E" Foreground="#FFFFFF"
                                                              HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="预计发货日期" FontSize="10" Foreground="#AAAAAA"/>
                                                    <CalendarDatePicker SelectedDate="{Binding PresaleDeliveryDate}"
                                                                        HorizontalAlignment="Stretch"
                                                                        CornerRadius="8"/>
                                                </StackPanel>
                                                <Border Background="#1AFF6B6B" CornerRadius="6" Padding="8 4">
                                                    <TextBlock Text="预售商品将在关联批次收获后自动通知买家" FontSize="10" Foreground="#FF6B6B" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="发布商品" Classes="PrimaryAction" Padding="24 12" CornerRadius="10"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Name="PublishProductButton"
                                            Click="OnPublishProductClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 3: 订单管理 ═══ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowOrdersPanel}">
                            <!-- 订单状态筛选 -->
                            <Border Classes="SurfaceCard" Padding="8 4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="全部" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="-1"/>
                                        <Button Content="待付款" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="0"/>
                                        <Button Content="待发货" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="1"/>
                                        <Button Content="已发货" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="2"/>
                                        <Button Content="已完成" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="3"/>
                                        <Button Content="已关闭" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnOrderStatusFilterClick" Tag="4"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Classes="SurfaceCard" Padding="8 6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Orders.Count, StringFormat='订单列表 ({0})'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="刷新" Classes="QuietAction" Padding="10 4" FontSize="11" CornerRadius="6"
                                            Command="{Binding RefreshOrdersCommand}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Orders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="SurfaceCard" Padding="16" Margin="0 0 0 8" CornerRadius="12">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding OrderNo}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="6" Padding="8 3" Background="#25FFA726">
                                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#FFA726"/>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0 2 0 0">
                                                                <TextBlock Text="{Binding ProductName}" FontSize="12"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" Foreground="#888888"/>
                                                                    <TextBlock Text="{Binding Subtotal, StringFormat='¥{0:F2}'}" FontSize="12" Foreground="#FF6B6B"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Height="1" Background="#10FFFFFF"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding TotalAmount, StringFormat='合计: ¥{0:F2}'}" FontSize="13" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="发货" Classes="PrimaryAction" Padding="12 5" FontSize="11" CornerRadius="8"
                                                                IsEnabled="{Binding CanShip}"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ShowShipDialogCommand}"
                                                                CommandParameter="{Binding OrderId}"/>
                                                        <Button Content="物流" Classes="QuietAction" Padding="12 5" FontSize="11" CornerRadius="8"
                                                                IsVisible="{Binding CanViewLogistics}"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ViewMerchantLogisticsCommand}"
                                                                CommandParameter="{Binding OrderId}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="SurfaceCard" Padding="40" IsVisible="{Binding !HasOrders}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无订单" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 4: 退款管理 ═══ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowRefundsPanel}">
                            <Border Classes="SurfaceCard" Padding="8 4">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="全部" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnRefundStatusFilterClick" Tag="-1"/>
                                        <Button Content="待审核" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnRefundStatusFilterClick" Tag="0"/>
                                        <Button Content="已同意" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnRefundStatusFilterClick" Tag="1"/>
                                        <Button Content="已拒绝" Classes="QuietAction" Padding="12 6" CornerRadius="16" FontSize="11" Click="OnRefundStatusFilterClick" Tag="2"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Refunds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="SurfaceCard" Padding="16" Margin="0 0 0 8" CornerRadius="12">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding RefundNo}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="#888888"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="6" Padding="8 3" Background="#25EF5350">
                                                        <TextBlock FontSize="10" Foreground="#EF5350">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}">
                                                                    <Binding Path="Status"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding RefundAmount, StringFormat='退款: ¥{0:F2}'}" FontSize="13" Foreground="#FF6B6B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="同意" Classes="PrimaryAction" Padding="12 5" FontSize="11" CornerRadius="8"
                                                            Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ApproveRefundCommand}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Grid.Column="2" Content="拒绝" Classes="QuietAction" Padding="12 5" FontSize="11" CornerRadius="8"
                                                            Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).RejectRefundCommand}"
                                                            CommandParameter="{Binding Id}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="SurfaceCard" Padding="40" IsVisible="{Binding !HasRefunds}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无退款申请" FontSize="14" Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 5: 结算管理 ═══ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowSettlementPanel}">
                            <!-- 结算账户 -->
                            <Border Classes="SurfaceCard" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="结算账户" FontSize="16" FontWeight="SemiBold"/>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="银行名称" FontSize="12" Foreground="#AAAAAA"/>
                                            <TextBox Text="{Binding SettlementBankName}" Watermark="请输入银行名称"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="银行账号" FontSize="12" Foreground="#AAAAAA"/>
                                            <TextBox Text="{Binding SettlementAccountNo}" Watermark="请输入银行账号"
                                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="户名" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SettlementAccountName}" Watermark="请输入户名"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <Button Content="保存结算账户" Classes="PrimaryAction" Padding="24 12" CornerRadius="10"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Command="{Binding SaveSettlementAccountCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- 结算账单 -->
                            <Border Classes="SurfaceCard" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="结算账单" FontSize="14" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding SettlementBills}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0 0 0 6" CornerRadius="8" Background="#1A1A2E">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Remark}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="10" Foreground="#888888"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Amount, StringFormat='¥{0:F2}'}" FontSize="14" Foreground="#FF6B6B" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <Border CornerRadius="4" Padding="6 2" Background="#254CAF50" HorizontalAlignment="Right">
                                                                <TextBlock FontSize="9" Foreground="#4CAF50" Text="{Binding Status}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Padding="20" IsVisible="{Binding !HasSettlementBills}">
                                        <TextBlock Text="暂无结算记录" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══ Tab 6: 店铺设置 ═══ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowSettingsPanel}">
                            <!-- 店铺信息 -->
                            <Border Classes="SurfaceCard" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="店铺设置" FontSize="16" FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="店铺名称" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding EditShopName}"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="联系电话" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding EditPhone}"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="店铺描述" FontSize="12" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding EditDescription}"
                                                 Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"
                                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="保存修改" Classes="PrimaryAction" Padding="24 12" CornerRadius="10"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Command="{Binding SaveShopSettingsCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- 发货点管理 -->
                            <Border Classes="SurfaceCard" Padding="20">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="发货点管理" FontSize="14" FontWeight="SemiBold"/>

                                    <ItemsControl ItemsSource="{Binding Shippers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0 0 0 6" CornerRadius="8" Background="#1A1A2E">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding ShipperName}" FontSize="12" FontWeight="SemiBold"/>
                                                                <Border Background="#2542A5F5" CornerRadius="4" Padding="4 1" IsVisible="{Binding IsDefaultSendGoods}">
                                                                    <TextBlock Text="默认" FontSize="9" Foreground="#42A5F5"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Address}" FontSize="11" Foreground="#888888"/>
                                                            <TextBlock Text="{Binding TelPhone}" FontSize="10" Foreground="#666666"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="删除" Classes="QuietAction" Padding="10 5" FontSize="10" CornerRadius="6"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).DeleteShipperCommand}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Padding="20" IsVisible="{Binding !HasShippers}">
                                        <TextBlock Text="暂无发货点" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 添加发货点 -->
                                    <Border Background="#1A1A2E" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="添加发货点" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="标签" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding NewShipperTag}" Watermark="如：仓库A"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="名称 *" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding NewShipperName}" Watermark="发货点名称"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="地址 *" FontSize="10" Foreground="#AAAAAA"/>
                                                <TextBox Text="{Binding NewShipperAddress}" Watermark="详细地址"
                                                         Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="电话" FontSize="10" Foreground="#AAAAAA"/>
                                                    <TextBox Text="{Binding NewShipperPhone}" Watermark="联系电话"
                                                             Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="添加" Classes="PrimaryAction" Padding="16 8" CornerRadius="8" FontSize="12"
                                                        VerticalAlignment="Bottom"
                                                        Command="{Binding AddShipperCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Panel>

                <!-- 运费模板管理 Tab 9 -->
                <Panel IsVisible="{Binding ShowFreightPanel}">
                    <StackPanel Spacing="16">
                        <Border Classes="SurfaceCard" Padding="16 12" CornerRadius="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="运费模板管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ 新增模板" Classes="PrimaryAction" Padding="16 8"
                                        CornerRadius="8" FontSize="13" Click="OnOpenFreightTemplateDialogClick" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FreightTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="SurfaceCard" Padding="16" CornerRadius="12" Margin="0 0 0 8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Background="#1A4CAF50" CornerRadius="4" Padding="6 2" IsVisible="{Binding IsFree}">
                                                        <TextBlock Text="包邮" FontSize="11" Foreground="#4CAF50" />
                                                    </Border>
                                                    <Border Background="#1AFF9800" CornerRadius="4" Padding="6 2" IsVisible="{Binding !IsFree}">
                                                        <TextBlock Text="计费" FontSize="11" Foreground="#FF9800" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FirstPrice, StringFormat='首件 ¥{0:F2}'}" FontSize="12" Foreground="#AAAAAA"
                                                               IsVisible="{Binding !IsFree}" />
                                                    <TextBlock Text="{Binding ContinuePrice, StringFormat='续件 ¥{0:F2}'}" FontSize="12" Foreground="#AAAAAA"
                                                               IsVisible="{Binding !IsFree}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="删除" FontSize="11" Padding="10 5" CornerRadius="6"
                                                    Foreground="#EF5350" Background="Transparent"
                                                    Click="OnDeleteFreightTemplateClick" Tag="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Panel>

                <!-- 运费模板弹窗 -->
                <Border Classes="SurfaceCard" Padding="24" IsVisible="{Binding ShowFreightTemplateDialog}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <StackPanel Spacing="16">
                        <TextBlock Text="新增运费模板" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="模板名称 *" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBox Text="{Binding NewTemplateName}" Watermark="如：默认运费模板"
                                     Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <CheckBox Content="包邮（免运费）" IsChecked="{Binding NewTemplateIsFree}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding !NewTemplateIsFree}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="首件价格" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding NewTemplateFirstPrice}" Watermark="0.00"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="续件价格" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding NewTemplateContinuePrice}" Watermark="0.00"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10"
                                    Click="OnCancelFreightTemplateClick"/>
                            <Button Content="创建" Classes="PrimaryAction" Padding="24 10" CornerRadius="10"
                                    Click="OnSaveFreightTemplateClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 发货弹窗遮罩 -->
                <Panel IsVisible="{Binding ShowShipDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
                    <Border Background="#80000000" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Classes="SurfaceCard" Padding="24" MaxWidth="400">
                        <StackPanel Spacing="16">
                            <TextBlock Text="填写发货信息" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="物流公司 *" FontSize="12" Foreground="#AAAAAA"/>
                                <ComboBox ItemsSource="{Binding ExpressCompanies}"
                                          SelectedItem="{Binding SelectedExpressCompany}"
                                          Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="运单号 *" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding ShipOrderNumber}" Watermark="请输入运单号"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10"
                                        Command="{Binding CancelShipCommand}"/>
                                <Button Content="确认发货" Classes="PrimaryAction" Padding="24 10" CornerRadius="10"
                                        Command="{Binding ConfirmShipCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Panel>

                <Panel IsVisible="{Binding ShowMerchantLogisticsDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
                    <Border Background="#80000000" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="#1E1E2E" CornerRadius="16" Padding="24" MaxWidth="480" MaxHeight="600">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="物流跟踪" FontSize="16" FontWeight="SemiBold"/>
                                    <Button Grid.Column="1" Content="✕" Classes="QuietAction" Padding="8 4" CornerRadius="8"
                                            Command="{Binding CloseMerchantLogisticsDialogCommand}"/>
                                </Grid>

                                <Border Background="#25FFFFFF" CornerRadius="10" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="12" Foreground="#AAAAAA">
                                            <Run Text="快递公司："/>
                                            <Run Text="{Binding MerchantLogisticsMapData.ExpressCompanyName}" Foreground="#FFFFFF"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#AAAAAA">
                                            <Run Text="运单号："/>
                                            <Run Text="{Binding MerchantLogisticsMapData.ShipOrderNumber}" Foreground="#FFFFFF"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel IsVisible="{Binding IsLoadingMerchantLogistics}" HorizontalAlignment="Center" Spacing="8" Margin="0 20">
                                    <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="正在查询物流信息..." FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasNoMerchantLogistics}" HorizontalAlignment="Center" Spacing="8" Margin="0 20">
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无物流信息" FontSize="12" Foreground="#888888" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <controls:LogisticsMapView MapData="{Binding MerchantLogisticsMapData}" Height="250" IsVisible="{Binding HasMerchantLogisticsNodes}"/>

                                <ItemsControl ItemsSource="{Binding MerchantLogisticsMapData.Nodes}" IsVisible="{Binding HasMerchantLogisticsNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,12,*" Margin="0">
                                                <StackPanel Width="20" VerticalAlignment="Stretch">
                                                    <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Center"
                                                            Background="#66BB6A" Margin="0 4 0 0"/>
                                                    <Border Width="2" Background="#3066BB6A" HorizontalAlignment="Center"
                                                            Margin="0 2 0 0" VerticalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" Margin="0 0 0 16">
                                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                               FontSize="11" Foreground="#888888"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#AAAAAA"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Panel>

                <!-- 调价确认对话框 -->
                <Border Classes="SurfaceCard" Padding="24" IsVisible="{Binding ShowPriceAdjustDialog}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel Spacing="16">
                        <TextBlock Text="确认调价" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="商品名称" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBlock Text="{Binding SelectedPriceAdjustment.ProductName}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前价格" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBlock Text="{Binding SelectedPriceAdjustment.CurrentPrice, StringFormat='¥{0:F2}'}" FontSize="18" Foreground="#888888" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="建议价格" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBlock Text="{Binding SelectedPriceAdjustment.SuggestedPrice, StringFormat='¥{0:F2}'}" FontSize="18" Foreground="#42A5F5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#25EF5350" CornerRadius="6" Padding="8 4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPriceAdjustment.ChangePercent, StringFormat='价格变动: {0:+0.0;-0.0}%'}" FontSize="12" Foreground="#EF5350" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="调价原因" FontSize="12" Foreground="#AAAAAA"/>
                            <TextBlock Text="{Binding SelectedPriceAdjustment.Reason}" FontSize="12" Foreground="#CCCCCC" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10"
                                    Click="OnCancelPriceAdjustClick"/>
                            <Button Content="确认调价" Classes="PrimaryAction" Padding="24 10" CornerRadius="10"
                                    Click="OnConfirmPriceAdjustClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 编辑商品抽屉式侧边栏 (放在ScrollViewer外面，固定在右侧顶部) -->
        <Panel IsVisible="{Binding ShowEditProductDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="#80000000" Tapped="OnEditDrawerOverlayTapped" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#1E1E2E" BorderBrush="#333333" BorderThickness="1 0 0 1"
                    Width="420" MaxWidth="500" MaxHeight="900"
                    CornerRadius="0 0 0 16" Margin="0 20 0 0">
                <Border.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 抽屉标题栏 -->
                    <Border Grid.Row="0" Padding="20 16" BorderBrush="#333333" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="编辑商品" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="{Binding EditProductName}" FontSize="12" Foreground="#888888" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="QuietAction" Padding="8" CornerRadius="8"
                                    Click="OnCancelEditProductClick" ToolTip.Tip="关闭">
                                <TextBlock Text="✕" FontSize="16" Foreground="#AAAAAA"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 抽屉内容区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="商品名称 *" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding EditProductName}" Watermark="请输入商品名称"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="售价 *" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBox Text="{Binding EditProductPrice}" Watermark="0.00"
                                             Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="市场价" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBox Text="{Binding EditProductMarketPrice}" Watermark="0.00"
                                             Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="库存 *" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBox Text="{Binding EditProductStock}" Watermark="0"
                                             Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="单位" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBox Text="{Binding EditProductUnit}" Watermark="束"
                                             Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Text="商品描述" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding EditProductDescription}" Watermark="请输入商品描述"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"
                                         AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="图片URL" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding EditProductImages}" Watermark="图片URL，多个用逗号分隔"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"/>
                            </StackPanel>

                            <!-- SKU管理 -->
                            <Border Height="1" Background="#333333" Margin="0 4"/>
                            <TextBlock Text="SKU管理" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding NewSkuColor}" Watermark="颜色" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding NewSkuSize}" Watermark="尺码" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                <TextBox Grid.Column="2" Text="{Binding NewSkuVersion}" Watermark="版本" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                <TextBox Grid.Column="3" Text="{Binding NewSkuPrice}" Watermark="价格" Width="60" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                                <TextBox Grid.Column="4" Text="{Binding NewSkuStock}" Watermark="库存" Width="60" Padding="8 6" CornerRadius="6" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF" FontSize="11"/>
                            </Grid>
                            <Button Content="+ 添加SKU" Classes="QuietAction" Padding="16 6" CornerRadius="8" FontSize="12"
                                    HorizontalAlignment="Left" Click="OnAddSkuClick"/>

                            <ItemsControl ItemsSource="{Binding EditProductSKUs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#2A2A3E" CornerRadius="6" Padding="8 6" Margin="0 2 0 0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SalePrice, StringFormat='¥{0:F2}'}" FontSize="12" Foreground="#FF6B6B" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Stock, StringFormat='库存:{0}'}" FontSize="11" Foreground="#888888" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="删除" FontSize="10" Padding="8 4" CornerRadius="4"
                                                        Foreground="#EF5350" Background="Transparent"
                                                        Click="OnDeleteSkuClick" Tag="{Binding Id}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 抽屉底部操作栏 -->
                    <Border Grid.Row="2" Padding="20 16" BorderBrush="#333333" BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10" MinWidth="80"
                                    Click="OnCancelEditProductClick"/>
                            <Button Content="保存" Classes="PrimaryAction" Padding="24 10" CornerRadius="10" MinWidth="80"
                                    Click="OnSaveEditProductClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Panel>

        <!-- 审核对话框遮罩 -->
        <Panel IsVisible="{Binding ShowAuditDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="#80000000" Tapped="OnAuditOverlayTapped" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#1E1E2E" BorderBrush="#333333" BorderThickness="1 0 0 1"
                    Width="420" MaxWidth="500"
                    CornerRadius="16" Margin="0 20 0 0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 对话框标题栏 -->
                    <Border Grid.Row="0" Padding="20 16" BorderBrush="#333333" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="商品审核" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                            <Button Grid.Column="1" Classes="QuietAction" Padding="8" CornerRadius="8"
                                    Click="OnCancelAuditClick" ToolTip.Tip="关闭">
                                <TextBlock Text="✕" FontSize="16" Foreground="#AAAAAA"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 对话框内容区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="审核结果 *" FontSize="12" Foreground="#AAAAAA"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton Content="审核通过" GroupName="AuditApproved"
                                                 IsChecked="{Binding AuditApproved, Converter={StaticResource BoolToIntEqualOneConverter}}"
                                                 Padding="16 10" CornerRadius="10" Background="#2A2A3E" Foreground="#FFFFFF"
                                                 FontSize="13"
                                                 Tag="1"
                                                 Click="OnAuditRadioClick"/>
                                    <RadioButton Content="审核拒绝" GroupName="AuditApproved"
                                                 IsChecked="{Binding AuditApproved, Converter={StaticResource BoolToIntEqualZeroConverter}}"
                                                 Padding="16 10" CornerRadius="10" Background="#2A2A3E" Foreground="#FFFFFF"
                                                 FontSize="13"
                                                 Tag="0"
                                                 Click="OnAuditRadioClick"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding AuditApproved, Converter={StaticResource EqualToZeroConverter}}">
                                <TextBlock Text="拒绝原因" FontSize="12" Foreground="#AAAAAA"/>
                                <TextBox Text="{Binding AuditReason}" Watermark="请输入拒绝原因"
                                         Padding="12 10" CornerRadius="10" Background="#2A2A3E" BorderThickness="0" Foreground="#FFFFFF"
                                         AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 对话框底部操作栏 -->
                    <Border Grid.Row="2" Padding="20 16" BorderBrush="#333333" BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Classes="QuietAction" Padding="24 10" CornerRadius="10" MinWidth="80"
                                    Click="OnCancelAuditClick"/>
                            <Button Content="确认审核" Classes="PrimaryAction" Padding="24 10" CornerRadius="10" MinWidth="80"
                                    Click="OnConfirmAuditClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Panel>

        <!-- 加载中 -->
        <Border Classes="SurfaceCard" Padding="40" IsVisible="{Binding IsLoading}" ZIndex="500">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="加载中..." FontSize="13" Foreground="#888888" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</controls:GalleryPage>
</UserControl>
