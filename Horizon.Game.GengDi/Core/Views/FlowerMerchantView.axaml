<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerMerchantView"
             x:DataType="vm:FlowerMerchantViewModel">

    <UserControl.Resources>
        <converters:EqualToZeroConverter x:Key="EqualToZeroConverter" />
        <converters:EqualToOneConverter x:Key="EqualToOneConverter" />
        <converters:EqualToTwoConverter x:Key="EqualToTwoConverter" />
        <converters:EqualToThreeConverter x:Key="EqualToThreeConverter" />
        <converters:BoolToIntEqualOneConverter x:Key="BoolToIntEqualOneConverter" />
        <converters:BoolToIntEqualZeroConverter x:Key="BoolToIntEqualZeroConverter" />
    </UserControl.Resources>

    <controls:GalleryPage Title="商家管理"
                          Subtitle="商家后台仪表盘 · 订单管理 · 商品管理 · 经营统计"
                          Description="FlowerMerchantView.axaml"
                          IconSource="{StaticResource HomeIcon}">

        <!-- 使用Grid让抽屉面板覆盖整个内容区 -->
        <Grid>
            <!-- 主内容滚动区 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="0 0 0 24">

                <!-- ═══ 未注册 - 引导提示 ═══ -->
                <Border Classes="GdCard" Padding="48" IsVisible="{Binding ShowRegisterPrompt}">
                    <StackPanel HorizontalAlignment="Center" Spacing="20">
                        <TextBlock Text="🏪" FontSize="56" HorizontalAlignment="Center" Opacity="0.5"/>
                        <TextBlock Text="您还不是商家" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="注册成为商家后，即可发布商品、管理订单和查看经营数据" FontSize="13" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <TextBlock Text="✓ 免费入驻" FontSize="12" Foreground="{DynamicResource GdPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 商品管理" FontSize="12" Foreground="{DynamicResource GdPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 订单处理" FontSize="12" Foreground="{DynamicResource GdPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="✓ 经营统计" FontSize="12" Foreground="{DynamicResource GdPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="立即注册"
                                Classes="GdPrimary"
                                HorizontalAlignment="Center"
                                Padding="32 12"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                FontSize="14"
                                Command="{Binding ShowRegisterFormCommand}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ 未注册 - 注册表单 ═══ -->
                <Border Classes="GdCard" Padding="32" IsVisible="{Binding ShowRegisterForm}" MaxWidth="600" HorizontalAlignment="Center">
                    <StackPanel Spacing="20">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="注册商家" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="填写以下信息完成商家入驻" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="店铺名称 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBox Text="{Binding RegisterShopName}" Watermark="请输入店铺名称"
                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="商户类型" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <RadioButton Content="个人商户" IsChecked="True"
                                             GroupName="MerchantType" Padding="8 6" Click="OnRegisterTypeClick" Tag="0"/>
                                <RadioButton Content="企业商户" GroupName="MerchantType" Padding="8 6" Click="OnRegisterTypeClick" Tag="1"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="联系电话 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBox Text="{Binding RegisterPhone}" Watermark="请输入联系电话"
                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="店铺描述" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBox Text="{Binding RegisterDescription}" Watermark="简要描述您的店铺（选填）"
                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"
                                     Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Command="{Binding CancelRegisterCommand}"/>
                            <Button Content="提交注册" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Name="RegisterMerchantButton"
                                    Click="OnRegisterMerchantClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 已注册 - 商家内容 ═══ -->
                <Panel IsVisible="{Binding ShowMerchantContent}">
                    <StackPanel Spacing="16">

                        <!-- ═══ 商户信息卡（匹配原型：圆形logo + 店铺名 + 认证badge + 信誉badge + 地址信息 + 刷新按钮）═══ -->
                        <Border Classes="GdCard" Padding="20" Margin="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <!-- 圆形 logo -->
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource GdInfoSurfaceBrush}">
                                    <TextBlock Text="🏪" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- 店铺信息 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding MerchantInfo.ShopName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        <!-- 已认证 badge -->
                                        <Border Classes="GdBadge GdBadgeSuccess" IsVisible="{Binding MerchantInfo.IsVerified}">
                                            <TextBlock Text="✓ 已认证"/>
                                        </Border>
                                        <!-- 待认证 badge -->
                                        <Border Classes="GdBadge GdBadgeWarning" IsVisible="{Binding !MerchantInfo.IsVerified}">
                                            <TextBlock Text="待认证"/>
                                        </Border>
                                        <!-- 信誉 badge -->
                                        <Border Classes="GdBadge GdBadgeInfo">
                                            <TextBlock Text="{Binding ShopGradeDisplay}"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- 地址信息行 -->
                                    <TextBlock FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}">
                                        <Run Text="{Binding MerchantInfo.Description}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding MerchantTypeDisplay}"/>
                                        <Run Text=" · 联系电话 "/>
                                        <Run Text="{Binding MerchantInfo.ContactPhone}"/>
                                    </TextBlock>
                                </StackPanel>
                                <!-- 刷新按钮 -->
                                <Button Grid.Column="2" Classes="GdGhost" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                        VerticalAlignment="Center"
                                        Command="{Binding LoadMerchantCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⟳" FontSize="13"/>
                                        <TextBlock Text="刷新" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══ Tab 栏（保留现有Tab系统，匹配原型样式）═══ -->
                        <Border Classes="GdCard" Padding="4" Margin="0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Content="概览" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="0"/>
                                    <Button Content="商品" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="1"/>
                                    <Button Content="发布" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="2"/>
                                    <Button Content="订单" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="3"/>
                                    <Button Content="退款" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="4"/>
                                    <Button Content="结算" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="5"/>
                                    <Button Content="设置" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="6"/>
                                    <Button Content="运费" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                            Click="OnTabClick" Tag="9"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- 状态消息 -->
                        <Border Classes="GdCard" Padding="12 8" Margin="0" IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource GdBrand400Brush}"/>
                        </Border>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 0: 概览（100% 匹配原型布局）═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowOverviewPanel}">

                            <!-- 统计卡 4 列（匹配原型：今日订单/今日营收/待发货/库存预警，每个带图标+数值+delta）-->
                            <UniformGrid Columns="4" Rows="1">
                                <!-- 今日订单 -->
                                <Border Classes="GdStatCard" Margin="0 0 8 0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🛍" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Classes="GdStatLabel" Text="今日订单"/>
                                        </StackPanel>
                                        <TextBlock Classes="GdStatValue" Text="{Binding TodayOrders}" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        <TextBlock Classes="GdStatDelta" Text="📈 +3 较昨日" Foreground="{DynamicResource GdSuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- 今日营收 -->
                                <Border Classes="GdStatCard" Margin="4 0 4 0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🏦" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Classes="GdStatLabel" Text="今日营收"/>
                                        </StackPanel>
                                        <TextBlock Classes="GdStatValue" Text="{Binding TodayRevenue, StringFormat='¥{0:F0}'}" Foreground="{DynamicResource GdInfoBrush}"/>
                                        <TextBlock Classes="GdStatDelta" Text="📈 +18.2%" Foreground="{DynamicResource GdSuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- 待发货 -->
                                <Border Classes="GdStatCard" Margin="4 0 4 0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="🚚" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Classes="GdStatLabel" Text="待发货"/>
                                        </StackPanel>
                                        <TextBlock Classes="GdStatValue" Text="{Binding PendingShipCount}" Foreground="{DynamicResource GdWarningBrush}"/>
                                        <TextBlock Classes="GdStatDelta" Text="需 24h 内处理" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
                                <!-- 库存预警 -->
                                <Border Classes="GdStatCard" Margin="8 0 0 0">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="📦" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Classes="GdStatLabel" Text="库存预警"/>
                                        </StackPanel>
                                        <TextBlock Classes="GdStatValue" Text="{Binding LowStockCount}" Foreground="{DynamicResource GdErrorBrush}"/>
                                        <TextBlock Classes="GdStatDelta" Text="{Binding LowStockProductNames}" Foreground="{DynamicResource GdMutedForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- ═══ 订单管理表格（匹配原型：pill筛选标签 + DataGrid，列：订单号/买家/商品/数量/金额/状态/操作）═══ -->
                            <Border Classes="GdCard" Padding="16" Margin="0">
                                <StackPanel Spacing="12">
                                    <!-- 表头：标题 + 计数badge + pill筛选 -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="订单管理" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                                            <Border Classes="GdBadge GdBadgeInfo">
                                                <TextBlock Text="{Binding Orders.Count, StringFormat='共 {0} 条'}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="GdPill GdPillActive" Content="全部" Click="OnOrderStatusFilterClick" Tag="-1"/>
                                            <Button Classes="GdPill" Content="待付款" Click="OnOrderStatusFilterClick" Tag="0"/>
                                            <Button Classes="GdPill" Content="待发货" Click="OnOrderStatusFilterClick" Tag="1"/>
                                            <Button Classes="GdPill" Content="已发货" Click="OnOrderStatusFilterClick" Tag="2"/>
                                            <Button Classes="GdPill" Content="已完成" Click="OnOrderStatusFilterClick" Tag="3"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 表格头 -->
                                    <Border Classes="GdDivider" Margin="0"/>
                                    <Grid ColumnDefinitions="1.4*,1*,1.4*,0.5*,0.8*,0.8*,1*" ColumnSpacing="8">
                                        <TextBlock Text="订单号" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="1" Text="买家" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="2" Text="商品" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="3" Text="数量" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="4" Text="金额" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="5" Text="状态" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBlock Grid.Column="6" Text="操作" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    </Grid>

                                    <!-- 订单行 -->
                                    <ItemsControl ItemsSource="{Binding Orders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0 8" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 0 0 1">
                                                    <Grid ColumnDefinitions="1.4*,1*,1.4*,0.5*,0.8*,0.8*,1*" ColumnSpacing="8" VerticalAlignment="Center">
                                                        <!-- 订单号 -->
                                                        <TextBlock Text="{Binding OrderNo}" FontSize="12" FontFamily="{DynamicResource GdFontMono}" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center"/>
                                                        <!-- 买家 -->
                                                        <TextBlock Grid.Column="1" Text="{Binding ShipTo}" FontSize="12" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- 商品 -->
                                                        <TextBlock Grid.Column="2" Text="{Binding FirstProductName}" FontSize="12" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <!-- 数量 -->
                                                        <TextBlock Grid.Column="3" Text="{Binding FirstItemQuantity}" FontSize="12" FontFamily="{DynamicResource GdFontMono}" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center"/>
                                                        <!-- 金额 -->
                                                        <TextBlock Grid.Column="4" Text="{Binding TotalAmount, StringFormat='¥{0:F2}'}" FontSize="12" FontFamily="{DynamicResource GdFontMono}" FontWeight="SemiBold" Foreground="{DynamicResource GdErrorBrush}" VerticalAlignment="Center"/>
                                                        <!-- 状态 -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border Classes="GdBadge GdBadgeWarning" IsVisible="{Binding Status, Converter={StaticResource EqualToOneConverter}}">
                                                                <TextBlock Text="待发货"/>
                                                            </Border>
                                                            <Border Classes="GdBadge GdBadgeInfo" IsVisible="{Binding Status, Converter={StaticResource EqualToTwoConverter}}">
                                                                <TextBlock Text="已发货"/>
                                                            </Border>
                                                            <Border Classes="GdBadge GdBadgeSuccess" IsVisible="{Binding Status, Converter={StaticResource EqualToThreeConverter}}">
                                                                <TextBlock Text="已完成"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <!-- 操作 -->
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Button Content="发货" Classes="GdPill" Padding="10 4" FontSize="11"
                                                                    IsVisible="{Binding CanShip}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ShowShipDialogCommand}"
                                                                    CommandParameter="{Binding OrderId}"/>
                                                            <Button Content="物流" Classes="GdPill" Padding="10 4" FontSize="11"
                                                                    IsVisible="{Binding CanViewLogistics}"
                                                                    Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ViewMerchantLogisticsCommand}"
                                                                    CommandParameter="{Binding OrderId}"/>
                                                            <Button Content="详情" Classes="GdPill" Padding="10 4" FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ViewMerchantLogisticsCommand}"
                                                                    CommandParameter="{Binding OrderId}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 空状态 -->
                                    <Border Padding="20" IsVisible="{Binding !HasOrders}">
                                        <TextBlock Text="暂无订单" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ═══ 商品管理网格卡（匹配原型：4列商品卡片，每个带emoji图标+名称+状态badge+价格+库存）═══ -->
                            <Border Classes="GdCard" Padding="16" Margin="0">
                                <StackPanel Spacing="14">
                                    <!-- 表头：标题 + 发布按钮 -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="商品管理" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Classes="GdPrimary" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13"
                                                Click="OnTabClick" Tag="2">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="+" FontSize="13"/>
                                                <TextBlock Text="发布商品" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- 4列商品网格 -->
                                    <ItemsControl ItemsSource="{Binding Products}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="GdCard" Padding="14" Margin="4" CornerRadius="{DynamicResource GdRadiusMd}">
                                                    <StackPanel Spacing="10">
                                                        <!-- 图标 + 名称 + 状态 -->
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <!-- emoji 图标 -->
                                                            <Border Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdErrorSurfaceBrush}">
                                                                <TextBlock Text="🌸" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                                                <!-- 状态 badge -->
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <Border Classes="GdBadge GdBadgeSuccess" IsVisible="{Binding IsActive}">
                                                                        <TextBlock Text="已上架"/>
                                                                    </Border>
                                                                    <Border Classes="GdBadge GdBadgeInfo" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToOneConverter}}">
                                                                        <TextBlock Text="已通过"/>
                                                                    </Border>
                                                                    <Border Classes="GdBadge GdBadgeWarning" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToZeroConverter}}">
                                                                        <TextBlock Text="待审核"/>
                                                                    </Border>
                                                                    <Border Classes="GdBadge GdBadgeError" IsVisible="{Binding !IsActive}">
                                                                        <TextBlock Text="下架"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>
                                                        <!-- 价格 + 库存 -->
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="{Binding Price, StringFormat='¥{0:F2}'}" FontSize="16" FontWeight="SemiBold" FontFamily="{DynamicResource GdFontMono}" Foreground="{DynamicResource GdErrorBrush}"/>
                                                            <TextBlock Text="{Binding Stock, StringFormat='库存 {0}'}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Bottom"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 空状态 -->
                                    <Border Padding="20" IsVisible="{Binding !HasProducts}">
                                        <TextBlock Text="暂无商品，去发布吧" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- ═══ 数据统计区（匹配原型：2:1 网格 - 左侧营收趋势图区域 + 右侧品类销售占比图区域）═══ -->
                            <Grid ColumnDefinitions="2*,1*" ColumnSpacing="16">
                                <!-- 左侧：营收趋势 -->
                                <Border Classes="GdCard" Padding="16" Margin="0" Height="300">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="近 7 日营收趋势" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalRevenue, StringFormat='累计 ¥{0:F0}'}" FontSize="12" FontFamily="{DynamicResource GdFontMono}" Foreground="{DynamicResource GdInfoBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- 图表区域：近 7 日营收趋势折线图 -->
                                        <lvc:CartesianChart Series="{Binding RevenueTrendSeries}"
                                                            XAxes="{Binding RevenueXAxes}"
                                                            YAxes="{Binding RevenueYAxes}"
                                                            Height="240" />
                                    </StackPanel>
                                </Border>
                                <!-- 右侧：品类占比 -->
                                <Border Grid.Column="1" Classes="GdCard" Padding="16" Margin="0" Height="300">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="品类销售占比" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        <!-- 图表区域：品类销售占比饼图 -->
                                        <lvc:PieChart Series="{Binding CategoryPieSeries}"
                                                      Height="240" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 1: 商品管理 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowProductsPanel}">
                            <!-- 搜索和筛选 -->
                            <Border Classes="GdCard" Padding="12" Margin="0">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding SearchKeyword}" Watermark="搜索商品名称..."
                                             Padding="10 8" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                    <Button Grid.Column="1" Content="搜索" Classes="GdGhost" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                            Command="{Binding SearchProductsCommand}"/>
                                    <Button Grid.Column="2" Content="刷新" Classes="GdGhost" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                            Command="{Binding RefreshProductsCommand}"/>
                                </Grid>
                            </Border>

                            <!-- 分类筛选 -->
                            <Border Classes="GdCard" Padding="8 4" Margin="0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="全部" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="0"/>
                                        <Button Content="红玫瑰" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="1"/>
                                        <Button Content="百合" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="2"/>
                                        <Button Content="康乃馨" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="3"/>
                                        <Button Content="混合花束" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="4"/>
                                        <Button Content="红绿搭配" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusLg}" FontSize="11" Click="OnCategoryFilterClick" Tag="5"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- 智能调价建议 -->
                            <Border Classes="GdCard" Padding="12" Margin="0" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdWarningSurfaceBrush}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="智能调价建议" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdWarningBrush}" VerticalAlignment="Center"/>
                                        <Border Background="{DynamicResource GdWarningBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="6 2" IsVisible="{Binding HasPriceAdjustments}">
                                            <TextBlock Text="{Binding PriceAdjustmentSuggestions.Count, StringFormat='{}{0}条'}" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="查看建议" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="12"
                                            Command="{Binding LoadPriceAdjustmentsCommand}" Click="OnShowPriceAdjustmentsClick"/>
                                </Grid>
                            </Border>

                            <!-- 调价建议列表 -->
                            <ItemsControl ItemsSource="{Binding PriceAdjustmentSuggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GdCard" Padding="12" Margin="0 0 0 6" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                <StackPanel Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ProductName}" FontSize="13" FontWeight="SemiBold"/>
                                                        <Border Background="{DynamicResource GdErrorSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" Padding="6 2">
                                                            <TextBlock Text="{Binding ChangePercent, StringFormat='{}{0:+0.0;-0.0}%'}" FontSize="10" Foreground="{DynamicResource GdErrorBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding CurrentPrice, StringFormat='当前: ¥{0:F2}'}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                        <TextBlock Text="{Binding SuggestedPrice, StringFormat='建议: ¥{0:F2}'}" FontSize="11" Foreground="{DynamicResource GdBrand400Brush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}" TextWrapping="Wrap" MaxWidth="400"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="调整" Classes="GdPrimary" Padding="12 5" FontSize="11" CornerRadius="{DynamicResource GdRadiusMd}"
                                                        Click="OnAdjustPriceClick"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 商品列表 -->
                            <ItemsControl ItemsSource="{Binding Products}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GdCard" Padding="16" Margin="0 0 0 8" CornerRadius="{DynamicResource GdRadiusLg}">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                <!-- 商品编号 -->
                                                <Border Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProductCode}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </Border>
                                                <!-- 商品图标 -->
                                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdInfoSurfaceBrush}">
                                                    <TextBlock Text="🌸" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding ProductName}" FontSize="14" FontWeight="SemiBold"/>
                                                        <Border Classes="GdBadge GdBadgeWarning" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToZeroConverter}}">
                                                            <TextBlock Text="待审核"/>
                                                        </Border>
                                                        <Border Classes="GdBadge GdBadgeInfo" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToOneConverter}}">
                                                            <TextBlock Text="已通过"/>
                                                        </Border>
                                                        <Border Classes="GdBadge GdBadgeError" IsVisible="{Binding AuditStatus, Converter={StaticResource EqualToTwoConverter}}">
                                                            <TextBlock Text="已拒绝"/>
                                                        </Border>
                                                        <Border Classes="GdBadge GdBadgeSuccess" IsVisible="{Binding IsActive}">
                                                            <TextBlock Text="已上架"/>
                                                        </Border>
                                                        <Border Classes="GdBadge" Background="{DynamicResource GdMutedBrush}" IsVisible="{Binding !IsActive}">
                                                            <TextBlock Text="已下架" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <TextBlock Text="{Binding Price, StringFormat='¥{0:F2}'}" FontSize="13" Foreground="{DynamicResource GdErrorBrush}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Stock, StringFormat='库存: {0}'}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}">
                                                        <Button Padding="6 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdBrand400Brush}" Background="Transparent"
                                                                Click="OnMoveUpProductClick">▲</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}">
                                                        <Button Padding="6 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdBrand400Brush}" Background="Transparent"
                                                                Click="OnMoveDownProductClick">▼</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdBrand400Brush}" Background="Transparent"
                                                                Click="OnEditProductClick">编辑</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdWarningSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdWarningBrush}" Background="Transparent"
                                                                Click="OnAuditProductClick">审核</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdSuccessSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" IsVisible="{Binding !IsActive}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdPrimaryBrush}" Background="Transparent"
                                                                Click="OnActivateProductClick">上架</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdWarningSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" IsVisible="{Binding IsActive}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdWarningBrush}" Background="Transparent"
                                                                Click="OnDeactivateProductClick">下架</Button>
                                                    </Border>
                                                    <Border Background="{DynamicResource GdErrorSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}">
                                                        <Button Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Foreground="{DynamicResource GdErrorBrush}" Background="Transparent"
                                                                Click="OnDeleteProductClick">删除</Button>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="GdCard" Padding="40" IsVisible="{Binding !HasProducts}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="📦" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无商品，去发布吧" FontSize="14" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 2: 发布商品 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowPublishPanel}">
                            <Border Classes="GdCard" Padding="20" Margin="0">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="发布新商品" FontSize="16" FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="花卉品种 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <ComboBox ItemsSource="{Binding SpeciesOptions}" SelectedItem="{Binding SelectedSpeciesFilter}"
                                                  DisplayMemberBinding="{Binding DisplayName}"
                                                  Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                  HorizontalAlignment="Stretch"
                                                  Name="PublishSpeciesComboBox"/>
                                    </StackPanel>

                                    <!-- 建议价格区域 -->
                                    <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12" IsVisible="{Binding HasSuggestedPrice}">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="💡" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Text="智能建议价" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdBrand400Brush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SuggestedPriceDisplay}" FontSize="12" Foreground="{DynamicResource GdBrand400Brush}"/>
                                            <TextBlock Text="{Binding SuggestedPriceRange.Reason}" FontSize="11" Foreground="{DynamicResource GdBrand400Brush}" TextWrapping="Wrap" MaxWidth="400"/>
                                            <Button Content="采纳建议价" Classes="GdPrimary" Padding="16 6" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="12"
                                                    Command="{Binding AcceptSuggestedPriceCommand}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12" IsVisible="{Binding IsLoadingSuggestedPrice}">
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Width="100"/>
                                            <TextBlock Text="加载建议价..." FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品名称 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding NewProductName}" Watermark="请输入商品名称"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="价格 (¥) *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <TextBox Text="{Binding NewProductPrice}" Watermark="0.00"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="库存数量 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <TextBox Text="{Binding NewProductStock}" Watermark="0"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="计量单位" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <TextBox Text="{Binding NewProductUnit}" Watermark="束"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="分类" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                                                      DisplayMemberBinding="{Binding Name}"
                                                      Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                      HorizontalAlignment="Stretch"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="运费模板" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <ComboBox ItemsSource="{Binding FreightTemplates}" SelectedItem="{Binding SelectedFreightTemplate}"
                                                  DisplayMemberBinding="{Binding Name}"
                                                  Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                  HorizontalAlignment="Stretch"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品图片" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding NewProductImages}" Watermark="图片URL，多个用逗号分隔"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                            <Button Grid.Column="1" Content="📁 本地上传" Classes="GdGhost" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                                    FontSize="12" Click="OnLocalImageUploadClick" />
                                            <Button Grid.Column="2" Content="🔗 在线解析" Classes="GdGhost" Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                                    FontSize="12" Click="OnOnlineImageParseClick" />
                                        </Grid>
                                        <!-- 图片预览 -->
                                        <ItemsControl ItemsSource="{Binding NewProductImageList}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="8" Margin="0 0 8 8">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <Border Width="40" Height="40" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}">
                                                                <TextBlock Text="🖼" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <Button Grid.Column="2" Content="✕" Classes="GdGhost" Padding="4 2" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                    Click="OnRemoveImageClick" Tag="{Binding}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="商品描述" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding NewProductDescription}" Watermark="请输入商品描述"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"
                                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- 阶梯价格 -->
                                    <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <TextBlock Text="阶梯价格" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOpenLadder}"/>
                                            </Grid>
                                            <StackPanel Spacing="8" IsVisible="{Binding IsOpenLadder}">
                                                <ItemsControl ItemsSource="{Binding LadderPrices}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="8" Margin="0 0 0 6">
                                                                <TextBox Text="{Binding MinBatch}" Watermark="最小批量" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                                <TextBox Grid.Column="1" Text="{Binding MaxBatch}" Watermark="最大批量" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                                <TextBox Grid.Column="2" Text="{Binding Price}" Watermark="价格" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                                <Button Grid.Column="3" Content="✕" Classes="GdGhost" Padding="6 4" FontSize="11" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                        Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).RemoveLadderPriceCommand}"
                                                                        CommandParameter="{Binding}"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="+ 添加阶梯价格" Classes="GdGhost" Padding="12 6" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="11"
                                                        Command="{Binding AddLadderPriceCommand}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- SKU 配置 -->
                                    <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="SKU 配置" FontSize="13" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="颜色" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding SkuColors}" Watermark="红,蓝,白"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="尺寸" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding SkuSizes}" Watermark="S,M,L"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="4">
                                                    <TextBlock Text="版本" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding SkuVersions}" Watermark="标准,豪华"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="多个值用逗号分隔" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 预售设置 -->
                                    <Border Background="{DynamicResource GdErrorSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="🏷️" FontSize="14" VerticalAlignment="Center"/>
                                                    <TextBlock Text="预售商品" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdErrorBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsPresale}"/>
                                            </Grid>
                                            <StackPanel Spacing="8" IsVisible="{Binding ShowPresaleOptions}">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="关联种植批次" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <ComboBox ItemsSource="{Binding AvailableBatches}" SelectedItem="{Binding SelectedBatch}"
                                                              DisplayMemberBinding="{Binding BatchName}"
                                                              Padding="10 8" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                              HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="预计发货日期" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <CalendarDatePicker SelectedDate="{Binding PresaleDeliveryDate}"
                                                                        HorizontalAlignment="Stretch"
                                                                        CornerRadius="{DynamicResource GdRadiusMd}"/>
                                                </StackPanel>
                                                <Border Background="{DynamicResource GdErrorSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" Padding="8 4">
                                                    <TextBlock Text="预售商品将在关联批次收获后自动通知买家" FontSize="10" Foreground="{DynamicResource GdErrorBrush}" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="发布商品" Classes="GdPrimary" Padding="24 12" CornerRadius="{DynamicResource GdRadiusMd}"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Name="PublishProductButton"
                                            Click="OnPublishProductClick"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 3: 订单管理 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowOrdersPanel}">
                            <!-- 订单状态筛选 -->
                            <Border Classes="GdCard" Padding="8 4" Margin="0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="全部" Classes="GdPill GdPillActive" Click="OnOrderStatusFilterClick" Tag="-1"/>
                                        <Button Content="待付款" Classes="GdPill" Click="OnOrderStatusFilterClick" Tag="0"/>
                                        <Button Content="待发货" Classes="GdPill" Click="OnOrderStatusFilterClick" Tag="1"/>
                                        <Button Content="已发货" Classes="GdPill" Click="OnOrderStatusFilterClick" Tag="2"/>
                                        <Button Content="已完成" Classes="GdPill" Click="OnOrderStatusFilterClick" Tag="3"/>
                                        <Button Content="已关闭" Classes="GdPill" Click="OnOrderStatusFilterClick" Tag="4"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <Border Classes="GdCard" Padding="8 6" Margin="0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Orders.Count, StringFormat='订单列表 ({0})'}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="刷新" Classes="GdGhost" Padding="10 4" FontSize="11" CornerRadius="{DynamicResource GdRadiusSm}"
                                            Command="{Binding RefreshOrdersCommand}"/>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Orders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GdCard" Padding="16" Margin="0 0 0 8" CornerRadius="{DynamicResource GdRadiusLg}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding OrderNo}" FontSize="13" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Classes="GdBadge GdBadgeWarning" IsVisible="{Binding CanShip}">
                                                        <TextBlock Text="待发货"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Classes="GdBadge GdBadgeInfo" IsVisible="{Binding CanViewLogistics}">
                                                        <TextBlock Text="已发货"/>
                                                    </Border>
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding Items}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0 2 0 0">
                                                                <TextBlock Text="{Binding ProductName}" FontSize="12"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                                    <TextBlock Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                                    <TextBlock Text="{Binding Subtotal, StringFormat='¥{0:F2}'}" FontSize="12" Foreground="{DynamicResource GdErrorBrush}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Height="1" Background="{DynamicResource GdBorderBrush}"/>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding TotalAmount, StringFormat='合计: ¥{0:F2}'}" FontSize="13" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                        <Button Content="发货" Classes="GdPrimary" Padding="12 5" FontSize="11" CornerRadius="{DynamicResource GdRadiusMd}"
                                                                IsEnabled="{Binding CanShip}"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ShowShipDialogCommand}"
                                                                CommandParameter="{Binding OrderId}"/>
                                                        <Button Content="物流" Classes="GdGhost" Padding="12 5" FontSize="11" CornerRadius="{DynamicResource GdRadiusMd}"
                                                                IsVisible="{Binding CanViewLogistics}"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ViewMerchantLogisticsCommand}"
                                                                CommandParameter="{Binding OrderId}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="GdCard" Padding="40" IsVisible="{Binding !HasOrders}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="📋" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无订单" FontSize="14" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 4: 退款管理 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="12" IsVisible="{Binding ShowRefundsPanel}">
                            <Border Classes="GdCard" Padding="8 4" Margin="0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="全部" Classes="GdPill GdPillActive" Click="OnRefundStatusFilterClick" Tag="-1"/>
                                        <Button Content="待审核" Classes="GdPill" Click="OnRefundStatusFilterClick" Tag="0"/>
                                        <Button Content="已同意" Classes="GdPill" Click="OnRefundStatusFilterClick" Tag="1"/>
                                        <Button Content="已拒绝" Classes="GdPill" Click="OnRefundStatusFilterClick" Tag="2"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Refunds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="GdCard" Padding="16" Margin="0 0 0 8" CornerRadius="{DynamicResource GdRadiusLg}">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding RefundNo}" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Reason}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Classes="GdBadge GdBadgeError">
                                                        <TextBlock Text="{Binding Status}"/>
                                                    </Border>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding RefundAmount, StringFormat='退款: ¥{0:F2}'}" FontSize="13" Foreground="{DynamicResource GdErrorBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Content="同意" Classes="GdPrimary" Padding="12 5" FontSize="11" CornerRadius="{DynamicResource GdRadiusMd}"
                                                            Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).ApproveRefundCommand}"
                                                            CommandParameter="{Binding Id}"/>
                                                    <Button Grid.Column="2" Content="拒绝" Classes="GdGhost" Padding="12 5" FontSize="11" CornerRadius="{DynamicResource GdRadiusMd}"
                                                            Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).RejectRefundCommand}"
                                                            CommandParameter="{Binding Id}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Classes="GdCard" Padding="40" IsVisible="{Binding !HasRefunds}">
                                <StackPanel HorizontalAlignment="Center" Spacing="12">
                                    <TextBlock Text="💰" FontSize="32" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无退款申请" FontSize="14" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 5: 结算管理 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowSettlementPanel}">
                            <!-- 结算账户 -->
                            <Border Classes="GdCard" Padding="20" Margin="0">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="结算账户" FontSize="16" FontWeight="SemiBold"/>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="银行名称" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <TextBox Text="{Binding SettlementBankName}" Watermark="请输入银行名称"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="银行账号" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                            <TextBox Text="{Binding SettlementAccountNo}" Watermark="请输入银行账号"
                                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="户名" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding SettlementAccountName}" Watermark="请输入户名"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                    </StackPanel>

                                    <Button Content="保存结算账户" Classes="GdPrimary" Padding="24 12" CornerRadius="{DynamicResource GdRadiusMd}"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Command="{Binding SaveSettlementAccountCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- 结算账单 -->
                            <Border Classes="GdCard" Padding="16" Margin="0">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="结算账单" FontSize="14" FontWeight="SemiBold"/>
                                    <ItemsControl ItemsSource="{Binding SettlementBills}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0 0 0 6" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Remark}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding Amount, StringFormat='¥{0:F2}'}" FontSize="14" Foreground="{DynamicResource GdErrorBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                            <Border Classes="GdBadge GdBadgeSuccess" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding Status}"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Padding="20" IsVisible="{Binding !HasSettlementBills}">
                                        <TextBlock Text="暂无结算记录" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <!-- ═══ Tab 6: 店铺设置 ═══ -->
                        <!-- ═══════════════════════════════════════════════════════════ -->
                        <StackPanel Spacing="16" IsVisible="{Binding ShowSettingsPanel}">
                            <!-- 店铺信息 -->
                            <Border Classes="GdCard" Padding="20" Margin="0">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="店铺设置" FontSize="16" FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="店铺名称" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding EditShopName}"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="联系电话" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding EditPhone}"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="店铺描述" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                        <TextBox Text="{Binding EditDescription}"
                                                 Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"
                                                 Height="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Content="保存修改" Classes="GdPrimary" Padding="24 12" CornerRadius="{DynamicResource GdRadiusMd}"
                                            HorizontalAlignment="Center" FontSize="14"
                                            Command="{Binding SaveShopSettingsCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- 发货点管理 -->
                            <Border Classes="GdCard" Padding="20" Margin="0">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="发货点管理" FontSize="14" FontWeight="SemiBold"/>

                                    <ItemsControl ItemsSource="{Binding Shippers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12" Margin="0 0 0 6" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding ShipperName}" FontSize="12" FontWeight="SemiBold"/>
                                                                <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" Padding="4 1" IsVisible="{Binding IsDefaultSendGoods}">
                                                                    <TextBlock Text="默认" FontSize="9" Foreground="{DynamicResource GdBrand400Brush}"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Address}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                            <TextBlock Text="{Binding TelPhone}" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="删除" Classes="GdGhost" Padding="10 5" FontSize="10" CornerRadius="{DynamicResource GdRadiusSm}"
                                                                Command="{Binding $parent[ItemsControl].((vm:FlowerMerchantViewModel)DataContext).DeleteShipperCommand}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Padding="20" IsVisible="{Binding !HasShippers}">
                                        <TextBlock Text="暂无发货点" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 添加发货点 -->
                                    <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="添加发货点" FontSize="12" FontWeight="SemiBold"/>
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="标签" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding NewShipperTag}" Watermark="如：仓库A"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="名称 *" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding NewShipperName}" Watermark="发货点名称"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="地址 *" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                <TextBox Text="{Binding NewShipperAddress}" Watermark="详细地址"
                                                         Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                            </StackPanel>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="电话" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBox Text="{Binding NewShipperPhone}" Watermark="联系电话"
                                                             Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="添加" Classes="GdPrimary" Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="12"
                                                        VerticalAlignment="Bottom"
                                                        Command="{Binding AddShipperCommand}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </Panel>

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- ═══ Tab 9: 运费模板管理 ═══ -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Panel IsVisible="{Binding ShowFreightPanel}">
                    <StackPanel Spacing="16">
                        <Border Classes="GdCard" Padding="16 12" Margin="0" CornerRadius="{DynamicResource GdRadiusLg}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="运费模板管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ 新增模板" Classes="GdPrimary" Padding="16 8"
                                        CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13" Click="OnOpenFreightTemplateDialogClick" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding FreightTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="GdCard" Padding="16" CornerRadius="{DynamicResource GdRadiusLg}" Margin="0 0 0 8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Border Classes="GdBadge GdBadgeSuccess" IsVisible="{Binding IsFree}">
                                                        <TextBlock Text="包邮" />
                                                    </Border>
                                                    <Border Classes="GdBadge GdBadgeWarning" IsVisible="{Binding !IsFree}">
                                                        <TextBlock Text="计费" />
                                                    </Border>
                                                    <TextBlock Text="{Binding FirstPrice, StringFormat='首件 ¥{0:F2}'}" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                               IsVisible="{Binding !IsFree}" />
                                                    <TextBlock Text="{Binding ContinuePrice, StringFormat='续件 ¥{0:F2}'}" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                               IsVisible="{Binding !IsFree}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="删除" FontSize="11" Padding="10 5" CornerRadius="{DynamicResource GdRadiusSm}"
                                                    Foreground="{DynamicResource GdErrorBrush}" Background="Transparent"
                                                    Click="OnDeleteFreightTemplateClick" Tag="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Panel>

                <!-- ═══ 运费模板弹窗 ═══ -->
                <Border Classes="GdCard" Padding="24" IsVisible="{Binding ShowFreightTemplateDialog}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                    <StackPanel Spacing="16">
                        <TextBlock Text="新增运费模板" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="模板名称 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBox Text="{Binding NewTemplateName}" Watermark="如：默认运费模板"
                                     Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                        </StackPanel>
                        <CheckBox Content="包邮（免运费）" IsChecked="{Binding NewTemplateIsFree}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding !NewTemplateIsFree}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="首件价格" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding NewTemplateFirstPrice}" Watermark="0.00"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="续件价格" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding NewTemplateContinuePrice}" Watermark="0.00"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnCancelFreightTemplateClick"/>
                            <Button Content="创建" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnSaveFreightTemplateClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 发货弹窗遮罩 ═══ -->
                <Panel IsVisible="{Binding ShowShipDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
                    <Border Background="{DynamicResource GdOverlayBrush}" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Classes="GdCard" Padding="24" MaxWidth="400">
                        <StackPanel Spacing="16">
                            <TextBlock Text="填写发货信息" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="物流公司 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <ComboBox ItemsSource="{Binding ExpressCompanies}"
                                          SelectedItem="{Binding SelectedExpressCompany}"
                                          Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="运单号 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding ShipOrderNumber}" Watermark="请输入运单号"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                        Command="{Binding CancelShipCommand}"/>
                                <Button Content="确认发货" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                        Command="{Binding ConfirmShipCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- ═══ 物流跟踪弹窗 ═══ -->
                <Panel IsVisible="{Binding ShowMerchantLogisticsDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
                    <Border Background="{DynamicResource GdOverlayBrush}" />
                    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="24" MaxWidth="480" MaxHeight="600">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="物流跟踪" FontSize="16" FontWeight="SemiBold"/>
                                    <Button Grid.Column="1" Content="✕" Classes="GdGhost" Padding="8 4" CornerRadius="{DynamicResource GdRadiusMd}"
                                            Command="{Binding CloseMerchantLogisticsDialogCommand}"/>
                                </Grid>

                                <Border Background="{DynamicResource GdInfoSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusMd}" Padding="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}">
                                            <Run Text="快递公司："/>
                                            <Run Text="{Binding MerchantLogisticsMapData.ExpressCompanyName}" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}">
                                            <Run Text="运单号："/>
                                            <Run Text="{Binding MerchantLogisticsMapData.ShipOrderNumber}" Foreground="{DynamicResource GdForegroundBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <StackPanel IsVisible="{Binding IsLoadingMerchantLogistics}" HorizontalAlignment="Center" Spacing="8" Margin="0 20">
                                    <TextBlock Text="⏳" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="正在查询物流信息..." FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding HasNoMerchantLogistics}" HorizontalAlignment="Center" Spacing="8" Margin="0 20">
                                    <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="暂无物流信息" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <controls:LogisticsMapView MapData="{Binding MerchantLogisticsMapData}" Height="250" IsVisible="{Binding HasMerchantLogisticsNodes}"/>

                                <ItemsControl ItemsSource="{Binding MerchantLogisticsMapData.Nodes}" IsVisible="{Binding HasMerchantLogisticsNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,12,*" Margin="0">
                                                <StackPanel Width="20" VerticalAlignment="Stretch">
                                                    <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Center"
                                                            Background="{DynamicResource GdPrimaryBrush}" Margin="0 4 0 0"/>
                                                    <Border Width="2" Background="{DynamicResource GdInfoSurfaceBrush}" HorizontalAlignment="Center"
                                                            Margin="0 2 0 0" VerticalAlignment="Stretch"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" Margin="0 0 0 16">
                                                    <TextBlock Text="{Binding Time, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                               FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Panel>

                <!-- ═══ 调价确认对话框 ═══ -->
                <Border Classes="GdCard" Padding="24" IsVisible="{Binding ShowPriceAdjustDialog}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <StackPanel Spacing="16">
                        <TextBlock Text="确认调价" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="商品名称" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBlock Text="{Binding SelectedPriceAdjustment.ProductName}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前价格" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBlock Text="{Binding SelectedPriceAdjustment.CurrentPrice, StringFormat='¥{0:F2}'}" FontSize="18" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="建议价格" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBlock Text="{Binding SelectedPriceAdjustment.SuggestedPrice, StringFormat='¥{0:F2}'}" FontSize="18" Foreground="{DynamicResource GdBrand400Brush}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource GdErrorSurfaceBrush}" CornerRadius="{DynamicResource GdRadiusSm}" Padding="8 4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPriceAdjustment.ChangePercent, StringFormat='价格变动: {0:+0.0;-0.0}%'}" FontSize="12" Foreground="{DynamicResource GdErrorBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Spacing="8">
                            <TextBlock Text="调价原因" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            <TextBlock Text="{Binding SelectedPriceAdjustment.Reason}" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" TextWrapping="Wrap" MaxWidth="380"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                            <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnCancelPriceAdjustClick"/>
                            <Button Content="确认调价" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnConfirmPriceAdjustClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 编辑商品抽屉式侧边栏 (放在ScrollViewer外面，固定在右侧顶部) ═══ -->
        <Panel IsVisible="{Binding ShowEditProductDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnEditDrawerOverlayTapped" />
            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{DynamicResource GdCardBrush}" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="1 0 0 1"
                    Width="420" MaxWidth="500" MaxHeight="900"
                    CornerRadius="0 0 0 16" Margin="0 20 0 0">
                <Border.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </Border.Transitions>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 抽屉标题栏 -->
                    <Border Grid.Row="0" Padding="20 16" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="编辑商品" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                                <TextBlock Text="{Binding EditProductName}" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="GdGhost" Padding="8" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnCancelEditProductClick" ToolTip.Tip="关闭">
                                <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 抽屉内容区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="商品名称 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding EditProductName}" Watermark="请输入商品名称"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="售价 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    <TextBox Text="{Binding EditProductPrice}" Watermark="0.00"
                                             Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="市场价" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    <TextBox Text="{Binding EditProductMarketPrice}" Watermark="0.00"
                                             Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="库存 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    <TextBox Text="{Binding EditProductStock}" Watermark="0"
                                             Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="单位" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                    <TextBox Text="{Binding EditProductUnit}" Watermark="束"
                                             Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="8">
                                <TextBlock Text="商品描述" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding EditProductDescription}" Watermark="请输入商品描述"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"
                                         AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="图片URL" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding EditProductImages}" Watermark="图片URL，多个用逗号分隔"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"/>
                            </StackPanel>

                            <!-- SKU管理 -->
                            <Border Height="1" Background="{DynamicResource GdBorderBrush}" Margin="0 4"/>
                            <TextBlock Text="SKU管理" FontSize="13" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,*,*,Auto,Auto" ColumnSpacing="6">
                                <TextBox Text="{Binding NewSkuColor}" Watermark="颜色" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding NewSkuSize}" Watermark="尺码" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                <TextBox Grid.Column="2" Text="{Binding NewSkuVersion}" Watermark="版本" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                <TextBox Grid.Column="3" Text="{Binding NewSkuPrice}" Watermark="价格" Width="60" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                                <TextBox Grid.Column="4" Text="{Binding NewSkuStock}" Watermark="库存" Width="60" Padding="8 6" CornerRadius="{DynamicResource GdRadiusSm}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}" FontSize="11"/>
                            </Grid>
                            <Button Content="+ 添加SKU" Classes="GdGhost" Padding="16 6" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="12"
                                    HorizontalAlignment="Left" Click="OnAddSkuClick"/>

                            <ItemsControl ItemsSource="{Binding EditProductSKUs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusSm}" Padding="8 6" Margin="0 2 0 0">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding SalePrice, StringFormat='¥{0:F2}'}" FontSize="12" Foreground="{DynamicResource GdErrorBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Stock, StringFormat='库存:{0}'}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="删除" FontSize="10" Padding="8 4" CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Foreground="{DynamicResource GdErrorBrush}" Background="Transparent"
                                                        Click="OnDeleteSkuClick" Tag="{Binding Id}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 抽屉底部操作栏 -->
                    <Border Grid.Row="2" Padding="20 16" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}" MinWidth="80"
                                    Click="OnCancelEditProductClick"/>
                            <Button Content="保存" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}" MinWidth="80"
                                    Click="OnSaveEditProductClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Panel>

        <!-- ═══ 审核对话框遮罩 ═══ -->
        <Panel IsVisible="{Binding ShowAuditDialog}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="1000">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnAuditOverlayTapped" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource GdCardBrush}" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="1 0 0 1"
                    Width="420" MaxWidth="500"
                    CornerRadius="{DynamicResource GdRadiusLg}" Margin="0 20 0 0">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 对话框标题栏 -->
                    <Border Grid.Row="0" Padding="20 16" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="商品审核" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundBrush}"/>
                            <Button Grid.Column="1" Classes="GdGhost" Padding="8" CornerRadius="{DynamicResource GdRadiusMd}"
                                    Click="OnCancelAuditClick" ToolTip.Tip="关闭">
                                <TextBlock Text="✕" FontSize="16" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 对话框内容区 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="16" Margin="20">
                            <StackPanel Spacing="8">
                                <TextBlock Text="审核结果 *" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <RadioButton Content="审核通过" GroupName="AuditApproved"
                                                 IsChecked="{Binding AuditApproved, Converter={StaticResource BoolToIntEqualOneConverter}}"
                                                 Padding="16 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                 FontSize="13"
                                                 Tag="1"
                                                 Click="OnAuditRadioClick"/>
                                    <RadioButton Content="审核拒绝" GroupName="AuditApproved"
                                                 IsChecked="{Binding AuditApproved, Converter={StaticResource BoolToIntEqualZeroConverter}}"
                                                 Padding="16 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" Foreground="{DynamicResource GdForegroundBrush}"
                                                 FontSize="13"
                                                 Tag="0"
                                                 Click="OnAuditRadioClick"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="8" IsVisible="{Binding AuditApproved, Converter={StaticResource EqualToZeroConverter}}">
                                <TextBlock Text="拒绝原因" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}"/>
                                <TextBox Text="{Binding AuditReason}" Watermark="请输入拒绝原因"
                                         Padding="12 10" CornerRadius="{DynamicResource GdRadiusMd}" Background="{DynamicResource GdCardBrush}" BorderThickness="0" Foreground="{DynamicResource GdForegroundBrush}"
                                         AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 对话框底部操作栏 -->
                    <Border Grid.Row="2" Padding="20 16" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 1 0 0">
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Content="取消" Classes="GdGhost" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}" MinWidth="80"
                                    Click="OnCancelAuditClick"/>
                            <Button Content="确认审核" Classes="GdPrimary" Padding="24 10" CornerRadius="{DynamicResource GdRadiusMd}" MinWidth="80"
                                    Click="OnConfirmAuditClick"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Panel>

        <!-- 加载中 -->
        <Border Classes="GdCard" Padding="40" IsVisible="{Binding IsLoading}" ZIndex="500">
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200"/>
                <TextBlock Text="加载中..." FontSize="13" Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</controls:GalleryPage>
</UserControl>
