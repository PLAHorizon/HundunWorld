<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:enums="using:Horizon.Game.GengDi.Enums"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">

    <UserControl.Resources>
        <converters:DownloadTaskIconConverter x:Key="TaskIconConverter" />
        <converters:DownloadTaskGradientConverter x:Key="TaskGradientConverter" />
    </UserControl.Resources>

    <controls:GalleryPage Title="下载"
                          Subtitle="Horizon.Game.GengDi.Downloads"
                          Description="下载任务列表与进度条，含速度、剩余时间、暂停/取消操作及完成态。"
                          IconSource="{StaticResource DownloadsIcon}">

        <StackPanel Spacing="18">

            <!-- ═══ 顶部统计：3列网格 ═══ -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="16">

                <!-- 活跃任务 -->
                <Border Classes="GdMetricCard"
                        Padding="16">
                    <StackPanel Orientation="Horizontal"
                                Spacing="14">
                        <Border Classes="GdStatIcon"
                                Background="{DynamicResource GdInfoSurfaceBrush}">
                            <Path Classes="GdLucideIcon"
                                  Width="20"
                                  Height="20"
                                  Data="{StaticResource LucideLoaderGeometry}"
                                  Stroke="{DynamicResource GdInfoBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="活跃任务"
                                       FontSize="11"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBlock Text="{Binding DownloadTasks.Count}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                       Foreground="{DynamicResource GdForegroundBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 总下载速度 -->
                <Border Grid.Column="1"
                        Classes="GdMetricCard"
                        Padding="16">
                    <StackPanel Orientation="Horizontal"
                                Spacing="14">
                        <Border Classes="GdStatIcon"
                                Background="{DynamicResource GdSuccessSurfaceBrush}">
                            <Path Classes="GdLucideIcon"
                                  Width="20"
                                  Height="20"
                                  Data="{StaticResource LucideGaugeGeometry}"
                                  Stroke="{DynamicResource GdSuccessBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="总下载速度"
                                       FontSize="11"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <TextBlock Text="{Binding TotalDownloadSpeedValue}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="{Binding TotalDownloadSpeedUnit}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0 0 0 3" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 已用空间 -->
                <Border Grid.Column="2"
                        Classes="GdMetricCard"
                        Padding="16">
                    <StackPanel Orientation="Horizontal"
                                Spacing="14">
                        <Border Classes="GdStatIcon"
                                Background="{DynamicResource GdWarningSurfaceBrush}">
                            <Path Classes="GdLucideIcon"
                                  Width="20"
                                  Height="20"
                                  Data="{StaticResource LucideHardDriveGeometry}"
                                  Stroke="{DynamicResource GdWarningBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="0">
                            <TextBlock Text="已用空间"
                                       FontSize="11"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4">
                                <TextBlock Text="{Binding UsedDiskSpaceValue}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="{Binding UsedDiskSpaceUnit}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0 0 0 3" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ 下载任务列表 ═══ -->
            <Border Classes="GdMetricCard"
                    Padding="0">
                <StackPanel>

                    <!-- 列表头：标题（左边框3px品牌色） + 操作按钮（带图标） -->
                    <Border Padding="16,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border BorderBrush="{DynamicResource GdPrimaryBrush}"
                                    BorderThickness="3 0 0 0"
                                    Padding="10 0 0 0"
                                    Height="20">
                                <TextBlock Text="下载任务"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GdForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                <Button Classes="GdGhost GdBtnSm"
                                        Command="{Binding PauseAllCommand}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <Path Classes="GdLucideIcon"
                                              Width="13"
                                              Height="13"
                                              Data="{StaticResource LucidePauseGeometry}" />
                                        <TextBlock Text="全部暂停" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="GdGhost GdBtnSm"
                                        Command="{Binding ClearCompletedCommand}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <Path Classes="GdLucideIcon"
                                              Width="13"
                                              Height="13"
                                              Data="{StaticResource LucideTrash2Geometry}" />
                                        <TextBlock Text="清空已完成" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 活跃任务列表（下载中 / 暂停 / 等待中） -->
                    <ItemsControl ItemsSource="{Binding DownloadTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadTask">
                                <Border Classes="GdDlRow">
                                    <Grid ColumnDefinitions="48,*,Auto"
                                          ColumnSpacing="14">

                                        <!-- 任务图标（渐变背景 + Lucide 图标，按 IconKey 差异化） -->
                                        <Border Classes="GdDlIcon"
                                                Background="{Binding GradientIndex, Converter={StaticResource TaskGradientConverter}}">
                                            <Path Classes="GdLucideIcon"
                                                  Width="24"
                                                  Height="24"
                                                  Data="{Binding IconKey, Converter={StaticResource TaskIconConverter}}"
                                                  Stroke="{DynamicResource GdPrimaryForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 任务信息 -->
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <!-- 标题 + 状态 badge -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                                <!-- 下载中 badge -->
                                                <Border Classes="GdBadge GdInfo"
                                                        IsVisible="{Binding IsDownloading}">
                                                    <TextBlock Text="{Binding StatusDisplayText}" />
                                                </Border>
                                                <!-- 已暂停 badge -->
                                                <Border Classes="GdBadge GdWarning"
                                                        IsVisible="{Binding IsPaused}">
                                                    <TextBlock Text="{Binding StatusDisplayText}" />
                                                </Border>
                                                <!-- 等待中 badge -->
                                                <Border Classes="GdBadge GdInfo"
                                                        IsVisible="{Binding IsPending}">
                                                    <TextBlock Text="{Binding StatusDisplayText}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 进度条（按状态切换颜色：下载中=品牌色，暂停=warning，等待=品牌色） -->
                                            <Grid Height="6">
                                                <ProgressBar IsVisible="{Binding IsDownloading}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdPrimaryBrush}" />
                                                <ProgressBar IsVisible="{Binding IsPaused}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdWarningBrush}" />
                                                <ProgressBar IsVisible="{Binding IsPending}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdPrimaryBrush}" />
                                            </Grid>

                                            <!-- 详情行：11px muted-foreground + mono 字体 + "·" 分隔 -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="14">
                                                <TextBlock Text="{Binding FormattedSizeText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding ProgressText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                <!-- 下载中：速度 + 剩余时间 -->
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsDownloading}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding SpeedText}"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsDownloading}"
                                                           Foreground="{DynamicResource GdSuccessBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsDownloading}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock IsVisible="{Binding IsDownloading}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}">
                                                    <Run Text="剩余 " />
                                                    <Run Text="{Binding RemainingTimeText}"
                                                         FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                </TextBlock>
                                                <!-- 暂停状态：暂停时间 -->
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsPaused}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding PausedTimeText}"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsPaused}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 操作按钮（按状态显示，带 Lucide 图标） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <!-- 下载中：暂停（ghost + pause图标） + 取消（danger + x图标） -->
                                            <Button Classes="GdGhost GdBtnSm"
                                                    IsVisible="{Binding IsDownloading}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.PauseDownloadCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="暂停">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucidePauseGeometry}" />
                                            </Button>
                                            <Button Classes="GdDanger GdBtnSm"
                                                    IsVisible="{Binding IsDownloading}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CancelDownloadCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="取消">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucideXGeometry}" />
                                            </Button>
                                            <!-- 暂停：继续（primary + play图标） + 取消（danger + x图标） -->
                                            <Button Classes="GdPrimary GdBtnSm"
                                                    IsVisible="{Binding IsPaused}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ResumeDownloadCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="继续">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucidePlayGeometry}" />
                                            </Button>
                                            <Button Classes="GdDanger GdBtnSm"
                                                    IsVisible="{Binding IsPaused}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CancelDownloadCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="取消">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucideXGeometry}" />
                                            </Button>
                                            <!-- 等待中：取消（danger + x图标） -->
                                            <Button Classes="GdDanger GdBtnSm"
                                                    IsVisible="{Binding IsPending}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.CancelDownloadCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="取消">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucideXGeometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 已完成任务列表（已完成 / 失败 / 已取消），与活跃任务连续渲染为单一列表 -->
                    <ItemsControl ItemsSource="{Binding CompletedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DownloadTask">
                                <Border Classes="GdDlRow">
                                    <Grid ColumnDefinitions="48,*,Auto"
                                          ColumnSpacing="14">

                                        <!-- 任务图标（渐变背景 + Lucide 图标） -->
                                        <Border Classes="GdDlIcon"
                                                Background="{Binding GradientIndex, Converter={StaticResource TaskGradientConverter}}">
                                            <Path Classes="GdLucideIcon"
                                                  Width="24"
                                                  Height="24"
                                                  Data="{Binding IconKey, Converter={StaticResource TaskIconConverter}}"
                                                  Stroke="{DynamicResource GdPrimaryForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 任务信息 -->
                                        <StackPanel Grid.Column="1"
                                                    Spacing="6">
                                            <!-- 标题 + 状态 badge -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GameName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                                <!-- 已完成 badge（带 check 图标） -->
                                                <Border Classes="GdBadge GdSuccess"
                                                        IsVisible="{Binding IsCompleted}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="11"
                                                              Height="11"
                                                              Data="{StaticResource LucideCheckGeometry}" />
                                                        <TextBlock Text="{Binding StatusDisplayText}" />
                                                    </StackPanel>
                                                </Border>
                                                <!-- 失败 badge -->
                                                <Border Classes="GdBadge GdError"
                                                        IsVisible="{Binding IsFailed}">
                                                    <TextBlock Text="{Binding StatusDisplayText}" />
                                                </Border>
                                                <!-- 已取消 badge -->
                                                <Border Classes="GdBadge GdWarning"
                                                        IsVisible="{Binding IsCancelled}">
                                                    <TextBlock Text="{Binding StatusDisplayText}" />
                                                </Border>
                                            </StackPanel>

                                            <!-- 进度条（已完成=success绿，失败=error红，已取消=muted灰） -->
                                            <Grid Height="6">
                                                <ProgressBar IsVisible="{Binding IsCompleted}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdSuccessBrush}" />
                                                <ProgressBar IsVisible="{Binding IsFailed}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdErrorBrush}" />
                                                <ProgressBar IsVisible="{Binding IsCancelled}"
                                                             Value="{Binding Progress}"
                                                             Maximum="100"
                                                             Height="6"
                                                             CornerRadius="999"
                                                             Background="{DynamicResource GdMutedBrush}"
                                                             Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </Grid>

                                            <!-- 详情行 -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="14">
                                                <TextBlock Text="{Binding FormattedDownloadedSizeText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                <TextBlock Text="·"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <!-- 已完成：完成时间 -->
                                                <TextBlock Text="{Binding CompletedTimeText}"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsCompleted}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                                                <!-- 失败：错误信息 -->
                                                <TextBlock Text="{Binding ErrorMessage}"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsFailed}"
                                                           Foreground="{DynamicResource GdErrorBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- 已取消 -->
                                                <TextBlock Text="已取消"
                                                           FontSize="11"
                                                           IsVisible="{Binding IsCancelled}"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 操作按钮（带 Lucide 图标） -->
                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <!-- 已完成：打开（primary + folder-open图标 + 文字） -->
                                            <Button Classes="GdPrimary GdBtnSm"
                                                    IsVisible="{Binding IsCompleted}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.OpenFolderCommand}"
                                                    CommandParameter="{Binding Id}">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <Path Classes="GdLucideIcon"
                                                          Width="14"
                                                          Height="14"
                                                          Data="{StaticResource LucideFolderOpenGeometry}" />
                                                    <TextBlock Text="打开" />
                                                </StackPanel>
                                            </Button>
                                            <!-- 删除（danger + trash-2图标） -->
                                            <Button Classes="GdDanger GdBtnSm"
                                                    Command="{Binding $parent[ItemsControl].DataContext.DeleteTaskCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    ToolTip.Tip="删除">
                                                <Path Classes="GdLucideIcon"
                                                      Width="14"
                                                      Height="14"
                                                      Data="{StaticResource LucideTrash2Geometry}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ 下载设置（保留功能绑定） ═══ -->
            <Border Classes="GdCard">
                <Grid ColumnDefinitions="Auto,120,Auto,120,*"
                      ColumnSpacing="12"
                      RowDefinitions="Auto,Auto">
                    <TextBlock Text="最大并发下载数"
                               Classes="GdMetricLabel"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Classes="GdInput"
                             Width="100"
                             Text="{Binding MaxConcurrentDownloads}" />
                    <TextBlock Grid.Column="2"
                               Text="下载速度限制"
                               Classes="GdMetricLabel"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Column="3"
                             Classes="GdInput"
                             Width="100"
                             Text="{Binding DownloadSpeedLimit}" />
                    <Button Grid.Column="4"
                            Content="检查更新"
                            Classes="GdPrimary"
                            HorizontalAlignment="Right"
                            Command="{Binding CheckForUpdatesCommand}" />

                    <StackPanel Grid.Row="1"
                                Grid.ColumnSpan="5"
                                Margin="0 12 0 0"
                                Spacing="4">
                        <TextBlock Text="下载包保存目录"
                                   Classes="GdMetricLabel" />
                        <TextBlock Text="{Binding DownloadPackageDirectory}"
                                   TextWrapping="Wrap"
                                   FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                   FontSize="13"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <TextBlock Text="并发数、限速和下载包保存目录都会跟随本地设置自动加载。"
                                   FontSize="12"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </controls:GalleryPage>
</UserControl>
