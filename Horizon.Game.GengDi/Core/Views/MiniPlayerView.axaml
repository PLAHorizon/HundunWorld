<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.MiniPlayerView"
             x:DataType="vm:MiniPlayerViewModel"
             Height="64">

    <Border Background="{DynamicResource MiniPlayerBackgroundBrush}"
            BorderBrush="{DynamicResource TitleBarBorderBrush}"
            BorderThickness="0 1 0 0"
            Padding="12 0">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" IsVisible="{Binding HasSong}">

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <Border Width="44" Height="44" CornerRadius="8"
                        Background="{DynamicResource SocialAvatarBackgroundBrush}"
                        ClipToBounds="True">
                    <Panel>
                        <TextBlock Text="♪" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SocialAvatarTextBrush}"
                                   IsVisible="{Binding !ShowLoadingIndicator}" />
                        <ProgressBar IsIndeterminate="True" Width="24" Height="3"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding ShowLoadingIndicator}" />
                    </Panel>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleBarTextBrush}"
                               MaxWidth="200" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Artist}" FontSize="11"
                                   Foreground="{DynamicResource TitleBarTextSecondaryBrush}"
                                   MaxWidth="160" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding !ShowErrorStatus}" />
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    IsVisible="{Binding ShowErrorStatus}">
                            <ui:SymbolIcon Symbol="Cancel" FontSize="10" Foreground="#FF4444" />
                            <TextBlock Text="无法播放" FontSize="11" Foreground="#FF4444" />
                            <Button Command="{Binding RetryCommand}" Padding="4 0" FontSize="10"
                                    Classes="QuietAction" VerticalAlignment="Center">
                                <TextBlock Text="重试" FontSize="10" />
                            </Button>
                        </StackPanel>
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TitleBarTextSecondaryBrush}"
                                   IsVisible="{Binding ShowLoadingIndicator}">
                            <Run Text="加载中..." />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16">
                <Button Classes="TitleBarIconButton"
                        Command="{Binding PreviousCommand}"
                        Width="32" Height="32"
                        PointerPressed="OnControlButtonPressed">
                    <ui:SymbolIcon Symbol="Previous" FontSize="14" />
                </Button>
                <Button Classes="TitleBarIconButton"
                        Command="{Binding PlayPauseCommand}"
                        Width="36" Height="36"
                        PointerPressed="OnControlButtonPressed">
                    <Panel>
                        <ui:SymbolIcon Symbol="Pause" FontSize="16"
                                       IsVisible="{Binding IsPlaying}" />
                        <ui:SymbolIcon Symbol="Play" FontSize="16"
                                       IsVisible="{Binding !IsPlaying}" />
                    </Panel>
                </Button>
                <Button Classes="TitleBarIconButton"
                        Command="{Binding NextCommand}"
                        Width="32" Height="32"
                        PointerPressed="OnControlButtonPressed">
                    <ui:SymbolIcon Symbol="Next" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding PositionText}" FontSize="11"
                           Foreground="{DynamicResource TitleBarTextSecondaryBrush}"
                           VerticalAlignment="Center" />
                <ProgressBar Value="{Binding Progress}" Maximum="1"
                             Width="120" Height="4"
                             VerticalAlignment="Center" />
                <TextBlock Text="{Binding DurationText}" FontSize="11"
                           Foreground="{DynamicResource TitleBarTextSecondaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
