<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerAddressView"
             x:DataType="vm:FlowerAddressViewModel">
    <ScrollViewer Padding="0">
        <StackPanel Spacing="18" Margin="0">

            <!-- ============ Section Header: 收货地址 ============ -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Classes="GdSectionHeader" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Classes="GdSectionHeaderTitle" Text="收货地址" />
                    <TextBlock Classes="GdSectionHeaderSub" Text="管理鲜花交易收货地址，支持设置默认地址" />
                </StackPanel>
                <Button Grid.Column="1" Classes="PrimaryAction" Click="OnAddAddressClick"
                        VerticalAlignment="Center" CornerRadius="{DynamicResource GdRadiusMd}"
                        Padding="16 8" IsVisible="{Binding !IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="新增地址" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ============ 地址卡片列表（3 列均匀网格） ============ -->
            <ItemsControl ItemsSource="{Binding Addresses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="GdStatCard" Padding="16 18" Margin="7">
                            <StackPanel Spacing="10">
                                <!-- 顶部：收货人 + 手机号 + 默认标签 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding ShipTo}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Phone}" FontSize="12"
                                               FontFamily="{DynamicResource GdFontMono}"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center" />
                                    <Border Classes="GdBadge GdBadgeInfo" IsVisible="{Binding IsDefault}">
                                        <TextBlock Text="默认" />
                                    </Border>
                                </StackPanel>

                                <!-- 完整地址 -->
                                <TextBlock Text="{Binding FullAddress}" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{DynamicResource GdForegroundBrush}"
                                           LineHeight="20" Margin="0 0 0 4" />

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="QuietAction" Click="OnEditAddressClick" Tag="{Binding}"
                                            Padding="12 6" CornerRadius="{DynamicResource GdRadiusSm}" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✎" FontSize="12" />
                                            <TextBlock Text="编辑" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="QuietAction" Click="OnDeleteAddressClick" Tag="{Binding}"
                                            Padding="12 6" CornerRadius="{DynamicResource GdRadiusSm}" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="✕" FontSize="12" />
                                            <TextBlock Text="删除" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="QuietAction" Click="OnSetDefaultClick" Tag="{Binding}"
                                            Padding="12 6" CornerRadius="{DynamicResource GdRadiusSm}" FontSize="12"
                                            IsVisible="{Binding !IsDefault}">
                                        <TextBlock Text="设为默认" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 空状态 -->
            <Border Classes="GdStatCard" Padding="40" IsVisible="{Binding !HasAddresses}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <TextBlock Text="📭" FontSize="32" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无收货地址" FontSize="14"
                               Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="点击上方新增地址按钮添加" FontSize="12"
                               Foreground="{DynamicResource GdMutedForegroundBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ============ 新增收货地址表单 ============ -->
            <Border Classes="GdStatCard" Padding="20">
                <StackPanel Spacing="16">
                    <!-- 表单标题 -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="+" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource GdPrimaryBrush}" />
                        <TextBlock Text="新增收货地址" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                    </StackPanel>

                    <!-- 2x2 表单网格 -->
                    <Grid ColumnDefinitions="1*,1*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                        <!-- 收货人 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                            <TextBlock Text="收货人" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding EditShipTo}" Watermark="请输入收货人姓名" />
                        </StackPanel>

                        <!-- 手机号 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                            <TextBlock Text="手机号" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <TextBox Text="{Binding EditPhone}" Watermark="请输入 11 位手机号" />
                        </StackPanel>

                        <!-- 省 / 市 / 区 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                            <TextBlock Text="省 / 市 / 区" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox ItemsSource="{Binding Provinces}" SelectedItem="{Binding EditProvinceName}"
                                              PlaceholderText="省" MinWidth="90" />
                                    <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding EditCityName}"
                                              PlaceholderText="市" MinWidth="90" />
                                    <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding EditDistrictName}"
                                              PlaceholderText="区" MinWidth="90" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox ItemsSource="{Binding Streets}" SelectedItem="{Binding EditStreetName}"
                                              PlaceholderText="街道/镇" MinWidth="120" />
                                    <ComboBox ItemsSource="{Binding Communities}" SelectedItem="{Binding EditCommunityName}"
                                              PlaceholderText="社区/村" MinWidth="120" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- 详细地址 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                            <TextBlock Text="详细地址" FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding EditAddress}" Watermark="街道、楼栋、门牌号" />
                                <Button Grid.Column="1" Classes="QuietAction" Click="OnMapSelectClick"
                                        Padding="12 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                        FontSize="12" Content="地图选点" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- 底部：设为默认 + 保存/取消 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <CheckBox Grid.Column="0" Content="设为默认收货地址" IsChecked="{Binding EditIsDefault}"
                                  FontSize="13" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="QuietAction" Click="OnCancelEditClick" Content="取消"
                                    Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}"
                                    FontSize="13" IsVisible="{Binding IsEditing}" />
                            <Button Classes="PrimaryAction" Click="OnSaveEditClick"
                                    Padding="16 8" CornerRadius="{DynamicResource GdRadiusMd}" FontSize="13">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="✓" FontSize="14" />
                                    <TextBlock Text="保存地址" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 底部提示文字 -->
            <TextBlock Classes="GdSectionHeaderSub" Margin="2 0 0 0"
                       Text="提示：默认地址将作为下单时的首选收货地址，最多可保留 20 条地址记录。" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
