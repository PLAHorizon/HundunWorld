<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerAddressView"
             x:DataType="vm:FlowerAddressViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Classes="SurfaceCard" Padding="16 12" CornerRadius="12" Margin="0 0 0 12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="收货地址管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="+ 新增地址" Classes="PrimaryAction" Padding="16 8"
                        CornerRadius="8" FontSize="13" Click="OnAddAddressClick"
                        IsVisible="{Binding !IsEditing}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEditing}">
                    <Button Content="保存" Classes="PrimaryAction" Padding="16 8" CornerRadius="8"
                            FontSize="13" Click="OnSaveEditClick" />
                    <Button Content="取消" Classes="QuietAction" Padding="16 8" CornerRadius="8"
                            FontSize="13" Click="OnCancelEditClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12" Margin="0">
                <!-- 编辑表单 -->
                <Border Classes="SurfaceCard" Padding="20" CornerRadius="12" IsVisible="{Binding IsEditing}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="编辑地址" FontSize="14" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="收货人" FontSize="13" VerticalAlignment="Center" Width="64" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditShipTo}" Watermark="请输入收货人姓名" />

                            <TextBlock Grid.Row="1" Text="手机号" FontSize="13" VerticalAlignment="Center" Width="64" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditPhone}" Watermark="请输入手机号" />

                            <TextBlock Grid.Row="2" Text="省/市/区" FontSize="13" VerticalAlignment="Center" Width="64" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{Binding Provinces}" SelectedItem="{Binding EditProvinceName}"
                                              PlaceholderText="省" Width="120" />
                                    <ComboBox ItemsSource="{Binding Cities}" SelectedItem="{Binding EditCityName}"
                                              PlaceholderText="市" Width="120" />
                                    <ComboBox ItemsSource="{Binding Districts}" SelectedItem="{Binding EditDistrictName}"
                                              PlaceholderText="区" Width="120" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{Binding Streets}" SelectedItem="{Binding EditStreetName}"
                                              PlaceholderText="街道/镇" Width="120" />
                                    <ComboBox ItemsSource="{Binding Communities}" SelectedItem="{Binding EditCommunityName}"
                                              PlaceholderText="社区/村" Width="120" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Grid.Row="3" Text="详细地址" FontSize="13" VerticalAlignment="Center" Width="64" />
                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding EditAddress}" Watermark="请输入详细地址" />
                                <Button Grid.Column="1" Content="🗺 地图选点" Classes="QuietAction" Padding="12 8" CornerRadius="8"
                                        FontSize="12" Click="OnMapSelectClick" />
                            </Grid>

                            <CheckBox Grid.Row="4" Grid.Column="1" Content="设为默认地址" IsChecked="{Binding EditIsDefault}" Margin="0 4 0 0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 地址列表 -->
                <ItemsControl ItemsSource="{Binding Addresses}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="SurfaceCard" Padding="16" CornerRadius="12" Margin="0 0 0 8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding ShipTo}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="{DynamicResource LoginFormMutedBrush}" VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource LoginErrorBrush}" CornerRadius="4" Padding="6 2" IsVisible="{Binding IsDefault}">
                                                <TextBlock Text="默认" FontSize="11" Foreground="White" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FullAddress}" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="编辑" Classes="QuietAction" Padding="12 6" CornerRadius="6"
                                                FontSize="12" Click="OnEditAddressClick" Tag="{Binding}" />
                                        <Button Content="删除" Classes="QuietAction" Padding="12 6" CornerRadius="6"
                                                FontSize="12" Click="OnDeleteAddressClick" Tag="{Binding}" />
                                        <Button Content="设为默认" Classes="QuietAction" Padding="12 6" CornerRadius="6"
                                                FontSize="12" Click="OnSetDefaultClick" Tag="{Binding}"
                                                IsVisible="{Binding !IsDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态 -->
                <Border Classes="SurfaceCard" Padding="40" CornerRadius="12"
                        IsVisible="{Binding !HasAddresses}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <TextBlock Text="📍" FontSize="32" HorizontalAlignment="Center" />
                        <TextBlock Text="暂无收货地址" FontSize="14" Foreground="{DynamicResource LoginFormMutedBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="点击上方新增地址按钮添加" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
