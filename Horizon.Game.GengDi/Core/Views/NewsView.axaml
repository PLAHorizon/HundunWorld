<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.NewsView"
             x:DataType="vm:NewsViewModel">

    <controls:GalleryPage Title="新闻"
                          Subtitle="Horizon.Game.GengDi.News"
                          Description="左侧分类筛选与右侧新闻图文卡列表，悬停高亮品牌色边框。"
                          IconSource="{StaticResource NewsIcon}">

        <!-- ═══ 原型布局：220px 分类筛选 + 1fr 新闻卡列表 ═══ -->
        <Grid ColumnDefinitions="220,*"
              ColumnSpacing="20">

            <!-- ═══ 左侧分类筛选 ═══ -->
            <Border Classes="GdMetricCard"
                    Padding="12"
                    VerticalAlignment="Stretch">
                <StackPanel Spacing="2">
                    <Border Padding="6,6,10,0"
                            BorderBrush="{DynamicResource GdBorderBrush}"
                            BorderThickness="0 0 0 1"
                            Margin="0 0 0 8">
                        <TextBlock Text="分类筛选"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                    </Border>

                    <Button Classes="GdNavItem"
                            Classes.GdNavItemActive="{Binding IsAllNewsActive}"
                            Command="{Binding LoadNewsCommand}"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ui:IconSourceElement Grid.Column="0"
                                                  IconSource="{StaticResource GamesIcon}"
                                                  Width="15" Height="15" />
                            <TextBlock Grid.Column="1"
                                       Text="全部"
                                       Margin="8 0 0 0" />
                            <TextBlock Grid.Column="2"
                                       Text="48"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </Grid>
                    </Button>

                    <Button Classes="GdNavItem"
                            Classes.GdNavItemActive="{Binding IsActivityAnnouncementActive}"
                            Command="{Binding LoadNewsByCategoryCommand}"
                            CommandParameter="活动公告"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ui:IconSourceElement Grid.Column="0"
                                                  IconSource="{StaticResource NotificationsIcon}"
                                                  Width="15" Height="15" />
                            <TextBlock Grid.Column="1"
                                       Text="公告"
                                       Margin="8 0 0 0" />
                            <TextBlock Grid.Column="2"
                                       Text="12"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </Grid>
                    </Button>

                    <Button Classes="GdNavItem"
                            Command="{Binding LoadNewsByCategoryCommand}"
                            CommandParameter="活动"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ui:IconSourceElement Grid.Column="0"
                                                  IconSource="{StaticResource LoginFlowerIcon}"
                                                  Width="15" Height="15" />
                            <TextBlock Grid.Column="1"
                                       Text="活动"
                                       Margin="8 0 0 0" />
                            <TextBlock Grid.Column="2"
                                       Text="15"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </Grid>
                    </Button>

                    <Button Classes="GdNavItem"
                            Classes.GdNavItemActive="{Binding IsGameDynamicActive}"
                            Command="{Binding LoadNewsByCategoryCommand}"
                            CommandParameter="游戏动态"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ui:IconSourceElement Grid.Column="0"
                                                  IconSource="{StaticResource RefreshIcon}"
                                                  Width="15" Height="15" />
                            <TextBlock Grid.Column="1"
                                       Text="更新"
                                       Margin="8 0 0 0" />
                            <TextBlock Grid.Column="2"
                                       Text="9"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </Grid>
                    </Button>

                    <Button Classes="GdNavItem"
                            Command="{Binding LoadNewsByCategoryCommand}"
                            CommandParameter="资讯"
                            HorizontalAlignment="Stretch">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <ui:IconSourceElement Grid.Column="0"
                                                  IconSource="{StaticResource NewsIcon}"
                                                  Width="15" Height="15" />
                            <TextBlock Grid.Column="1"
                                       Text="资讯"
                                       Margin="8 0 0 0" />
                            <TextBlock Grid.Column="2"
                                       Text="12"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ 右侧新闻图文卡列表 ═══ -->
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding NewsList}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:News">
                            <Border Classes="GdNewsCard"
                                    Cursor="Hand">
                                <Grid ColumnDefinitions="160,*"
                                      ColumnSpacing="14">

                                    <!-- 新闻缩略图（渐变背景 + 图标） -->
                                    <Border Classes="GdNewsThumb"
                                            Width="160"
                                            Height="96"
                                            CornerRadius="{DynamicResource GdRadiusMd}"
                                            ClipToBounds="True">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="{DynamicResource GdBrand500}" Offset="0" />
                                                <GradientStop Color="{DynamicResource GdBrand700}" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Viewbox Width="32" Height="32"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Document"
                                                           Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                                           Opacity="0.9" />
                                        </Viewbox>
                                    </Border>

                                    <!-- 新闻内容区 -->
                                    <StackPanel Grid.Column="1"
                                                Spacing="6">
                                        <!-- 分类 chip + 标题 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Border Classes="GdChip GdInfo">
                                                <TextBlock Text="{Binding Category}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GdForegroundBrush}"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>

                                        <!-- 描述 -->
                                        <TextBlock Text="{Binding Content}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   LineHeight="19" />

                                        <!-- 元信息：作者 · 时间 · 浏览量 -->
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="12"
                                                    Margin="0 4 0 0">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4">
                                                <ui:SymbolIcon Symbol="Contact"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding Author}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="4">
                                                <ui:SymbolIcon Symbol="Clock"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                <TextBlock Text="{Binding PublishDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                           FontSize="11"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </controls:GalleryPage>
</UserControl>
