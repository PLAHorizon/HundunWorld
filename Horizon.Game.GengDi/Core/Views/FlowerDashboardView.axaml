<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             x:Class="Horizon.Game.GengDi.Core.Views.FlowerDashboardView"
             x:DataType="vm:FlowerDashboardViewModel"
             Background="{DynamicResource GdBackgroundBrush}"
             Foreground="{DynamicResource GdForegroundBrush}">

    <controls:GalleryPage Title="行情仪表盘"
                          Subtitle="Horizon.Game.GengDi.FlowerDashboard"
                          Description="花卉市场实时行情概览与预警监控。"
                          IconSource="{StaticResource NotificationsIcon}">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="20" Margin="0 0 0 24">

                <!-- 指标卡（设计稿：图标+标签+数值+副文本） -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                    <Border Classes="GdCard" Padding="20" Margin="0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📈" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="今日均价" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding AvgPrice, StringFormat='¥{0:F2}'}" FontSize="26" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                       Foreground="{DynamicResource GdForegroundBrush}" />
                            <TextBlock Text="较昨日 +¥0.28" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="GdCard" Padding="20" Margin="0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📊" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="涨跌幅" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding PriceChangeDirection}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource GdUpBrush}" />
                                <TextBlock Text="{Binding PriceChangePercent, StringFormat='{}{0:F2}%'}" FontSize="26" FontWeight="Bold"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdUpBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="市场整体偏强" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="GdCard" Padding="20" Margin="0"
                            BorderBrush="{DynamicResource GdWarningBrush}" BorderThickness="3 0 0 0">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🔔" FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="预警数" FontSize="12" Foreground="{DynamicResource GdWarningBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding AlertCount}" FontSize="26" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                       Foreground="{DynamicResource GdWarningBrush}" />
                            <TextBlock Text="待处理预警" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 品种价格走势标题栏 -->
                <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="📉" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="品种价格走势" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="GdOutline" Padding="12 6" FontSize="12"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔄" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="刷新" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="GdCard" Padding="20" Background="{DynamicResource GdCardBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBlock Text="品种" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="价格" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold" MinWidth="80" TextAlignment="Right" />
                            <TextBlock Grid.Column="2" Text="涨跌幅" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold" MinWidth="80" TextAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="趋势" FontSize="12" Foreground="{DynamicResource GdMutedForegroundBrush}" FontWeight="SemiBold" MinWidth="40" TextAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopSpecies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0 8" BorderBrush="{DynamicResource GdInfoSurfaceBrush}" BorderThickness="0 0 0 1">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SpeciesIcon}" FontSize="16" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SpeciesName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Border Background="{DynamicResource GdInfoSurfaceBrush}"
                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Padding="6 2"
                                                        IsVisible="{Binding IsExpandSuggestion}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="建议扩种" FontSize="10" Foreground="{DynamicResource GdPrimaryBrush}" FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="{DynamicResource GdInfoSurfaceBrush}"
                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Padding="6 2"
                                                        IsVisible="{Binding IsEarlyHarvestSuggestion}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="建议提前采收" FontSize="10" Foreground="{DynamicResource GdErrorBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Price, StringFormat='¥{0:F2}'}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       MinWidth="80"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ChangePercent, StringFormat='{}{0:F2}%'}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       MinWidth="80"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Foreground>
                                                    <MultiBinding StringFormat="{}">
                                                        <Binding Path="IsPositive" />
                                                    </MultiBinding>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding ForecastTrendDisplay}"
                                                       FontSize="12"
                                                       MinWidth="40"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="GdCard" Padding="20" Background="{DynamicResource GdCardBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="最新预警" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding AlertCount, StringFormat='共 {0} 条'}"
                                       FontSize="12"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding RecentAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12 8" Margin="0 0 0 8" Background="{DynamicResource GdCardBrush}" CornerRadius="{DynamicResource GdRadiusMd}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                            <TextBlock Text="{Binding LevelIcon}" FontSize="18" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding AlertTypeDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdWarningBrush}" />
                                                    <TextBlock Text="{Binding SpeciesName}" FontSize="11" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TriggeredValue, StringFormat='¥{0:F2}'}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource GdErrorBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="GdCard"
                        Padding="40"
                        Background="{DynamicResource GdCardBrush}"
                        IsVisible="{Binding IsLoading}">
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <ProgressBar IsIndeterminate="True" Height="4" />
                        <TextBlock Text="加载行情数据中..."
                                   FontSize="13"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </controls:GalleryPage>
</UserControl>
