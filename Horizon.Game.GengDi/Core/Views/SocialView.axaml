<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="780"
             x:Class="Horizon.Game.GengDi.Core.Views.SocialView"
             x:DataType="vm:SocialViewModel"
             x:Name="socialView"
             Loaded="SocialView_Loaded">
    <controls:GalleryPage Title="社交"
                          Subtitle="有朋自远方来，不亦说乎"
                          Description="海内存知己，天涯若比邻。图文传心意，音视频相连。"
                          IsPageScrollingEnabled="False"
                          IconSource="{StaticResource SocialIcon}">

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <Grid ColumnDefinitions="320,*"
                  ColumnSpacing="16">

                <!-- ===== 左侧面板：通讯录+群组 ===== -->
                <Border Classes="SurfaceCard"
                        Grid.Column="0"
                        Padding="0"
                        ClipToBounds="True">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  MinHeight="0">
                        <StackPanel Spacing="16"
                                    Margin="16">

                            <!-- 通讯录区块 -->
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="通讯录"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="在线状态、备注和快速操作"
                                                   Classes="SupportingText"
                                                   FontSize="11" />
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Classes="PrimaryAction"
                                            Background="{StaticResource BattleNetPrimaryBrush}"
                                            CornerRadius="8"
                                            Padding="10 6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="在线"
                                                       Foreground="White"
                                                       FontSize="11" />
                                            <TextBlock Text="{Binding OnlineFriendsCount}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- 添加好友输入 -->
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBox Text="{Binding FriendRequestUsername}"
                                                 Watermark="输入通行证号"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="12" />
                                        <Button Grid.Column="1"
                                                Content="添加"
                                                Command="{Binding SendFriendRequestCommand}"
                                                Classes="PrimaryAction"
                                                Padding="14 6"
                                                FontSize="12" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding ActionStatusMessage}"
                                           Classes="SupportingText"
                                           FontSize="11"
                                           IsVisible="False" />
                            </StackPanel>

                            <!-- 待处理好友申请 -->
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding HasSuggestedFriends}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <TextBlock Text="{Binding SuggestedFriendsHeader}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="8 4"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasSuggestedFriends}">
                                        <TextBlock Text="{Binding SuggestedFriendsCount}"
                                                   Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding SuggestedFriendsDescription}"
                                           Classes="SupportingText"
                                           FontSize="10"
                                           IsVisible="{Binding !HasSuggestedFriends}" />
                                <ItemsControl ItemsSource="{Binding SuggestedFriends}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:User">
                                            <Border Classes="SurfaceCard subtle"
                                                    CornerRadius="8"
                                                    Padding="10 8"
                                                    Margin="0 0 0 8">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="10">
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="20"
                                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       IsVisible="{Binding !HasAvatarBitmap}" />
                                                            <Image Source="{Binding AvatarBitmap}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasAvatarBitmap}" />
                                                        </Panel>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding SocialSummary}"
                                                                   Classes="SupportingText"
                                                                   FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   MaxLines="2" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Button Content="接受"
                                                                Command="{Binding $parent[UserControl].DataContext.AddSuggestedFriendCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                Classes="PrimaryAction"
                                                                Padding="10 4"
                                                                FontSize="10" />
                                                        <Button Content="拒绝"
                                                                Command="{Binding $parent[UserControl].DataContext.RejectFriendRequestCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                Classes="QuietAction"
                                                                Padding="10 4"
                                                                FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 待处理入群邀请 -->
                            <StackPanel Spacing="8"
                                        IsVisible="{Binding HasPendingGroupInvites}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <TextBlock Text="入群邀请"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                            CornerRadius="8"
                                            Padding="8 4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PendingGroupInviteCount}"
                                                   Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                   FontWeight="Bold"
                                                   FontSize="12" />
                                    </Border>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PendingGroupInvites}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupInviteItem">
                                            <Border Classes="SurfaceCard subtle"
                                                    CornerRadius="8"
                                                    Padding="10 8"
                                                    Margin="0 0 0 8">
                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                      ColumnSpacing="10">
                                                    <Border Width="40"
                                                            Height="40"
                                                            CornerRadius="20"
                                                            Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                        <TextBlock Text="{Binding DisplayInitial}"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Spacing="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding GroupName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding Summary}"
                                                                   Classes="SupportingText"
                                                                   FontSize="10" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsActionable}">
                                                        <Button Content="同意"
                                                                Command="{Binding $parent[UserControl].DataContext.AcceptGroupInviteCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="PrimaryAction"
                                                                Padding="10 4"
                                                                FontSize="10" />
                                                        <Button Content="拒绝"
                                                                Command="{Binding $parent[UserControl].DataContext.RejectGroupInviteCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="QuietAction"
                                                                Padding="10 4"
                                                                FontSize="10" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 好友分组列表 -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="好友分组"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Classes="SupportingText"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="+ 新建"
                                            FontSize="11"
                                            Padding="8 4"
                                            CornerRadius="6"
                                            Foreground="{StaticResource BattleNetPrimaryBrush}"
                                            Background="Transparent"
                                            Click="OnCreateGroupClick" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding FriendGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FriendGroupItem">
                                            <StackPanel Spacing="4">
                                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                        Padding="10 8"
                                                        CornerRadius="8"
                                                        Cursor="Hand"
                                                        PointerPressed="FriendGroupHeader_PointerPressed"
                                                        PointerReleased="FriendGroupHeader_PointerReleased"
                                                        Tag="{Binding}"
                                                        DragDrop.AllowDrop="True">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Width="3"
                                                                    Height="16"
                                                                    Background="{StaticResource BattleNetPrimaryBrush}"
                                                                    CornerRadius="2"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsExpanded}" />
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <Button ToolTip.Tip="编辑分组"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Padding="2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4"
                                                                    Click="OnEditGroupClick"
                                                                    Tag="{Binding}"
                                                                    IsVisible="{Binding !IsDefault}">
                                                                <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                          Width="12"
                                                                          Height="12"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </Button>
                                                            <Button ToolTip.Tip="删除分组"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Padding="2"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    CornerRadius="4"
                                                                    Click="OnDeleteGroupClick"
                                                                    Tag="{Binding}"
                                                                    IsVisible="{Binding !IsDefault}">
                                                                <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                          Width="12"
                                                                          Height="12"
                                                                          HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </Button>
                                                            <TextBlock Text="{Binding Friends.Count, StringFormat='{}{0}'}"
                                                                       FontSize="10"
                                                                       Classes="SupportingText"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Friends}"
                                                              IsVisible="{Binding IsExpanded}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:User">
                                                            <controls:SwipeRevealPanel ActionWidth="70" SwipeThreshold="35">
                                                                <controls:SwipeRevealPanel.ActionContent>
                                                                    <Button Content="删除"
                                                                            Command="{Binding $parent[UserControl].DataContext.RemoveFriendCommand}"
                                                                            CommandParameter="{Binding Id}"
                                                                            Background="{DynamicResource LoginErrorBrush}"
                                                                            Foreground="White"
                                                                            FontWeight="SemiBold"
                                                                            Padding="10 6"
                                                                            FontSize="12"
                                                                            CornerRadius="0"
                                                                            VerticalAlignment="Stretch"
                                                                            HorizontalAlignment="Stretch"
                                                                            HorizontalContentAlignment="Center"
                                                                            VerticalContentAlignment="Center" />
                                                                </controls:SwipeRevealPanel.ActionContent>
                                                                <Panel>
                                                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                            IsVisible="{Binding IsSelected}"
                                                                            CornerRadius="4" />
                                                                    <Border Width="3"
                                                                            HorizontalAlignment="Left"
                                                                            Background="{StaticResource BattleNetPrimaryBrush}"
                                                                            CornerRadius="2"
                                                                            IsVisible="{Binding IsSelected}"
                                                                            Margin="0 6" />
                                                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                            BorderThickness="0 0 0 1"
                                                                            Padding="10 10"
                                                                            Cursor="Hand"
                                                                            PointerPressed="FriendItem_PointerPressed"
                                                                            PointerMoved="FriendItem_PointerMoved"
                                                                            PointerReleased="FriendItem_PointerReleased">
                                                                <Grid ColumnDefinitions="Auto,*"
                                                                      ColumnSpacing="10">
                                                                    <Grid Width="44"
                                                                          Height="44">
                                                                        <Border Width="44"
                                                                                Height="44"
                                                                                CornerRadius="22"
                                                                                ClipToBounds="True"
                                                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                                            <Panel>
                                                                                <TextBlock Text="{Binding AvatarInitial}"
                                                                                           FontWeight="Bold"
                                                                                           FontSize="14"
                                                                                           Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                                           VerticalAlignment="Center"
                                                                                           HorizontalAlignment="Center"
                                                                                           IsVisible="{Binding !HasAvatarBitmap}" />
                                                                                <Image Source="{Binding AvatarBitmap}"
                                                                                       Stretch="UniformToFill"
                                                                                       IsVisible="{Binding HasAvatarBitmap}" />
                                                                            </Panel>
                                                                        </Border>
                                                                        <Ellipse Width="12"
                                                                                 Height="12"
                                                                                 Fill="{StaticResource SocialOnlineBadgeBrush}"
                                                                                 Stroke="White"
                                                                                 StrokeThickness="2"
                                                                                 HorizontalAlignment="Right"
                                                                                 VerticalAlignment="Bottom"
                                                                                 IsVisible="{Binding IsAvailable}" />
                                                                        <Border Background="{StaticResource SocialUnreadBadgeBrush}"
                                                                                CornerRadius="9"
                                                                                Padding="4 1"
                                                                                HorizontalAlignment="Right"
                                                                                VerticalAlignment="Top"
                                                                                IsVisible="{Binding HasUnreadMessages}">
                                                                            <TextBlock Text="{Binding UnreadBadgeText}"
                                                                                       Foreground="White"
                                                                                       FontSize="9"
                                                                                       FontWeight="Bold"
                                                                                       HorizontalAlignment="Center" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <StackPanel Grid.Column="1"
                                                                                Spacing="3"
                                                                                VerticalAlignment="Center">
                                                                        <Grid ColumnDefinitions="*,Auto"
                                                                              ColumnSpacing="6">
                                                                            <TextBlock Text="{Binding DisplayName}"
                                                                                       FontSize="13"
                                                                                       FontWeight="SemiBold" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding DisplayStatus}"
                                                                                       Classes="SupportingText"
                                                                                       FontSize="10"
                                                                                       VerticalAlignment="Center"
                                                                                       IsVisible="{Binding HasNoUnreadMessages}" />
                                                                        </Grid>
                                                                        <TextBlock Text="{Binding SocialSummary}"
                                                                                   Classes="SupportingText"
                                                                                   FontSize="10"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxLines="1" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                            </Panel>
                                                            </controls:SwipeRevealPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- 分隔线 -->
                            <Border Height="1"
                                    Background="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Opacity="0.5"
                                    Margin="4 4" />

                            <!-- 群组会话 -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="群组会话"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8"
                                        Padding="8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBox Text="{Binding NewGroupName}"
                                                 Watermark="输入群名称"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontSize="12" />
                                        <Button Grid.Column="1"
                                                Content="创建"
                                                Command="{Binding CreateGroupCommand}"
                                                Classes="PrimaryAction"
                                                Padding="14 6"
                                                FontSize="12" />
                                    </Grid>
                                </Border>
                                <ListBox x:Name="GroupsListBox"
                                         ItemsSource="{Binding Groups}"
                                         SelectedItem="{Binding SelectedGroup}"
                                         SelectionChanged="GroupsListBox_SelectionChanged"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                        <Style Selector="ListBoxItem:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Group">
                                            <controls:SwipeRevealPanel ActionWidth="70" SwipeThreshold="35">
                                                <controls:SwipeRevealPanel.ActionContent>
                                                    <Button Content="{Binding RemoveGroupActionText}"
                                                            Command="{Binding $parent[UserControl].DataContext.RemoveGroupCommand}"
                                                            CommandParameter="{Binding Id}"
                                                            Background="{DynamicResource LoginErrorBrush}"
                                                            Foreground="White"
                                                            FontWeight="SemiBold"
                                                            Padding="10 6"
                                                            FontSize="12"
                                                            CornerRadius="0"
                                                            VerticalAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center" />
                                                </controls:SwipeRevealPanel.ActionContent>
                                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="0 0 0 1"
                                                        Padding="10 10"
                                                        Background="Transparent">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="10">
                                                        <Grid Width="40"
                                                              Height="40">
                                                            <Border Width="40"
                                                                    Height="40"
                                                                    CornerRadius="20"
                                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                                <TextBlock Text="{Binding DisplayInitial}"
                                                                           FontWeight="Bold"
                                                                           FontSize="13"
                                                                           Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>
                                                            <Border Background="{StaticResource SocialUnreadBadgeBrush}"
                                                                    CornerRadius="9"
                                                                    Padding="4 1"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Top"
                                                                    IsVisible="{Binding HasUnreadMessages}">
                                                                <TextBlock Text="{Binding UnreadBadgeText}"
                                                                           Foreground="White"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center" />
                                                            </Border>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="3">
                                                            <Grid ColumnDefinitions="*,Auto"
                                                                  ColumnSpacing="6">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="12" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding MemberSummary}"
                                                                           Classes="SupportingText"
                                                                           FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           IsVisible="{Binding HasNoUnreadMessages}" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding GroupSummary}"
                                                                       Classes="SupportingText"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="1" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </controls:SwipeRevealPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 侧边栏加载遮罩 -->
                    <Border Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            Opacity="0.85"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            IsVisible="{Binding IsSidebarBusy}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <ProgressBar IsIndeterminate="True"
                                         Width="180" />
                            <TextBlock Text="{Binding SidebarLoadingMessage}"
                                       FontWeight="SemiBold"
                                       Classes="SupportingText" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 右侧面板：对话区 + 群组成员面板 ===== -->
            <Border Grid.Column="1"
                    Classes="SurfaceCard"
                    MinHeight="0"
                    Padding="0"
                    ClipToBounds="True">
                <Grid ColumnDefinitions="*,Auto">
                    <TransitioningContentControl Name="ConversationTransitionHost"
                                                 Content="{Binding ActiveConversationState}"
                                                 MinHeight="0">
                        <TransitioningContentControl.PageTransition>
                            <CrossFade Duration="0:0:0.25" />
                        </TransitioningContentControl.PageTransition>
                        <TransitioningContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:ConversationViewState">
                                <Grid RowDefinitions="Auto,*,Auto"
                                      RowSpacing="0">
                                    <!-- 对话头 -->
                                    <Border Classes="SurfaceCard"
                                            CornerRadius="0"
                                            Padding="16 14">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                              ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Category}"
                                                           Classes="PageEyebrow" />
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}"
                                                           Classes="SupportingText"
                                                           TextWrapping="Wrap"
                                                           FontSize="11" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="邀请好友"
                                                    ToolTip.Tip="邀请好友入群"
                                                    Classes="QuietAction"
                                                    Padding="10 6"
                                                    FontSize="11"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding $parent[UserControl].DataContext.IsGroupConversationActive}"
                                                    Command="{Binding $parent[UserControl].DataContext.InviteToGroupCommand}" />

                                            <Button Grid.Column="2"
                                                    ToolTip.Tip="群成员"
                                                    Classes="QuietAction"
                                                    Padding="10 6"
                                                    FontSize="11"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding $parent[UserControl].DataContext.IsGroupConversationActive}"
                                                    Command="{Binding $parent[UserControl].DataContext.ToggleGroupMembersPanelCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="👥" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding $parent[UserControl].DataContext.GroupMemberCountText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    ToolTip.Tip="清理聊天记录"
                                                    Classes="TitleBarIconButton"
                                                    Width="32"
                                                    Height="32"
                                                    Command="{Binding $parent[UserControl].DataContext.ClearChatCommand}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="🗑"
                                                           FontSize="14"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- 消息列表 -->
                                    <Grid Grid.Row="1"
                                          MinHeight="0">
                                        <ScrollViewer Name="ConversationMessagesScrollViewer"
                                                      Padding="16 12 30 12"
                                                      MinHeight="0"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto"
                                                      ClipToBounds="True">
                                            <ItemsControl ItemsSource="{Binding Messages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                                                        <StackPanel Margin="0 0 0 8"
                                                                    Spacing="4">
                                                            <!-- 消息头：昵称 + 时间 -->
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="8"
                                                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                                                        IsVisible="{Binding !IsEmoji}">
                                                                <TextBlock Text="{Binding SenderDisplayName}"
                                                                           Classes="PageEyebrow"
                                                                           FontSize="10" />
                                                                <TextBlock Text="{Binding TimestampText}"
                                                                           Classes="SupportingText"
                                                                           FontSize="9" />
                                                            </StackPanel>

                                                            <Border CornerRadius="12"
                                                                    Background="{Binding BubbleBackground}"
                                                                    BorderBrush="{Binding BubbleBorder}"
                                                                    BorderThickness="1"
                                                                    Padding="14 10"
                                                                    MaxWidth="420"
                                                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                                                    IsVisible="{Binding !IsEmoji}">
                                                                <StackPanel Spacing="8">
                                                                    <TextBlock Text="{Binding Text}"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding HasText}"
                                                                               FontSize="12" />
                                                                    <Border IsVisible="{Binding HasFileCard}"
                                                                            Cursor="Hand"
                                                                            PointerPressed="MediaCard_Tapped"
                                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                            CornerRadius="8"
                                                                            Padding="12 10">
                                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                                            <Border Grid.Column="0"
                                                                                    Width="40" Height="40"
                                                                                    CornerRadius="8"
                                                                                    Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                                                <TextBlock Text="{Binding FileIcon}"
                                                                                           FontSize="18"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1"
                                                                                        VerticalAlignment="Center"
                                                                                        Spacing="3">
                                                                                <TextBlock Text="{Binding FileDisplayName}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           TextTrimming="CharacterEllipsis"
                                                                                           MaxWidth="280" />
                                                                                <TextBlock Text="{Binding FileSizeLabel}"
                                                                                           FontSize="10"
                                                                                           Classes="SupportingText" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                    <Border IsVisible="{Binding HasCard}"
                                                                            Cursor="Hand"
                                                                            PointerPressed="MediaCard_Tapped">
                                                                        <controls:VideoMessageCard />
                                                                    </Border>
                                                                    <UniformGrid IsVisible="{Binding HasMultipleImages}"
                                                                                  Columns="{Binding AttachmentGridColumns}"
                                                                                  Rows="0">
                                                                        <ItemsControl ItemsSource="{Binding AttachmentImages}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <UniformGrid Columns="1" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border Margin="2"
                                                                                            CornerRadius="4"
                                                                                            ClipToBounds="True"
                                                                                            Cursor="Hand"
                                                                                            PointerPressed="AttachmentImage_PointerPressed"
                                                                                            Tag="{Binding $self}">
                                                                                        <Image Source="{Binding}"
                                                                                               Stretch="UniformToFill"
                                                                                               Width="120"
                                                                                               Height="120" />
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </UniformGrid>
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock Text="{Binding Text}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding IsEmoji}"
                                                                       FontSize="32"
                                                                       HorizontalAlignment="{Binding BubbleAlignment}" />

                                                            <!-- 消息操作按钮行 -->
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                                                        IsVisible="{Binding CanForward}">
                                                                <Button ToolTip.Tip="转发"
                                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                        BorderThickness="0"
                                                                        Width="30"
                                                                        Height="30"
                                                                        Padding="0"
                                                                        CornerRadius="6"
                                                                        IsVisible="{Binding CanForward}"
                                                                        Click="ForwardButton_Click">
                                                                    <PathIcon Data="M9 5v2h6.59L4 18.59 5.41 20 17 8.41V15h2V5z"
                                                                              Width="14"
                                                                              Height="14"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                                <Button ToolTip.Tip="复制"
                                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                        BorderThickness="0"
                                                                        Width="30"
                                                                        Height="30"
                                                                        Padding="0"
                                                                        CornerRadius="6"
                                                                        IsVisible="{Binding CanCopyContent}"
                                                                        Click="CopyButton_Click">
                                                                    <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm4 8H8V3h12v6zM6 21h12v-2H6v2zm14-6H8V9h12v6z"
                                                                              Width="14"
                                                                              Height="14"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                                <Button ToolTip.Tip="保存"
                                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                                        BorderThickness="0"
                                                                        Width="30"
                                                                        Height="30"
                                                                        Padding="0"
                                                                        CornerRadius="6"
                                                                        IsVisible="{Binding CanSaveMedia}"
                                                                        Click="SaveButton_Click">
                                                                    <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                                              Width="14"
                                                                              Height="14"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <Button Name="ScrollToBottomButton"
                                                Content="回到底部"
                                                Classes="PrimaryAction"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0 0 0 18"
                                                Padding="16 6"
                                                FontSize="11"
                                                IsVisible="False"
                                                Click="ScrollToBottomButton_Click" />
                                    </Grid>

                                    <!-- 输入区 -->
                                    <Border Grid.Row="2"
                                            Padding="14 12">
                                        <StackPanel Spacing="10">
                                            <Border Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                    CornerRadius="8"
                                                    Padding="8"
                                                    IsVisible="{Binding $parent[UserControl].DataContext.HasPendingAttachment}">
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="8">
                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                  VerticalScrollBarVisibility="Disabled">
                                                        <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.PendingAttachments}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Width="56"
                                                                            Height="56"
                                                                            CornerRadius="6"
                                                                            ClipToBounds="True"
                                                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                                        <Grid>
                                                                            <TextBlock Text="{Binding KindLabel}"
                                                                                       FontSize="9"
                                                                                       Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                            <Button Width="18"
                                                                                    Height="18"
                                                                                    Padding="0"
                                                                                    CornerRadius="9"
                                                                                    FontSize="9"
                                                                                    HorizontalAlignment="Right"
                                                                                    VerticalAlignment="Top"
                                                                                    Margin="0 2 2 0"
                                                                                    Background="#CC000000"
                                                                                    Foreground="White"
                                                                                    Click="RemovePendingAttachment_Click"
                                                                                    Tag="{Binding}"
                                                                                    Content="✕" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                    <Button Grid.Column="1"
                                                            Content="清空"
                                                            Classes="QuietAction"
                                                            Padding="10 4"
                                                            FontSize="10"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[UserControl].DataContext.ClearAllAttachmentsCommand}" />
                                                </Grid>
                                            </Border>

                                            <!-- 输入框 -->
                                            <TextBox x:Name="MessageInputBox"
                                                     Text="{Binding $parent[UserControl].DataContext.NewMessageContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="70"
                                                     MaxHeight="120"
                                                     FontSize="12"
                                                     Watermark="{Binding InputWatermark}"
                                                     CornerRadius="8" />

                                            <!-- 操作按钮行 -->
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                                                  ColumnSpacing="8">
                                                <Button ToolTip.Tip="发送图片"
                                                        Classes="QuietAction"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Click="AttachImageButton_Click">
                                                    <PathIcon Data="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="1"
                                                        ToolTip.Tip="发送视频"
                                                        Classes="QuietAction"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Click="AttachVideoButton_Click">
                                                    <PathIcon Data="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="2"
                                                        ToolTip.Tip="发送文件"
                                                        Classes="QuietAction"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Click="AttachFileButton_Click">
                                                    <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                </Button>
                                                <Button Grid.Column="3"
                                                        ToolTip.Tip="表情"
                                                        Classes="QuietAction"
                                                        Padding="8"
                                                        CornerRadius="8"
                                                        Click="EmojiPickerButton_Click">
                                                    <PathIcon Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"
                                                                Width="16"
                                                                Height="16"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                    <Button.Flyout>
                                                        <Flyout Placement="Top">
                                                            <ScrollViewer MaxWidth="260" MaxHeight="160">
                                                                <WrapPanel x:Name="EmojiWrapPanel" Width="240">
                                                                </WrapPanel>
                                                            </ScrollViewer>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                                    <TextBlock Classes="SupportingText"
                                                               FontSize="9"
                                                               Text="Enter 发送 | Alt+Enter 换行" />
                                                </StackPanel>
                                                <Button Grid.Column="5"
                                                        Content="{Binding $parent[UserControl].DataContext.SendButtonLabel}"
                                                        Classes="PrimaryAction"
                                                        Padding="18 6"
                                                        FontSize="12"
                                                        Command="{Binding $parent[UserControl].DataContext.SendMessageCommand}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </TransitioningContentControl.ContentTemplate>
                    </TransitioningContentControl>

                    <!-- 媒体查看器覆盖层 -->
                    <Border x:Name="MediaViewerOverlay"
                            Grid.ColumnSpan="2"
                            Background="#CC000000"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            IsVisible="False">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- 顶部操作栏 -->
                            <Grid ColumnDefinitions="Auto,*"
                                  Margin="16 12">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <Button ToolTip.Tip="上一张"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerPrevButton_Click">
                                        <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                    <Button ToolTip.Tip="下一张"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerNextButton_Click">
                                        <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="6">
                                    <Button ToolTip.Tip="转发"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerForwardButton_Click">
                                        <PathIcon Data="M9 5v2h6.59L4 18.59 5.41 20 17 8.41V15h2V5z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                    <Button ToolTip.Tip="复制"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerCopyButton_Click">
                                        <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm4 8H8V3h12v6zM6 21h12v-2H6v2zm14-6H8V9h12v6z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                    <Button ToolTip.Tip="保存"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerSaveButton_Click">
                                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                    <Button ToolTip.Tip="关闭"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36"
                                            Height="36"
                                            Padding="8"
                                            CornerRadius="8"
                                            Click="ViewerCloseButton_Click">
                                        <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                  Width="16"
                                                  Height="16"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 媒体展示区 -->
                            <Image x:Name="MediaViewerImage"
                                   Grid.Row="1"
                                   Stretch="Uniform"
                                   Margin="32" />

                            <!-- 底部信息栏 -->
                            <StackPanel Grid.Row="2"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 16"
                                        Spacing="4">
                                <TextBlock x:Name="MediaViewerTitle"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="White" />
                                <TextBlock x:Name="MediaViewerSubtitle"
                                           HorizontalAlignment="Center"
                                           Classes="SupportingText"
                                           Foreground="#CCFFFFFF" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 对话区加载遮罩 -->
                    <Border Grid.ColumnSpan="2"
                            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            Opacity="0.85"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            IsVisible="{Binding IsConversationBusy}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <ProgressBar IsIndeterminate="True"
                                         Width="200" />
                            <TextBlock Text="{Binding ConversationLoadingMessage}"
                                       FontWeight="SemiBold"
                                       Classes="SupportingText" />
                        </StackPanel>
                    </Border>

                    <!-- 群组成员面板（仿微信群） -->
                    <Border Grid.Column="1"
                            Width="220"
                            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1 0 0 0"
                            IsVisible="{Binding IsGroupMembersPanelOpen}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="0">
                            <!-- 面板头 -->
                            <Border Padding="14 12"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0 0 0 1">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="群成员"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GroupMemberCountText}"
                                                                   FontSize="11"
                                                                   Classes="SupportingText" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            FontSize="12"
                                            Padding="6 4"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleGroupMembersPanelCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <!-- 加载指示器 -->
                            <ProgressBar Grid.Row="1"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsGroupMembersLoading}"
                                         Height="2" />

                            <!-- 成员列表 -->
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="10 8">
                                <ItemsControl ItemsSource="{Binding GroupMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupMemberItem">
                                            <Border Padding="6 6"
                                                    CornerRadius="6"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="10">
                                                    <!-- 头像 -->
                                                    <Grid Width="36" Height="36">
                                                        <Border Width="36" Height="36"
                                                                CornerRadius="18"
                                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                                IsVisible="{Binding !HasAvatarBitmap}">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding AvatarBitmap}"
                                                               Width="36" Height="36"
                                                               IsVisible="{Binding HasAvatarBitmap}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Rect="0 0 36 36" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <!-- 在线状态指示点 -->
                                                        <Border Width="10" Height="10"
                                                                CornerRadius="5"
                                                                Background="{Binding StatusDotColor}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                Margin="0 0 0 0"
                                                                IsVisible="{Binding IsOnline}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="2" Opacity="0.5" />
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 昵称 + 角色 -->
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="1">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="120" />
                                                        <TextBlock Text="{Binding RoleLabel}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   IsVisible="{Binding IsOwner}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 邀请好友入群弹窗 -->
                    <Border x:Name="InviteFriendsOverlay"
                            Grid.ColumnSpan="2"
                            Background="#CC000000"
                            CornerRadius="{DynamicResource OverlayCornerRadius}"
                            IsVisible="{Binding IsInviteFriendsOverlayOpen}">
                        <Border Classes="SurfaceCard"
                                Padding="20"
                                MaxWidth="380"
                                MaxHeight="460"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Grid RowDefinitions="Auto,*,Auto"
                                  RowSpacing="12">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="邀请好友入群"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="选择要邀请的好友（支持多选）"
                                               Classes="SupportingText"
                                               FontSize="10" />
                                </StackPanel>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Friends}"
                                         SelectionMode="Multiple"
                                         x:Name="InviteFriendsListBox"
                                         BorderThickness="0"
                                         Background="Transparent">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="6" />
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:User">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10">
                                                <Border Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        ClipToBounds="True"
                                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                                    <Panel>
                                                        <TextBlock Text="{Binding AvatarInitial}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource BattleNetPrimaryBrush}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   IsVisible="{Binding !HasAvatarBitmap}" />
                                                        <Image Source="{Binding AvatarBitmap}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding HasAvatarBitmap}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="*,Auto,Auto"
                                      ColumnSpacing="8">
                                    <TextBlock Text="{Binding InviteStatusMessage}"
                                               Classes="SupportingText"
                                               FontSize="10"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="取消"
                                            Classes="QuietAction"
                                            Padding="14 6"
                                            FontSize="11"
                                            Command="{Binding CloseInviteFriendsOverlayCommand}" />
                                    <Button Grid.Column="2"
                                            Content="发送邀请"
                                            Classes="PrimaryAction"
                                            Padding="14 6"
                                            FontSize="11"
                                            Click="SendGroupInviteButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- 好友分组新增/编辑弹窗（全页覆盖） -->
            <Border x:Name="FriendGroupOverlay"
                    ZIndex="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CC000000"
                    IsVisible="{Binding IsFriendGroupOverlayOpen}">
                <Border Classes="SurfaceCard"
                        Padding="20"
                        Width="380"
                        MaxHeight="235"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="12">
                        <StackPanel Grid.Row="0"
                                    Spacing="4">
                            <TextBlock Text="{Binding FriendGroupOverlayTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FriendGroupOverlaySubtitle}"
                                       Classes="SupportingText"
                                       FontSize="10" />
                        </StackPanel>
                        <TextBox x:Name="FriendGroupInputBox"
                                 Grid.Row="1"
                                 Text="{Binding FriendGroupInputText, Mode=TwoWay}"
                                 Watermark="分组名称"
                                 FontSize="13"
                                 Padding="10 8"
                                 CornerRadius="8"
                                 KeyDown="FriendGroupInputBox_KeyDown" />
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding FriendGroupStatusMessage}"
                                       Classes="SupportingText"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Classes="QuietAction"
                                    Padding="14 6"
                                    FontSize="11"
                                    Command="{Binding CloseFriendGroupOverlayCommand}" />
                            <Button Grid.Column="2"
                                    Content="{Binding FriendGroupOverlayTitle}"
                                    Classes="PrimaryAction"
                                    Padding="14 6"
                                    FontSize="11"
                                    Command="{Binding ConfirmFriendGroupOverlayCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- 删除分组确认弹窗（全页覆盖） -->
            <Border x:Name="DeleteGroupOverlay"
                    ZIndex="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="#CC000000"
                    IsVisible="{Binding IsDeleteGroupOverlayOpen}">
                <Border Classes="SurfaceCard"
                        Padding="20"
                        Width="380"
                        MaxHeight="235"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="12">
                        <StackPanel Grid.Row="0"
                                    Spacing="4">
                            <TextBlock Text="删除分组"
                                       FontSize="16"
                                       FontWeight="SemiBold" />
                            <TextBlock Classes="SupportingText"
                                       FontSize="10"
                                       TextWrapping="Wrap">
                                <Run Text="确定要删除分组「" /><Run Text="{Binding DeleteGroupDisplayName}" FontWeight="SemiBold" /><Run Text="」吗？分组内的好友将移动到默认分组。" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding DeleteGroupStatusMessage}"
                                       Classes="SupportingText"
                                       FontSize="10"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Classes="QuietAction"
                                    Padding="14 6"
                                    FontSize="11"
                                    Command="{Binding CloseDeleteGroupOverlayCommand}" />
                            <Button Grid.Column="2"
                                    Content="删除"
                                    Classes="PrimaryAction"
                                    Padding="14 6"
                                    FontSize="11"
                                    Command="{Binding ConfirmDeleteGroupOverlayCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </controls:GalleryPage>
</UserControl>
