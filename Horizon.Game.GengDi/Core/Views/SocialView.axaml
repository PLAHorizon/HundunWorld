<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="780"
             x:Class="Horizon.Game.GengDi.Core.Views.SocialView"
             x:DataType="vm:SocialViewModel"
             x:Name="socialView"
             Loaded="SocialView_Loaded">
    <controls:GalleryPage Title="社交"
                          Subtitle="有朋自远方来，不亦说乎"
                          Description="海内存知己，天涯若比邻。图文传心意，音视频相连。"
                          IsPageScrollingEnabled="False"
                          IconSource="{StaticResource SocialIcon}">

        <Grid HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">

            <!-- ===== 三栏布局：240(通讯录) | 1fr(聊天) | 220(信息) ===== -->
            <Grid ColumnDefinitions="240,*,220"
                  ColumnSpacing="14">

                <!-- ============================================================ -->
                <!-- 左栏：通讯录（搜索 + 好友分组 + 群组）                          -->
                <!-- ============================================================ -->
                <Border Classes="GdMetricCard"
                        Grid.Column="0"
                        Padding="0"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*,Auto">
                        <!-- 标题栏：通讯录 + 添加好友 -->
                        <Border Padding="12,14"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <TextBlock Text="通讯录"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        ToolTip.Tip="添加好友"
                                        Classes="GdGhost"
                                        Padding="8 4"
                                        FontSize="11"
                                        Command="{Binding SendFriendRequestCommand}">
                                    <Path Classes="GdLucideIcon"
                                          Width="13"
                                          Height="13"
                                          Data="{StaticResource LucideUserPlusGeometry}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 搜索 / 添加好友输入 -->
                        <Border Grid.Row="1"
                                Padding="8,10"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Border Classes="GdSearchBar">
                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="6">
                                    <Path Grid.Column="0"
                                          Classes="GdLucideIcon"
                                          Width="13"
                                          Height="13"
                                          Data="{StaticResource LucideSearchGeometry}"
                                          Stroke="{DynamicResource GdMutedForegroundBrush}"
                                          VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding FriendRequestUsername}"
                                             Watermark="搜索好友 / 通行证号"
                                             Classes="GdInput"
                                             Padding="4,6"
                                             FontSize="12"
                                             BorderThickness="0"
                                             Background="Transparent" />
                                </Grid>
                            </Border>
                        </Border>

                        <!-- 滚动列表区 -->
                        <ScrollViewer Grid.Row="2"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      MinHeight="0">
                            <StackPanel Spacing="12"
                                        Margin="10,10">

                                <TextBlock Text="{Binding ActionStatusMessage}"
                                           FontSize="11"
                                           IsVisible="False"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />

                                <!-- 待处理好友申请 -->
                                <StackPanel Spacing="8"
                                            IsVisible="{Binding HasSuggestedFriends}">
                                    <TextBlock Text="{Binding SuggestedFriendsHeader}"
                                               Classes="GdSectionHeader"
                                               FontSize="11" />
                                    <ItemsControl ItemsSource="{Binding SuggestedFriends}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:User">
                                                <Border Classes="GdListItem"
                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Offset="0" Color="{StaticResource GdBrand500}" />
                                                                    <GradientStop Offset="1" Color="{StaticResource GdBrand700}" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <Panel>
                                                                <TextBlock Text="{Binding AvatarInitial}"
                                                                           FontWeight="Bold"
                                                                           FontSize="11"
                                                                           Foreground="White"
                                                                           VerticalAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           IsVisible="{Binding !HasAvatarBitmap}" />
                                                                <Image Source="{Binding AvatarBitmap}"
                                                                       Stretch="UniformToFill"
                                                                       IsVisible="{Binding HasAvatarBitmap}" />
                                                            </Panel>
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding SocialSummary}"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       MaxLines="2"
                                                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="接受"
                                                                    Command="{Binding $parent[UserControl].DataContext.AddSuggestedFriendCommand}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Classes="GdPrimary GdBtnSm"
                                                                    Padding="8,4"
                                                                    FontSize="10" />
                                                            <Button Content="拒绝"
                                                                    Command="{Binding $parent[UserControl].DataContext.RejectFriendRequestCommand}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Classes="GdGhost GdBtnSm"
                                                                    Padding="8,4"
                                                                    FontSize="10" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 待处理入群邀请 -->
                                <StackPanel Spacing="8"
                                            IsVisible="{Binding HasPendingGroupInvites}">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="入群邀请"
                                                   Classes="GdSectionHeader"
                                                   FontSize="11" />
                                        <Border Grid.Column="1"
                                                Classes="GdBadge GdInfo">
                                            <TextBlock Text="{Binding PendingGroupInviteCount}" />
                                        </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PendingGroupInvites}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:GroupInviteItem">
                                                <Border Classes="GdListItem"
                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Padding="8,6"
                                                        Margin="0,0,0,6">
                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                          ColumnSpacing="8">
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                    <GradientStop Offset="0" Color="{StaticResource GdBrand500}" />
                                                                    <GradientStop Offset="1" Color="{StaticResource GdBrand700}" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <TextBlock Text="{Binding DisplayInitial}"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       Foreground="White"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" />
                                                        </Border>

                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GroupName}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="12"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Summary}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    VerticalAlignment="Center"
                                                                    IsVisible="{Binding IsActionable}">
                                                            <Button Content="同意"
                                                                    Command="{Binding $parent[UserControl].DataContext.AcceptGroupInviteCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="GdPrimary GdBtnSm"
                                                                    Padding="8,4"
                                                                    FontSize="10" />
                                                            <Button Content="拒绝"
                                                                    Command="{Binding $parent[UserControl].DataContext.RejectGroupInviteCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="GdGhost GdBtnSm"
                                                                    Padding="8,4"
                                                                    FontSize="10" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 好友分组列表 -->
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="好友分组"
                                                   Classes="GdSectionHeader"
                                                   FontSize="11" />
                                        <Button Grid.Column="1"
                                                Content="+ 新建"
                                                Classes="GdGhost GdBtnSm"
                                                Padding="6,2"
                                                FontSize="10"
                                                Click="OnCreateGroupClick" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding FriendGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FriendGroupItem">
                                                <StackPanel Spacing="2">
                                                    <Border Background="{DynamicResource GdMutedBrush}"
                                                            Padding="8,6"
                                                            CornerRadius="{DynamicResource GdRadiusSm}"
                                                            Cursor="Hand"
                                                            PointerPressed="FriendGroupHeader_PointerPressed"
                                                            PointerReleased="FriendGroupHeader_PointerReleased"
                                                            Tag="{Binding}"
                                                            DragDrop.AllowDrop="True">
                                                        <Grid ColumnDefinitions="*,Auto"
                                                              ColumnSpacing="6">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="6">
                                                                <Border Width="3"
                                                                        Height="14"
                                                                        Background="{DynamicResource GdPrimaryBrush}"
                                                                        CornerRadius="2"
                                                                        VerticalAlignment="Center"
                                                                        IsVisible="{Binding IsExpanded}" />
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Spacing="4"
                                                                        VerticalAlignment="Center">
                                                                <Button ToolTip.Tip="编辑分组"
                                                                        Width="22"
                                                                        Height="22"
                                                                        Padding="2"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="OnEditGroupClick"
                                                                        Tag="{Binding}"
                                                                        IsVisible="{Binding !IsDefault}">
                                                                    <PathIcon Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                                                              Width="11"
                                                                              Height="11"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                </Button>
                                                                <Button ToolTip.Tip="删除分组"
                                                                        Width="22"
                                                                        Height="22"
                                                                        Padding="2"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        CornerRadius="4"
                                                                        Click="OnDeleteGroupClick"
                                                                        Tag="{Binding}"
                                                                        IsVisible="{Binding !IsDefault}">
                                                                    <PathIcon Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                                                              Width="11"
                                                                              Height="11"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                </Button>
                                                                <TextBlock Text="{Binding Friends.Count, StringFormat='{}{0}'}"
                                                                           FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ItemsControl ItemsSource="{Binding Friends}"
                                                                  IsVisible="{Binding IsExpanded}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:User">
                                                                <controls:SwipeRevealPanel ActionWidth="70" SwipeThreshold="35">
                                                                    <controls:SwipeRevealPanel.ActionContent>
                                                                        <Button Content="删除"
                                                                                Command="{Binding $parent[UserControl].DataContext.RemoveFriendCommand}"
                                                                                CommandParameter="{Binding Id}"
                                                                                Background="{DynamicResource GdErrorBrush}"
                                                                                Foreground="White"
                                                                                FontWeight="SemiBold"
                                                                                Padding="10,6"
                                                                                FontSize="12"
                                                                                CornerRadius="0"
                                                                                VerticalAlignment="Stretch"
                                                                                HorizontalAlignment="Stretch"
                                                                                HorizontalContentAlignment="Center"
                                                                                VerticalContentAlignment="Center" />
                                                                    </controls:SwipeRevealPanel.ActionContent>
                                                                    <Panel>
                                                                        <Border Classes="GdFriendItem"
                                                                                Classes.GdFriendItemActive="{Binding IsSelected}"
                                                                                Margin="0,0,0,2"
                                                                                Cursor="Hand"
                                                                                PointerPressed="FriendItem_PointerPressed"
                                                                                PointerMoved="FriendItem_PointerMoved"
                                                                                PointerReleased="FriendItem_PointerReleased">
                                                                            <Grid ColumnDefinitions="Auto,*"
                                                                                  ColumnSpacing="10">
                                                                                <Grid Width="32"
                                                                                      Height="32">
                                                                                    <!-- 在线头像（渐变背景 + 白字） -->
                                                                                    <Border Width="32"
                                                                                            Height="32"
                                                                                            CornerRadius="16"
                                                                                            ClipToBounds="True"
                                                                                            IsVisible="{Binding IsAvailable}">
                                                                                        <Border.Background>
                                                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                                                <GradientStop Offset="0" Color="{StaticResource GdSuccess}" />
                                                                                                <GradientStop Offset="1" Color="{StaticResource GdBrand600}" />
                                                                                            </LinearGradientBrush>
                                                                                        </Border.Background>
                                                                                        <Panel>
                                                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                                                       FontWeight="Bold"
                                                                                                       FontSize="12"
                                                                                                       Foreground="White"
                                                                                                       VerticalAlignment="Center"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       IsVisible="{Binding !HasAvatarBitmap}" />
                                                                                            <Image Source="{Binding AvatarBitmap}"
                                                                                                   Stretch="UniformToFill"
                                                                                                   IsVisible="{Binding HasAvatarBitmap}" />
                                                                                        </Panel>
                                                                                    </Border>
                                                                                    <!-- 离线头像（muted 背景 + muted-foreground 字） -->
                                                                                    <Border Width="32"
                                                                                            Height="32"
                                                                                            CornerRadius="16"
                                                                                            ClipToBounds="True"
                                                                                            Background="{DynamicResource GdMutedBrush}"
                                                                                            IsVisible="{Binding !IsAvailable}">
                                                                                        <Panel>
                                                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                                                       FontWeight="Bold"
                                                                                                       FontSize="12"
                                                                                                       Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                                                                       VerticalAlignment="Center"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       IsVisible="{Binding !HasAvatarBitmap}" />
                                                                                            <Image Source="{Binding AvatarBitmap}"
                                                                                                   Stretch="UniformToFill"
                                                                                                   IsVisible="{Binding HasAvatarBitmap}" />
                                                                                        </Panel>
                                                                                    </Border>
                                                                                    <!-- 在线状态点（success） -->
                                                                                    <Ellipse Width="9"
                                                                                             Height="9"
                                                                                             Fill="{DynamicResource GdSuccessBrush}"
                                                                                             Stroke="{DynamicResource GdCardBrush}"
                                                                                             StrokeThickness="2"
                                                                                             HorizontalAlignment="Right"
                                                                                             VerticalAlignment="Bottom"
                                                                                             IsVisible="{Binding IsAvailable}" />
                                                                                    <!-- 离线状态点（muted-foreground） -->
                                                                                    <Ellipse Width="9"
                                                                                             Height="9"
                                                                                             Fill="{DynamicResource GdMutedForegroundBrush}"
                                                                                             Stroke="{DynamicResource GdCardBrush}"
                                                                                             StrokeThickness="2"
                                                                                             HorizontalAlignment="Right"
                                                                                             VerticalAlignment="Bottom"
                                                                                             IsVisible="{Binding !IsAvailable}" />
                                                                                    <!-- 未读消息徽章 -->
                                                                                    <Border Background="{StaticResource GdErrorBrush}"
                                                                                            CornerRadius="8"
                                                                                            Padding="4,1"
                                                                                            HorizontalAlignment="Right"
                                                                                            VerticalAlignment="Top"
                                                                                            IsVisible="{Binding HasUnreadMessages}">
                                                                                        <TextBlock Text="{Binding UnreadBadgeText}"
                                                                                                   Foreground="White"
                                                                                                   FontSize="9"
                                                                                                   FontWeight="Bold"
                                                                                                   HorizontalAlignment="Center" />
                                                                                    </Border>
                                                                                </Grid>

                                                                                <StackPanel Grid.Column="1"
                                                                                            Spacing="2"
                                                                                            VerticalAlignment="Center">
                                                                                    <Grid ColumnDefinitions="*,Auto"
                                                                                          ColumnSpacing="6">
                                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                                   FontSize="13"
                                                                                                   FontWeight="Medium"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding DisplayStatus}"
                                                                                                   FontSize="9"
                                                                                                   VerticalAlignment="Center"
                                                                                                   IsVisible="{Binding HasNoUnreadMessages}"
                                                                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                                    </Grid>
                                                                                    <TextBlock Text="{Binding SocialSummary}"
                                                                                               FontSize="11"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxLines="1"
                                                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </Panel>
                                                                </controls:SwipeRevealPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 分隔线 -->
                                <Border Height="1"
                                        Background="{DynamicResource GdBorderBrush}"
                                        Opacity="0.5"
                                        Margin="2,2" />

                                <!-- 群组会话 -->
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="群组会话"
                                                   Classes="GdSectionHeader"
                                                   FontSize="11" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="6">
                                        <TextBox Text="{Binding NewGroupName}"
                                                 Watermark="群名称"
                                                 Classes="GdInput"
                                                 Padding="8,6"
                                                 FontSize="12" />
                                        <Button Grid.Column="1"
                                                Content="创建"
                                                Command="{Binding CreateGroupCommand}"
                                                Classes="GdPrimary GdBtnSm"
                                                Padding="10,6" />
                                    </Grid>
                                    <ListBox x:Name="GroupsListBox"
                                             ItemsSource="{Binding Groups}"
                                             SelectedItem="{Binding SelectedGroup}"
                                             SelectionChanged="GroupsListBox_SelectionChanged"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusSm}" />
                                            </Style>
                                            <Style Selector="ListBoxItem:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource GdMutedBrush}" />
                                            </Style>
                                            <Style Selector="ListBoxItem:selected">
                                                <Setter Property="Background" Value="{DynamicResource GdInfoSurfaceBrush}" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:Group">
                                                <controls:SwipeRevealPanel ActionWidth="70" SwipeThreshold="35">
                                                    <controls:SwipeRevealPanel.ActionContent>
                                                        <Button Content="{Binding RemoveGroupActionText}"
                                                                Command="{Binding $parent[UserControl].DataContext.RemoveGroupCommand}"
                                                                CommandParameter="{Binding Id}"
                                                                Background="{DynamicResource GdErrorBrush}"
                                                                Foreground="White"
                                                                FontWeight="SemiBold"
                                                                Padding="10,6"
                                                                FontSize="12"
                                                                CornerRadius="0"
                                                                VerticalAlignment="Stretch"
                                                                HorizontalAlignment="Stretch"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center" />
                                                    </controls:SwipeRevealPanel.ActionContent>
                                                    <Border BorderBrush="{DynamicResource GdBorderBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="8,8"
                                                            Background="Transparent">
                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="8">
                                                            <Grid Width="34"
                                                                  Height="34">
                                                                <Border Width="34"
                                                                        Height="34"
                                                                        CornerRadius="17">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                                            <GradientStop Offset="0" Color="{StaticResource GdBrand500}" />
                                                                            <GradientStop Offset="1" Color="{StaticResource GdBrand700}" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                    <TextBlock Text="{Binding DisplayInitial}"
                                                                               FontWeight="Bold"
                                                                               FontSize="12"
                                                                               Foreground="White"
                                                                               VerticalAlignment="Center"
                                                                               HorizontalAlignment="Center" />
                                                                </Border>
                                                                <Border Background="{StaticResource GdErrorBrush}"
                                                                        CornerRadius="8"
                                                                        Padding="4,1"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        IsVisible="{Binding HasUnreadMessages}">
                                                                    <TextBlock Text="{Binding UnreadBadgeText}"
                                                                               Foreground="White"
                                                                               FontSize="9"
                                                                               FontWeight="Bold"
                                                                               HorizontalAlignment="Center" />
                                                                </Border>
                                                            </Grid>

                                                            <StackPanel Grid.Column="1"
                                                                        Spacing="2"
                                                                        VerticalAlignment="Center">
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      ColumnSpacing="6">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="12"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding MemberSummary}"
                                                                               FontSize="9"
                                                                               VerticalAlignment="Center"
                                                                               IsVisible="{Binding HasNoUnreadMessages}"
                                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding GroupSummary}"
                                                                           FontSize="10"
                                                                           TextWrapping="Wrap"
                                                                           MaxLines="1"
                                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </controls:SwipeRevealPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- 侧边栏加载遮罩 -->
                        <Border Grid.Row="3"
                                Background="{DynamicResource GdBackgroundBrush}"
                                Opacity="0.85"
                                IsVisible="{Binding IsSidebarBusy}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Margin="0,8">
                                <ProgressBar IsIndeterminate="True"
                                             Width="160" />
                                <TextBlock Text="{Binding SidebarLoadingMessage}"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- 中栏：聊天面板（对话头 + 消息列表 + 输入区）                    -->
                <!-- ============================================================ -->
                <Border Classes="GdMetricCard"
                        Grid.Column="1"
                        Padding="0"
                        MinHeight="0"
                        ClipToBounds="True">
                    <Grid>
                        <TransitioningContentControl Name="ConversationTransitionHost"
                                                     Content="{Binding ActiveConversationState}"
                                                     MinHeight="0">
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.25" />
                            </TransitioningContentControl.PageTransition>
                            <TransitioningContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:ConversationViewState">
                                    <Grid RowDefinitions="Auto,*,Auto"
                                          RowSpacing="0">
                                        <!-- 对话头 -->
                                        <Border BorderBrush="{DynamicResource GdBorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="16,12">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="10">
                                                <!-- 头像（32x32 渐变背景 + 首字） -->
                                                <Border Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        ClipToBounds="True">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                            <GradientStop Offset="0" Color="{StaticResource GdSuccess}" />
                                                            <GradientStop Offset="1" Color="{StaticResource GdBrand600}" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>

                                                <!-- 昵称 + 在线状态 -->
                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding OnlineStatusText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource GdSuccessBrush}" />
                                                </StackPanel>

                                                <!-- 右侧操作按钮组（间距4px，对应设计稿 gap:4px） -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <Button ToolTip.Tip="语音通话"
                                                            Classes="GdHeaderIconBtn"
                                                            IsVisible="{Binding !$parent[UserControl].DataContext.IsGroupConversationActive}">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="16"
                                                              Height="16"
                                                              Data="{StaticResource LucidePhoneGeometry}" />
                                                    </Button>

                                                    <Button ToolTip.Tip="视频通话"
                                                            Classes="GdHeaderIconBtn"
                                                            IsVisible="{Binding !$parent[UserControl].DataContext.IsGroupConversationActive}">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="16"
                                                              Height="16"
                                                              Data="{StaticResource LucideVideoGeometry}" />
                                                    </Button>

                                                    <Button ToolTip.Tip="邀请好友入群"
                                                            Classes="GdHeaderIconBtn"
                                                            IsVisible="{Binding $parent[UserControl].DataContext.IsGroupConversationActive}"
                                                            Command="{Binding $parent[UserControl].DataContext.InviteToGroupCommand}">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="16"
                                                              Height="16"
                                                              Data="{StaticResource LucideUserPlusGeometry}" />
                                                    </Button>

                                                    <Button ToolTip.Tip="群成员"
                                                            Classes="GdHeaderIconBtn"
                                                            IsVisible="{Binding $parent[UserControl].DataContext.IsGroupConversationActive}"
                                                            Command="{Binding $parent[UserControl].DataContext.ToggleGroupMembersPanelCommand}">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="16"
                                                              Height="16"
                                                              Data="{StaticResource LucideUsersGeometry}" />
                                                    </Button>

                                                    <Button ToolTip.Tip="清理聊天记录"
                                                            Classes="GdHeaderIconBtn"
                                                            Command="{Binding $parent[UserControl].DataContext.ClearChatCommand}">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="16"
                                                              Height="16"
                                                              Data="{StaticResource LucideTrash2Geometry}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 消息列表 -->
                                        <Grid Grid.Row="1"
                                              MinHeight="0">
                                            <ScrollViewer Name="ConversationMessagesScrollViewer"
                                                          Padding="14,12,28,12"
                                                          MinHeight="0"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Auto"
                                                          ClipToBounds="True"
                                                          Background="{DynamicResource GdBackgroundBrush}">
                                                <ItemsControl ItemsSource="{Binding Messages}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                                                            <StackPanel Margin="0,0,0,8"
                                                                        Spacing="4">
                                                                <!-- 消息头：昵称（仅群聊显示） -->
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="8"
                                                                            HorizontalAlignment="{Binding BubbleAlignment}"
                                                                            IsVisible="{Binding $parent[UserControl].DataContext.IsGroupConversationActive}">
                                                                    <TextBlock Text="{Binding SenderDisplayName}"
                                                                               Classes="GdEyebrow"
                                                                               FontSize="10" />
                                                                </StackPanel>

                                                                <Border Classes="GdChatBubble"
                                                                        CornerRadius="{Binding BubbleCornerRadius}"
                                                                        Background="{Binding BubbleBackground}"
                                                                        BorderBrush="{Binding BubbleBorder}"
                                                                        BorderThickness="0"
                                                                        HorizontalAlignment="{Binding BubbleAlignment}"
                                                                        IsVisible="{Binding !IsEmoji}">
                                                                    <StackPanel Spacing="8">
                                                                        <TextBlock Text="{Binding Text}"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding HasText}"
                                                                                   Foreground="{Binding BubbleForeground}" />
                                                                        <Border IsVisible="{Binding HasFileCard}"
                                                                                Cursor="Hand"
                                                                                PointerPressed="MediaCard_Tapped"
                                                                                Background="{DynamicResource GdMutedBrush}"
                                                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                                                Padding="10,8">
                                                                            <Grid ColumnDefinitions="Auto,*"
                                                                                  ColumnSpacing="10">
                                                                                <Border Grid.Column="0"
                                                                                        Width="36"
                                                                                        Height="36"
                                                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                                                        Background="{DynamicResource GdMutedBrush}">
                                                                                    <TextBlock Text="{Binding FileIcon}"
                                                                                               FontSize="16"
                                                                                               HorizontalAlignment="Center"
                                                                                               VerticalAlignment="Center" />
                                                                                </Border>
                                                                                <StackPanel Grid.Column="1"
                                                                                            VerticalAlignment="Center"
                                                                                            Spacing="2">
                                                                                    <TextBlock Text="{Binding FileDisplayName}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               MaxWidth="260" />
                                                                                    <TextBlock Text="{Binding FileSizeLabel}"
                                                                                               FontSize="10"
                                                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                        <Border IsVisible="{Binding HasCard}"
                                                                                Cursor="Hand"
                                                                                PointerPressed="MediaCard_Tapped">
                                                                            <controls:VideoMessageCard />
                                                                        </Border>
                                                                        <UniformGrid IsVisible="{Binding HasMultipleImages}"
                                                                                      Columns="{Binding AttachmentGridColumns}"
                                                                                      Rows="0">
                                                                            <ItemsControl ItemsSource="{Binding AttachmentImages}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <UniformGrid Columns="1" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Border Margin="2"
                                                                                                CornerRadius="4"
                                                                                                ClipToBounds="True"
                                                                                                Cursor="Hand"
                                                                                                PointerPressed="AttachmentImage_PointerPressed"
                                                                                                Tag="{Binding $self}">
                                                                                            <Image Source="{Binding}"
                                                                                                   Stretch="UniformToFill"
                                                                                                   Width="120"
                                                                                                   Height="120" />
                                                                                        </Border>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </UniformGrid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- 时间戳（气泡下方） -->
                                                                <TextBlock Text="{Binding TimestampText}"
                                                                           Classes="GdChatTime"
                                                                           HorizontalAlignment="{Binding BubbleAlignment}"
                                                                           IsVisible="{Binding !IsEmoji}" />

                                                                <TextBlock Text="{Binding Text}"
                                                                           TextWrapping="Wrap"
                                                                           IsVisible="{Binding IsEmoji}"
                                                                           FontSize="32"
                                                                           HorizontalAlignment="{Binding BubbleAlignment}" />

                                                                <!-- 消息操作按钮行 -->
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="4"
                                                                            HorizontalAlignment="{Binding BubbleAlignment}"
                                                                            IsVisible="{Binding CanForward}">
                                                                    <Button ToolTip.Tip="转发"
                                                                            Background="{DynamicResource GdMutedBrush}"
                                                                            BorderThickness="0"
                                                                            Width="28"
                                                                            Height="28"
                                                                            Padding="0"
                                                                            CornerRadius="{DynamicResource GdRadiusSm}"
                                                                            IsVisible="{Binding CanForward}"
                                                                            Click="ForwardButton_Click">
                                                                        <PathIcon Data="M9 5v2h6.59L4 18.59 5.41 20 17 8.41V15h2V5z"
                                                                                  Width="13"
                                                                                  Height="13"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                    </Button>
                                                                    <Button ToolTip.Tip="复制"
                                                                            Background="{DynamicResource GdMutedBrush}"
                                                                            BorderThickness="0"
                                                                            Width="28"
                                                                            Height="28"
                                                                            Padding="0"
                                                                            CornerRadius="{DynamicResource GdRadiusSm}"
                                                                            IsVisible="{Binding CanCopyContent}"
                                                                            Click="CopyButton_Click">
                                                                        <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm4 8H8V3h12v6zM6 21h12v-2H6v2zm14-6H8V9h12v6z"
                                                                                  Width="13"
                                                                                  Height="13"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                    </Button>
                                                                    <Button ToolTip.Tip="保存"
                                                                            Background="{DynamicResource GdMutedBrush}"
                                                                            BorderThickness="0"
                                                                            Width="28"
                                                                            Height="28"
                                                                            Padding="0"
                                                                            CornerRadius="{DynamicResource GdRadiusSm}"
                                                                            IsVisible="{Binding CanSaveMedia}"
                                                                            Click="SaveButton_Click">
                                                                        <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                                                  Width="13"
                                                                                  Height="13"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"
                                                                                  Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <Button Name="ScrollToBottomButton"
                                                    Content="回到底部"
                                                    Classes="GdPrimary GdBtnSm"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Bottom"
                                                    Margin="0,0,0,16"
                                                    Padding="14,5"
                                                    FontSize="11"
                                                    IsVisible="False"
                                                    Click="ScrollToBottomButton_Click" />
                                        </Grid>

                                        <!-- 输入区 -->
                                        <Border Grid.Row="2"
                                                BorderBrush="{DynamicResource GdBorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Padding="16,12">
                                            <StackPanel Spacing="8">
                                                <Border Background="{DynamicResource GdMutedBrush}"
                                                        CornerRadius="{DynamicResource GdRadiusSm}"
                                                        Padding="6"
                                                        IsVisible="{Binding $parent[UserControl].DataContext.HasPendingAttachment}">
                                                    <Grid ColumnDefinitions="*,Auto"
                                                          ColumnSpacing="8">
                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding $parent[UserControl].DataContext.PendingAttachments}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="6" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Width="52"
                                                                                Height="52"
                                                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                                                ClipToBounds="True"
                                                                                Background="{DynamicResource GdMutedBrush}">
                                                                            <Grid>
                                                                                <TextBlock Text="{Binding KindLabel}"
                                                                                           FontSize="9"
                                                                                           Foreground="{DynamicResource GdPrimaryBrush}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                                <Button Width="18"
                                                                                        Height="18"
                                                                                        Padding="0"
                                                                                        CornerRadius="9"
                                                                                        FontSize="9"
                                                                                        HorizontalAlignment="Right"
                                                                                        VerticalAlignment="Top"
                                                                                        Margin="0,2,2,0"
                                                                                        Background="{DynamicResource GdOverlayBrush}"
                                                                                        Foreground="White"
                                                                                        Click="RemovePendingAttachment_Click"
                                                                                        Tag="{Binding}"
                                                                                        Content="✕" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <Button Grid.Column="1"
                                                                Content="清空"
                                                                Classes="GdGhost GdBtnSm"
                                                                Padding="8,4"
                                                                FontSize="10"
                                                                VerticalAlignment="Center"
                                                                Command="{Binding $parent[UserControl].DataContext.ClearAllAttachmentsCommand}" />
                                                    </Grid>
                                                </Border>

                                                <!-- 输入框 -->
                                                <TextBox x:Name="MessageInputBox"
                                                         Text="{Binding $parent[UserControl].DataContext.NewMessageContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         MinHeight="64"
                                                         MaxHeight="110"
                                                         FontSize="12"
                                                         Watermark="{Binding InputWatermark}"
                                                         Classes="GdInput"
                                                         CornerRadius="{DynamicResource GdRadiusSm}" />

                                                <!-- 操作按钮行 -->
                                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                                                      ColumnSpacing="8">
                                                    <Button ToolTip.Tip="表情"
                                                            Classes="GdHeaderIconBtn"
                                                            Click="EmojiPickerButton_Click">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="18"
                                                              Height="18"
                                                              Data="{StaticResource LucideSmileGeometry}" />
                                                        <Button.Flyout>
                                                            <Flyout Placement="Top">
                                                                <ScrollViewer MaxWidth="260"
                                                                              MaxHeight="160">
                                                                    <WrapPanel x:Name="EmojiWrapPanel"
                                                                               Width="240">
                                                                    </WrapPanel>
                                                                </ScrollViewer>
                                                            </Flyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            ToolTip.Tip="发送图片"
                                                            Classes="GdHeaderIconBtn"
                                                            Click="AttachImageButton_Click">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="18"
                                                              Height="18"
                                                              Data="{StaticResource LucideImageGeometry}" />
                                                    </Button>
                                                    <Button Grid.Column="2"
                                                            ToolTip.Tip="发送视频"
                                                            Classes="GdHeaderIconBtn"
                                                            Click="AttachVideoButton_Click">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="18"
                                                              Height="18"
                                                              Data="{StaticResource LucideVideoGeometry}" />
                                                    </Button>
                                                    <Button Grid.Column="3"
                                                            ToolTip.Tip="发送文件"
                                                            Classes="GdHeaderIconBtn"
                                                            Click="AttachFileButton_Click">
                                                        <Path Classes="GdLucideIcon"
                                                              Width="18"
                                                              Height="18"
                                                              Data="{StaticResource LucideFileTextGeometry}" />
                                                    </Button>
                                                    <TextBlock Grid.Column="4"
                                                               FontSize="9"
                                                               Text="Enter 发送 | Alt+Enter 换行"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                    <Button Grid.Column="5"
                                                            Classes="GdPrimary"
                                                            Padding="16,8"
                                                            FontSize="13"
                                                            Command="{Binding $parent[UserControl].DataContext.SendMessageCommand}">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="6">
                                                            <Path Classes="GdLucideIcon"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Data="{StaticResource LucideSendGeometry}" />
                                                            <TextBlock Text="{Binding $parent[UserControl].DataContext.SendButtonLabel}" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </TransitioningContentControl.ContentTemplate>
                        </TransitioningContentControl>

                        <!-- 媒体查看器覆盖层 -->
                        <Border x:Name="MediaViewerOverlay"
                                Background="{DynamicResource GdOverlayBrush}"
                                IsVisible="False">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- 顶部操作栏 -->
                                <Grid ColumnDefinitions="Auto,*"
                                      Margin="14,10">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="4">
                                        <Button ToolTip.Tip="上一张"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerPrevButton_Click">
                                            <PathIcon Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                        <Button ToolTip.Tip="下一张"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerNextButton_Click">
                                            <PathIcon Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="4">
                                        <Button ToolTip.Tip="转发"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerForwardButton_Click">
                                            <PathIcon Data="M9 5v2h6.59L4 18.59 5.41 20 17 8.41V15h2V5z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                        <Button ToolTip.Tip="复制"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerCopyButton_Click">
                                            <PathIcon Data="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm4 8H8V3h12v6zM6 21h12v-2H6v2zm14-6H8V9h12v6z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                        <Button ToolTip.Tip="保存"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerSaveButton_Click">
                                            <PathIcon Data="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                        <Button ToolTip.Tip="关闭"
                                                Classes="GdGhost GdBtnSm"
                                                Width="32"
                                                Height="32"
                                                Padding="0"
                                                CornerRadius="{DynamicResource GdRadiusSm}"
                                                Click="ViewerCloseButton_Click">
                                            <PathIcon Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                      Width="15"
                                                      Height="15"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="White" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- 媒体展示区 -->
                                <Image x:Name="MediaViewerImage"
                                       Grid.Row="1"
                                       Stretch="Uniform"
                                       Margin="28" />

                                <!-- 底部信息栏 -->
                                <StackPanel Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,14"
                                            Spacing="4">
                                    <TextBlock x:Name="MediaViewerTitle"
                                               HorizontalAlignment="Center"
                                               FontWeight="SemiBold"
                                               Foreground="White" />
                                    <TextBlock x:Name="MediaViewerSubtitle"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 对话区加载遮罩 -->
                        <Border Background="{DynamicResource GdBackgroundBrush}"
                                Opacity="0.85"
                                IsVisible="{Binding IsConversationBusy}">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10">
                                <ProgressBar IsIndeterminate="True"
                                             Width="200" />
                                <TextBlock Text="{Binding ConversationLoadingMessage}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- 邀请好友入群弹窗 -->
                        <Border x:Name="InviteFriendsOverlay"
                                Background="{DynamicResource GdOverlayBrush}"
                                IsVisible="{Binding IsInviteFriendsOverlayOpen}">
                            <Border Classes="GdDialog"
                                    Padding="18"
                                    MaxWidth="360"
                                    MaxHeight="440"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Grid RowDefinitions="Auto,*,Auto"
                                      RowSpacing="10">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="邀请好友入群"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="选择要邀请的好友（支持多选）"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    </StackPanel>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding Friends}"
                                             SelectionMode="Multiple"
                                             x:Name="InviteFriendsListBox"
                                             BorderThickness="0"
                                             Background="Transparent">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="6" />
                                                <Setter Property="CornerRadius" Value="{DynamicResource GdRadiusSm}" />
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:User">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="8">
                                                    <Border Width="28"
                                                            Height="28"
                                                            CornerRadius="14"
                                                            ClipToBounds="True"
                                                            Background="{DynamicResource GdMutedBrush}">
                                                        <Panel>
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontWeight="Bold"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource GdPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center"
                                                                       IsVisible="{Binding !HasAvatarBitmap}" />
                                                            <Image Source="{Binding AvatarBitmap}"
                                                                   Stretch="UniformToFill"
                                                                   IsVisible="{Binding HasAvatarBitmap}" />
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2"
                                          ColumnDefinitions="*,Auto,Auto"
                                          ColumnSpacing="8">
                                        <TextBlock Text="{Binding InviteStatusMessage}"
                                                   FontSize="10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                        <Button Grid.Column="1"
                                                Content="取消"
                                                Classes="GdGhost GdBtnSm"
                                                Padding="12,5"
                                                FontSize="11"
                                                Command="{Binding CloseInviteFriendsOverlayCommand}" />
                                        <Button Grid.Column="2"
                                                Content="发送邀请"
                                                Classes="GdPrimary GdBtnSm"
                                                Padding="12,5"
                                                FontSize="11"
                                                Click="SendGroupInviteButton_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- ============================================================ -->
                <!-- 右栏：聊天信息面板（头像+昵称+签名+共享文件+操作）              -->
                <!-- 群组成员面板作为覆盖层（IsGroupMembersPanelOpen 时显示）         -->
                <!-- ============================================================ -->
                <Grid Grid.Column="2">
                    <!-- 聊天信息面板 -->
                    <Border Classes="GdMetricCard"
                            Padding="0"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <!-- 头像 + 昵称 + 状态 + 签名 -->
                            <Border Padding="16,16"
                                    BorderBrush="{DynamicResource GdBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="10"
                                            HorizontalAlignment="Center">
                                    <!-- 在线大头像（渐变背景 + 白字） -->
                                    <Border Width="56"
                                            Height="56"
                                            CornerRadius="28"
                                            ClipToBounds="True"
                                            IsVisible="{Binding ActiveConversationState.IsOnline}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Offset="0" Color="{StaticResource GdSuccess}" />
                                                <GradientStop Offset="1" Color="{StaticResource GdBrand600}" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <TextBlock Text="{Binding ActiveConversationState.AvatarInitial}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <!-- 离线大头像（muted 背景 + muted-foreground 字） -->
                                    <Border Width="56"
                                            Height="56"
                                            CornerRadius="28"
                                            ClipToBounds="True"
                                            Background="{DynamicResource GdMutedBrush}"
                                            IsVisible="{Binding !ActiveConversationState.IsOnline}">
                                        <TextBlock Text="{Binding ActiveConversationState.AvatarInitial}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding ActiveConversationState.Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                Spacing="4">
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource GdSuccessBrush}"
                                                 IsVisible="{Binding ActiveConversationState.IsOnline}" />
                                        <Ellipse Width="7"
                                                 Height="7"
                                                 Fill="{DynamicResource GdMutedForegroundBrush}"
                                                 IsVisible="{Binding !ActiveConversationState.IsOnline}" />
                                        <TextBlock Text="{Binding ActiveConversationState.OnlineStatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource GdSuccessBrush}"
                                                   IsVisible="{Binding ActiveConversationState.IsOnline}" />
                                        <TextBlock Text="{Binding ActiveConversationState.OnlineStatusText}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                   IsVisible="{Binding !ActiveConversationState.IsOnline}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveConversationState.Description}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               LineHeight="17"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 共享文件列表（对应设计稿3个文件卡：图片/文档/音乐） -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="共享文件"
                                               Classes="GdSectionHeader"
                                               FontSize="11" />
                                    <!-- 图片文件卡（info-surface + image 图标） -->
                                    <Border Classes="GdSharedFileCard">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="{DynamicResource GdRadiusSm}"
                                                    Background="{DynamicResource GdInfoSurfaceBrush}">
                                                <Path Classes="GdLucideIcon"
                                                      Width="16"
                                                      Height="16"
                                                      Data="{StaticResource LucideImageGeometry}"
                                                      Stroke="{DynamicResource GdInfoBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="百合叶片.jpg"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                                <TextBlock Text="248 KB"
                                                           FontSize="10"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 文档文件卡（success-surface + file-text 图标） -->
                                    <Border Classes="GdSharedFileCard">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="{DynamicResource GdRadiusSm}"
                                                    Background="{DynamicResource GdSuccessSurfaceBrush}">
                                                <Path Classes="GdLucideIcon"
                                                      Width="16"
                                                      Height="16"
                                                      Data="{StaticResource LucideFileTextGeometry}"
                                                      Stroke="{DynamicResource GdSuccessBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="种植笔记.pdf"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                                <TextBlock Text="1.2 MB"
                                                           FontSize="10"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 音乐文件卡（warning-surface + music 图标） -->
                                    <Border Classes="GdSharedFileCard">
                                        <Grid ColumnDefinitions="Auto,*"
                                              ColumnSpacing="8">
                                            <Border Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    CornerRadius="{DynamicResource GdRadiusSm}"
                                                    Background="{DynamicResource GdWarningSurfaceBrush}">
                                                <Path Classes="GdLucideIcon"
                                                      Width="16"
                                                      Height="16"
                                                      Data="{StaticResource LucideMusicGeometry}"
                                                      Stroke="{DynamicResource GdWarningBrush}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="田园午后.mp3"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                                <TextBlock Text="4.6 MB"
                                                           FontSize="10"
                                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- 操作按钮区 -->
                            <Border Grid.Row="2"
                                    Padding="12"
                                    BorderBrush="{DynamicResource GdBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                <StackPanel Spacing="6">
                                    <Button Classes="GdGhost"
                                            Padding="6"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <Path Classes="GdLucideIcon"
                                                  Width="13"
                                                  Height="13"
                                                  Data="{StaticResource LucideUserXGeometry}" />
                                            <TextBlock Text="屏蔽消息" />
                                        </StackPanel>
                                    </Button>
                                    <Button Classes="GdDanger"
                                            Padding="6"
                                            FontSize="12"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <Path Classes="GdLucideIcon"
                                                  Width="13"
                                                  Height="13"
                                                  Data="{StaticResource LucideUserMinusGeometry}" />
                                            <TextBlock Text="删除好友" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 群组成员面板（覆盖聊天信息） -->
                    <Border Background="{DynamicResource GdCardBrush}"
                            BorderBrush="{DynamicResource GdBorderBrush}"
                            BorderThickness="1,0,0,0"
                            IsVisible="{Binding IsGroupMembersPanelOpen}"
                            ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto,*"
                              RowSpacing="0">
                            <!-- 面板头 -->
                            <Border Padding="12,10"
                                    BorderBrush="{DynamicResource GdBorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="群成员"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GroupMemberCountText}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="✕"
                                            FontSize="11"
                                            Padding="6,4"
                                            CornerRadius="4"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding ToggleGroupMembersPanelCommand}"
                                            VerticalAlignment="Top" />
                                </Grid>
                            </Border>

                            <!-- 加载指示器 -->
                            <ProgressBar Grid.Row="1"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsGroupMembersLoading}"
                                         Height="2" />

                            <!-- 成员列表 -->
                            <ScrollViewer Grid.Row="2"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="8,6">
                                <ItemsControl ItemsSource="{Binding GroupMembers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:GroupMemberItem">
                                            <Border Padding="5,5"
                                                    CornerRadius="{DynamicResource GdRadiusSm}"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="8">
                                                    <!-- 头像 -->
                                                    <Grid Width="32"
                                                          Height="32">
                                                        <Border Width="32"
                                                                Height="32"
                                                                CornerRadius="16"
                                                                Background="{DynamicResource GdMutedBrush}"
                                                                IsVisible="{Binding !HasAvatarBitmap}">
                                                            <TextBlock Text="{Binding AvatarInitial}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <Image Source="{Binding AvatarBitmap}"
                                                               Width="32"
                                                               Height="32"
                                                               IsVisible="{Binding HasAvatarBitmap}">
                                                            <Image.Clip>
                                                                <EllipseGeometry Rect="0,0,32,32" />
                                                            </Image.Clip>
                                                        </Image>
                                                        <Border Width="9"
                                                                Height="9"
                                                                CornerRadius="5"
                                                                Background="{Binding StatusDotColor}"
                                                                HorizontalAlignment="Right"
                                                                VerticalAlignment="Bottom"
                                                                IsVisible="{Binding IsOnline}">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="2"
                                                                                  Opacity="0.5" />
                                                            </Border.Effect>
                                                        </Border>
                                                    </Grid>

                                                    <!-- 昵称 + 角色 -->
                                                    <StackPanel Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                Spacing="1">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="110" />
                                                        <TextBlock Text="{Binding RoleLabel}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                                                   IsVisible="{Binding IsOwner}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 好友分组新增/编辑弹窗（全页覆盖） -->
            <Border x:Name="FriendGroupOverlay"
                    ZIndex="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource GdOverlayBrush}"
                    IsVisible="{Binding IsFriendGroupOverlayOpen}">
                <Border Classes="GdDialog"
                        Padding="18"
                        Width="360"
                        MaxHeight="225"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                        <StackPanel Grid.Row="0"
                                    Spacing="4">
                            <TextBlock Text="{Binding FriendGroupOverlayTitle}"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding FriendGroupOverlaySubtitle}"
                                       FontSize="10"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        </StackPanel>
                        <TextBox x:Name="FriendGroupInputBox"
                                 Grid.Row="1"
                                 Text="{Binding FriendGroupInputText, Mode=TwoWay}"
                                 Watermark="分组名称"
                                 Classes="GdInput"
                                 FontSize="13"
                                 Padding="10,8"
                                 KeyDown="FriendGroupInputBox_KeyDown" />
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding FriendGroupStatusMessage}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Classes="GdGhost GdBtnSm"
                                    Padding="12,5"
                                    FontSize="11"
                                    Command="{Binding CloseFriendGroupOverlayCommand}" />
                            <Button Grid.Column="2"
                                    Content="{Binding FriendGroupOverlayTitle}"
                                    Classes="GdPrimary GdBtnSm"
                                    Padding="12,5"
                                    FontSize="11"
                                    Command="{Binding ConfirmFriendGroupOverlayCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- 删除分组确认弹窗（全页覆盖） -->
            <Border x:Name="DeleteGroupOverlay"
                    ZIndex="100"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource GdOverlayBrush}"
                    IsVisible="{Binding IsDeleteGroupOverlayOpen}">
                <Border Classes="GdDialog"
                        Padding="18"
                        Width="360"
                        MaxHeight="225"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid RowDefinitions="Auto,Auto,Auto"
                          RowSpacing="10">
                        <StackPanel Grid.Row="0"
                                    Spacing="4">
                            <TextBlock Text="删除分组"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}">
                                <Run Text="确定要删除分组「" /><Run Text="{Binding DeleteGroupDisplayName}" FontWeight="SemiBold" /><Run Text="」吗？分组内的好友将移动到默认分组。" />
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding DeleteGroupStatusMessage}"
                                       FontSize="10"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            <Button Grid.Column="1"
                                    Content="取消"
                                    Classes="GdGhost GdBtnSm"
                                    Padding="12,5"
                                    FontSize="11"
                                    Command="{Binding CloseDeleteGroupOverlayCommand}" />
                            <Button Grid.Column="2"
                                    Content="删除"
                                    Classes="GdDanger GdBtnSm"
                                    Padding="12,5"
                                    FontSize="11"
                                    Command="{Binding ConfirmDeleteGroupOverlayCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </controls:GalleryPage>
</UserControl>
