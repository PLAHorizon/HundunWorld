<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
			 xmlns:models="using:Horizon.Game.GengDi.Models"
			 xmlns:ui="using:FluentAvalonia.UI.Controls"
			 xmlns:media="using:Avalonia.Media"
			 x:Class="Horizon.Game.GengDi.Core.Views.LoginView"
			 x:DataType="vm:LoginDashboardViewModel">

	<UserControl.Styles>
		<!-- 登录信息卡片样式 -->
		<Style Selector="Border.InfoCard">
			<Setter Property="Background" Value="{DynamicResource LoginInfoCardBackgroundBrush}" />
			<Setter Property="CornerRadius" Value="16" />
			<Setter Property="Padding" Value="20" />
			<Setter Property="BorderBrush" Value="{DynamicResource LoginInfoCardBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Border.InfoCard TextBlock.CardTitle">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LoginInfoCardTitleBrush}" />
		</Style>
		<Style Selector="Border.InfoCard TextBlock.CardText">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource LoginInfoCardTextBrush}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.InfoCard TextBlock.CardValue">
			<Setter Property="FontSize" Value="28" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource LoginFormTextBrush}" />
		</Style>
		<Style Selector="Border.InfoCard TextBlock.CardLoading">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource LoginInfoCardLoadingBrush}" />
		</Style>

		<!-- 登录输入框样式 -->
		<Style Selector="Border.LoginInputBox">
			<Setter Property="Background" Value="{DynamicResource LoginInputBackgroundBrush}" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="BorderBrush" Value="{DynamicResource LoginInputBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="12,12,12,12" />
		</Style>
		<Style Selector="Border.LoginInputBox TextBox">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource LoginFormTextBrush}" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Normal" />
		</Style>
		<Style Selector="Border.LoginInputBox TextBlock.InputIcon">
			<Setter Property="Foreground" Value="{DynamicResource LoginFormMutedBrush}" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- 登录按钮样式 -->
		<Style Selector="Button.LoginPrimary">
			<Setter Property="Background" Value="{DynamicResource BattleNetPrimaryBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Height" Value="48" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Button.LoginPrimary:pointerover">
			<Setter Property="Background" Value="{DynamicResource BattleNetPrimaryHoverBrush}" />
		</Style>
		<Style Selector="Button.LoginPrimary:pressed">
			<Setter Property="Background" Value="{DynamicResource BattleNetPrimaryPressedBrush}" />
		</Style>

		<Style Selector="Button.LoginSecondary">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource LoginFormSubtitleBrush}" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Height" Value="48" />
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="BorderBrush" Value="{DynamicResource BattleNetOutlineBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="Button.LoginSecondary:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource BattleNetPrimaryBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource LoginInfoCardTitleBrush}" />
		</Style>

		<!-- 标签样式 -->
		<Style Selector="TextBlock.LoginLabel">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{DynamicResource LoginFormTitleBrush}" />
			<Setter Property="Margin" Value="0,0,0,8" />
		</Style>
	</UserControl.Styles>

	<Grid ColumnDefinitions="*,440"
		  Margin="0">
		<!-- ==================== LEFT: Hero Area ==================== -->
		<Border Grid.Column="0"
				Background="{DynamicResource BattleNetHeroBackgroundBrush}"
				CornerRadius="0"
				Padding="0"
				ClipToBounds="True">
			<Panel>
				<Border Background="{DynamicResource LoginHeroOverlayBrush}" />
				<Image Source="/Assets/Images/wuxia-atmosphere.jpg"
					   Stretch="UniformToFill"
					   Opacity="0.55" />

				<Canvas ClipToBounds="True" Opacity="0.35">
					<Ellipse Width="320" Height="320" Canvas.Left="-70" Canvas.Top="-40"
							 Fill="{DynamicResource LoginDecorCircleBrush}" />
					<Ellipse Width="220" Height="220" Canvas.Left="300" Canvas.Top="320"
							 Fill="{DynamicResource LoginDecorCircleBrush}" />
				</Canvas>

				<Grid VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
					<StackPanel Spacing="20" HorizontalAlignment="Center">
						<Border Width="76" Height="76" CornerRadius="38"
								Background="{DynamicResource BattleNetPrimaryBrush}"
								HorizontalAlignment="Center">
							<Image Source="/Assets/Images/white-dove.jpg"
								   Stretch="UniformToFill"
								   ClipToBounds="True"
								   Margin="8" />
						</Border>

						<TextBlock Text="元阳游戏方舟"
								   FontSize="36"
								   FontWeight="Bold"
								   HorizontalAlignment="Center"
								   Foreground="{DynamicResource LoginTitleGradientBrush}" />
						<TextBlock Text="探索无限可能的游戏世界"
								   FontSize="16"
								   FontWeight="Light"
								   Foreground="{DynamicResource LoginFormSubtitleBrush}"
								   HorizontalAlignment="Center"
								   TextAlignment="Center"
								   TextWrapping="Wrap"
								   Margin="0,0,0,24" />

						<StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
							<Border Classes="InfoCard" Width="220">
								<StackPanel Spacing="10">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource LoginInfoCardIconBgBrush}">
											<Viewbox Margin="7">
												<ui:IconSourceElement IconSource="{StaticResource LoginWeatherIcon}" />
											</Viewbox>
										</Border>
										<TextBlock Text="天气预报" Classes="CardTitle" VerticalAlignment="Center" />
									</StackPanel>
									<TextBlock Text="{Binding WeatherSummary}" Classes="CardValue" />
									<TextBlock Text="加载中..." Classes="CardLoading" IsVisible="{Binding IsLoading}" />
								</StackPanel>
							</Border>

							<Border Classes="InfoCard" Width="220">
								<StackPanel Spacing="10">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource LoginInfoCardIconBgBrush}">
											<Viewbox Margin="7">
												<ui:IconSourceElement IconSource="{StaticResource LoginFlowerIcon}" />
											</Viewbox>
										</Border>
										<TextBlock Text="花卉推荐" Classes="CardTitle" VerticalAlignment="Center" />
									</StackPanel>
									<TextBlock Text="{Binding FlowerSummary}" Classes="CardValue" />
									<TextBlock Text="加载中..." Classes="CardLoading" IsVisible="{Binding IsLoading}" />
								</StackPanel>
							</Border>

							<Border Classes="InfoCard" Width="220">
								<StackPanel Spacing="10">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource LoginInfoCardIconBgBrush}">
											<Viewbox Margin="7">
												<ui:IconSourceElement IconSource="{StaticResource LoginGameIcon}" />
											</Viewbox>
										</Border>
										<TextBlock Text="推荐游戏" Classes="CardTitle" VerticalAlignment="Center" />
									</StackPanel>
									<ItemsControl ItemsSource="{Binding RecommendedGames}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="models:GameInfo">
												<TextBlock Text="{Binding Name}"
														   FontSize="12"
														   Foreground="{DynamicResource LoginFormTextBrush}"
														   Margin="0,2"
														   TextWrapping="Wrap" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<TextBlock Text="加载中..." Classes="CardLoading" IsVisible="{Binding IsLoading}" />
								</StackPanel>
							</Border>
						</StackPanel>
					</StackPanel>
				</Grid>
			</Panel>
		</Border>

		<!-- ==================== RIGHT: Login Form ==================== -->
		<Border Grid.Column="1"
				Background="{DynamicResource LoginFormBackgroundBrush}"
				Padding="44,32,44,32">
			<Border >
				<StackPanel VerticalAlignment="Center"
							Spacing="20"
							MaxWidth="360"
							HorizontalAlignment="Stretch">

					<TextBlock Text="登录"
							   FontSize="30"
							   FontWeight="Bold"
							   Foreground="{DynamicResource LoginFormTitleBrush}" />
					<TextBlock Text="使用已注册账户进入客户端"
							   FontSize="14"
							   Foreground="{DynamicResource LoginFormSubtitleBrush}"
							   TextWrapping="Wrap" />

					<!-- 用户名 -->
					<StackPanel Spacing="8">
					<TextBlock Text="用户名" Classes="LoginLabel" />
					<Border Classes="LoginInputBox">
						<Grid ColumnDefinitions="Auto,*">
							<Viewbox Grid.Column="0"
									Width="18" Height="18"
									Margin="0,0,10,0"
									VerticalAlignment="Center">
								<ui:IconSourceElement IconSource="{StaticResource LoginUserIcon}"
													  Foreground="{DynamicResource LoginFormMutedBrush}" />
							</Viewbox>
							<TextBox Grid.Column="1"
									 Text="{Binding LoginVm.Username}"
									 Watermark="请输入用户名" />
						</Grid>
					</Border>
				</StackPanel>

				<!-- 密码 -->
				<StackPanel Spacing="8">
					<TextBlock Text="密码" Classes="LoginLabel" />
					<Border Classes="LoginInputBox">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Viewbox Grid.Column="0"
									Width="18" Height="18"
									Margin="0,0,10,0"
									VerticalAlignment="Center">
								<ui:IconSourceElement IconSource="{StaticResource LoginLockIcon}"
													  Foreground="{DynamicResource LoginFormMutedBrush}" />
							</Viewbox>
							<TextBox Grid.Column="1"
									 Text="{Binding LoginVm.Password}"
									 PasswordChar="*"
									 Watermark="请输入密码" />
							<Button Grid.Column="2"
									Background="Transparent"
									BorderThickness="0"
									VerticalAlignment="Center"
									Padding="4"
									Cursor="Hand">
								<Viewbox Width="18" Height="18">
									<ui:IconSourceElement IconSource="{StaticResource LoginEyeOffIcon}" />
								</Viewbox>
							</Button>
						</Grid>
					</Border>
				</StackPanel>

					<!-- 记住登录信息 -->
					<CheckBox Content="记住登录信息"
							  IsChecked="{Binding LoginVm.RememberLogin}"
							  Foreground="{DynamicResource LoginFormSubtitleBrush}" />

					<!-- 错误信息 -->
					<TextBlock Text="{Binding LoginVm.ErrorMessage}"
							   Foreground="{DynamicResource LoginErrorBrush}"
							   FontSize="13"
							   TextWrapping="Wrap"
							   IsVisible="{Binding LoginVm.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

					<!-- 按钮区（全宽堆叠） -->
					<StackPanel Spacing="16">
						<Button Content="登录"
								Classes="LoginPrimary"
								Command="{Binding LoginVm.LoginCommand}" />
						<Button Content="注册"
								Classes="LoginSecondary"
								Command="{Binding LoginVm.NavigateToRegisterCommand}" />
					</StackPanel>

				</StackPanel>
			</Border>
		</Border>
	</Grid>
</UserControl>
