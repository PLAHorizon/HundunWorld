<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.LoginView"
             x:DataType="vm:LoginDashboardViewModel">

    <Grid ColumnDefinitions="3*,2*">
        <!-- ==================== LEFT: Hero 品牌展示区（设计稿：brand-600背景 + 装饰几何 + 信息chip） ==================== -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{DynamicResource GdBrand600}" Offset="0" />
                    <GradientStop Color="{DynamicResource GdBrand800}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Panel>
                <!-- 装饰几何图形 -->
                <Canvas ClipToBounds="True">
                    <Ellipse Width="340" Height="340" Canvas.Left="-80" Canvas.Top="-90"
                             Fill="#1AFFFFFF" />
                    <Ellipse Width="220" Height="220" Canvas.Left="400" Canvas.Top="380"
                             Fill="#12FFFFFF" />
                    <Ellipse Width="120" Height="120" Canvas.Left="350" Canvas.Top="80"
                             Fill="#1FFFFFFF" />
                </Canvas>

                <!-- 品牌内容 -->
                <StackPanel VerticalAlignment="Center" Margin="60" Spacing="24">
                    <!-- Logo -->
                    <Border Width="56" Height="56" CornerRadius="{DynamicResource GdRadiusMd}"
                            Background="#33FFFFFF" HorizontalAlignment="Left">
                        <ui:IconSourceElement IconSource="{StaticResource SproutIcon}"
                                              Width="32" Height="32"
                                              Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="欢迎回到耕地"
                               FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                    <TextBlock Text="登录账户，继续你的花卉交易与游戏之旅。专业暗色终端，为每一位种植者与商人而生。"
                               FontSize="14" Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" MaxWidth="420" />

                    <!-- 天气卡片预览 · Weather Widget（设计稿 100% 还原）
                         适配暗色品牌背景: 半透明白色渐变 + 半透明白色边框/文字 -->
                    <Border MaxWidth="280" CornerRadius="{DynamicResource GdRadiusLg}"
                            Padding="20" BorderBrush="#33FFFFFF" BorderThickness="1"
                            Margin="0 16 0 0" HorizontalAlignment="Left">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#1AFFFFFF" Offset="0" />
                                <GradientStop Color="#0DFFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Spacing="12">
                            <!-- weather-location: 地图图标 + 位置 -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:SymbolIcon Symbol="MapPin" FontSize="14"
                                               Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                                <TextBlock Text="{Binding WeatherLocation}" FontSize="13"
                                           Foreground="#AAFFFFFF" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- weather-main: 左列(状况+风) + 右列(温度) -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <!-- weather-condition: 天气图标 + 状况文本 -->
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <controls:WeatherIconControl
                                            WmoCode="{Binding CurrentWeather.Current.WmoCode}"
                                            WeatherCondition="{Binding CurrentWeather.Current.ConditionText}"
                                            Width="18" Height="18" />
                                        <TextBlock Text="{Binding CurrentWeather.Current.ConditionText}"
                                                   FontSize="14" FontWeight="Medium"
                                                   Foreground="{DynamicResource GdPrimaryForegroundBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <!-- weather-meta: 风图标 + 风向风力 -->
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="🌬" FontSize="11"
                                                   Foreground="#AAFFFFFF" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CurrentWeather.Current.WindDescription}"
                                                   FontSize="12" Foreground="#AAFFFFFF"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- weather-temp: 当前温度 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentWeather.Current.Temperature, StringFormat={}{0}°}"
                                           FontSize="42" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GdPrimaryForegroundBrush}" LineHeight="42"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- weather-forecast: 预报摘要（顶部分隔线） -->
                            <Border BorderBrush="#33FFFFFF" BorderThickness="0 1 0 0"
                                    Padding="0 10 0 0">
                                <TextBlock Text="{Binding WeatherForecastSummary}"
                                           FontSize="12" Foreground="#AAFFFFFF"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 信息 Chip（花卉推荐 + 市场指数） -->
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0 12 0 0">
                        <Border Background="#1AFFFFFF" CornerRadius="{DynamicResource GdRadiusMd}"
                                Width="172" Height="68" Padding="14 10">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="🌸" FontSize="13" />
                                    <TextBlock Text="花卉推荐" FontSize="12" Foreground="#AAFFFFFF" />
                                </StackPanel>
                                <TextBlock Text="{Binding FlowerSummary}" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Background="#1AFFFFFF" CornerRadius="{DynamicResource GdRadiusMd}"
                                Width="172" Height="68" Padding="14 10">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="📈" FontSize="13" />
                                    <TextBlock Text="市场指数" FontSize="12" Foreground="#AAFFFFFF" />
                                </StackPanel>
                                <TextBlock Text="+3.2%" FontSize="14"
                                           FontWeight="SemiBold" Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Panel>
        </Border>

        <!-- ==================== RIGHT: 表单区（设计稿：card背景, 居中表单） ==================== -->
        <Border Grid.Column="1"
                Background="{DynamicResource GdCardBrush}"
                Padding="40 48">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center"
                            Spacing="0"
                            MaxWidth="380"
                            HorizontalAlignment="Stretch">

                    <!-- Logo + 品牌名 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 6">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource GdRadiusSm}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="{DynamicResource GdBrand500}" Offset="0" />
                                    <GradientStop Color="{DynamicResource GdBrand700}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:IconSourceElement IconSource="{StaticResource SproutIcon}"
                                                  Width="16" Height="16"
                                                  Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="耕地" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标题 -->
                    <TextBlock Text="登录" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource GdForegroundBrush}"
                               Margin="0 0 0 6" />
                    <TextBlock Text="使用已注册账户进入客户端" FontSize="13"
                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                               Margin="0 0 0 28" />

                    <!-- 账号输入框 -->
                    <StackPanel Spacing="8" Margin="0 0 0 18">
                        <TextBlock Text="账号" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:IconSourceElement IconSource="{StaticResource LoginUserIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LoginVm.Username}"
                                         Watermark="请输入用户名或手机号"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}"
                                         FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 密码输入框 -->
                    <StackPanel Spacing="8" Margin="0 0 0 16">
                        <TextBlock Text="密码" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <ui:IconSourceElement IconSource="{StaticResource LoginLockIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding LoginVm.Password}"
                                         PasswordChar="*"
                                         Watermark="请输入密码"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}"
                                         FontSize="14" />
                                <Button Grid.Column="2" Background="Transparent" BorderThickness="0"
                                        Padding="4" Cursor="Hand">
                                    <ui:IconSourceElement IconSource="{StaticResource LoginEyeOffIcon}"
                                                          Width="18" Height="18"
                                                          Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 记住我 + 忘记密码 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 22">
                        <CheckBox Content="记住登录信息"
                                  IsChecked="{Binding LoginVm.RememberLogin}"
                                  Foreground="{DynamicResource GdMutedForegroundBrush}"
                                  FontSize="13" />
                        <Button Grid.Column="1" Classes="GdGhost" Padding="4 2"
                                Content="忘记密码？" FontSize="13"
                                Foreground="{DynamicResource GdPrimaryBrush}" />
                    </Grid>

                    <!-- 错误信息 -->
                    <TextBlock Text="{Binding LoginVm.ErrorMessage}"
                               Foreground="{DynamicResource GdErrorBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0 0 0 12"
                               IsVisible="{Binding LoginVm.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- 登录按钮（全宽 46px） -->
                    <Button Classes="GdPrimary" Height="46" FontSize="15"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Command="{Binding LoginVm.LoginCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ui:IconSourceElement IconSource="{StaticResource LoginArrowIcon}"
                                                  Width="18" Height="18" />
                            <TextBlock Text="登录" />
                        </StackPanel>
                    </Button>

                    <!-- 分隔线 "或" -->
                    <Grid ColumnDefinitions="*,Auto,*" Margin="0 24 0 18">
                        <Border Background="{DynamicResource GdBorderBrush}" Height="1"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="或" FontSize="12"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                   Margin="12 0" VerticalAlignment="Center" />
                        <Border Grid.Column="2" Background="{DynamicResource GdBorderBrush}" Height="1"
                                VerticalAlignment="Center" />
                    </Grid>

                    <!-- 第三方登录按钮组 -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0 0 0 24">
                        <Button Classes="GdOutline" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="8 10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="💬" FontSize="14" />
                                <TextBlock Text="微信" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="GdOutline" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="8 10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🐧" FontSize="14" />
                                <TextBlock Text="QQ" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="GdOutline" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="8 10">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📷" FontSize="14" />
                                <TextBlock Text="扫码" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 底部注册链接 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="还没有账号？" FontSize="13"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        <Button Classes="GdGhost" Padding="4 2"
                                Command="{Binding LoginVm.NavigateToRegisterCommand}">
                            <TextBlock Text="立即注册" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GdPrimaryBrush}" />
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
