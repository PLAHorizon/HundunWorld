<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             xmlns:views="using:Horizon.Game.GengDi.Core.Views"
             x:Class="Horizon.Game.GengDi.Core.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <converters:WeatherIconConverter x:Key="WeatherIconConverter" />
        <converters:BoolToMaxHeightConverter x:Key="BoolToMaxHeightConverter" />
        <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        <converters:MapLayerToForegroundConverter x:Key="MapLayerToForegroundConverter" />
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource GdBackgroundBrush}">
            <StackPanel Spacing="20" Margin="24">

                <!-- ═══ 1. Hero Header（设计稿：64px渐变图标 + 标题 + 副标题 + 描述） ═══ -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <Border Width="64" Height="64" CornerRadius="{DynamicResource GdRadiusLg}"
                            VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="{DynamicResource GdBrand500}" Offset="0" />
                                <GradientStop Color="{DynamicResource GdBrand700}" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="🏠" FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Horizon 游戏管理平台" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <TextBlock Text="Horizon Game GengDi" FontSize="13"
                                   FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        <TextBlock Text="下载、更新和启动您喜爱的游戏" FontSize="13"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- ═══ 天气加载中 ═══ -->
                <Border Background="{DynamicResource GdCardBrush}"
                        BorderBrush="{DynamicResource GdBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource GdRadiusLg}"
                        Padding="24"
                        IsVisible="{Binding IsLoadingWeather}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Height="3"
                                     Foreground="{DynamicResource GdPrimaryBrush}"
                                     Background="{DynamicResource GdMutedBrush}" />
                        <TextBlock Text="正在加载天气数据..." FontSize="13"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ═══ 2. 天气大卡片（设计稿：平面布局，gradient背景，左栏数据+右栏图表） ═══ -->
                <Border CornerRadius="{DynamicResource GdRadiusLg}"
                        BorderBrush="{DynamicResource GdBorderBrush}"
                        BorderThickness="1"
                        Padding="24"
                        IsVisible="{Binding WeatherForecast}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1A2962FF" Offset="0" />
                            <GradientStop Color="#0F26A69A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ColumnDefinitions="*,280">
                        <!-- 左栏 -->
                        <StackPanel Spacing="12">
                            <!-- 地点 + 更新时间 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding SelectedCityName}" FontSize="14" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}" />
                                    <Button Classes="GdGhost" Padding="6 4"
                                            Command="{Binding ToggleCityPickerCommand}">
                                        <TextBlock Text="▾" FontSize="12"
                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding WeatherForecast.LastUpdateTime, StringFormat='{}{0:HH:mm} 更新'}"
                                           FontSize="12"
                                           FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </Grid>
                            <!-- 天气状态 -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <controls:WeatherIconControl WmoCode="{Binding WeatherForecast.Current.WmoCode}"
                                                             Width="24" Height="24" />
                                <TextBlock Text="{Binding WeatherForecast.Current.ConditionText}"
                                           FontSize="16" Foreground="{DynamicResource GdForegroundBrush}" />
                            </StackPanel>
                            <!-- 大温度 -->
                            <TextBlock FontSize="48" FontWeight="Light"
                                       FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                       Foreground="{DynamicResource GdForegroundBrush}"
                                       LineHeight="48">
                                <Run Text="{Binding WeatherForecast.Current.Temperature}" /><Run Text="°" />
                            </TextBlock>
                            <!-- 附加指标行 -->
                            <StackPanel Orientation="Horizontal" Spacing="20">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="降水概率" FontSize="12"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    <TextBlock Text="{Binding WeatherForecast.Daily[0].Precipitation, StringFormat='{}{0:F0}%'}"
                                               FontSize="14"
                                               FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                               Foreground="{DynamicResource GdForegroundBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="体感温度" FontSize="12"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    <TextBlock Text="{Binding WeatherForecast.Current.FeelsLike, StringFormat='{}{0}°'}"
                                               FontSize="14"
                                               FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                               Foreground="{DynamicResource GdForegroundBrush}" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="风向风力" FontSize="12"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                    <TextBlock Text="{Binding WeatherForecast.Current.WindDescription}"
                                               FontSize="14"
                                               FontFamily="JetBrains Mono, Cascadia Code, ui-monospace, monospace"
                                               Foreground="{DynamicResource GdForegroundBrush}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- 今日预报 -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="今日：" FontSize="13"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text="{Binding WeatherForecast.Current.ConditionText}" FontSize="13"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text=" · " FontSize="13"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text="{Binding WeatherForecast.Daily[0].Precipitation, StringFormat='{}降水{0:F0}%'}"
                                           FontSize="13" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text=" · " FontSize="13"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock FontSize="13" Foreground="{DynamicResource GdMutedForegroundBrush}">
                                    <Run Text="{Binding WeatherForecast.Daily[0].TemperatureMin, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding WeatherForecast.Daily[0].TemperatureMax, Mode=OneWay}" />
                                    <Run Text="°" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <!-- 右栏：温度趋势图区域 -->
                        <Border Grid.Column="1" Margin="24 0 0 0"
                                Background="#05FFFFFF"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="24小时温度趋势" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <Border Height="120" Background="#08FFFFFF"
                                        CornerRadius="{DynamicResource GdRadiusSm}">
                                    <TextBlock Text="📈" FontSize="32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.4" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 城市选择 Popup -->
                <Popup IsOpen="{Binding IsCityPickerOpen}"
                       Placement="Pointer"
                       MinWidth="320" MaxWidth="400">
                    <Popup.Child>
                        <Border Background="{DynamicResource GdPopoverBrush}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource GdRadiusLg}"
                                Padding="16"
                                BoxShadow="0 12 40 0 #00000088">
                            <StackPanel Spacing="12" MaxHeight="400">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding CitySearchText}"
                                             Watermark="搜索城市名称..."
                                             Classes="GdInput" Padding="10 8" />
                                    <Button Grid.Column="1" Content="✕" Classes="GdGhost"
                                            Padding="8 4" Margin="8 0 0 0"
                                            Command="{Binding CloseCityPickerCommand}" />
                                </Grid>
                                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSearchingCities}"
                                             Height="2" Foreground="{DynamicResource GdPrimaryBrush}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                                    <ItemsControl ItemsSource="{Binding FilteredCities}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:CityInfo">
                                                <Button Classes="GdGhost" Padding="12 10"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[UserControl].DataContext.SelectCityCommand}"
                                                        CommandParameter="{Binding LocationId}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                                   FontWeight="Medium"
                                                                   Foreground="{DynamicResource GdForegroundBrush}" />
                                                        <TextBlock Text="{Binding Province}" FontSize="11"
                                                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup.Child>
                </Popup>

                <!-- ═══ 天气加载错误 ═══ -->
                <Border Classes="GdCard"
                        IsVisible="{Binding WeatherLoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="24" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding WeatherLoadError}" FontSize="13"
                                   Foreground="{DynamicResource GdErrorBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="重试" Classes="GdOutline" Padding="12,6"
                                HorizontalAlignment="Center"
                                Command="{Binding LoadWeatherCommand}" />
                    </StackPanel>
                </Border>

                <!-- ═══ 3. 天气子卡片网格（设计稿：4列，图标容器+标题+描述） ═══ -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16"
                      IsVisible="{Binding WeatherForecast}">
                    <!-- 逐时预报 -->
                    <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleHourlyDetailCommand}">
                        <Border Classes="GdMetricCard">
                            <StackPanel Spacing="10">
                                <Border Classes="GdStatIcon" Background="{DynamicResource GdInfoSurfaceBrush}">
                                    <TextBlock Text="🕐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="逐时预报" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="查看未来24小时天气变化" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- 空气质量 -->
                    <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleAirQualityDetailCommand}">
                        <Border Classes="GdMetricCard">
                            <StackPanel Spacing="10">
                                <Border Classes="GdStatIcon" Background="{DynamicResource GdSuccessSurfaceBrush}">
                                    <TextBlock Text="🌬️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="空气质量" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="AQI 45 · 优" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- 生活指数 -->
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            IsVisible="{Binding LifeIndices.Count, Converter={StaticResource CountToVisibilityConverter}}"
                            Command="{Binding ToggleLifeIndexDetailCommand}">
                        <Border Classes="GdMetricCard">
                            <StackPanel Spacing="10">
                                <Border Classes="GdStatIcon" Background="{DynamicResource GdWarningSurfaceBrush}">
                                    <TextBlock Text="🎯" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="生活指数" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="紫外线强 · 注意防晒" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- 天气资讯 -->
                    <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding ToggleNewsDetailCommand}">
                        <Border Classes="GdMetricCard">
                            <StackPanel Spacing="10">
                                <Border Classes="GdStatIcon" Background="{DynamicResource GdInfoSurfaceBrush}">
                                    <TextBlock Text="📰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="天气资讯" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="最新气象资讯与预警" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </Grid>

                <!-- ═══ 4. 节气横幅（设计稿：warning gradient + sun图标 + 标题描述 + badge） ═══ -->
                <Border CornerRadius="{DynamicResource GdRadiusLg}"
                        Padding="16 20"
                        IsVisible="{Binding WeatherForecast}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#1AFF9800" Offset="0" />
                            <GradientStop Color="#0FEF5350" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#33FF9800" />
                    </Border.BorderBrush>
                    <Border.BorderThickness>1</Border.BorderThickness>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="☀️" FontSize="28" VerticalAlignment="Center" Margin="0 0 16 0" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding WeatherForecast.SolarTerm.Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                                <TextBlock Text="· 养生提醒" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GdForegroundBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherForecast.SolarTerm.Description}"
                                       FontSize="13" Foreground="{DynamicResource GdMutedForegroundBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="GdBadge GdWarning" VerticalAlignment="Center">
                            <TextBlock Text="高温预警" />
                        </Border>
                    </Grid>
                </Border>

                <!-- ═══ 5. 快速访问（设计稿：6列网格，图标+文字居中） ═══ -->
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="快速访问" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="12">
                        <!-- 行情仪表盘 -->
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="📊" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="行情仪表盘" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- 花卉市场 -->
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🌸" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="花卉市场" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- 种植建议 -->
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🌱" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="种植建议" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- AI助手 -->
                        <Button Grid.Column="3" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🤖" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="AI助手" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- 数据大屏 -->
                        <Button Grid.Column="4" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="📈" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="数据大屏" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                        <!-- 音乐 -->
                        <Button Grid.Column="5" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding NavigateToGamesCommand}">
                            <Border Classes="GdMetricCard">
                                <StackPanel Spacing="8" HorizontalAlignment="Center">
                                    <TextBlock Text="🎵" FontSize="28" HorizontalAlignment="Center" />
                                    <TextBlock Text="音乐" FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ═══ 花卉行情模块 ═══ -->
                <Border Classes="GdCard"
                        IsVisible="{Binding IsFlowerDataLoaded}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="🌸" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Text="花卉行情" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GdForegroundBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="预警中心" Classes="GdGhost"
                                    Padding="8 4" FontSize="11" />
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                            <Border Background="{DynamicResource GdInfoSurfaceBrush}"
                                    CornerRadius="{DynamicResource GdRadiusMd}" Padding="16 12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="今日均价" FontSize="11"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FlowerAvgPrice}" FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource GdInfoSurfaceBrush}"
                                    CornerRadius="{DynamicResource GdRadiusMd}" Padding="16 12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="涨跌幅" FontSize="11"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FlowerPriceChange}" FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource GdInfoSurfaceBrush}"
                                    CornerRadius="{DynamicResource GdRadiusMd}" Padding="16 12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="预警数" FontSize="11"
                                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FlowerAlertCount}" FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource GdForegroundBrush}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{DynamicResource GdInfoSurfaceBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}" Padding="16 12"
                                Cursor="Hand" Tapped="OnFlowerSpeciesDetailTapped">
                            <StackPanel Spacing="6">
                                <TextBlock Text="趋势预览" FontSize="12"
                                           Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBlock Text="📈 查看K线走势与预测区间 →" FontSize="13"
                                           Foreground="{DynamicResource GdBrand400Brush}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 天气详情侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsWeatherDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnWeatherOverlayTapped" />
            <views:WeatherDetailDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:WeatherDetailDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:WeatherDetailDrawerView.Transitions>
            </views:WeatherDetailDrawerView>
        </Panel>

        <!-- ═══ 节气食补侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsDishDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnDishOverlayTapped" />
            <views:DishDetailDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:DishDetailDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:DishDetailDrawerView.Transitions>
            </views:DishDetailDrawerView>
        </Panel>

        <!-- ═══ 逐时预报侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsHourlyDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnHourlyOverlayTapped" />
            <views:HourlyForecastDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:HourlyForecastDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:HourlyForecastDrawerView.Transitions>
            </views:HourlyForecastDrawerView>
        </Panel>

        <!-- ═══ 空气质量侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsAirQualityDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnAirQualityOverlayTapped" />
            <views:AirQualityDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:AirQualityDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:AirQualityDrawerView.Transitions>
            </views:AirQualityDrawerView>
        </Panel>

        <!-- ═══ 生活指数侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsLifeIndexDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnLifeIndexOverlayTapped" />
            <views:LifeIndexDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:LifeIndexDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:LifeIndexDrawerView.Transitions>
            </views:LifeIndexDrawerView>
        </Panel>

        <!-- ═══ 天气资讯侧滑抽屉 ═══ -->
        <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               IsVisible="{Binding IsNewsDetailOpen}" ZIndex="100">
            <Border Background="{DynamicResource GdOverlayBrush}" Tapped="OnNewsOverlayTapped" />
            <views:WeatherNewsDrawerView HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <views:WeatherNewsDrawerView.Transitions>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" />
                    </Transitions>
                </views:WeatherNewsDrawerView.Transitions>
            </views:WeatherNewsDrawerView>
        </Panel>
    </Grid>
</UserControl>
