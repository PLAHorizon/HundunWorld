<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:enums="using:Horizon.Game.GengDi.Enums"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:views="using:Horizon.Game.GengDi.Core.Views"
             x:Class="Horizon.Game.GengDi.Core.Views.MusicDiscoverView"
             x:DataType="vm:MusicDiscoverViewModel">

    <Panel>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Margin="24">

            <controls:GalleryPage Title="发现音乐"
                                  Subtitle="汽水音乐"
                                  Description="发现你喜欢的音乐，随时随地享受旋律。"
                                  IconSource="{StaticResource MusicIcon}">

                <StackPanel Spacing="20">

                    <Border Classes="SurfaceCard" Padding="24">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="为你推荐" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="根据你的喜好，为你精选的音乐" FontSize="13" Classes="SupportingText" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="导入本地歌曲" Classes="QuietAction" Padding="16 8"
                                        Command="{Binding OpenLocalImportDialogCommand}" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding RecommendedSongs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="200" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Song">
                                        <Border Classes="SurfaceCard" Margin="0 0 12 12" Padding="12"
                                                CornerRadius="12" Cursor="Hand"
                                                Tapped="SongItem_Tapped">
                                            <StackPanel Spacing="8">
                                                <Border Width="176" Height="120" CornerRadius="8"
                                                        Background="{DynamicResource SocialAvatarBackgroundBrush}"
                                                        ClipToBounds="True">
                                                    <TextBlock Text="♪" FontSize="36"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SocialAvatarTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                <TextBlock Text="{Binding DisplayArtist}" FontSize="12"
                                                           Classes="SupportingText"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="SurfaceCard" Padding="24" IsVisible="{Binding HasNetworkPlaylists}">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="热门歌单" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="来自网易云音乐" FontSize="12"
                                           Classes="SupportingText" VerticalAlignment="Center" />
                            </Grid>

                            <ItemsControl ItemsSource="{Binding NetworkPlaylists}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" ItemWidth="200" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Playlist">
                                        <Border Classes="SurfaceCard" Margin="0 0 12 12" Padding="12"
                                                CornerRadius="12" Cursor="Hand"
                                                Tapped="PlaylistItem_Tapped">
                                            <StackPanel Spacing="8">
                                                <Border Width="176" Height="120" CornerRadius="8"
                                                        Background="{DynamicResource SocialAvatarBackgroundBrush}"
                                                        ClipToBounds="True">
                                                    <Panel>
                                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding CoverUrl, Converter={x:Static views:StringNotEmptyConverter.Instance}}" />
                                                        <TextBlock Text="♫" FontSize="36"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource SocialAvatarTextBrush}"
                                                                   IsVisible="{Binding CoverUrl, Converter={x:Static views:StringNotEmptyConverter.Instance}, ConverterParameter=invert}" />
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="2"
                                                           LineHeight="18" />
                                                <TextBlock FontSize="11" Classes="SupportingText"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1">
                                                    <Run Text="{Binding CreatorName}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding PlayCount}" />
                                                    <Run Text=" 次播放" />
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="SurfaceCard" Padding="24">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="排行榜" FontSize="20" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="热门" Classes="QuietAction" Padding="12 6"
                                            Command="{Binding SelectRankingTypeCommand}"
                                            CommandParameter="{x:Static enums:MusicRankingType.Hot}" />
                                    <Button Content="新歌" Classes="QuietAction" Padding="12 6"
                                            Command="{Binding SelectRankingTypeCommand}"
                                            CommandParameter="{x:Static enums:MusicRankingType.New}" />
                                    <Button Content="飙升" Classes="QuietAction" Padding="12 6"
                                            Command="{Binding SelectRankingTypeCommand}"
                                            CommandParameter="{x:Static enums:MusicRankingType.Rising}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding CurrentRankingSongs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Song">
                                        <Border Padding="12 8" CornerRadius="8" Margin="0 0 0 4"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                Cursor="Hand"
                                                Tapped="SongItem_Tapped">
                                            <Grid ColumnDefinitions="40,*,Auto" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding #}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12 0 0 0">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                        <Border Background="{DynamicResource AccentTextFillColorSecondaryBrush}" CornerRadius="4" Padding="4 1" IsVisible="{Binding IsLocal}" VerticalAlignment="Center">
                                                            <TextBlock Text="本地" FontSize="10" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DisplayArtist}" FontSize="12" Classes="SupportingText" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                               Classes="SupportingText" VerticalAlignment="Center" />
                                                    <Button Classes="QuietAction" Padding="4"
                                                            Tapped="StoryButton_Tapped"
                                                            ToolTip.Tip="音乐故事">
                                                        <ui:SymbolIcon Symbol="MusicInfo" FontSize="12" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </controls:GalleryPage>
        </StackPanel>
    </ScrollViewer>

    <Popup IsOpen="{Binding LocalImportViewModel.IsDialogOpen}"
           Placement="Center" HorizontalOffset="0" VerticalOffset="0">
        <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="24" MinWidth="520" MaxHeight="600"
                BoxShadow="0 8 32 0 #00000044">
            <StackPanel Spacing="16" DataContext="{Binding LocalImportViewModel}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="导入本地歌曲" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="QuietAction" Padding="4"
                            Command="{Binding CloseDialogCommand}">
                        <ui:SymbolIcon Symbol="Cancel" FontSize="14" />
                    </Button>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="选择文件夹" Classes="QuietAction" Padding="16 8"
                            Command="{Binding SelectDirectoryCommand}" />
                    <Button Content="选择文件" Classes="QuietAction" Padding="16 8"
                            Command="{Binding SelectFilesCommand}" />
                </StackPanel>
                <CheckBox Content="复制到音乐库（推荐，避免移动文件后无法播放）" IsChecked="{Binding CopyToLibrary}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanning}" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Classes="SupportingText"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock FontSize="12" Classes="SupportingText"
                           IsVisible="{Binding IsScanning}">
                    <Run Text="扫描进度: " /><Run Text="{Binding ScanProgressText}" />
                </TextBlock>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding HasScannedSongs}">
                    <ItemsControl ItemsSource="{Binding ScannedSongs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Song">
                                <Border Padding="10 6" CornerRadius="6" Margin="0 0 0 3"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <TextBlock Text="♪" FontSize="14" Margin="0 0 8 0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SocialAvatarTextBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayArtist}" FontSize="11" Classes="SupportingText" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FileFormat}" FontSize="10"
                                                   Classes="SupportingText" VerticalAlignment="Center" Margin="8 0 0 0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right"
                            IsVisible="{Binding HasScannedSongs}">
                    <Button Content="取消" Classes="QuietAction" Padding="16 8"
                            Command="{Binding CloseDialogCommand}" />
                    <Button Content="导入选中歌曲" Classes="PrimaryAction" Padding="16 8"
                            Command="{Binding ImportCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>
    </Panel>
</UserControl>
