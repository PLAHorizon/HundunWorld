<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:models="using:Horizon.Game.GengDi.Models"
             xmlns:controls="using:Horizon.Game.GengDi.Core.Controls"
             xmlns:converters="using:Horizon.Game.GengDi.Core.Converters"
             x:Class="Horizon.Game.GengDi.Core.Views.WeatherDetailDrawerView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource GdPopoverBrush}"
            BorderBrush="{DynamicResource GdBorderBrush}"
            BorderThickness="1 0 0 0"
            Width="420" MaxWidth="500"
            HorizontalAlignment="Right">
        <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 0 0 1" Padding="20 16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="天气详情" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource GdForegroundBrush}" />
                    <Button Grid.Column="1" Content="✕" Classes="GdGhost" Padding="8 4" FontSize="14"
                            Command="{Binding CloseWeatherDetailCommand}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="20 16">

                    <!-- 日出日落（全宽卡片） -->
                    <Border Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8">
                                <TextBlock Text="🌅 日出日落" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdWarningBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="日出" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding TodaySunrise}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GdWarningBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="日落" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding TodaySunset}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GdWarningBrush}" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="日照" FontSize="10" Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                        <TextBlock Text="{Binding DayLength}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource GdWarningBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                            <Canvas Grid.Column="1" Width="100" Height="50" VerticalAlignment="Center">
                                <Path Data="M 10,40 A 40,40 0 0,1 90,40" Stroke="{StaticResource GdWarningSurface}" StrokeThickness="1.5" StrokeDashArray="3,2" />
                                <Ellipse Canvas.Left="45" Canvas.Top="8" Width="10" Height="10">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Color="{StaticResource GdWarning}" Offset="0.0" />
                                            <GradientStop Color="{StaticResource GdDown}" Offset="1.0" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>

                    <!-- 气象指标（4宫格，等高卡片） -->
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                          ColumnSpacing="12" RowSpacing="12">
                        <Border Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16 14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="🌬️ 风" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdBrand400Brush}" />
                                <TextBlock Text="{Binding WeatherForecast.Current.WindDirection}"
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GdForegroundBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding WeatherForecast.Current.WindSpeed, StringFormat='{}{0:F0} km/h'}"
                                               FontSize="11" Foreground="{DynamicResource GdBrand400Brush}" />
                                    <TextBlock Text="{Binding WeatherForecast.Current.WindLevel}"
                                               FontSize="11" Foreground="{DynamicResource GdUpBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16 14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="💧 湿度" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdBrand400Brush}" />
                                <TextBlock Text="{Binding WeatherForecast.Current.Humidity, StringFormat='{}{0}%'}"
                                           FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GdForegroundBrush}" />
                                <ProgressBar Value="{Binding WeatherForecast.Current.Humidity}" Maximum="100"
                                             Height="4" Foreground="{DynamicResource GdBrand400Brush}" Background="{DynamicResource GdMutedBrush}" CornerRadius="2" />
                                <TextBlock Text="{Binding WeatherForecast.Current.DewPoint, StringFormat='{}露点 {0}°'}"
                                           FontSize="10" Foreground="{DynamicResource GdForegroundMutedBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16 14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="📊 气压" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdUpBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding WeatherForecast.Current.Pressure, StringFormat='{}{0:F0}'}"
                                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GdForegroundBrush}" VerticalAlignment="Bottom" />
                                    <TextBlock Text="hPa" FontSize="11" Foreground="{DynamicResource GdForegroundMutedBrush}" VerticalAlignment="Bottom" Margin="0 0 0 3" />
                                </StackPanel>
                                <TextBlock Text="{Binding WeatherForecast.Current.PressureLevel}"
                                           FontSize="11" Foreground="{DynamicResource GdUpBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16 14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="☀️ 紫外线" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdWarningBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding WeatherForecast.Current.UvIndex}"
                                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GdForegroundBrush}" />
                                    <TextBlock Text="{Binding WeatherForecast.Current.UvText}"
                                               FontSize="13" Foreground="{DynamicResource GdWarningBrush}" VerticalAlignment="Bottom" Margin="0 0 0 3" />
                                </StackPanel>
                                <ProgressBar Value="{Binding WeatherForecast.Current.UvIndex}" Maximum="11"
                                             Height="4" Foreground="{DynamicResource GdWarningBrush}" Background="{DynamicResource GdMutedBrush}" CornerRadius="2" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 能见度（全宽卡片） -->
                    <Border Background="{DynamicResource GdMutedBrush}" CornerRadius="{DynamicResource GdRadiusLg}" Padding="16 14">
                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                            <StackPanel Spacing="4">
                                <TextBlock Text="👁️ 能见度" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource GdBrand400Brush}" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                    <TextBlock Text="{Binding WeatherForecast.Current.Visibility, StringFormat='{}{0:F0}'}"
                                               FontSize="24" FontWeight="Bold" Foreground="{DynamicResource GdForegroundBrush}" />
                                    <TextBlock Text="km" FontSize="11" Foreground="{DynamicResource GdForegroundMutedBrush}" VerticalAlignment="Bottom" Margin="0 0 0 3" />
                                </StackPanel>
                                <TextBlock Text="{Binding WeatherForecast.Current.VisibilityLevel}"
                                           FontSize="11" Foreground="{DynamicResource GdBrand400Brush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="☁️" FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding WeatherForecast.Current.CloudCover, StringFormat='{}云量 {0:F0}%'}"
                                               FontSize="11" Foreground="{DynamicResource GdForegroundMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BorderBrush="{DynamicResource GdBorderBrush}" BorderThickness="0 1 0 0" />

                    <!-- 未来天气 -->
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📅" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="未来天气" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource GdForegroundMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WeatherForecast.Daily}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DailyWeather">
                                    <Border Padding="14 10" CornerRadius="{DynamicResource GdRadiusMd}" Margin="0 0 0 6"
                                            Background="{DynamicResource GdMutedBrush}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding WeekDay}" FontSize="13" FontWeight="Medium"
                                                           Foreground="{DynamicResource GdForegroundMutedBrush}" Width="32" VerticalAlignment="Center" />
                                                <controls:WeatherIconControl WmoCode="{Binding WmoCode}"
                                                                             Width="28" Height="28" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="12 0">
                                                <TextBlock Text="{Binding Condition}" FontSize="11" Foreground="{DynamicResource GdForegroundMutedBrush}" />
                                                <Grid Width="100" Height="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <Border CornerRadius="2" Background="{DynamicResource GdBorderBrush}" />
                                                    <Border CornerRadius="2" Margin="{Binding TempBarMargin}"
                                                            Width="{Binding TempBarWidth}" Height="4"
                                                            HorizontalAlignment="Left">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                                <GradientStop Color="{StaticResource GdBrand400}" Offset="0.0" />
                                                                <GradientStop Color="{StaticResource GdWarning}" Offset="0.5" />
                                                                <GradientStop Color="{StaticResource GdDown}" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Precipitation, StringFormat='{}降水{0:F0}%'}" FontSize="9" Foreground="{DynamicResource GdBrand400Brush}" />
                                                    <TextBlock Text="{Binding Humidity, StringFormat='{}湿度{0}%'}" FontSize="9" Foreground="{DynamicResource GdForegroundMutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding TemperatureMin}" Foreground="{DynamicResource GdBrand400Brush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="°" Foreground="{DynamicResource GdBrand400Brush}" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock Text=" ~ " Foreground="{DynamicResource GdMutedForegroundBrush}" FontSize="9" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding TemperatureMax}" Foreground="{DynamicResource GdDownBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="°" Foreground="{DynamicResource GdDownBrush}" FontSize="10" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
