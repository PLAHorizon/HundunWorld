<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Horizon.Game.GengDi.Core.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Horizon.Game.GengDi.Core.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">
    <UserControl.DataContext>
        <vm:RegisterViewModel />
    </UserControl.DataContext>

    <Grid ColumnDefinitions="3*,2*">
        <!-- ==================== LEFT: Hero 品牌展示区 ==================== -->
        <Border Grid.Column="0" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="{DynamicResource GdBrand600}" Offset="0" />
                    <GradientStop Color="{DynamicResource GdBrand800}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Panel>
                <Canvas ClipToBounds="True">
                    <Ellipse Width="340" Height="340" Canvas.Left="-80" Canvas.Top="-90"
                             Fill="#1AFFFFFF" />
                    <Ellipse Width="220" Height="220" Canvas.Left="400" Canvas.Top="380"
                             Fill="#12FFFFFF" />
                    <Ellipse Width="120" Height="120" Canvas.Left="350" Canvas.Top="80"
                             Fill="#1FFFFFFF" />
                </Canvas>

                <StackPanel VerticalAlignment="Center" Margin="60" Spacing="24">
                    <Border Width="56" Height="56" CornerRadius="{DynamicResource GdRadiusMd}"
                            Background="#33FFFFFF" HorizontalAlignment="Left">
                        <ui:IconSourceElement IconSource="{StaticResource SproutIcon}"
                                              Width="32" Height="32"
                                              Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="加入耕地" FontSize="32" FontWeight="Bold"
                               Foreground="{DynamicResource GdPrimaryForegroundBrush}" />
                    <TextBlock Text="创建新账户，开启花卉交易与游戏之旅。专业暗色终端，为每一位种植者与商人而生。"
                               FontSize="14" Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" MaxWidth="420" />
                </StackPanel>
            </Panel>
        </Border>

        <!-- ==================== RIGHT: 注册表单 ==================== -->
        <Border Grid.Column="1"
                Background="{DynamicResource GdCardBrush}"
                Padding="40 48">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel VerticalAlignment="Center" Spacing="0"
                            MaxWidth="380" HorizontalAlignment="Stretch">

                    <!-- Logo + 品牌名 -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 0 0 6">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource GdRadiusSm}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="{DynamicResource GdBrand500}" Offset="0" />
                                    <GradientStop Color="{DynamicResource GdBrand700}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ui:IconSourceElement IconSource="{StaticResource SproutIcon}"
                                                  Width="16" Height="16"
                                                  Foreground="{DynamicResource GdPrimaryForegroundBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="耕地" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GdForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="注册" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource GdForegroundBrush}"
                               Margin="0 0 0 6" />
                    <TextBlock Text="填写基本信息创建账户" FontSize="13"
                               Foreground="{DynamicResource GdMutedForegroundBrush}"
                               Margin="0 0 0 28" />

                    <!-- 用户名 -->
                    <StackPanel Spacing="8" Margin="0 0 0 18">
                        <TextBlock Text="用户名" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:IconSourceElement IconSource="{StaticResource LoginUserIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Username}"
                                         Watermark="请输入用户名"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}" FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 邮箱 -->
                    <StackPanel Spacing="8" Margin="0 0 0 18">
                        <TextBlock Text="邮箱" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:IconSourceElement IconSource="{StaticResource LoginUserIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Email}"
                                         Watermark="请输入邮箱"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}" FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 密码 -->
                    <StackPanel Spacing="8" Margin="0 0 0 18">
                        <TextBlock Text="密码" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:IconSourceElement IconSource="{StaticResource LoginLockIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding Password}"
                                         PasswordChar="*" Watermark="8-20 位，建议字母数字组合"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}" FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 确认密码 -->
                    <StackPanel Spacing="8" Margin="0 0 0 16">
                        <TextBlock Text="确认密码" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource GdForegroundBrush}" />
                        <Border Background="{DynamicResource GdMutedBrush}"
                                CornerRadius="{DynamicResource GdRadiusMd}"
                                BorderBrush="{DynamicResource GdBorderBrush}"
                                BorderThickness="1" Padding="12 10">
                            <Grid ColumnDefinitions="Auto,*">
                                <ui:IconSourceElement IconSource="{StaticResource LoginLockIcon}"
                                                      Width="18" Height="18" Margin="0 0 10 0"
                                                      Foreground="{DynamicResource GdMutedForegroundBrush}" />
                                <TextBox Grid.Column="1" Text="{Binding ConfirmPassword}"
                                         PasswordChar="*" Watermark="请再次输入密码"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource GdForegroundBrush}" FontSize="14" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- 错误信息 -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource GdErrorBrush}"
                               FontSize="13" TextWrapping="Wrap" Margin="0 0 0 12"
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <!-- 注册按钮 -->
                    <Button Classes="GdPrimary" Height="46" FontSize="15"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0 0 0 16"
                            Command="{Binding RegisterCommand}">
                        <TextBlock Text="注册" />
                    </Button>

                    <!-- 返回登录 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="已有账号？" FontSize="13"
                                   Foreground="{DynamicResource GdMutedForegroundBrush}" />
                        <Button Classes="GdGhost" Padding="4 2"
                                Command="{Binding NavigateToLoginCommand}">
                            <TextBlock Text="返回登录" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GdPrimaryBrush}" />
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
