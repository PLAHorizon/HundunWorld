@page "/login"
@layout Horizon.WebAdmin.Shared.EmptyLayout
@namespace Horizon.WebAdmin.Pages
@using Horizon.WebAdmin.Services.Auth

@inject AuthService AuthService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div style="display:flex;min-height:100vh;">
    <div class="login-left" style="width:55%;background:linear-gradient(135deg,#1a1a2e,#16213e,#0f3460);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;color:white;">
        <div style="text-align:center;z-index:1;padding:40px;">
            <div style="font-size:48px;font-weight:700;color:white;text-shadow:0 2px 10px rgba(0,0,0,0.3);margin-bottom:16px;">Horizon</div>
            <div style="color:rgba(255,255,255,0.7);font-size:18px;">智能管理平台</div>
        </div>
    </div>
    <div style="width:45%;background:#f0f2f5;display:flex;align-items:center;justify-content:center;padding:40px;">
        <Card Style="width:400px;">
            <div style="text-align:center;margin-bottom:24px;">
                <TypographyTitle Level="3" Style="background:linear-gradient(135deg,#4A90D9,#7B68EE);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Horizon 管理后台</TypographyTitle>
                <TypographyText Class="login-subtitle-fadein">请输入系统账号密码登录</TypographyText>
            </div>
            <Form Model="@LoginForm" Layout="@FormLayout.Vertical" OnFinish="HandleLogin">
                <FormItem Label="账号">
                    <Input @bind-Value="@LoginForm.PassportId" Placeholder="请输入通行证号" />
                </FormItem>
                <FormItem Label="密码">
                    <InputPassword @bind-Value="@LoginForm.Password" Placeholder="请输入密码" />
                </FormItem>
                @if (!string.IsNullOrEmpty(ErrorMessage))
                {
                    <Alert Type="@AlertType.Error" Message="@ErrorMessage" ShowIcon="true" Style="margin-bottom:16px;" />
                }
                <Button Type="@ButtonType.Primary" HtmlType="submit" Block="true" Loading="@Loading" Style="margin-top:16px;">登 录</Button>
            </Form>
        </Card>
    </div>
</div>

@code {
    private LoginModel LoginForm { get; set; } = new();
    private bool Loading { get; set; }
    private string ErrorMessage { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var user = await AuthService.GetCurrentUserAsync();
        if (user?.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task HandleLogin(Microsoft.AspNetCore.Components.Forms.EditContext ctx)
    {
        Loading = true;
        ErrorMessage = "";
        try
        {
            var result = await AuthService.LoginAsync(LoginForm.PassportId, LoginForm.Password);
            if (result.Success)
            {
                await AuthStateProvider.NotifyStateChangedAsync();
                Navigation.NavigateTo("/", true);
            }
            else
            {
                ErrorMessage = result.ErrorMessage ?? "登录失败";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"登录异常: {ex.Message}";
        }
        Loading = false;
    }

    private class LoginModel
    {
        public string PassportId { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
