{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 系统概览",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Silo状态",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"hundunworld-silo\"}", "legendFormat": "{{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }
          ]
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "网关状态",
      "type": "stat",
      "targets": [
        { "expr": "up{job=\"hundunworld-gateway\"}", "legendFormat": "{{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 5000 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "活跃连接数",
      "type": "stat",
      "targets": [
        { "expr": "sum(hundunworld_gateway_connections_active)", "legendFormat": "连接数" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "活跃会话数",
      "type": "stat",
      "targets": [
        { "expr": "sum(hundunworld_silo_sessions_active)", "legendFormat": "会话数" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Grain调用速率",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(hundunworld_silo_grain_calls_total[5m]))", "legendFormat": "调用/秒" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "运行中任务",
      "type": "stat",
      "targets": [
        { "expr": "sum(hundunworld_silo_tasks_running)", "legendFormat": "任务数" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "⚡ Grain性能",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Grain调用速率（按类型）",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (grain_type) (rate(hundunworld_silo_grain_calls_total[5m]))", "legendFormat": "{{ grain_type }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" } },
      "title": "Grain调用延迟分位数",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(hundunworld_silo_grain_call_duration_ms_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(hundunworld_silo_grain_call_duration_ms_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(hundunworld_silo_grain_call_duration_ms_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "custom": { "lineWidth": 2, "fillOpacity": 10 }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 12,
      "title": "Grain错误率",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (grain_type) (rate(hundunworld_silo_grain_call_errors_total[5m])) / sum by (grain_type) (rate(hundunworld_silo_grain_calls_total[5m]))", "legendFormat": "{{ grain_type }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 13,
      "title": "Grain错误速率（按类型）",
      "type": "timeseries",
      "targets": [
        { "expr": "sum by (grain_type) (rate(hundunworld_silo_grain_call_errors_total[5m]))", "legendFormat": "{{ grain_type }}" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "🔐 认证与安全",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 20,
      "title": "认证速率",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(hundunworld_silo_auth_login_attempts_total[5m])", "legendFormat": "登录尝试" },
        { "expr": "rate(hundunworld_silo_auth_login_success_total[5m])", "legendFormat": "登录成功" },
        { "expr": "rate(hundunworld_silo_auth_login_failures_total[5m])", "legendFormat": "登录失败" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 21,
      "title": "注册与密码变更速率",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(hundunworld_silo_auth_registrations_total[5m])", "legendFormat": "注册" },
        { "expr": "rate(hundunworld_silo_auth_password_changes_total[5m])", "legendFormat": "密码变更" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 103,
      "title": "🌐 网关连接",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "id": 30,
      "title": "活跃连接数",
      "type": "timeseries",
      "targets": [
        { "expr": "hundunworld_gateway_connections_active", "legendFormat": "{{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "id": 31,
      "title": "连接建立/断开速率",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(hundunworld_gateway_connections_established_total[5m])", "legendFormat": "建立" },
        { "expr": "rate(hundunworld_gateway_connections_closed_total[5m])", "legendFormat": "断开" },
        { "expr": "rate(hundunworld_gateway_connections_errors_total[5m])", "legendFormat": "错误" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 104,
      "title": "📨 消息处理",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "id": 40,
      "title": "消息吞吐量",
      "type": "timeseries",
      "targets": [
        { "expr": "sum(rate(hundunworld_gateway_messages_received_total[5m]))", "legendFormat": "接收" },
        { "expr": "sum(rate(hundunworld_gateway_messages_sent_total[5m]))", "legendFormat": "发送" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "id": 41,
      "title": "消息处理延迟分位数",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(hundunworld_gateway_messages_processing_duration_ms_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(hundunworld_gateway_messages_processing_duration_ms_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(hundunworld_gateway_messages_processing_duration_ms_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "id": 105,
      "title": "🖥️ .NET运行时",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 50 },
      "id": 50,
      "title": "GC堆内存大小",
      "type": "timeseries",
      "targets": [
        { "expr": "process_runtime_dotnet_gc_heap_size_bytes", "legendFormat": "{{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 50 },
      "id": 51,
      "title": "GC回收次数",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(process_runtime_dotnet_gc_collections_count_total[5m])", "legendFormat": "Gen{{ generation }} - {{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 50 },
      "id": 52,
      "title": "线程池使用情况",
      "type": "timeseries",
      "targets": [
        { "expr": "process_runtime_dotnet_thread_pool_threads_count", "legendFormat": "活跃线程 - {{ instance }}" },
        { "expr": "process_runtime_dotnet_thread_pool_queue_length", "legendFormat": "队列长度 - {{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 58 },
      "id": 53,
      "title": "网络流量",
      "type": "timeseries",
      "targets": [
        { "expr": "rate(hundunworld_gateway_network_bytes_received_total[5m])", "legendFormat": "接收 {{ instance }}" },
        { "expr": "rate(hundunworld_gateway_network_bytes_sent_total[5m])", "legendFormat": "发送 {{ instance }}" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "lineWidth": 2, "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 58 },
      "id": 54,
      "title": "网络延迟",
      "type": "timeseries",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(hundunworld_gateway_network_latency_ms_bucket[5m])) by (le))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum(rate(hundunworld_gateway_network_latency_ms_bucket[5m])) by (le))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum(rate(hundunworld_gateway_network_latency_ms_bucket[5m])) by (le))", "legendFormat": "P99" }
      ]
    }
